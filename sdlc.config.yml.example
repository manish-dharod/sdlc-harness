# sdlc.config.yml — per-project configuration for sdlc-harness.
#
# Copy this file to `sdlc.config.yml` in your project root and edit
# the values to match your repo. The scripts read these as
# environment variables (the harness sources this file at startup
# via `scripts/load-config`).
#
# Every value has a documented default (or "no default — adopter must
# set"). The goal: no project-specific hardcoding anywhere in the
# engine layer.

# -----------------------------------------------------------------------
# Version control
# -----------------------------------------------------------------------

# The base branch your features merge into.
# Default: master
SDLC_BASE_BRANCH: master

# -----------------------------------------------------------------------
# Verification
# -----------------------------------------------------------------------

# Each feature can declare its own verification profile by dropping
# an executable script at scripts/<feature-slug>-verify. The script
# accepts a single arg: fast | unit | full. No central case
# statement; auto-discovery only.
#
# (No config keys required here; declaration is by file presence.)

# -----------------------------------------------------------------------
# Artifact hygiene
# -----------------------------------------------------------------------

# Paths that should NEVER appear in a branch diff (generated files,
# build outputs, test reports). Newline-separated extended regex
# patterns matched against `git diff --name-only <base>..HEAD`.
# Default: empty (no checks).
#
# Examples by project type:
#   Web app:        ^dist/|^build/|^.next/|^node_modules/
#   Python lib:     ^dist/|^build/|^.tox/|^htmlcov/|^.coverage
#   Rust:           ^target/|^Cargo\.lock$
#   Go:             ^bin/|^vendor/
#   Static site:    ^_site/|^public/build/|^cache/
SDLC_ARTIFACT_HYGIENE_PATTERNS: |
  # (uncomment + edit for your project)
  # ^dist/
  # ^build/
  # ^node_modules/

# -----------------------------------------------------------------------
# Arena eligibility
# -----------------------------------------------------------------------

# /feature-arena (constructive parallelism: N candidate implementations
# + cross-judge) is expensive. The framework only auto-spawns arena
# when a task touches a "high-risk surface" declared here.
#
# There is no built-in default. If this remains empty, /feature-arena
# refuses all tasks unless the invoker passes --force. Set this to
# patterns specific to your domain before relying on arena routing.
# Anything you set here is used verbatim.
#
# Pattern is an extended regex matched against task content
# (intended file ownership + task title + AC IDs).
#
# Examples by domain:
#   Payment / fintech:  (db/migrations/|payment[/_-]?gateway|secrets-vault|launch flag)
#   Healthcare:         (db/migrations/|phi-?vault|ehr-?integration|hipaa-?audit)
#   Multi-tenant SaaS:  (db/migrations/|tenancy-?boundary|rls-?policy|sso-?config)
#   Embedded / safety:  (firmware/|safety-?critical/|boot/|hardware-?driver/)
#   Open-source lib:    (api-?contract|public-?interface|version-?bump)
SDLC_ARENA_ELIGIBILITY_REGEX: ""

# -----------------------------------------------------------------------
# Codex CLI
# -----------------------------------------------------------------------

# Override tool binary paths (auto-discovered via PATH where possible).
# Default: discovered via PATH.
# CODEX_BIN: /usr/local/bin/codex
# CLAUDE_BIN: /usr/local/bin/claude

# Reasoning effort for codex invocations.
# One of: minimal | low | medium | high | xhigh
# Default: xhigh for adversary/security wrappers.
# ADVERSARY_REASONING: xhigh
# SECURITY_REASONING: xhigh

# Timeout for cross-model adversarial review wrapper calls, in seconds.
# Default: 300. Set to 0 to disable the timeout wrapper.
# ADVERSARY_REVIEW_TIMEOUT_SECONDS: 300

# -----------------------------------------------------------------------
# Optional local notification
# -----------------------------------------------------------------------

# Optional command for /feature-orchestrate to run after the final report is
# written. Keep this local and context-free. Do not use it to send feature
# context, secrets, diffs, or credentials to external services.
# SDLC_NOTIFY_COMMAND: afplay /System/Library/Sounds/Blow.aiff

# -----------------------------------------------------------------------
# Cross-model adversarial review
# -----------------------------------------------------------------------
#
# When SDLC_CROSS_MODEL_ADVERSARIAL_REQUIRED is true, every code-bearing
# Done task's adversarial trail MUST declare:
#   - Implementer tool + Implementer model
#   - Reviewer tool   + Reviewer model
# and the tool values MUST differ (claude-code vs codex-cli; same tool
# family does NOT satisfy the gate because RLHF lineage + training-data
# overlap correlate blind spots).
#
# When Reviewer tool is codex-cli or claude-code, the named local artifact path
# must exist as a real file. The cross-model section in
# `scripts/feature-reconcile` checks all of this; an unavailable reviewer is a
# hard block (no silent fallback to same-tool review).
# A per-feature `.cross-model-exempt` file (one task ID per line)
# grandfathers tasks that pre-date the gate.

# Default: true. Set to false to disable the gate (not recommended; the
# gate exists because same-model adversarial walks have a documented
# history of missing findings that cross-model catches).
# SDLC_CROSS_MODEL_ADVERSARIAL_REQUIRED: true

# Pinned reviewer models. When Claude wrote the code, the Codex
# reviewer must use this model. When Codex wrote the code, the Claude Code
# reviewer must use the model below.
# SDLC_CODEX_ADVERSARY_REQUIRED_MODEL: gpt-5.5
# SDLC_CLAUDE_ADVERSARY_REQUIRED_MODEL: claude-opus-4-8

# Review-stage false-confidence gates. These are mandatory in current public
# harness behavior; setting either false is reported as drift by reconcile.
# SDLC_REVIEW_STAGE_CROSS_MODEL_ADVERSARIAL_REQUIRED: true
# SDLC_QA_COVERAGE_LEDGER_REQUIRED: true

# Code-bearing root pathspecs used by feature-reconcile for task ownership and
# hygiene checks. Space-separated pathspecs.
# Default: scripts/*
# SDLC_CODE_BEARING_ROOTS: "scripts/* src/* app/*"

# Additional path regexes to ignore in reconcile changed-path checks.
# Default: empty.
# SDLC_RECONCILE_PATH_IGNORE: |
#   ^docs/generated/

# -----------------------------------------------------------------------
# Agent capsules
# -----------------------------------------------------------------------

# Optional bounded worker wrappers. The generated capsule is checked before
# dispatch and can be run through Codex CLI or Claude Code.
# Defaults:
#   SDLC_CODEX_WORKER_REQUIRED_MODEL: gpt-5.5
#   SDLC_CODEX_WORKER_REASONING: xhigh
#   SDLC_CLAUDE_WORKER_REQUIRED_MODEL: claude-opus-4-8
#   SDLC_CLAUDE_WORKER_EFFORT: xhigh
#   SDLC_CAPSULE_TIMEOUT_SECONDS: 900
# SDLC_CODEX_WORKER_REQUIRED_MODEL: gpt-5.5
# SDLC_CODEX_WORKER_REASONING: xhigh
# SDLC_CLAUDE_WORKER_REQUIRED_MODEL: claude-opus-4-8
# SDLC_CLAUDE_WORKER_EFFORT: xhigh
# SDLC_CAPSULE_TIMEOUT_SECONDS: 900

# -----------------------------------------------------------------------
# External / scratch worktrees
# -----------------------------------------------------------------------

# Optional root for agent-owned scratch worktrees. There is intentionally no
# default because the right location is project- and machine-specific. When set,
# scripts/worktree-add-external creates worktrees under this root and the bash
# guard hook blocks raw `git worktree add` targets outside it.
# SDLC_WORKTREE_ROOT: /absolute/path/to/agent-worktrees

# -----------------------------------------------------------------------
# Program backlog
# -----------------------------------------------------------------------

# Allowed backlog item areas. Used by scripts/backlog-index.
# Default: product|platform|sdlc-harness|security|quality|docs|ops|other
# SDLC_BACKLOG_AREAS_RE: "^(product|platform|sdlc-harness|security|quality|docs|ops|other)$"

# -----------------------------------------------------------------------
# Protected paths
# -----------------------------------------------------------------------

# Files / paths that no sdlc-* agent may modify without explicit
# human approval (config files, deployment manifests, secrets).
# Newline-separated extended regex.
# Default: empty (only the framework's own non-negotiables apply).
SDLC_PROTECTED_PATHS: |
  # .env
  # config/production.yml
  # deploy/

# -----------------------------------------------------------------------
# Domain pack
# -----------------------------------------------------------------------

# Optional: name of the domain pack the project draws from. The pack
# lives at examples/domains/<name>/ in the framework repo and supplies
# domain-specific principles, eligibility regex defaults, and
# verification helpers. Adopters can also write their own pack and
# point at it.
# Default: none (adopter wires per-piece manually).
# SDLC_DOMAIN_PACK: generic-web-app
