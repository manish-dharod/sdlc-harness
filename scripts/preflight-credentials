#!/usr/bin/env bash
# scripts/preflight-credentials — check declared external API readiness.
#
# Usage:
#   scripts/preflight-credentials <feature-slug>
#
# DESIGN.md format (legacy command preflight, still supported):
#   ## Credentials & external APIs
#   - Provider: Cloudflare
#     - Endpoint/action: Purge cache for a single URL
#     - Required scopes: Zone:Read, Cache Purge:Edit
#     - Preflight command: scripts/cloudflare-cache-purge-check --dry-run
#
# DESIGN.md / FEATURE.md format (declarative preflight, preferred for simple
# local readiness checks):
#   ## Required capabilities / credentials
#   - none
#   - env: ENV_VAR_NAME
#   - env-file: path/to/.env ENV_VAR_NAME
#   - file: path/to/file
#   - dir-writable: path/to/dir
#   - command: executable-name
#   - setup-script: scripts/path-to-helper
#
# The script runs only commands explicitly declared as "Preflight command:".
# It prints the literal command from DESIGN.md before running it; do not put
# raw secret values in that command. Reference environment variables instead.
# Declarative checks never print credential values and never run setup scripts.

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 3

. "$ROOT/scripts/load-config"

SLUG="${1:-}"

usage() {
  cat <<'EOF'
Usage: scripts/preflight-credentials <feature-slug>

Runs external API / credential preflight checks declared in:
  docs/features/<slug>/DESIGN.md
  docs/features/<slug>/FEATURE.md (small tier)

Command rows use:
  - Preflight command: <shell command>

Declarative rows under "## Required capabilities / credentials" use:
  - none
  - env: ENV_VAR_NAME
  - env-file: path/to/.env ENV_VAR_NAME
  - file: path/to/file
  - dir-writable: path/to/dir
  - command: executable-name
  - setup-script: scripts/path-to-helper

Exit codes:
  0 — no checks declared OR all declared checks passed
  1 — at least one declared check failed
  3 — usage / feature not found
EOF
}

if [ -z "$SLUG" ] || [ "$SLUG" = "-h" ] || [ "$SLUG" = "--help" ]; then
  usage
  exit 3
fi

DIR="docs/features/$SLUG"
if [ ! -d "$DIR" ]; then
  printf 'Feature not found: %s\n' "$DIR" >&2
  exit 3
fi

TIER="large"
if [ -f "$DIR/.tier" ]; then
  TIER=$(tr -d '[:space:]' < "$DIR/.tier")
fi
case "$TIER" in small|medium|large) ;; *) TIER="large" ;; esac

case "$TIER" in
  small) SOURCE_FILE="$DIR/FEATURE.md" ;;
  *)     SOURCE_FILE="$DIR/DESIGN.md" ;;
esac

DESIGN="$DIR/DESIGN.md"

commands_file="$(mktemp)"
declarations_file="$(mktemp)"
trap 'rm -f "$commands_file" "$declarations_file"' EXIT

if [ -f "$DESIGN" ]; then
  awk '
    /^```/ { in_code = !in_code; next }
    in_code { next }
    /^[[:space:]]*-[[:space:]]+Preflight command:[[:space:]]*/ {
      cmd = $0
      sub(/^[[:space:]]*-[[:space:]]+Preflight command:[[:space:]]*/, "", cmd)
      if (cmd != "") print cmd
    }
  ' "$DESIGN" > "$commands_file"
fi

if [ -f "$SOURCE_FILE" ]; then
  awk '
    /^```/ { in_code = !in_code; next }
    in_code { next }
    /^## Required capabilities \/ credentials[[:space:]]*$/ { in_section = 1; next }
    in_section && /^## / { exit }
    in_section && /^[[:space:]]*-/ { print }
  ' "$SOURCE_FILE" > "$declarations_file"
fi

count=$(wc -l < "$commands_file" | tr -d '[:space:]')
decl_count=$(wc -l < "$declarations_file" | tr -d '[:space:]')

if [ "${count:-0}" -eq 0 ] 2>/dev/null && [ "${decl_count:-0}" -eq 0 ] 2>/dev/null; then
  printf 'credential preflight: no checks declared for %s\n' "$SLUG"
  exit 0
fi

trim() {
  printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

is_valid_env_name() {
  case "$1" in
    ""|[0-9]*|*[!A-Za-z0-9_]*)
      return 1
      ;;
    *)
      return 0
      ;;
  esac
}

env_file_has_key() {
  local file="$1"
  local key="$2"
  awk -v key="$key" '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    {
      line=$0
      sub(/^[[:space:]]*/, "", line)
      if (index(line, key "=") == 1) {
        value=line
        sub(/^[^=]*=/, "", value)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
        if (value != "") found=1
      }
    }
    END { exit(found ? 0 : 1) }
  ' "$file"
}

failures=0

if [ "${decl_count:-0}" -gt 0 ] 2>/dev/null; then
  printf 'credential preflight: checking %s declaration(s) for %s\n' "$decl_count" "$SLUG"
  saw_none=0
  checked=0
  while IFS= read -r raw_line || [ -n "$raw_line" ]; do
    line=$(trim "$raw_line")
    line=${line#-}
    line=$(trim "$line")
    [ -z "$line" ] && continue
    checked=$((checked + 1))

    case "$line" in
      none)
        saw_none=1
        printf '  PASS: declares no external capabilities\n'
        ;;
      env:*)
        env_name=$(trim "${line#env:}")
        if ! is_valid_env_name "$env_name"; then
          printf '  FAIL: invalid env declaration name: %s\n' "$env_name" >&2
          failures=$((failures + 1))
        elif [ -n "${!env_name:-}" ]; then
          printf '  PASS: env present: %s\n' "$env_name"
        else
          printf '  FAIL: env missing or empty: %s\n' "$env_name" >&2
          failures=$((failures + 1))
        fi
        ;;
      env-file:*)
        rest=$(trim "${line#env-file:}")
        set -- $rest
        env_file="${1:-}"
        env_key="${2:-}"
        extra="${3:-}"
        if [ -z "$env_file" ] || [ -z "$env_key" ] || [ -n "$extra" ]; then
          printf '  FAIL: invalid env-file declaration (expected: env-file: path KEY)\n' >&2
          failures=$((failures + 1))
        elif ! is_valid_env_name "$env_key"; then
          printf '  FAIL: invalid env-file key name: %s\n' "$env_key" >&2
          failures=$((failures + 1))
        elif [ ! -r "$env_file" ]; then
          printf '  FAIL: env file missing or unreadable: %s\n' "$env_file" >&2
          failures=$((failures + 1))
        elif env_file_has_key "$env_file" "$env_key"; then
          printf '  PASS: env-file key present: %s %s\n' "$env_file" "$env_key"
        else
          printf '  FAIL: env-file key missing or empty: %s %s\n' "$env_file" "$env_key" >&2
          failures=$((failures + 1))
        fi
        ;;
      file:*)
        path=$(trim "${line#file:}")
        if [ -n "$path" ] && [ -e "$path" ]; then
          printf '  PASS: file exists: %s\n' "$path"
        else
          printf '  FAIL: file missing: %s\n' "$path" >&2
          failures=$((failures + 1))
        fi
        ;;
      dir-writable:*)
        path=$(trim "${line#dir-writable:}")
        if [ -n "$path" ] && [ -d "$path" ] && [ -w "$path" ]; then
          printf '  PASS: directory writable: %s\n' "$path"
        else
          printf '  FAIL: directory missing or not writable: %s\n' "$path" >&2
          failures=$((failures + 1))
        fi
        ;;
      command:*)
        cmd=$(trim "${line#command:}")
        case "$cmd" in
          ""|*/*|*[!A-Za-z0-9_.+-]*)
            printf '  FAIL: invalid command declaration: %s\n' "$cmd" >&2
            failures=$((failures + 1))
            ;;
          *)
            if command -v "$cmd" >/dev/null 2>&1; then
              printf '  PASS: command available: %s\n' "$cmd"
            else
              printf '  FAIL: command missing: %s\n' "$cmd" >&2
              failures=$((failures + 1))
            fi
            ;;
        esac
        ;;
      setup-script:*)
        path=$(trim "${line#setup-script:}")
        case "$path" in
          scripts/*)
            if printf '%s' "$path" | grep -qE '(^|/)\.\.($|/)'; then
              printf '  FAIL: setup-script path must not contain '"'"'..'"'"': %s\n' "$path" >&2
              failures=$((failures + 1))
            elif [ -f "$path" ] && [ -x "$path" ]; then
              printf '  PASS: setup-script executable: %s\n' "$path"
            else
              printf '  FAIL: setup-script missing or not executable: %s\n' "$path" >&2
              failures=$((failures + 1))
            fi
            ;;
          *)
            printf '  FAIL: setup-script must be a relative path under scripts/: %s\n' "$path" >&2
            failures=$((failures + 1))
            ;;
        esac
        ;;
      *)
        printf '  FAIL: unsupported declaration: %s\n' "$line" >&2
        failures=$((failures + 1))
        ;;
    esac
  done < "$declarations_file"

  if [ "$saw_none" -eq 1 ] && [ "$checked" -gt 1 ]; then
    printf '  FAIL: '"'"'none'"'"' cannot be combined with other preflight declarations\n' >&2
    failures=$((failures + 1))
  fi
fi

if [ "${count:-0}" -gt 0 ] 2>/dev/null; then
printf 'credential preflight: running %s command(s) for %s\n' "$count" "$SLUG"

idx=0
while IFS= read -r cmd || [ -n "$cmd" ]; do
  idx=$((idx + 1))
  printf '\n[%d/%d] %s\n' "$idx" "$count" "$cmd"
  if bash -lc "$cmd"; then
    printf '  PASS: preflight command %d\n' "$idx"
  else
    rc=$?
    failures=$((failures + 1))
    printf '  FAIL: preflight command %d exited %d\n' "$idx" "$rc" >&2
  fi
done < "$commands_file"
fi

if [ "$failures" -gt 0 ]; then
  printf '\ncredential preflight failed: %d check(s) failed\n' "$failures" >&2
  exit 1
fi

printf '\ncredential preflight passed: %s command(s), %s declaration(s)\n' "$count" "$decl_count"
exit 0
