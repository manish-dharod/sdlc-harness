#!/usr/bin/env python3
"""Fail-closed validator for owner-controlled per-item auto markers."""

import argparse
import json
from pathlib import Path
import re


def frontmatter(path: Path) -> dict[str, str]:
    lines = path.read_text(errors="replace").splitlines()
    if not lines or lines[0] != "---":
        raise ValueError("missing frontmatter")
    out: dict[str, str] = {}
    for line in lines[1:]:
        if line == "---":
            break
        if ": " in line:
            key, value = line.split(": ", 1)
            out[key] = value.strip()
    return out


def main() -> int:
    p = argparse.ArgumentParser()
    p.add_argument("route", choices=["visual-qa"])
    p.add_argument("item", type=Path)
    a = p.parse_args()
    if not a.item.is_file():
        p.error("item snapshot not found")

    try:
        if a.item.suffix == ".json":
            data = json.loads(a.item.read_text())
            labels = {v.get("name", "") if isinstance(v, dict) else str(v) for v in data.get("labels", [])}
            allowed = str(data.get("state", "")).lower() == "open" and {"auto", "visual-qa-regression"} <= labels
            item_id = f"GH-{data.get('number', 'unknown')}"
        else:
            data = frontmatter(a.item)
            allowed = (data.get("auto", "false") == "true" and
                       data.get("auto_consumer") == "visual-qa" and
                       data.get("status") in {"accepted", "in-progress"})
            item_id = data.get("id", "unknown")
    except (ValueError, json.JSONDecodeError):
        allowed, item_id = False, "unknown"

    if not re.fullmatch(r"(?:ENH-\d+|GH-\d+)", item_id) or not allowed:
        print("AUTO_ITEM_BLOCKED: explicit owner marker and eligible item state required")
        return 5
    print(json.dumps({"route": "visual-qa-review-branch", "item": item_id, "deploy": False, "merge": False}, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
