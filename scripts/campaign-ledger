#!/usr/bin/env python3
"""Append a parser-compatible RUN entry for supervisor/merge-train campaigns."""

import argparse
import datetime as dt
from pathlib import Path
import re

ROOT = Path(__file__).resolve().parent.parent


def main() -> int:
    p = argparse.ArgumentParser()
    p.add_argument("slug")
    p.add_argument("--campaign", required=True)
    p.add_argument("--iteration", required=True, type=int)
    p.add_argument("--mode", choices=["fast", "unit", "full"], required=True)
    p.add_argument("--routing", required=True)
    p.add_argument("--task", required=True)
    p.add_argument("--files-changed", required=True, type=int)
    p.add_argument("--diff-hash", required=True)
    p.add_argument("--verification", choices=["pass", "fail", "skipped"], required=True)
    p.add_argument("--stop-reason", required=True)
    p.add_argument("--stop-code", required=True)
    p.add_argument("--as-of")
    p.add_argument("--feature-dir", type=Path, help=argparse.SUPPRESS)
    a = p.parse_args()

    safe = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:/-]*$")
    for name, value in (("slug", a.slug), ("campaign", a.campaign), ("routing", a.routing),
                        ("task", a.task), ("diff hash", a.diff_hash), ("stop reason", a.stop_reason),
                        ("stop code", a.stop_code)):
        if not safe.fullmatch(value):
            p.error(f"unsafe {name}")
    if a.iteration < 0 or a.files_changed < 0:
        p.error("iteration and files-changed must be non-negative")

    feature = a.feature_dir or ROOT / "docs" / "features" / a.slug
    runs = feature / "RUNS.md"
    if not runs.is_file():
        p.error(f"missing {runs}")
    body = runs.read_text()
    ids = [int(v) for v in re.findall(r"^### RUN-(\d+)\b", body, re.M)]
    run_id = max(ids, default=0) + 1
    timestamp = a.as_of or dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    entry = f"""

### RUN-{run_id:03d} — {timestamp}

- Campaign: {a.campaign}
- Iteration index: {a.iteration}
- Mode: {a.mode}
- Routing: {a.routing}
- Task claimed: {a.task}
- Files changed: {a.files_changed}
- Diff hash: {a.diff_hash}
- Findings opened: none
- Findings closed: none
- Verification: {a.mode} = {a.verification}
- Approvals touched: none
- Stop reason: {a.stop_reason}
- Stop reason code: {a.stop_code}
- Cost estimate: {a.iteration + 1} iterations into {a.slug}
- Next step: route through the normal feature-loop/readiness gates
"""
    with runs.open("a") as out:
        out.write(entry)
    print(f"campaign-ledger: RUN-{run_id:03d} appended to {runs}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
