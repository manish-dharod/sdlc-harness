    if subprocess.run(
        ["git", "merge-base", "--is-ancestor", data["reviewed_candidate_sha"], "HEAD"],
        cwd=root, env=git_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    ).returncode:
        print("review-attempt: scoped receipt candidate is not an ancestor of current HEAD; preserve reviewed history (no squash/rebase)", file=sys.stderr)
        raise SystemExit(1)
    scope_proc = subprocess.run(
        [sys.executable, os.path.join(root, "scripts", "lib-review-scope.py"), "scope-json",
         data["feature"], data["task_id"], data["base_sha"], data["reviewed_candidate_sha"]],
        cwd=root, env=git_env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    if scope_proc.returncode:
        print(scope_proc.stderr.decode("utf-8", "replace").strip(), file=sys.stderr)
        raise SystemExit(1)
    scope = json.loads(scope_proc.stdout)
    if scope["scope_paths"] != data["scope_paths"] or scope["scope_hash"] != data["scope_hash"]:
        print("review-attempt: scoped receipt ownership/scope mismatch", file=sys.stderr)
        raise SystemExit(1)

