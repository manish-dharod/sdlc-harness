import json
import os, stat, sys

meta = os.lstat(sys.argv[1])
if not stat.S_ISREG(meta.st_mode) or meta.st_size > 262_144:
    raise SystemExit("review-attempt: receipt is not a bounded regular file")
with open(sys.argv[1], encoding="utf-8") as handle:
    data = json.load(handle)
machine_fields = {
    "base_sha", "canonical_diff_hash", "prompt_hash", "reviewed_candidate_sha",
    "scope_hash", "transcript_hash",
}
for key in sorted(data):
    if key in machine_fields:
        continue
    value = data[key]
    if key == "scope_paths":
        if not isinstance(value, list) or any(not isinstance(path, str) for path in value):
            raise SystemExit("review-attempt: receipt has invalid scope_paths projection")
        for path in value:
            print(f"scope_path={path}")
    elif isinstance(value, (str, int)) and not isinstance(value, bool):
        print(f"{key}={value}")
    else:
        raise SystemExit(f"review-attempt: receipt field cannot be safely projected: {key}")
PY
