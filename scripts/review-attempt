            "canonical-hash", data["base_sha"], data["reviewed_candidate_sha"]]
if version == 2:
    hash_cmd.extend([data["feature"], data["task_id"]])
proc = subprocess.run(hash_cmd, cwd=root, env=git_env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
if proc.returncode:
    print(proc.stderr.decode("utf-8", "replace").strip(), file=sys.stderr)
    raise SystemExit(1)
actual = proc.stdout.decode("ascii").strip()
if actual != data["canonical_diff_hash"]:
    print("review-attempt: canonical diff hash mismatch", file=sys.stderr)
    raise SystemExit(1)
