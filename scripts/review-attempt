        print("review-attempt: scoped receipt has unsafe scope path", file=sys.stderr)
        raise SystemExit(1)
    if not hash_re.fullmatch(data["scope_hash"]):
        print("review-attempt: scoped receipt has invalid scope_hash", file=sys.stderr)
