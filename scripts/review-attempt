    if subprocess.run(
        ["git", "cat-file", "-e", f"{value}^{{commit}}"], cwd=root,
        env=git_env,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    ).returncode:
        print(f"review-attempt: receipt references missing commit {value}", file=sys.stderr)
        raise SystemExit(1)
