#!/usr/bin/env bash
# Structured review-attempt metadata helper for SDLC cross-model review
# wrappers. Keeps the wrapper artifacts human-readable while giving
# orchestration scripts a durable, machine-readable sidecar to route retry,
# resume, and invalid-output states.

set -u
set -o pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 3
for git_redirect in GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_SHALLOW_FILE GIT_NAMESPACE; do
  unset "$git_redirect"
done
export GIT_NO_REPLACE_OBJECTS=1

usage() {
  cat <<'EOF'
Usage:
  scripts/review-attempt validate <adversary|security> <artifact.md>
  scripts/review-attempt status <adversary|security> <artifact.md>
  scripts/review-attempt next-attempt <feature-slug> <adversary|security> [task-id]
  scripts/review-attempt allocate <feature-slug> <adversary|security> <task-id|empty> <reviewer> <attempt>
  scripts/review-attempt write <sidecar.json> key=value ...
  scripts/review-attempt latest-retryable <feature-slug> [task-id] [adversary|security]
  scripts/review-attempt dirty-owned <feature-slug> <task-id>
  scripts/review-attempt dirty-scope <feature-slug> <task-id|feature> <base-sha> <candidate-sha>
  scripts/review-attempt scope-json <feature-slug> <task-id|feature> <base-sha> <candidate-sha>
  scripts/review-attempt canonical-diff <base-sha> <candidate-sha> [feature-slug task-id|feature [max-bytes]]
  scripts/review-attempt canonical-diff-hash <base-sha> <candidate-sha> [feature-slug task-id|feature]
  scripts/review-attempt write-receipt <receipt.json> key=value ...
  scripts/review-attempt validate-receipt <receipt.json> [--require-scoped] [--schema-only]
  scripts/review-attempt receipt-human-fields <receipt.json>

Statuses:
  clear | findings | timeout | incomplete | invalid-output | unavailable

Exit codes:
  0  command succeeded
  1  validation found invalid/incomplete output, or no retryable attempt found
  3  usage / missing feature / invalid argument
EOF
}

kind_dir() {
  case "$1" in
    adversary) printf 'adversary' ;;
    security)  printf 'security' ;;
    *) return 1 ;;
  esac
}

valid_identity() {
  [[ "$1" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]]
}

status_from_artifact() {
  local kind="$1"
  local artifact="$2"
  [ -f "$artifact" ] || { printf 'incomplete\n'; return 1; }

  # Parse Markdown structurally instead of grepping the entire transcript.
  # Reviewer prompts contain example verdict enums and models sometimes revise
  # themselves after an earlier verdict. Only one final, outside-code-fence
  # `### Verdict` block is authoritative. Its enum must agree with the actual
  # finding-record headings in the artifact.
  python3 - "$kind" "$artifact" <<'PY'
import os, re, stat
import sys

kind, artifact = sys.argv[1:3]
try:
    metadata = os.lstat(artifact)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_size > 300_000:
        raise OSError("artifact is not a bounded regular file")
    lines = open(artifact, encoding="utf-8").read().splitlines()
except OSError:
    print("incomplete")
    raise SystemExit(1)
except UnicodeError:
    print("invalid-output")
    raise SystemExit(1)

# Claude Code commonly wraps the whole requested Markdown response in one
# transport fence. After wrapper HTML headers and blank lines, strip only an
# exact first opener + last matching closer. The inner Markdown is then parsed
# normally, including balanced nested Evidence fences. A separate first and
# last code block leaves the real verdict fenced and is therefore rejected.
payload = list(lines)
while payload and (not payload[0].strip() or re.fullmatch(r"<!--.*-->", payload[0].strip())):
    payload.pop(0)
while payload and not payload[-1].strip():
    payload.pop()
if len(payload) >= 2:
    opener = re.match(r"^ {0,3}(`{3,}|~{3,})[^`~]*$", payload[0])
    if opener:
        char = opener.group(1)[0]
        width = len(opener.group(1))
        closer = re.fullmatch(rf" {{0,3}}{re.escape(char)}{{{width},}}[ \t]*", payload[-1])
        if closer:
            lines = payload[1:-1]

outside = []
fence_char = None
fence_len = 0
for line in lines:
    marker = re.match(r"^ {0,3}(`{3,}|~{3,})(?:[^`]*)$", line)
    if fence_char is None:
        if marker:
            fence_char = marker.group(1)[0]
            fence_len = len(marker.group(1))
            continue
        outside.append(line)
        continue
    close = re.match(r"^ {0,3}([`~]{3,})[ \t]*$", line)
    if close and close.group(1)[0] == fence_char and len(close.group(1)) >= fence_len:
        fence_char = None
        fence_len = 0

if fence_char is not None:
    print("invalid-output")
    raise SystemExit(1)

verdict_indexes = [
    index for index, line in enumerate(outside)
    if re.fullmatch(r" {0,3}### Verdict[ \t]*", line)
]
if len(verdict_indexes) != 1:
    lowered = "\n".join(outside).lower()
    if any(token in lowered for token in ("timed out after", "exited non-zero", "interrupted", "incomplete")):
        print("incomplete")
    else:
        print("invalid-output")
    raise SystemExit(1)

verdict_index = verdict_indexes[0]
tail = outside[verdict_index + 1 :]
if any(re.match(r"^ {0,3}#{1,6}[ \t]+", line) for line in tail):
    print("invalid-output")
    raise SystemExit(1)

if kind == "adversary":
    clear_enum = "ADVERSARIAL CLEAR"
    findings_enum = "ADVERSARIAL FINDINGS OPENED"
    finding_re = re.compile(r"^ {0,3}#{3,6}[ \t]+ADV-FND-[A-Za-z0-9._-]+(?:[ \t]|$)")
elif kind == "security":
    clear_enum = "SECURITY CLEAR"
    findings_enum = "SECURITY FINDINGS OPENED"
    finding_re = re.compile(r"^ {0,3}#{3,6}[ \t]+SEC-FND-[A-Za-z0-9._-]+(?:[ \t]|$)")
else:
    print("invalid-output")
    raise SystemExit(1)

substantive = [line for line in tail if line.strip()]
if not substantive:
    print("invalid-output")
    raise SystemExit(1)
enum_match = re.fullmatch(r"[ \t]*-[ \t]+(.+?)[ \t]*", substantive[0])
if not enum_match or enum_match.group(1) not in {clear_enum, findings_enum}:
    print("invalid-output")
    raise SystemExit(1)
enum_lines = [enum_match.group(1)]

# The verdict is genuinely terminal: after its single enum, permit only one
# optional Reason bullet and indented continuation text. This prevents a pair
# of unrelated code blocks from being mistaken for one transport wrapper that
# exposes an early fake CLEAR while hiding later substantive output.
remainder = substantive[1:]
if remainder:
    if not re.fullmatch(r"[ \t]*-[ \t]+Reason:[^\r\n]*", remainder[0]):
        print("invalid-output")
        raise SystemExit(1)
    if any(
        not re.match(r"^[ \t]{2,}\S", line)
        or re.match(r"^[ \t]*[-*+][ \t]+", line)
        for line in remainder[1:]
    ):
        print("invalid-output")
        raise SystemExit(1)

finding_count = sum(1 for line in outside[:verdict_index] if finding_re.match(line))
verdict = enum_lines[0]
if verdict == clear_enum and finding_count != 0:
    print("invalid-output")
    raise SystemExit(1)
if verdict == findings_enum and finding_count == 0:
    print("invalid-output")
    raise SystemExit(1)

print("clear" if verdict == clear_enum else "findings")
PY
}

cmd="${1:-}"
case "$cmd" in
  -h|--help|'')
    usage
    exit 3
    ;;
  validate)
    kind="${2:-}"
    artifact="${3:-}"
    if ! kind_dir "$kind" >/dev/null || [ -z "$artifact" ]; then
      usage >&2
      exit 3
    fi
    status_from_artifact "$kind" "$artifact" >/dev/null
    exit $?
    ;;
  status)
    kind="${2:-}"
    artifact="${3:-}"
    if ! kind_dir "$kind" >/dev/null || [ -z "$artifact" ]; then
      usage >&2
      exit 3
    fi
    status_from_artifact "$kind" "$artifact"
    exit 0
    ;;
  next-attempt)
    slug="${2:-}"
    kind="${3:-}"
    task_id="${4:-}"
    subdir=$(kind_dir "$kind" 2>/dev/null) || { usage >&2; exit 3; }
    valid_identity "$slug" && { [ -z "$task_id" ] || valid_identity "$task_id"; } || { usage >&2; exit 3; }
    dir="docs/features/$slug/$subdir"
    [ -d "docs/features/$slug" ] || { printf 'Feature not found: docs/features/%s\n' "$slug" >&2; exit 3; }
    if [ ! -d "$dir" ]; then
      printf '1\n'
      exit 0
    fi
    python3 - "$dir" "$task_id" "$slug" "$kind" <<'PY'
import datetime, glob, json, os, re, stat, sys
dir_path, task_id, slug, dir_kind = sys.argv[1:5]
token_re = re.compile(r"[A-Za-z0-9_][A-Za-z0-9._-]*")
def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate key: {key}")
        result[key] = value
    return result
def valid_name(path, data, attempt):
    reviewer = data.get("reviewer_tool")
    record_task = data.get("task_id")
    if not isinstance(reviewer, str) or not token_re.fullmatch(reviewer):
        return False
    task_name = record_task or "feature"
    pattern = rf"(?P<stamp>\d{{4}}-\d{{2}}-\d{{2}}T\d{{6}}Z)-{re.escape(task_name)}-{re.escape(reviewer)}-attempt-{attempt}-[0-9a-f]{{12}}\.attempt\.json"
    match = re.fullmatch(pattern, os.path.basename(path))
    if not match:
        return False
    datetime.datetime.strptime(match.group("stamp"), "%Y-%m-%dT%H%M%SZ")
    return True
try:
    meta = os.lstat(dir_path)
    if not stat.S_ISDIR(meta.st_mode):
        raise OSError("review sidecar directory is not a real directory")
except OSError as exc:
    print(f"review-attempt: unsafe sidecar directory: {exc}", file=sys.stderr)
    raise SystemExit(3)
paths = sorted(glob.glob(os.path.join(dir_path, "*.attempt.json")))
if len(paths) > 256:
    print("review-attempt: sidecar count exceeds hard 256-file limit", file=sys.stderr)
    raise SystemExit(3)
highest = 0
for path in paths:
    try:
        meta = os.lstat(path)
        if not stat.S_ISREG(meta.st_mode) or meta.st_size > 65_536:
            raise OSError("sidecar is not a bounded regular file")
        with open(path, "r", encoding="utf-8") as handle:
            data = json.load(handle, object_pairs_hook=unique_object)
    except Exception:
        continue
    if data.get("feature") != slug or (task_id and data.get("task_id") != task_id) or data.get("review_kind") != dir_kind:
        continue
    try:
        attempt = int(data.get("attempt_number", 0))
        if not isinstance(data.get("attempt_number"), bool) and 1 <= attempt <= 9999 and valid_name(path, data, attempt):
            highest = max(highest, attempt)
    except Exception:
        pass
print(highest + 1)
PY
    ;;
  allocate)
    slug="${2:-}"
    kind="${3:-}"
    task_id="${4:-}"
    reviewer="${5:-}"
    attempt="${6:-}"
    kind_dir "$kind" >/dev/null || { usage >&2; exit 3; }
    valid_identity "$slug" && { [ -z "$task_id" ] || valid_identity "$task_id"; } && valid_identity "$reviewer" || { usage >&2; exit 3; }
    python3 - "$ROOT" "$slug" "$kind" "$task_id" "$reviewer" "$attempt" <<'PY' || exit 3
import datetime, os, re, secrets, stat, sys

root, slug, kind, task_id, reviewer, attempt = sys.argv[1:7]
token_re = re.compile(r"[A-Za-z0-9_][A-Za-z0-9._-]*")
if not token_re.fullmatch(slug) or (task_id and not token_re.fullmatch(task_id)):
    raise SystemExit("review-attempt: invalid output allocation identity")
if not token_re.fullmatch(reviewer) or kind not in {"adversary", "security"}:
    raise SystemExit("review-attempt: invalid output allocation kind/reviewer")
if not attempt.isdigit() or not 1 <= int(attempt) <= 9999:
    raise SystemExit("review-attempt: invalid output allocation attempt")

def real_dir(path, create=False):
    if create:
        try:
            os.mkdir(path, 0o700)
        except FileExistsError:
            pass
    meta = os.lstat(path)
    if not stat.S_ISDIR(meta.st_mode):
        raise SystemExit(f"review-attempt: unsafe symlink/non-directory output parent: {path}")

current = root
for component in ("docs", "features", slug):
    current = os.path.join(current, component)
    real_dir(current)
out_dir = os.path.join(current, kind)
receipt_dir = os.path.join(current, "review-receipts")
real_dir(out_dir, create=True)
real_dir(receipt_dir, create=True)

stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H%M%SZ")
safe_task = task_id or "feature"
for _ in range(16):
    nonce = secrets.token_hex(6)
    stem = f"{stamp}-{safe_task}-{reviewer}-attempt-{attempt}-{nonce}"
    artifact = os.path.join(out_dir, stem + ".md")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(artifact, flags, 0o600)
    except FileExistsError:
        continue
    os.close(fd)
    sidecar = os.path.join(out_dir, stem + ".attempt.json")
    receipt_stem = f"{stamp}-{safe_task}-{kind}-{reviewer}-attempt-{attempt}-{nonce}.json"
    receipt = os.path.join(receipt_dir, receipt_stem)
    print("|".join((os.path.relpath(artifact, root), os.path.relpath(sidecar, root), os.path.relpath(receipt, root))))
    raise SystemExit(0)
raise SystemExit("review-attempt: could not reserve a unique output artifact")
PY
    ;;
  write)
    sidecar="${2:-}"
    shift 2 || true
    [ -n "$sidecar" ] || { usage >&2; exit 3; }
    python3 - "$ROOT" "$sidecar" "$@" <<'PY'
import datetime, json, os, re, stat, sys, tempfile
root, sidecar = sys.argv[1:3]
data = {}
number_keys = {"exit_code", "elapsed_seconds", "attempt_number"}
bool_keys = {"retryable"}
for item in sys.argv[3:]:
    if "=" not in item:
        raise SystemExit(f"invalid field (expected key=value): {item}")
    key, value = item.split("=", 1)
    if key in data or not re.fullmatch(r"[a-z][a-z0-9_]*", key):
        raise SystemExit(f"review-attempt: duplicate/invalid sidecar field: {key}")
    if key in number_keys:
        try:
            data[key] = int(value)
        except ValueError:
            raise SystemExit(f"review-attempt: sidecar field {key} must be an integer")
    elif key in bool_keys:
        if value.lower() not in {"true", "false"}:
            raise SystemExit(f"review-attempt: sidecar field {key} must be true or false")
        data[key] = value.lower() == "true"
    else:
        data[key] = value
feature = str(data.get("feature", ""))
kind = str(data.get("review_kind", ""))
task_id = data.get("task_id")
reviewer = data.get("reviewer_tool")
attempt = data.get("attempt_number")
token_re = re.compile(r"[A-Za-z0-9_][A-Za-z0-9._-]*")
model_re = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:+/-]*")
if not token_re.fullmatch(feature) or not isinstance(task_id, str) or (task_id and not token_re.fullmatch(task_id)):
    raise SystemExit("review-attempt: invalid sidecar feature/kind")
if kind not in {"adversary", "security"} or reviewer not in ({"codex-cli"} if kind == "security" else {"codex-cli", "claude-code"}):
    raise SystemExit("review-attempt: invalid sidecar feature/kind/reviewer")
if data.get("mode") not in {"review", "review-strict", "review-resume", "review-narrow"}:
    raise SystemExit("review-attempt: invalid sidecar mode")
statuses = {"clear", "findings", "timeout", "incomplete", "invalid-output", "unavailable"}
if data.get("status") not in statuses or not isinstance(data.get("retryable"), bool):
    raise SystemExit("review-attempt: invalid sidecar status/retryable")
if data["status"] in {"clear", "findings"} and data["retryable"]:
    raise SystemExit("review-attempt: terminal sidecar status cannot be retryable")
if not isinstance(attempt, int) or isinstance(attempt, bool) or not 1 <= attempt <= 9999:
    raise SystemExit("review-attempt: invalid sidecar attempt_number")
if not isinstance(data.get("implementer_model"), str) or not model_re.fullmatch(data["implementer_model"]):
    raise SystemExit("review-attempt: invalid sidecar implementer_model")
if not isinstance(data.get("base_sha"), str) or not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", data["base_sha"]):
    raise SystemExit("review-attempt: invalid sidecar base_sha")
for timestamp_key in ("started_at", "finished_at"):
    value = data.get(timestamp_key)
    if timestamp_key == "finished_at" or value is not None:
        if not isinstance(value, str):
            raise SystemExit(f"review-attempt: invalid sidecar {timestamp_key}")
        try:
            datetime.datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ")
        except ValueError:
            raise SystemExit(f"review-attempt: invalid sidecar {timestamp_key}")
if any(isinstance(value, str) and ("|" in value or any(ord(char) < 32 or ord(char) == 127 for char in value)) for value in data.values()):
    raise SystemExit("review-attempt: sidecar string fields cannot contain pipes/control characters")
expected = os.path.join(root, "docs", "features", feature, kind)
for path in (os.path.join(root, "docs"), os.path.join(root, "docs", "features"), os.path.join(root, "docs", "features", feature), expected):
    meta = os.lstat(path)
    if not stat.S_ISDIR(meta.st_mode):
        raise SystemExit(f"review-attempt: unsafe sidecar parent: {path}")
absolute = os.path.abspath(os.path.join(root, sidecar) if not os.path.isabs(sidecar) else sidecar)
task_name = task_id or "feature"
name_pattern = rf"(?P<stamp>\d{{4}}-\d{{2}}-\d{{2}}T\d{{6}}Z)-{re.escape(task_name)}-{re.escape(reviewer)}-attempt-{attempt}-[0-9a-f]{{12}}\.attempt\.json"
name_match = re.fullmatch(name_pattern, os.path.basename(absolute))
if not name_match or os.path.dirname(absolute) != expected or os.path.lexists(absolute):
    raise SystemExit("review-attempt: sidecar path must be a new file under its feature review directory")
try:
    datetime.datetime.strptime(name_match.group("stamp"), "%Y-%m-%dT%H%M%SZ")
except ValueError:
    raise SystemExit("review-attempt: sidecar filename timestamp is invalid")
if data.get("artifact_path") and os.path.basename(data["artifact_path"]) != os.path.basename(absolute).replace(".attempt.json", ".md"):
    raise SystemExit("review-attempt: sidecar artifact_path does not match allocated basename")
if any(isinstance(value, str) and len(value) > 4096 for value in data.values()):
    raise SystemExit("review-attempt: sidecar field exceeds hard 4096-character limit")
payload = (json.dumps(data, indent=2, sort_keys=True) + "\n").encode("utf-8")
if len(payload) > 65_536:
    raise SystemExit("review-attempt: sidecar exceeds hard 65536-byte limit")
fd, tmp = tempfile.mkstemp(prefix=".review-attempt-", suffix=".tmp", dir=expected)
try:
    with os.fdopen(fd, "wb") as handle:
        handle.write(payload)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(tmp, absolute)
finally:
    try:
        os.unlink(tmp)
    except FileNotFoundError:
        pass
PY
    ;;
  latest-retryable)
    slug="${2:-}"
    task_id="${3:-}"
    kind="${4:-}"
    valid_identity "$slug" && { [ -z "$task_id" ] || valid_identity "$task_id"; } || { usage >&2; exit 3; }
    [ -d "docs/features/$slug" ] || { printf 'Feature not found: docs/features/%s\n' "$slug" >&2; exit 3; }
    if [ -n "$kind" ]; then
      kind_dir "$kind" >/dev/null || { usage >&2; exit 3; }
    fi
    python3 - "$ROOT" "$slug" "$task_id" "$kind" <<'PY'
import datetime, glob, json, os, re, shlex, stat, sys
root, slug, task_id, kind_filter = sys.argv[1:5]
feature_dir = os.path.join(root, "docs", "features", slug)
kinds = [kind_filter] if kind_filter else ["adversary", "security"]
token_re = re.compile(r"[A-Za-z0-9_][A-Za-z0-9._-]*")
model_re = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:+/-]*")
retryable_statuses = {"timeout", "incomplete", "invalid-output", "unavailable"}
statuses = retryable_statuses | {"clear", "findings"}
def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate key: {key}")
        result[key] = value
    return result
def utc(value, shape):
    if not isinstance(value, str):
        raise ValueError("timestamp is not a string")
    return datetime.datetime.strptime(value, shape)
def validated(path, dir_kind):
    meta = os.lstat(path)
    if not stat.S_ISREG(meta.st_mode) or meta.st_size > 65_536:
        raise ValueError("sidecar is not a bounded regular file")
    with open(path, "r", encoding="utf-8") as handle:
        data = json.load(handle, object_pairs_hook=unique_object)
    if not isinstance(data, dict):
        raise ValueError("sidecar JSON is not an object")
    feature = data.get("feature")
    record_task = data.get("task_id")
    record_kind = data.get("review_kind")
    mode = data.get("mode")
    model = data.get("implementer_model")
    reviewer = data.get("reviewer_tool")
    base = data.get("base_sha")
    status = data.get("status")
    attempt = data.get("attempt_number")
    retryable = data.get("retryable")
    finished = data.get("finished_at")
    if feature != slug or record_kind != dir_kind or (task_id and record_task != task_id):
        raise ValueError("record identity does not match query/directory")
    if not isinstance(record_task, str) or (record_task and not token_re.fullmatch(record_task)):
        raise ValueError("invalid task")
    allowed_reviewers = {"codex-cli"} if dir_kind == "security" else {"codex-cli", "claude-code"}
    if reviewer not in allowed_reviewers or mode not in {"review", "review-strict", "review-resume", "review-narrow"}:
        raise ValueError("invalid reviewer/mode")
    if not isinstance(model, str) or not model_re.fullmatch(model) or not isinstance(base, str) or not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", base):
        raise ValueError("invalid model/base")
    if status not in statuses or not isinstance(retryable, bool):
        raise ValueError("invalid status/retryable")
    if status in {"clear", "findings"} and retryable:
        raise ValueError("terminal status cannot be retryable")
    if not isinstance(attempt, int) or isinstance(attempt, bool) or not 1 <= attempt <= 9999:
        raise ValueError("invalid attempt")
    finished_value = utc(finished, "%Y-%m-%dT%H:%M:%SZ")
    task_name = record_task or "feature"
    pattern = rf"(?P<stamp>\d{{4}}-\d{{2}}-\d{{2}}T\d{{6}}Z)-{re.escape(task_name)}-{re.escape(reviewer)}-attempt-{attempt}-[0-9a-f]{{12}}\.attempt\.json"
    match = re.fullmatch(pattern, os.path.basename(path))
    if not match:
        raise ValueError("sidecar basename was not allocator-produced")
    utc(match.group("stamp"), "%Y-%m-%dT%H%M%SZ")
    return data, (finished_value, attempt, os.path.basename(path))

latest_by_group = {}
for dir_kind in kinds:
    review_dir = os.path.join(feature_dir, dir_kind)
    if not os.path.exists(review_dir):
        continue
    if not stat.S_ISDIR(os.lstat(review_dir).st_mode):
        raise SystemExit("review-attempt: unsafe retry sidecar directory")
    paths = sorted(glob.glob(os.path.join(review_dir, "*.attempt.json")))
    if len(paths) > 256:
        raise SystemExit("review-attempt: retry sidecar count exceeds hard 256-file limit")
    for path in paths:
        try:
            data, sort_key = validated(path, dir_kind)
        except (OSError, UnicodeError, ValueError, json.JSONDecodeError):
            continue
        group = (data["task_id"], data["review_kind"])
        current = latest_by_group.get(group)
        if current is None or sort_key > current[0]:
            latest_by_group[group] = (sort_key, path, data)
records = []
for _group, (sort_key, path, data) in latest_by_group.items():
    if data["status"] in retryable_statuses and data["retryable"] is True:
        records.append((sort_key, path, data))
records.sort(key=lambda item: item[0], reverse=True)
if not records:
    raise SystemExit(1)
for _, path, data in records:
    next_mode = "review-narrow" if data["mode"] == "review-resume" else "review-resume"
    if data["review_kind"] == "security":
        wrapper = "scripts/security-review"
    elif data["reviewer_tool"] == "claude-code":
        wrapper = "scripts/claude-adversary-review"
    else:
        wrapper = "scripts/adversary-review"
    command = shlex.join([wrapper, slug, data["task_id"], next_mode, data["base_sha"], data["implementer_model"]])
    print("|".join((data["task_id"], data["review_kind"], data["status"], str(data["attempt_number"]), command, os.path.basename(path))))
