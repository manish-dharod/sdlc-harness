import fnmatch
import os
import stat, subprocess, sys, tempfile

root, slug, task_id = sys.argv[1:4]
feature_dir = os.path.join(root, "docs", "features", slug)
tier_path = os.path.join(feature_dir, ".tier")
tier = "large"
if os.path.isfile(tier_path):
    tier = open(tier_path, encoding="utf-8").read().strip()
ledger = os.path.join(feature_dir, "FEATURE.md" if tier == "small" else "TASKS.md")
if not os.path.isfile(ledger):
    raise SystemExit(0)

lines = open(ledger, encoding="utf-8").read().splitlines()
block = []
in_task = False
for line in lines:
    if line.startswith("### "):
        heading_id = line[4:].split(":", 1)[0].strip()
        if in_task:
            break
        if heading_id == task_id:
            in_task = True
    if in_task:
        block.append(line)
if not block:
    print(f"review-attempt: task not found in {os.path.relpath(ledger, root)}: {task_id}", file=sys.stderr)
    raise SystemExit(3)

owned = []
in_ownership = False
for line in block:
    if line == "- Intended file ownership:":
        in_ownership = True
        continue
    if in_ownership and line.startswith("- "):
        break
    if in_ownership and line.startswith("  - "):
        value = line[4:].strip().strip("`")
        if value:
            owned.append(value)
if not owned:
    raise SystemExit(0)

def changed(args):
    proc = subprocess.run(
        ["git", *args], cwd=root, check=True, stdout=subprocess.PIPE
    )
    return [item.decode("utf-8", "surrogateescape") for item in proc.stdout.split(b"\0") if item]

states = []
for label, args in (
    ("staged", ["diff", "--cached", "--name-only", "-z", "--"]),
    ("unstaged", ["diff", "--name-only", "-z", "--"]),
    ("untracked", ["ls-files", "--others", "--exclude-standard", "-z", "--"]),
):
    for path in changed(args):
        for pattern in owned:
            normalized = pattern
            if os.path.isabs(normalized):
                try:
                    normalized = os.path.relpath(normalized, root)
                except ValueError:
                    continue
                if normalized.startswith(".." + os.sep) or normalized == "..":
                    continue
            while normalized.startswith("./"):
                normalized = normalized[2:]
            matched = False
            if any(char in normalized for char in "*?["):
                matched = fnmatch.fnmatchcase(path, normalized)
            elif normalized.endswith("/"):
                matched = path.startswith(normalized)
            else:
                matched = path == normalized or path.startswith(normalized + "/")
            if matched:
                states.append((label, path))
                break

for label, path in sorted(set(states)):
    print(f"{label}|{path}")
raise SystemExit(1 if states else 0)
