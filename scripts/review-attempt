    ["git", "merge-base", "--is-ancestor", data["base_sha"], data["reviewed_candidate_sha"]],
    cwd=root, env=git_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
).returncode:
    print("review-attempt: receipt base is not an ancestor of candidate", file=sys.stderr)
    raise SystemExit(1)
