#!/usr/bin/env bash
# Regenerate docs/backlog/INDEX.md from backlog item frontmatter, or verify it
# is current. INDEX.md is generated; edit docs/backlog/items/*.md instead.
#
# Usage:
#   scripts/backlog-index            # regenerate INDEX.md
#   scripts/backlog-index --check    # exit 1 if INDEX.md is stale or invalid
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ITEMS_DIR="$ROOT/docs/backlog/items"
INDEX="$ROOT/docs/backlog/INDEX.md"
MODE="${1:-generate}"

AREAS_RE="${SDLC_BACKLOG_AREAS_RE:-^(product|platform|sdlc-harness|security|quality|docs|ops|other)$}"
STATUS_RE='^(proposed|accepted|in-progress|done|rejected|superseded)$'
PRIORITY_RE='^(now|next|later)$'

fail=0
rows=""   # area|prio_rank|id|priority|status|effort|title|trigger|file

field() {
  file="$1"
  key="$2"
  awk -v key="$key" '
    NR==1 && $0!="---" { exit }
    NR>1 && $0=="---" { exit }
    index($0, key": ")==1 {
      sub(key": ", ""); gsub(/^[ \t]+|[ \t]+$/, ""); print; exit
    }' "$file"
}

prio_rank() {
  case "$1" in
    now) echo 0 ;;
    next) echo 1 ;;
    later) echo 2 ;;
    *) echo 3 ;;
  esac
}

err() {
  printf 'backlog-index: ERROR %s\n' "$1" >&2
  fail=1
}

mkdir -p "$ITEMS_DIR" "$(dirname "$INDEX")"

seen_ids=""
shopt -s nullglob
for f in "$ITEMS_DIR"/ENH-*.md; do
  base="$(basename "$f")"
  id="$(field "$f" id)"
  title="$(field "$f" title)"
  area="$(field "$f" area)"
  status="$(field "$f" status)"
  priority="$(field "$f" priority)"
  effort="$(field "$f" effort)"
  trigger="$(field "$f" trigger)"

  [ -n "$id" ] || { err "$base: missing id"; continue; }
  case "$base" in "$id"-*) ;; *) err "$base: filename does not start with $id-";; esac
  case "$seen_ids" in *" $id "*) err "$base: duplicate id $id";; esac
  seen_ids="$seen_ids $id "
  [ -n "$title" ] || err "$base: missing title"
  case "$title" in *"|"*) err "$base: title may not contain '|'";; esac
  printf '%s' "$area" | grep -Eq "$AREAS_RE" || err "$base: bad area '$area' (allowed by SDLC_BACKLOG_AREAS_RE)"
  printf '%s' "$status" | grep -Eq "$STATUS_RE" || err "$base: bad status '$status'"
  printf '%s' "$priority" | grep -Eq "$PRIORITY_RE" || err "$base: bad priority '$priority'"
  [ -n "$effort" ] || effort="-"
  [ -n "$trigger" ] || trigger="none"

  rows="${rows}${area}|$(prio_rank "$priority")|${id}|${priority}|${status}|${effort}|${title}|${trigger}|items/${base}
"
done

[ "$fail" -eq 0 ] || exit 1

count_lines() {
  grep -c . 2>/dev/null || true
}

render() {
  printf '<!-- GENERATED by scripts/backlog-index; do not edit by hand. -->\n'
  printf '# Program backlog index\n\n'
  printf 'Conventions: [README.md](README.md). One file per item under `items/`.\n'
  printf 'Priority: now / next / later. An item with a `trigger` waits on that event.\n\n'

  sorted="$(printf '%s' "$rows" | sort -t'|' -k1,1 -k2,2n -k3,3)"
  open="$(printf '%s\n' "$sorted" | awk -F'|' '$5=="proposed"||$5=="accepted"||$5=="in-progress"')"
  closed="$(printf '%s\n' "$sorted" | awk -F'|' '$5=="done"||$5=="rejected"||$5=="superseded"')"
  n_open="$(printf '%s' "$open" | count_lines)"
  n_closed="$(printf '%s' "$closed" | count_lines)"
  printf '**%s open / %s closed**\n' "$n_open" "$n_closed"

  current_area=""
  while IFS='|' read -r area _rank id priority status effort title trigger file; do
    [ -n "${id:-}" ] || continue
    if [ "$area" != "$current_area" ]; then
      printf '\n## %s\n\n' "$area"
      printf '| ID | Priority | Status | Effort | Title | Trigger |\n'
      printf '|---|---|---|---|---|---|\n'
      current_area="$area"
    fi
    printf '| [%s](%s) | %s | %s | %s | %s | %s |\n' \
      "$id" "$file" "$priority" "$status" "$effort" "$title" "$trigger"
  done <<EOF_ROWS
$open
EOF_ROWS

  if [ "$n_closed" -gt 0 ]; then
    printf '\n## Closed\n\n'
    printf '| ID | Status | Title |\n|---|---|---|\n'
    while IFS='|' read -r _area _rank id _priority status _effort title _trigger file; do
      [ -n "${id:-}" ] || continue
      printf '| [%s](%s) | %s | %s |\n' "$id" "$file" "$status" "$title"
    done <<EOF_CLOSED
$closed
EOF_CLOSED
  fi
}

if [ "$MODE" = "--check" ]; then
  tmp="$(mktemp)"
  trap 'rm -f "$tmp"' EXIT
  render > "$tmp"
  if ! diff -q "$INDEX" "$tmp" >/dev/null 2>&1; then
    printf 'backlog-index: INDEX.md is stale; run scripts/backlog-index\n' >&2
    exit 1
  fi
  printf 'backlog-index: OK (%s items, index current)\n' "$(printf '%s' "$rows" | count_lines)"
else
  render > "$INDEX"
  printf 'backlog-index: wrote %s (%s items)\n' "${INDEX#$ROOT/}" "$(printf '%s' "$rows" | count_lines)"
fi
