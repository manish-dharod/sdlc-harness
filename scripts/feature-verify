#!/usr/bin/env bash
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 1

# Load per-project sdlc.config.yml (no-op if absent)
. "$ROOT/scripts/load-config"

FEATURE="${1:-}"
MODE="${2:-fast}"
FAILURES=0
FAILURE_LINES=""

usage() {
  cat <<'EOF'
Usage: scripts/feature-verify <feature-slug> [fast|unit|full]
       scripts/feature-verify --all-active [fast|unit|full]
       scripts/feature-verify --resolve-profile <feature-slug>

Runs feature-level verification. Feature-specific profiles may delegate to
domain scripts such as scripts/example-verify.

--all-active enumerates active docs/features/* control planes, excluding
fixtures/templates and generated artifact-only directories, runs each feature's
verify at the requested mode, prints a per-feature exit-code summary, and exits
non-zero if any feature failed.

--resolve-profile reports the executable profile that normal verification would
auto-discover without running framework, domain, or feature-state checks.
EOF
}

valid_mode() {
  [ "$1" = "fast" ] || [ "$1" = "unit" ] || [ "$1" = "full" ]
}

section() {
  printf '\n== %s ==\n' "$1"
}

feature_verdict() {
  state_file="$1/STATE.md"
  [ -f "$state_file" ] || return 1

  awk '
    BEGIN { in_yaml=0 }
    /^```yaml[[:space:]]*$/ { in_yaml=1; next }
    /^```[[:space:]]*$/ { in_yaml=0; next }
    in_yaml && /^[[:space:]]*verdict[[:space:]]*:/ {
      value=$0
      sub(/^[^:]*:[[:space:]]*/, "", value)
      gsub(/["'\''[:space:]]/, "", value)
      print tolower(value)
      exit
    }
  ' "$state_file"
}

is_active_feature_dir() {
  feature_dir="$1"
  feature_name="$(basename "$feature_dir")"

  [ -d "$feature_dir" ] || return 1
  case "$feature_name" in
    _template|_template-*|_test-fixture-*) return 1 ;;
  esac
  if [ ! -f "$feature_dir/.tier" ] && \
     [ ! -f "$feature_dir/FEATURE.md" ] && \
     [ ! -f "$feature_dir/TASKS.md" ] && \
     [ ! -f "$feature_dir/SPEC.md" ]; then
    return 1
  fi

  verdict="$(feature_verdict "$feature_dir")"
  case "$verdict" in
    released|abandoned) return 1 ;;
  esac

  return 0
}

domain_script_for() {
  printf 'scripts/%s-verify' "$1"
}

valid_feature_slug() {
  # Slugs become both control-plane and executable-profile paths. Keep that
  # interpolation to one portable filename segment so ../ cannot escape the
  # repository-owned docs/features and scripts directories.
  case "$1" in
    ''|[!a-z0-9]*|*[!a-z0-9-]*) return 1 ;;
    *) return 0 ;;
  esac
}

require_valid_feature_slug() {
  candidate_slug="$1"
  if ! valid_feature_slug "$candidate_slug"; then
    printf 'Invalid feature slug: %s (expected lowercase letters, digits, and hyphens)\n' \
      "$candidate_slug" >&2
    exit 2
  fi
}

resolve_profile() {
  profile_feature="$1"
  if [ -z "$profile_feature" ]; then
    usage
    exit 2
  fi
  require_valid_feature_slug "$profile_feature"

  profile_feature_dir="docs/features/$profile_feature"
  if [ ! -d "$profile_feature_dir" ]; then
    printf 'Feature not found: %s\n' "$profile_feature_dir" >&2
    exit 1
  fi

  profile_script="$(domain_script_for "$profile_feature")"
  if [ ! -x "$profile_script" ]; then
    printf 'No executable domain verification profile: %s\n' "$profile_script" >&2
    exit 1
  fi

  printf 'Domain verification profile (auto-discovered: %s)\n' "$profile_script"
  exit 0
}

ALL_ACTIVE_LOCK_KEY="feature-verify-all-active-v1"
ALL_ACTIVE_LOCK_DIR=""
ALL_ACTIVE_CHILD_PID=""
ALL_ACTIVE_EQUIVALENCE_KEYS=()
ALL_ACTIVE_EQUIVALENCE_RESULTS=()

profile_equivalence_key() {
  local profile_script="$1"

  [ -r "$profile_script" ] || return 1
  awk '
    BEGIN {
      prefix = "# sdlc-feature-verify-equivalence: "
      count = 0
      invalid = 0
    }
    index($0, prefix) == 1 {
      value = substr($0, length(prefix) + 1)
      if (value !~ /^[A-Za-z0-9][A-Za-z0-9._\/-]*$/) {
        invalid = 1
      } else {
        key = value
        count++
      }
    }
    END {
      if (invalid || count != 1) exit 1
      print key
    }
  ' "$profile_script"
}

all_active_equivalence_lookup() {
  local wanted_key="$1" index=0

  while [ "$index" -lt "${#ALL_ACTIVE_EQUIVALENCE_KEYS[@]}" ]; do
    if [ "${ALL_ACTIVE_EQUIVALENCE_KEYS[$index]}" = "$wanted_key" ]; then
      printf '%s\n' "${ALL_ACTIVE_EQUIVALENCE_RESULTS[$index]}"
      return 0
    fi
    index=$((index + 1))
  done
  return 1
}

all_active_equivalence_store() {
  ALL_ACTIVE_EQUIVALENCE_KEYS+=("$1")
  ALL_ACTIVE_EQUIVALENCE_RESULTS+=("$2")
}

all_active_lock_path() {
  local common_raw common_candidate common_real digest

  common_raw=$(git -C "$ROOT" rev-parse --git-common-dir 2>/dev/null) || return 1
  case "$common_raw" in
    /*) common_candidate="$common_raw" ;;
    *) common_candidate="$ROOT/$common_raw" ;;
  esac
  common_real=$(sdlc_learning_realpath "$common_candidate") || return 1
  digest=$(printf '%s\n%s\n' "$common_real" "$ALL_ACTIVE_LOCK_KEY" | \
    shasum -a 256 | awk '{print substr($1,1,20)}') || return 1
  printf '%s/sdlc-learning-locks/feature-%s.lock\n' "$common_real" "$digest"
}

all_active_report_lock_owner() {
  local lock_path="$1" owner_record owner_name owner_host owner_pid owner_token
  local local_host owner_scope

  if ! owner_record=$(sdlc_learning_lock_owner_read "$lock_path" 2>/dev/null); then
    printf 'All-active verification lock owner is ambiguous; preserving %s.\n' \
      "$lock_path" >&2
    return 1
  fi
  IFS=$'\t' read -r owner_name owner_host owner_pid owner_token <<< "$owner_record"
  owner_scope="foreign-host"
  if local_host=$(sdlc_learning_lock_host_id 2>/dev/null) && \
     [ "$owner_host" = "$local_host" ]; then
    owner_scope="local-host"
  fi
  printf 'All-active verification lock owner: pid=%s scope=%s; preserving %s.\n' \
    "$owner_pid" "$owner_scope" "$lock_path" >&2
}

all_active_stop_child() {
  local signal_name="${1:-TERM}" child_pid attempts

  [ -n "$ALL_ACTIVE_CHILD_PID" ] || return 0
  child_pid="$ALL_ACTIVE_CHILD_PID"
  ALL_ACTIVE_CHILD_PID=""

  # all_active_run_child gives every foreground-equivalent command its own
  # process group. Signal the complete verification subtree before releasing
  # the shared lock; fall back to the direct child only if group signaling is
  # unavailable on the host shell.
  if ! kill -s "$signal_name" -- "-$child_pid" 2>/dev/null; then
    kill -s "$signal_name" "$child_pid" 2>/dev/null || true
  fi
  # Give cooperative descendants a short grace window, then make completion
  # deterministic even when a verifier or grandchild ignores TERM/INT/HUP.
  attempts=0
  while kill -0 -- "-$child_pid" 2>/dev/null && [ "$attempts" -lt 10 ]; do
    sleep 0.05
    attempts=$((attempts + 1))
  done
  if kill -0 -- "-$child_pid" 2>/dev/null; then
    kill -KILL -- "-$child_pid" 2>/dev/null || \
      kill -KILL "$child_pid" 2>/dev/null || true
  fi
  wait "$child_pid" 2>/dev/null || true

  attempts=0
  while kill -0 -- "-$child_pid" 2>/dev/null && [ "$attempts" -lt 20 ]; do
    sleep 0.05
    attempts=$((attempts + 1))
  done
  if kill -0 -- "-$child_pid" 2>/dev/null; then
    printf 'feature-verify --all-active: verification process group survived forced cleanup\n' >&2
    return 1
  fi
  return 0
}

all_active_finish() {
  local requested_status="${1:-1}"
  local signal_name="${2:-TERM}"
  local child_stopped=1

  trap - EXIT HUP INT TERM
  if ! all_active_stop_child "$signal_name"; then
    requested_status=1
    child_stopped=0
  fi
  if [ -n "$ALL_ACTIVE_LOCK_DIR" ] && [ "$child_stopped" -eq 1 ]; then
    if ! sdlc_learning_lock_release "feature-verify --all-active" \
      "$ALL_ACTIVE_LOCK_DIR"; then
      printf 'feature-verify --all-active: failed to release the shared verification lock\n' >&2
      requested_status=1
    fi
    ALL_ACTIVE_LOCK_DIR=""
  elif [ -n "$ALL_ACTIVE_LOCK_DIR" ]; then
    printf 'feature-verify --all-active: retaining the lock because the verification process group is still live\n' >&2
  fi
  exit "$requested_status"
}

all_active_run_child() {
  local monitor_was_on=0 child_status child_pid

  case "$-" in *m*) monitor_was_on=1 ;; esac
  # Non-interactive Bash otherwise puts background commands in this shell's
  # process group. Monitor mode gives this one command a distinct group so a
  # signal can terminate its complete verification subtree without touching
  # the lock-owning parent.
  set -m
  "$@" &
  child_pid=$!
  ALL_ACTIVE_CHILD_PID="$child_pid"
  [ "$monitor_was_on" -eq 1 ] || set +m

  wait "$child_pid"
  child_status=$?
  ALL_ACTIVE_CHILD_PID=""
  return "$child_status"
}

all_active_reuse_parent_is_valid() {
  local parent_pid="${SDLC_FEATURE_VERIFY_ALL_ACTIVE_PARENT_PID:-}"
  local parent_lock="${SDLC_FEATURE_VERIFY_ALL_ACTIVE_LOCK_DIR:-}"
  local expected_lock owner_record owner_name owner_host owner_pid owner_token
  local local_host

  [[ "$parent_pid" =~ ^[1-9][0-9]{0,9}$ ]] || return 1
  [ "$parent_pid" = "$PPID" ] || return 1
  [ -n "$parent_lock" ] || return 1
  [ -r "$ROOT/scripts/lib-learning-artifacts.sh" ] || return 1
  # shellcheck source=lib-learning-artifacts.sh
  . "$ROOT/scripts/lib-learning-artifacts.sh"
  expected_lock=$(all_active_lock_path) || return 1
  [ "$parent_lock" = "$expected_lock" ] || return 1
  owner_record=$(sdlc_learning_lock_owner_read "$parent_lock" 2>/dev/null) || \
    return 1
  IFS=$'\t' read -r owner_name owner_host owner_pid owner_token <<< "$owner_record"
  local_host=$(sdlc_learning_lock_host_id 2>/dev/null) || return 1
  [ "$owner_host" = "$local_host" ] || return 1
  [ "$owner_pid" = "$parent_pid" ] || return 1
  kill -0 "$parent_pid" 2>/dev/null
}

run_all_active() {
  local expected_lock_path wait_attempts profile_script equivalence_key
  local profile_result feature_exit

  MODE="$1"
  if ! valid_mode "$MODE"; then
    usage
    exit 2
  fi

  if [ -n "${SDLC_FEATURE_VERIFY_ALL_ACTIVE_CHILD:-}" ]; then
    printf 'feature-verify --all-active: nested all-active invocation refused; the parent sweep owns serialization\n' >&2
    exit 2
  fi
  if [ ! -r "$ROOT/scripts/lib-learning-artifacts.sh" ]; then
    printf 'feature-verify --all-active: scripts/lib-learning-artifacts.sh is required for serialization\n' >&2
    exit 1
  fi
  # shellcheck source=lib-learning-artifacts.sh
  . "$ROOT/scripts/lib-learning-artifacts.sh"
  expected_lock_path=$(all_active_lock_path) || {
    printf 'feature-verify --all-active: could not resolve the shared verification lock path\n' >&2
    exit 1
  }
  if [ -e "$expected_lock_path" ] || [ -L "$expected_lock_path" ]; then
    wait_attempts="${SDLC_LEARNING_LOCK_ATTEMPTS:-200}"
    printf 'Waiting for the shared all-active verification lock (bounded attempts=%s).\n' \
      "$wait_attempts" >&2
    all_active_report_lock_owner "$expected_lock_path" || true
  fi
  if ! ALL_ACTIVE_LOCK_DIR=$(sdlc_learning_lock_acquire \
    "feature-verify --all-active" "$ROOT" "$ALL_ACTIVE_LOCK_KEY"); then
    printf 'feature-verify --all-active: could not acquire the shared verification lock\n' >&2
    if [ -e "$expected_lock_path" ] || [ -L "$expected_lock_path" ]; then
      all_active_report_lock_owner "$expected_lock_path" || true
    fi
    exit 1
  fi
  printf 'Acquired shared all-active verification lock: %s\n' "$ALL_ACTIVE_LOCK_DIR"
  trap 'all_active_finish "$?" TERM' EXIT
  trap 'all_active_finish 129 HUP' HUP
  trap 'all_active_finish 130 INT' INT
  trap 'all_active_finish 143 TERM' TERM

  section "Feature Verification: all active features ($MODE)"
  printf 'Read-only integration sweep: runs feature verify profiles only; no deploys.\n'

  active_features=()
  for feature_dir in docs/features/*; do
    if is_active_feature_dir "$feature_dir"; then
      active_features+=("$(basename "$feature_dir")")
    fi
  done

  if [ "${#active_features[@]}" -eq 0 ]; then
    printf 'No active features found under docs/features/.\n'
    exit 0
  fi

  summary_lines=""
  any_failed=0
  for active_feature in "${active_features[@]}"; do
    section "Sweep feature: $active_feature"
    profile_script=$(domain_script_for "$active_feature")
    equivalence_key=""
    if [ -x "$profile_script" ]; then
      equivalence_key=$(profile_equivalence_key "$profile_script" 2>/dev/null || true)
    fi

    if [ -n "$equivalence_key" ]; then
      if profile_result=$(all_active_equivalence_lookup "$equivalence_key"); then
        printf 'Reusing invocation-local profile equivalence %s (exit %s).\n' \
          "$equivalence_key" "$profile_result"
      else
        section "Run profile equivalence once: $equivalence_key"
        printf '$ %q %q\n' "$profile_script" "$MODE"
        if all_active_run_child env \
          SDLC_FEATURE_VERIFY_ALL_ACTIVE_CHILD=1 \
          "$profile_script" "$MODE"; then
          profile_result=0
        else
          profile_result=1
        fi
        all_active_equivalence_store "$equivalence_key" "$profile_result"
      fi
    else
      profile_result=""
    fi

    if all_active_run_child env \
      SDLC_FEATURE_VERIFY_ALL_ACTIVE_CHILD=1 \
      SDLC_FEATURE_VERIFY_ALL_ACTIVE_PARENT_PID="$$" \
      SDLC_FEATURE_VERIFY_ALL_ACTIVE_LOCK_DIR="$ALL_ACTIVE_LOCK_DIR" \
      SDLC_FEATURE_VERIFY_EQUIVALENCE_KEY="$equivalence_key" \
      SDLC_FEATURE_VERIFY_EQUIVALENCE_RESULT="$profile_result" \
      "$0" "$active_feature" "$MODE"; then
      feature_exit=0
    else
      feature_exit=$?
      any_failed=1
    fi
    summary_lines="${summary_lines}${active_feature} ${feature_exit}"$'\n'
  done

  section "All-active Summary"
  while read -r feature_name feature_exit; do
    [ -n "$feature_name" ] || continue
    printf '%s: exit %s\n' "$feature_name" "$feature_exit"
  done <<< "$summary_lines"

  if [ "$any_failed" -ne 0 ]; then
    printf 'all-active feature verification failed: one or more active features failed (%s)\n' "$MODE"
    exit 1
  fi

  printf 'all-active feature verification passed: all active features passed (%s)\n' "$MODE"
  exit 0
}

if [ "$FEATURE" = "--all-active" ]; then
  run_all_active "$MODE"
fi

if [ "$FEATURE" = "--resolve-profile" ]; then
  resolve_profile "${2:-}"
fi

if [ -z "$FEATURE" ] || [ "$FEATURE" = "-h" ] || [ "$FEATURE" = "--help" ]; then
  usage
  exit 2
fi

if ! valid_mode "$MODE"; then
  usage
  exit 2
fi

require_valid_feature_slug "$FEATURE"

FEATURE_DIR="docs/features/$FEATURE"
if [ ! -d "$FEATURE_DIR" ]; then
  printf 'Feature not found: %s\n' "$FEATURE_DIR" >&2
  exit 1
fi

FEATURE_TIER="large"
if [ -f "$FEATURE_DIR/.tier" ]; then
  FEATURE_TIER=$(tr -d '[:space:]' < "$FEATURE_DIR/.tier")
fi
case "$FEATURE_TIER" in small|medium|large) ;; *) FEATURE_TIER="large" ;; esac

run() {
  printf '\n$'
  printf ' %q' "$@"
  printf '\n'
  local display=""
  printf -v display '%q ' "$@"
  display="${display% }"

  if "$@"; then
    printf 'OK\n'
  else
    status=$?
    printf 'FAILED with exit code %s\n' "$status"
    FAILURES=$((FAILURES + 1))
    FAILURE_LINES="${FAILURE_LINES}${display} exited ${status}"$'\n'
  fi
}

run_shell() {
  label="$1"
  command="$2"

  printf '\n$ %s\n' "$label"
  if bash -lc "$command"; then
    printf 'OK\n'
  else
    status=$?
    printf 'FAILED with exit code %s\n' "$status"
    FAILURES=$((FAILURES + 1))
    FAILURE_LINES="${FAILURE_LINES}${label} exited ${status}"$'\n'
  fi
}

json_escape() {
  sed 's/\\/\\\\/g; s/"/\\"/g'
}

write_verify_status() {
  exit_code="$1"
  status_file="$FEATURE_DIR/.last-verify.json"
  head_sha=$(git rev-parse HEAD 2>/dev/null || printf 'unknown')
  dirty=false
  # Include untracked files. A clean tracked diff alone is not a releasable
  # candidate if an untracked source/config artifact influenced verification.
  if [ -n "$(git status --porcelain=v1 --untracked-files=normal -- . 2>/dev/null)" ]; then
    dirty=true
  fi
  timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

  {
    printf '{\n'
    printf '  "mode": "%s",\n' "$(printf '%s' "$MODE" | json_escape)"
    printf '  "exit_code": %s,\n' "$exit_code"
    printf '  "head_sha": "%s",\n' "$(printf '%s' "$head_sha" | json_escape)"
    printf '  "dirty": %s,\n' "$dirty"
    printf '  "timestamp": "%s",\n' "$timestamp"
    printf '  "failures": ['
    first=1
    if [ -n "$FAILURE_LINES" ]; then
      while IFS= read -r failure; do
        [ -z "$failure" ] && continue
        if [ "$first" -eq 0 ]; then
          printf ','
        fi
        printf '\n    "%s"' "$(printf '%s' "$failure" | json_escape)"
        first=0
      done <<< "$FAILURE_LINES"
    fi
    if [ "$first" -eq 0 ]; then
      printf '\n  '
    fi
    printf ']\n'
    printf '}\n'
  } > "$status_file"
}

section "Feature Verification: $FEATURE ($MODE)"

section "Framework Checks"
run git diff --check

# Tier-aware file-presence checks. Historical marker-free features retain the
# old file set; activated medium/large features also require INCREMENTS.md.
case "$FEATURE_TIER" in
  small)
    REQUIRED_FILES="FEATURE.md"
    ;;
  medium)
    REQUIRED_FILES="README.md SPEC.md DESIGN.md TASKS.md EVIDENCE.md"
    ;;
  large)
    REQUIRED_FILES="README.md STATE.md TASKS.md FINDINGS.md DECISIONS.md EVIDENCE.md"
    ;;
esac

if [ -f "$FEATURE_DIR/.incremental-delivery" ]; then
  REQUIRED_FILES="$REQUIRED_FILES INCREMENTS.md"
fi

for f in $REQUIRED_FILES; do
  run test -f "$FEATURE_DIR/$f"
done

if [ "$MODE" != "fast" ]; then
  section "Declared Capability Preflight"
  if [ -x scripts/preflight-credentials ]; then
    run scripts/preflight-credentials "$FEATURE"
  else
    printf 'FAILED: scripts/preflight-credentials missing or not executable\n'
    FAILURES=$((FAILURES + 1))
  fi
fi

# Auto-discover a per-feature verification profile. The framework looks
# for scripts/<feature-slug>-verify and runs it if executable. No
# hardcoded project switch — adopters declare per-feature verification
# by simply dropping a script with the right name in scripts/.
#
# (Previously this was a hardcoded case statement enumerating
# project-specific features. That was a project leak; replaced
# with auto-discovery in v1.0 per the cross-AI architecture review.)
domain_script="$(domain_script_for "$FEATURE")"
if [ -x "$domain_script" ]; then
  section "Domain verification (auto-discovered: $domain_script)"
  equivalence_key="${SDLC_FEATURE_VERIFY_EQUIVALENCE_KEY:-}"
  equivalence_result="${SDLC_FEATURE_VERIFY_EQUIVALENCE_RESULT:-}"
  if [ -n "$equivalence_key" ] || [ -n "$equivalence_result" ]; then
    declared_equivalence=$(profile_equivalence_key "$domain_script" 2>/dev/null || true)
    if [ "${SDLC_FEATURE_VERIFY_ALL_ACTIVE_CHILD:-}" != "1" ] || \
       [ -z "$equivalence_key" ] || \
       [ "$declared_equivalence" != "$equivalence_key" ] || \
       { [ "$equivalence_result" != "0" ] && [ "$equivalence_result" != "1" ]; } || \
       ! all_active_reuse_parent_is_valid; then
      printf 'FAILED: invalid all-active profile-equivalence reuse contract for %s\n' \
        "$domain_script"
      FAILURES=$((FAILURES + 1))
      FAILURE_LINES="${FAILURE_LINES}invalid profile-equivalence reuse for ${domain_script}"$'\n'
    elif [ "$equivalence_result" = "0" ]; then
      printf 'Reused passing invocation-local profile equivalence: %s\n' \
        "$equivalence_key"
    else
      printf 'FAILED: reused profile equivalence is red: %s\n' \
        "$equivalence_key"
      FAILURES=$((FAILURES + 1))
      FAILURE_LINES="${FAILURE_LINES}profile equivalence ${equivalence_key} exited 1"$'\n'
    fi
  else
    run "$domain_script" "$MODE"
  fi
else
  section "Generic Verification"
  if [ "$MODE" = "fast" ]; then
    printf 'No feature-specific fast checks declared for %s.\n' "$FEATURE"
    printf '  (Drop an executable scripts/%s-verify to add domain checks.)\n' "$FEATURE"
  else
    printf 'FAILED: no %s verification profile declared for %s\n' "$MODE" "$FEATURE"
    printf '  Create scripts/%s-verify with a case for "%s" mode and re-run.\n' "$FEATURE" "$MODE"
    FAILURES=$((FAILURES + 1))
  fi
fi

section "Result"
if [ "$FAILURES" -eq 0 ]; then
  printf 'feature verification passed: %s (%s)\n' "$FEATURE" "$MODE"
  write_verify_status 0
  exit 0
fi

printf 'feature verification failed: %s (%s) with %s failure(s)\n' "$FEATURE" "$MODE" "$FAILURES"
write_verify_status 1
exit 1
