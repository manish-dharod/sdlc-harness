#!/usr/bin/env bash
# Deterministic local SDLC maintenance report.
#
# Runs only shipped, local framework checks. It invokes the doctor in explicit
# offline mode, invokes no LLM, and never changes tracked files. Local memory
# and reports stay under gitignored .sdlc-memory/ and .sdlc/ directories.
#
# Usage:
#   scripts/sdlc-maintain [--quiet] [--as-of YYYY-MM-DD]
#
# Test-only aids (require --test-mode):
#   --scripts-dir DIR   invoke step executables from DIR instead of scripts/
#   --report-dir DIR    write reports under DIR instead of .sdlc/maintenance
#
# Exit codes: 0 all passed; 1 one or more steps failed; 3 usage/IO error.

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 3

QUIET=0
TEST_MODE=0
SCRIPTS_OVERRIDE=0
REPORT_OVERRIDE=0
SCRIPTS_DIR="$ROOT/scripts"
REPORT_DIR="$ROOT/.sdlc/maintenance"
AS_OF="$(date -u +%F)"

while [ $# -gt 0 ]; do
  case "$1" in
    --quiet) QUIET=1; shift ;;
    --test-mode) TEST_MODE=1; shift ;;
    --as-of)
      [ -n "${2:-}" ] || { printf 'sdlc-maintain: --as-of requires a value\n' >&2; exit 3; }
      AS_OF="$2"; shift 2 ;;
    --scripts-dir)
      [ -n "${2:-}" ] || { printf 'sdlc-maintain: --scripts-dir requires a value\n' >&2; exit 3; }
      SCRIPTS_DIR="$2"; SCRIPTS_OVERRIDE=1; shift 2 ;;
    --report-dir)
      [ -n "${2:-}" ] || { printf 'sdlc-maintain: --report-dir requires a value\n' >&2; exit 3; }
      REPORT_DIR="$2"; REPORT_OVERRIDE=1; shift 2 ;;
    -h|--help)
      sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) printf 'sdlc-maintain: unknown argument %s\n' "$1" >&2; exit 3 ;;
  esac
done

if [ "$TEST_MODE" -ne 1 ] && { [ "$SCRIPTS_OVERRIDE" -eq 1 ] || [ "$REPORT_OVERRIDE" -eq 1 ]; }; then
  printf 'sdlc-maintain: --scripts-dir and --report-dir require explicit --test-mode\n' >&2
  exit 3
fi

if ! python3 - "$AS_OF" <<'PY' >/dev/null 2>&1
import datetime
import sys
datetime.date.fromisoformat(sys.argv[1])
PY
then
  printf 'sdlc-maintain: --as-of must be YYYY-MM-DD\n' >&2
  exit 3
fi

if [ "$TEST_MODE" -ne 1 ] && { [ -L "$ROOT/.sdlc" ] || [ -L "$REPORT_DIR" ]; }; then
  printf 'sdlc-maintain: production report root must be a real directory under .sdlc/maintenance\n' >&2
  exit 3
fi
mkdir -p "$REPORT_DIR" || exit 3
REPORT="$REPORT_DIR/$AS_OF-report.md"
REFLECT_OUT="$REPORT_DIR/$AS_OF-reflect-proposal.md"

for target in "$REPORT" "$REFLECT_OUT"; do
  if [ -L "$target" ] || { [ -e "$target" ] && [ ! -f "$target" ]; }; then
    printf 'sdlc-maintain: output target is not a regular file: %s\n' "$target" >&2
    exit 3
  fi
done

OUT_DIR="$(mktemp -d)" || exit 3
SUMMARY="$OUT_DIR/summary.tsv"
REPORT_TMP=""
cleanup() {
  rm -rf "$OUT_DIR"
  [ -z "$REPORT_TMP" ] || rm -f "$REPORT_TMP"
}
trap cleanup EXIT

overall=0
n=0

say() { [ "$QUIET" -eq 1 ] || printf '%s\n' "$1"; }

run_step() { # run_step <display-label> <executable> [args...]
  label="$1"
  executable="$2"
  shift 2
  n=$((n + 1))
  outfile="$OUT_DIR/$n.log"
  say "== sdlc-maintain step $n: $label"
  if [ -x "$executable" ]; then
    "$executable" "$@" >"$outfile" 2>&1
    rc=$?
  else
    printf 'sdlc-maintain: missing step executable %s\n' "$executable" >"$outfile"
    rc=127
  fi
  [ "$rc" -eq 0 ] || overall=1
  [ "$QUIET" -eq 1 ] || cat "$outfile"
  say "== step $n exit=$rc"
  printf '%s\t%s\t%s\n' "$label" "$rc" "$outfile" >> "$SUMMARY"
}

run_step "sdlc-doctor --quiet --offline" "$SCRIPTS_DIR/sdlc-doctor" --quiet --offline
run_step "approvals-pending --as-of $AS_OF" "$SCRIPTS_DIR/approvals-pending" --as-of "$AS_OF"
run_step "sdlc-memory ingest-all-features" "$SCRIPTS_DIR/sdlc-memory" ingest-all-features
run_step "sdlc-memory stale" "$SCRIPTS_DIR/sdlc-memory" stale
run_step "backlog-index --check" "$SCRIPTS_DIR/backlog-index" --check
INSTALL_ROOT="$(cd "$SCRIPTS_DIR/.." 2>/dev/null && pwd)"
if [ -e "$SCRIPTS_DIR/insight-index" ] && [ -f "$INSTALL_ROOT/docs/insights/INDEX.md" ]; then
  run_step "insight-index --check" "$SCRIPTS_DIR/insight-index" --check
fi
run_step "reflect-harness --dry-run" "$SCRIPTS_DIR/reflect-harness" --dry-run --out "$REFLECT_OUT"

write_report() {
  printf '# SDLC maintenance report\n\n'
  printf -- '- As of: %s (UTC)\n' "$AS_OF"
  printf -- '- Repo head: %s\n' "$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || printf 'n/a')"
  printf -- '- Result: %s\n\n' "$([ "$overall" -eq 0 ] && printf 'PASS' || printf 'FAIL')"
  printf '| # | Step | Exit |\n|---|---|---|\n'
  i=0
  while IFS="$(printf '\t')" read -r label rc outfile; do
    [ -n "$label" ] || continue
    i=$((i + 1))
    printf '| %s | `%s` | %s |\n' "$i" "$label" "$rc"
  done < "$SUMMARY"
  printf '\n'
  i=0
  while IFS="$(printf '\t')" read -r label rc outfile; do
    [ -n "$label" ] || continue
    i=$((i + 1))
    printf '## Step %s: %s (exit %s)\n\n' "$i" "$label" "$rc"
    case "$label" in
      approvals-pending*)
        # The queue is already bounded by canonical approval blocks and sorted
        # oldest owner action first. Never tail-truncate those priority rows.
        sed 's/^/    /' "$outfile"
        ;;
      *)
        sed 's/^/    /' "$outfile" | tail -40
        ;;
    esac
    printf '\n'
  done < "$SUMMARY"
  printf '## Next actions\n\n'
  printf 'Nothing was auto-applied. Resolve failed deterministic checks or route\n'
  printf 'judgment work through the human-gated feature or harness workflows.\n'
}

REPORT_TMP="$(mktemp "$REPORT_DIR/.${AS_OF}-report.XXXXXX")" || {
  printf 'sdlc-maintain: could not create temporary report under %s\n' "$REPORT_DIR" >&2
  exit 3
}
if ! (set -e; set -o pipefail; write_report) > "$REPORT_TMP"; then
  printf 'sdlc-maintain: failed to write report: %s\n' "$REPORT" >&2
  exit 3
fi
if ! mv -f "$REPORT_TMP" "$REPORT"; then
  printf 'sdlc-maintain: failed to publish report: %s\n' "$REPORT" >&2
  exit 3
fi
REPORT_TMP=""

if [ "$QUIET" -eq 1 ]; then
  printf 'sdlc-maintain: %s (%s steps) report: %s\n' \
    "$([ "$overall" -eq 0 ] && printf 'PASS' || printf 'FAIL')" "$n" "${REPORT#$ROOT/}"
else
  say ""
  say "sdlc-maintain: $([ "$overall" -eq 0 ] && printf 'PASS' || printf 'FAIL') — report: ${REPORT#$ROOT/}"
fi
exit "$overall"
