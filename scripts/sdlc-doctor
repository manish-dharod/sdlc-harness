#!/usr/bin/env bash
# scripts/sdlc-doctor - read-only health check for the SDLC harness.
#
# Usage:
#   scripts/sdlc-doctor
#   scripts/sdlc-doctor --quiet

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 1

. "$ROOT/scripts/load-config"

QUIET=0
case "${1:-}" in
  "")
    ;;
  --quiet)
    QUIET=1
    ;;
  -h|--help)
    cat <<'EOF'
Usage: scripts/sdlc-doctor [--quiet]

Read-only harness health check. Exits 1 only for missing required framework
components. Optional tools such as Codex CLI and gh produce WARN rows.
EOF
    exit 0
    ;;
  *)
    printf 'sdlc-doctor: unknown arg: %s\n' "$1" >&2
    exit 3
    ;;
esac

PASS=0
FAIL=0
WARN=0

row() {
  status="$1"
  name="$2"
  detail="${3:-}"
  case "$status" in
    pass)
      PASS=$((PASS + 1))
      [ "$QUIET" -eq 1 ] || printf 'PASS %-34s %s\n' "$name" "$detail"
      ;;
    fail)
      FAIL=$((FAIL + 1))
      printf 'FAIL %-34s %s\n' "$name" "$detail"
      ;;
    warn)
      WARN=$((WARN + 1))
      printf 'WARN %-34s %s\n' "$name" "$detail"
      ;;
  esac
}

section() {
  [ "$QUIET" -eq 1 ] || printf '\n== %s ==\n' "$1"
}

section "Prerequisites"
bash_major="$(printf '%s' "${BASH_VERSION:-0}" | cut -d. -f1)"
if [ "${bash_major:-0}" -ge 3 ] 2>/dev/null; then
  row pass "bash" "${BASH_VERSION:-unknown}"
else
  row fail "bash" "need bash 3.2+"
fi

if command -v git >/dev/null 2>&1; then
  row pass "git" "$(git --version | head -1)"
else
  row fail "git" "required"
fi

if command -v codex >/dev/null 2>&1; then
  row pass "codex CLI" "$(codex --version 2>/dev/null | head -1 || printf present)"
else
  row warn "codex CLI" "not on PATH; cross-model wrappers exit 2"
fi

if command -v gh >/dev/null 2>&1; then
  if gh auth status >/dev/null 2>&1; then
    row pass "gh CLI" "authenticated"
  else
    row warn "gh CLI" "present but unauthenticated"
  fi
else
  row warn "gh CLI" "not on PATH; /feature-why GitHub category skips"
fi

section "Framework components"
agent_count="$(find .claude/agents -maxdepth 1 -name '*.md' 2>/dev/null | wc -l | tr -d '[:space:]')"
if [ "${agent_count:-0}" -ge 10 ] || { [ -f .claude/agents/planner.md ] && [ "${agent_count:-0}" -ge 5 ]; }; then
  row pass "agent prompts" "$agent_count prompt(s)"
else
  row fail "agent prompts" "expected sg-* prompts or generic v1.1 prompts"
fi

for cmd in feature-intake feature-orchestrate feature-context feature-review feature-why feature-arena feature-loop; do
  if [ -f ".claude/commands/${cmd}.md" ]; then
    row pass "command/${cmd}" "present"
  else
    row fail "command/${cmd}" "missing"
  fi
done

for script in feature-context feature-reconcile feature-ready feature-verify worktree-hygiene preflight-credentials adversary-review security-review sanitize-check sdlc-doctor; do
  if [ -x "scripts/${script}" ]; then
    row pass "script/${script}" "executable"
  else
    row fail "script/${script}" "missing or not executable"
  fi
done

if [ -x scripts/lib-sanitize.sh ] && scripts/lib-sanitize.sh >/dev/null 2>&1; then
  row pass "lib-sanitize.sh" "self-test passes"
else
  row fail "lib-sanitize.sh" "missing or self-test fails"
fi

if [ -x .claude/hooks/guard-bash.sh ]; then
  row pass "bash guard hook" "executable"
else
  row warn "bash guard hook" "missing or not executable"
fi

section "Configuration"
if [ -f sdlc.config.yml ]; then
  row pass "sdlc.config.yml" "present"
else
  row warn "sdlc.config.yml" "absent; using defaults"
fi

if [ -n "${SDLC_NOTIFY_COMMAND:-}" ]; then
  row pass "SDLC_NOTIFY_COMMAND" "configured"
else
  row warn "SDLC_NOTIFY_COMMAND" "unset; /feature-orchestrate will not notify"
fi

printf '\n== Summary ==\n'
printf 'Passed: %d\nWarnings: %d\nFailed: %d\n' "$PASS" "$WARN" "$FAIL"

if [ "$FAIL" -gt 0 ]; then
  exit 1
fi
exit 0
