#!/usr/bin/env bash
# Regenerate docs/insights/INDEX.md from INS item frontmatter, or verify it is
# current. INDEX.md is generated — never hand-edited.
#
# Usage:
#   scripts/insight-index            # regenerate INDEX.md
#   scripts/insight-index --check    # exit 1 if INDEX.md is stale or items malformed
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ITEMS_DIR="$ROOT/docs/insights/items"
INDEX="$ROOT/docs/insights/INDEX.md"
MODE="${1:-generate}"

ROUTING_RE='^(encode-in-structure|add-or-update-principle|role-prompt-edit)$'
STATUS_RE='^(captured|distilled-proposed|evaluated|rejected|human-gated|auto-structural|applied|superseded|rolled-back)$'

fail=0
rows=""   # routing|status|id|name|description|source_feature|source_tasks|file

field() { # field <file> <key> — first top-level frontmatter occurrence
  awk -v key="$2" '
    NR==1 && $0!="---" { exit }
    NR>1 && $0=="---" { exit }
    index($0, key": ")==1 {
      sub(key": ", ""); gsub(/^[ \t]+|[ \t]+$/, ""); print; exit
    }' "$1"
}

metadata_field() { # metadata_field <file> <key>
  awk -v key="$2" '
    NR==1 && $0!="---" { exit }
    NR>1 && $0=="---" { exit }
    /^metadata:[ \t]*$/ { in_meta=1; next }
    in_meta && /^[^ \t]/ { in_meta=0 }
    in_meta && index($0, "  " key ": ")==1 {
      sub("  " key ": ", ""); gsub(/^[ \t]+|[ \t]+$/, ""); print; exit
    }' "$1"
}

source_tasks() { # source_tasks <file>
  awk '
    NR==1 && $0!="---" { exit }
    NR>1 && $0=="---" { exit }
    /^  source_tasks:[ \t]*$/ { in_tasks=1; next }
    in_tasks && /^  [^ -]/ { in_tasks=0 }
    in_tasks && /^    - / {
      item=$0; sub(/^    - /, "", item); gsub(/^[ \t]+|[ \t]+$/, "", item)
      if (item!="") {
        if (out!="") out=out ","
        out=out item
      }
    }
    END { print out }' "$1"
}

section_count() { # section_count <file> <heading>
  grep -c "^## $2\$" "$1" || true
}

evidence_items() { # evidence_items <file>
  awk '
    /^## Evidence$/ { in_ev=1; next }
    /^## / && in_ev { in_ev=0 }
    in_ev && /^- / { count++ }
    END { print count+0 }' "$1"
}

err() {
  printf 'insight-index: ERROR %s\n' "$1" >&2
  fail=1
}

append_row() {
  rows="${rows}$1|$2|$3|$4|$5|$6|$7|$8
"
}

case "$MODE" in
  generate|--check) ;;
  -h|--help)
    printf 'Usage: scripts/insight-index [--check]\n'
    exit 0
    ;;
  *)
    printf 'Usage: scripts/insight-index [--check]\n' >&2
    exit 3
    ;;
esac

seen_ids=""
shopt -s nullglob
for f in "$ITEMS_DIR"/INS-*.md; do
  base="$(basename "$f")"
  id="$(field "$f" id)"
  name="$(field "$f" name)"
  description="$(field "$f" description)"
  type="$(metadata_field "$f" type)"
  routing="$(metadata_field "$f" routing)"
  status="$(metadata_field "$f" status)"
  source_feature="$(metadata_field "$f" source_feature)"
  tasks="$(source_tasks "$f")"

  [ -n "$id" ] || { err "$base: missing id"; continue; }
  case "$id" in INS-[0-9][0-9][0-9]) ;; *) err "$base: bad id '$id'";; esac
  case "$base" in "$id"-*) ;; *) err "$base: filename does not start with $id-";; esac
  case "$seen_ids" in *" $id "*) err "$base: duplicate id $id";; esac
  seen_ids="$seen_ids $id "

  [ -n "$name" ] || err "$base: missing name"
  [ -n "$description" ] || err "$base: missing description"
  [ "$type" = "insight" ] || err "$base: metadata.type must be insight"
  printf '%s' "$routing" | grep -Eq "$ROUTING_RE" || err "$base: bad metadata.routing '$routing'"
  printf '%s' "$status" | grep -Eq "$STATUS_RE" || err "$base: bad metadata.status '$status'"
  [ -n "$source_feature" ] || err "$base: missing metadata.source_feature"

  for value in "$name" "$description" "$source_feature" "$tasks"; do
    case "$value" in *"|"*) err "$base: table field may not contain '|'";; esac
  done

  for heading in Pattern Evidence Routing "Enforcement target" "Eval-corpus link"; do
    [ "$(section_count "$f" "$heading")" -eq 1 ] || err "$base: expected one '## $heading' section"
  done
  [ "$(evidence_items "$f")" -ge 2 ] || err "$base: Evidence section must cite at least two instances"

  append_row "$routing" "$status" "$id" "$name" "$description" "$source_feature" "${tasks:-none}" "items/$base"
done

[ "$fail" -eq 0 ] || exit 1

render() {
  printf '<!-- GENERATED by scripts/insight-index — do not edit by hand. -->\n'
  printf '# Insight index\n\n'
  printf 'Conventions: [README.md](README.md). One file per item under `items/`.\n'
  printf 'Raw capture logs stay under gitignored `.sdlc/capture/` and are never indexed here.\n\n'

  sorted="$(printf '%s' "$rows" | LC_ALL=C sort -t'|' -k1,1 -k2,2 -k3,3)"
  n_items="$(printf '%s' "$sorted" | grep -c . || true)"
  printf '**%s insight item(s)**\n' "$n_items"

  if [ "$n_items" -eq 0 ]; then
    printf '\nNo durable insight items have been accepted yet.\n'
    return
  fi

  current_routing=""
  while IFS='|' read -r routing status id name description source_feature tasks file; do
    [ -n "$id" ] || continue
    if [ "$routing" != "$current_routing" ]; then
      printf '\n## %s\n\n' "$routing"
      printf '| ID | Status | Name | Source | Tasks | Description |\n'
      printf '|---|---|---|---|---|---|\n'
      current_routing="$routing"
    fi
    printf '| [%s](%s) | %s | %s | %s | %s | %s |\n' \
      "$id" "$file" "$status" "$name" "$source_feature" "$tasks" "$description"
  done <<EOF_ROWS
$sorted
EOF_ROWS
}

if [ "$MODE" = "--check" ]; then
  tmp="$(mktemp)"
  trap 'rm -f "$tmp"' EXIT
  render > "$tmp"
  if ! diff -q "$INDEX" "$tmp" >/dev/null 2>&1; then
    printf 'insight-index: INDEX.md is stale — run scripts/insight-index\n' >&2
    exit 1
  fi
  printf 'insight-index: OK (%s item(s), index current)\n' "$(printf '%s' "$rows" | grep -c . || true)"
else
  mkdir -p "$(dirname "$INDEX")"
  render > "$INDEX"
  printf 'insight-index: wrote %s (%s item(s))\n' "${INDEX#$ROOT/}" "$(printf '%s' "$rows" | grep -c . || true)"
fi
