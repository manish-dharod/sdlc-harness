#!/usr/bin/env bash
# Regression tests for scripts/codex-capsule-run using a fake Codex CLI.

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUNNER="$ROOT/scripts/codex-capsule-run"
TMPDIR_TEST="$(mktemp -d)"
FEATURE="_test-codex-capsule-run-$$"
FEATURE_DIR="$ROOT/docs/features/$FEATURE"
PASS_COUNT=0
FAIL_COUNT=0

cleanup() {
  rm -rf "$TMPDIR_TEST" "$FEATURE_DIR"
}
trap cleanup EXIT

mkdir -p "$FEATURE_DIR"
printf 'large\n' > "$FEATURE_DIR/.tier"
touch "$FEATURE_DIR/EVIDENCE.md"

write_capsule() {
  local file="$1"
  cat > "$file" <<EOF
Goal: Test Codex capsule runner.
Current task: TASK-INFRA-900
Agent: Codex CLI implementation
Worktree: $ROOT
Base commit: abc1234
Spec anchors:
- docs/features/$FEATURE/EVIDENCE.md
Hard invariants:
- preserve declared domain invariants and public contracts
- no production deploys
- no secrets, credentials, tokens, or sensitive data
Owned files:
- docs/features/$FEATURE/EVIDENCE.md
Forbidden files:
- Do NOT edit another agent worktree
Stop conditions:
- Stop on P0/P1
- Stop on sanitizer failure
Required checks:
- scripts/test-codex-capsule-run
Commit rule:
- Commit only after checks pass. Do NOT push.
Checkpoint:
- docs/features/$FEATURE/EVIDENCE.md

Use separate worktree isolation and review committed diffs only.
EOF
}

write_fake_codex() {
  local file="$1"
  local logdir="$2"
  cat > "$file" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$@" > "$logdir/args"
cat > "$logdir/stdin"
printf 'fake codex worker completed\n'
EOF
  chmod +x "$file"
}

run_case() {
  local name="$1"
  local expected="$2"
  shift 2
  local output status

  output="$("$@" 2>&1)"
  status=$?

  if { [ "$expected" = "pass" ] && [ "$status" -eq 0 ]; } ||
     { [ "$expected" = "fail" ] && [ "$status" -ne 0 ]; }; then
    printf 'ok - %s\n' "$name"
    PASS_COUNT=$((PASS_COUNT + 1))
  else
    printf 'not ok - %s\n' "$name" >&2
    printf 'expected: %s, status: %s\n%s\n' "$expected" "$status" "$output" >&2
    FAIL_COUNT=$((FAIL_COUNT + 1))
  fi
}

capsule="$TMPDIR_TEST/capsule.md"
write_capsule "$capsule"
fake="$TMPDIR_TEST/codex"
write_fake_codex "$fake" "$TMPDIR_TEST"

run_codex() {
  AGENT_CAPSULE_FIXTURE_MODE=1 \
  AGENT_CAPSULE_ARTIFACT_DIR="$TMPDIR_TEST/artifacts" \
  CODEX_BIN="$fake" \
  "$RUNNER" "$FEATURE" TASK-INFRA-900 "$capsule" >/dev/null
}

run_case "fake Codex capsule run passes" pass run_codex
run_case "Codex runner uses pinned model" pass grep -q -- '--model' "$TMPDIR_TEST/args"
run_case "Codex runner passes gpt-5.5" pass grep -q -- 'gpt-5.5' "$TMPDIR_TEST/args"
run_case "Codex runner uses xhigh reasoning" pass grep -q 'model_reasoning_effort="xhigh"' "$TMPDIR_TEST/args"
run_case "Codex runner uses workspace-write sandbox by default" pass grep -q -- 'workspace-write' "$TMPDIR_TEST/args"
run_case "Codex runner passes capsule on stdin" pass grep -q 'Goal: Test Codex capsule runner.' "$TMPDIR_TEST/stdin"

danger_without_allow() {
  AGENT_CAPSULE_FIXTURE_MODE=1 \
  AGENT_CAPSULE_ARTIFACT_DIR="$TMPDIR_TEST/artifacts-danger-rejected" \
  AGENT_CAPSULE_CODEX_SANDBOX=danger-full-access \
  CODEX_BIN="$fake" \
  "$RUNNER" "$FEATURE" TASK-INFRA-900 "$capsule" >/dev/null
}
run_case "danger-full-access Codex sandbox requires explicit allow" fail danger_without_allow

danger_with_allow() {
  AGENT_CAPSULE_FIXTURE_MODE=1 \
  AGENT_CAPSULE_ARTIFACT_DIR="$TMPDIR_TEST/artifacts-danger-allowed" \
  AGENT_CAPSULE_CODEX_SANDBOX=danger-full-access \
  AGENT_CAPSULE_ALLOW_DANGER_SANDBOX=1 \
  CODEX_BIN="$fake" \
  "$RUNNER" "$FEATURE" TASK-INFRA-900 "$capsule" >/dev/null
}
run_case "danger-full-access Codex sandbox can be explicitly allowed" pass danger_with_allow
run_case "Codex runner passes explicit danger sandbox" pass grep -q -- 'danger-full-access' "$TMPDIR_TEST/args"

wrong_model() {
  AGENT_CAPSULE_FIXTURE_MODE=1 \
  AGENT_CAPSULE_ARTIFACT_DIR="$TMPDIR_TEST/artifacts-wrong" \
  CODEX_BIN="$fake" \
  CODEX_WORKER_MODEL=not-the-pinned-model \
  "$RUNNER" "$FEATURE" TASK-INFRA-900 "$capsule" >/dev/null
}
run_case "wrong Codex model is rejected" fail wrong_model

fixture_in_ci() {
  CI=true \
  AGENT_CAPSULE_FIXTURE_MODE=1 \
  AGENT_CAPSULE_ARTIFACT_DIR="$TMPDIR_TEST/artifacts-ci" \
  CODEX_BIN="$fake" \
  "$RUNNER" "$FEATURE" TASK-INFRA-900 "$capsule" >/dev/null
}
run_case "fixture mode is rejected in CI" fail fixture_in_ci

missing_cli() {
  AGENT_CAPSULE_FIXTURE_MODE=1 \
  AGENT_CAPSULE_ARTIFACT_DIR="$TMPDIR_TEST/artifacts-missing" \
  CODEX_BIN="$TMPDIR_TEST/missing-codex" \
  "$RUNNER" "$FEATURE" TASK-INFRA-900 "$capsule" >/dev/null
}
run_case "missing Codex CLI is rejected" fail missing_cli

printf '\nSummary: %s passed, %s failed\n' "$PASS_COUNT" "$FAIL_COUNT"
[ "$FAIL_COUNT" -eq 0 ]
