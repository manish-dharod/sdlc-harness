#!/usr/bin/env bash
# Sanctioned supervisor -> Codex CLI implementation capsule runner.

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export AGENT_CAPSULE_WORKER_TOOL=codex-cli
"$ROOT/scripts/agent-capsule-run" "$@"
status=$?
outcome="pass"
stop_reason="NONE"
if [ "$status" -ne 0 ]; then
  outcome="fail"
  stop_reason="WORKER_EXIT_NONZERO"
fi
"$ROOT/scripts/lib-capture.sh" emit \
  --source codex-capsule \
  --feature "${1:-global}" \
  --task "${2:-}" \
  --actor-tool codex-cli \
  --actor-model "${CODEX_WORKER_MODEL:-gpt-5.5}" \
  --outcome "$outcome" \
  --stop-reason "$stop_reason" \
  --verify-mode none \
  --verify-exit "$status" \
  --lesson-hint "Codex capsule run completed with status $status" >/dev/null 2>&1 || true
exit "$status"
