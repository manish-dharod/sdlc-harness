#!/usr/bin/env bash
# Verify maintenance report, failure aggregation, optional steps, and read-only behavior.

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 3

MODE="${1:-unit}"
case "$MODE" in
  fast|unit|full|--verbose) ;;
  -h|--help)
    printf 'Usage: scripts/test-sdlc-maintain [fast|unit|full|--verbose]\n'
    exit 0 ;;
  *)
    printf 'Usage: scripts/test-sdlc-maintain [fast|unit|full|--verbose]\n' >&2
    exit 3 ;;
esac

VERBOSE=0
if [ "$MODE" = "--verbose" ]; then MODE=unit; VERBOSE=1; fi
PASS=0
FAIL=0

check() {
  label="$1"
  shift
  if "$@"; then
    PASS=$((PASS + 1))
    [ "$VERBOSE" -eq 0 ] || printf 'PASS %s\n' "$label"
  else
    FAIL=$((FAIL + 1))
    printf 'FAIL %s\n' "$label" >&2
  fi
}

SM="$ROOT/scripts/sdlc-maintain"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

make_stubs() { # make_stubs <install-root> <failing-step-or-none> <with-insight:0|1>
  d="$1"; failing="$2"; with_insight="$3"
  scripts_dir="$d/scripts"
  mkdir -p "$scripts_dir"
  for s in sdlc-doctor approvals-pending sdlc-memory backlog-index reflect-harness; do
    if [ "$s" = "$failing" ]; then
      printf '#!/bin/sh\necho "stub %s: simulated failure" >&2\nexit 1\n' "$s" > "$scripts_dir/$s"
    else
      printf '#!/bin/sh\necho "stub %s ok: $*"\nexit 0\n' "$s" > "$scripts_dir/$s"
    fi
    chmod +x "$scripts_dir/$s"
  done
  if [ "$with_insight" -eq 1 ]; then
    mkdir -p "$d/docs/insights"
    printf '# generated fixture\n' > "$d/docs/insights/INDEX.md"
    if [ "insight-index" = "$failing" ]; then
      printf '#!/bin/sh\necho "stub insight-index: simulated failure" >&2\nexit 1\n' > "$scripts_dir/insight-index"
    else
      printf '#!/bin/sh\necho "stub insight-index ok: $*"\nexit 0\n' > "$scripts_dir/insight-index"
    fi
    chmod +x "$scripts_dir/insight-index"
  fi
}

make_probe_hook() { # make_probe_hook <path> <marker> <expected-report> <exit>
  hook_path="$1"
  marker_path="$2"
  expected_report="$3"
  hook_exit="$4"
  cat > "$hook_path" <<EOF
#!/bin/sh
{
  printf 'argc=%s\n' "\$#"
  printf 'inherited=%s\n' "\${SDLC_NOTIFY_TEST_SENTINEL-unset}"
  if [ -f '$expected_report' ]; then
    printf 'report=present\n'
  else
    printf 'report=missing\n'
  fi
} > '$marker_path'
exit $hook_exit
EOF
  chmod +x "$hook_path"
}

check "maintenance script executable" test -x "$SM"
HELP_OUT="$("$SM" --help 2>&1)"
check "maintenance help succeeds" test $? -eq 0
check "maintenance help documents notification hook" sh -c 'printf "%s\n" "$1" | grep -q -- "--notify-hook /absolute/executable"' sh "$HELP_OUT"
check "maintenance help contains comments only" sh -c '! printf "%s\n" "$1" | grep -q "set -u"' sh "$HELP_OUT"

STUB_A="$TMP/case-a"; make_stubs "$STUB_A" none 1
REP_A="$TMP/reports-a"
"$SM" --test-mode --as-of 2026-07-10 --scripts-dir "$STUB_A/scripts" --report-dir "$REP_A" >/dev/null 2>&1
check "all-pass run exits zero" test $? -eq 0
REPORT_A="$REP_A/2026-07-10-report.md"
check "deterministically named report written" test -f "$REPORT_A"
check "report records pass" grep -q 'Result: PASS' "$REPORT_A"
check "approval date forwarded" grep -q 'stub approvals-pending ok: --as-of 2026-07-10' "$REPORT_A"
check "doctor runs in explicit offline mode" grep -q 'stub sdlc-doctor ok: --quiet --offline' "$REPORT_A"
check "all shipped steps included" sh -c \
  'grep -q "sdlc-doctor" "$1" && grep -q "sdlc-memory stale" "$1" && grep -q "insight-index" "$1" && grep -q "reflect-harness" "$1"' sh "$REPORT_A"

STUB_B="$TMP/case-b"; make_stubs "$STUB_B" insight-index 1
REP_B="$TMP/reports-b"
"$SM" --test-mode --as-of 2026-07-10 --scripts-dir "$STUB_B/scripts" --report-dir "$REP_B" >/dev/null 2>&1
check "failing step exits one" test $? -eq 1
REPORT_B="$REP_B/2026-07-10-report.md"
check "report records failure" grep -q 'Result: FAIL' "$REPORT_B"
check "failing stderr captured" grep -q 'simulated failure' "$REPORT_B"
check "later steps continue" grep -q 'stub reflect-harness ok' "$REPORT_B"

STUB_C="$TMP/case-c"; make_stubs "$STUB_C" none 0
REP_C="$TMP/reports-c"
OUT_C="$("$SM" --test-mode --quiet --as-of 2026-07-10 --scripts-dir "$STUB_C/scripts" --report-dir "$REP_C" 2>&1)"
check "quiet run without optional insight succeeds" test $? -eq 0
check "optional absent insight omitted" sh -c '! grep -q "insight-index" "$1"' sh "$REP_C/2026-07-10-report.md"
check "quiet output is one summary line" test "$(printf '%s\n' "$OUT_C" | grep -c .)" -eq 1
check "default notification is explicitly skipped" sh -c 'printf "%s\n" "$1" | grep -q "notification=SKIPPED"' sh "$OUT_C"

REP_NOTIFY_PASS="$TMP/reports-notify-pass"
REPORT_NOTIFY_PASS="$REP_NOTIFY_PASS/2026-07-10-report.md"
MARK_NOTIFY_PASS="$TMP/notify-pass.marker"
HOOK_NOTIFY_PASS="$TMP/hook with spaces;\$(touch PWNED)"
make_probe_hook "$HOOK_NOTIFY_PASS" "$MARK_NOTIFY_PASS" "$REPORT_NOTIFY_PASS" 0
OUT_NOTIFY_PASS="$(SDLC_NOTIFY_TEST_SENTINEL=must-not-leak "$SM" --test-mode --quiet \
  --as-of 2026-07-10 --scripts-dir "$STUB_A/scripts" --report-dir "$REP_NOTIFY_PASS" \
  --notify-hook "$HOOK_NOTIFY_PASS" 2>&1)"
check "successful notification preserves maintenance success" test $? -eq 0
check "successful notification is surfaced" sh -c 'printf "%s\n" "$1" | grep -q "notification=PASS"' sh "$OUT_NOTIFY_PASS"
check "notification hook is invoked" test -f "$MARK_NOTIFY_PASS"
check "notification hook receives zero arguments" grep -q '^argc=0$' "$MARK_NOTIFY_PASS"
check "notification hook receives no inherited environment" grep -q '^inherited=unset$' "$MARK_NOTIFY_PASS"
check "report exists before notification hook runs" grep -q '^report=present$' "$MARK_NOTIFY_PASS"
check "shell-looking hook path is not evaluated" test ! -e "$TMP/PWNED"

REP_NOTIFY_FAIL="$TMP/reports-notify-fail"
MARK_NOTIFY_FAIL="$TMP/notify-fail.marker"
HOOK_NOTIFY_FAIL="$TMP/notify-fail"
make_probe_hook "$HOOK_NOTIFY_FAIL" "$MARK_NOTIFY_FAIL" "$REP_NOTIFY_FAIL/2026-07-10-report.md" 9
OUT_NOTIFY_FAIL="$("$SM" --test-mode --quiet --as-of 2026-07-10 \
  --scripts-dir "$STUB_A/scripts" --report-dir "$REP_NOTIFY_FAIL" \
  --notify-hook "$HOOK_NOTIFY_FAIL" 2>&1)"
check "hook failure does not turn passing maintenance nonzero" test $? -eq 0
check "hook failure is surfaced for passing maintenance" sh -c 'printf "%s\n" "$1" | grep -q "notification=FAIL"' sh "$OUT_NOTIFY_FAIL"

REP_B_NOTIFY="$TMP/reports-b-notify"
MARK_B_NOTIFY="$TMP/notify-b-fail.marker"
HOOK_B_NOTIFY="$TMP/notify-b-fail"
make_probe_hook "$HOOK_B_NOTIFY" "$MARK_B_NOTIFY" "$REP_B_NOTIFY/2026-07-10-report.md" 9
OUT_B_NOTIFY="$("$SM" --test-mode --quiet --as-of 2026-07-10 \
  --scripts-dir "$STUB_B/scripts" --report-dir "$REP_B_NOTIFY" \
  --notify-hook "$HOOK_B_NOTIFY" 2>&1)"
check "maintenance failure remains exit one when hook also fails" test $? -eq 1
check "hook failure is surfaced for failing maintenance" sh -c 'printf "%s\n" "$1" | grep -q "notification=FAIL"' sh "$OUT_B_NOTIFY"

"$SM" --test-mode --as-of invalid --scripts-dir "$STUB_A/scripts" --report-dir "$TMP/bad" >/dev/null 2>&1
check "invalid date exits usage" test $? -eq 3

"$SM" --as-of 2026-07-10 --scripts-dir "$STUB_A/scripts" --report-dir "$TMP/no-test-mode" >/dev/null 2>&1
check "path overrides require explicit test mode" test $? -eq 3
check "rejected override writes no report" test ! -e "$TMP/no-test-mode/2026-07-10-report.md"

REP_COLLISION="$TMP/reports-collision"
mkdir -p "$REP_COLLISION/2026-07-10-report.md"
MARK_COLLISION="$TMP/notify-collision.marker"
HOOK_COLLISION="$TMP/notify-collision"
make_probe_hook "$HOOK_COLLISION" "$MARK_COLLISION" "$REP_COLLISION/2026-07-10-report.md" 0
"$SM" --test-mode --as-of 2026-07-10 --scripts-dir "$STUB_A/scripts" \
  --report-dir "$REP_COLLISION" --notify-hook "$HOOK_COLLISION" >/dev/null 2>&1
check "report target directory collision exits IO error" test $? -eq 3
check "report preflight failure does not invoke hook" test ! -e "$MARK_COLLISION"

STUB_PREFLIGHT="$TMP/case-notify-preflight"; make_stubs "$STUB_PREFLIGHT" none 0
STEP_PREFLIGHT_MARKER="$TMP/notify-preflight-step.marker"
cat > "$STUB_PREFLIGHT/scripts/sdlc-doctor" <<EOF
#!/bin/sh
touch '$STEP_PREFLIGHT_MARKER'
exit 0
EOF
chmod +x "$STUB_PREFLIGHT/scripts/sdlc-doctor"
TARGET_PREFLIGHT_MARKER="$TMP/notify-preflight-hook.marker"
TARGET_PREFLIGHT="$TMP/notify-preflight-target"
make_probe_hook "$TARGET_PREFLIGHT" "$TARGET_PREFLIGHT_MARKER" "$TMP/unused-report.md" 0
LINK_PREFLIGHT="$TMP/notify-preflight-link"
ln -s "$TARGET_PREFLIGHT" "$LINK_PREFLIGHT"
"$SM" --test-mode --as-of 2026-07-10 --scripts-dir "$STUB_PREFLIGHT/scripts" \
  --report-dir "$TMP/reports-notify-preflight" --notify-hook "$LINK_PREFLIGHT" >/dev/null 2>&1
check "symlink notification hook is rejected" test $? -eq 3
check "invalid hook is rejected before maintenance steps" test ! -e "$STEP_PREFLIGHT_MARKER"
check "invalid hook is never invoked" test ! -e "$TARGET_PREFLIGHT_MARKER"

"$SM" --test-mode --as-of 2026-07-10 --scripts-dir "$STUB_A/scripts" \
  --report-dir "$TMP/reports-relative-hook" --notify-hook relative-hook >/dev/null 2>&1
check "relative notification hook is rejected" test $? -eq 3

NONEXEC_HOOK="$TMP/notify-nonexec"
make_probe_hook "$NONEXEC_HOOK" "$TMP/notify-nonexec.marker" "$TMP/unused-report.md" 0
chmod -x "$NONEXEC_HOOK"
"$SM" --test-mode --as-of 2026-07-10 --scripts-dir "$STUB_A/scripts" \
  --report-dir "$TMP/reports-nonexec-hook" --notify-hook "$NONEXEC_HOOK" >/dev/null 2>&1
check "non-executable notification hook is rejected" test $? -eq 3

"$SM" --test-mode --as-of 2026-07-10 --scripts-dir "$STUB_A/scripts" \
  --report-dir "$TMP/reports-missing-hook" --notify-hook "$TMP/missing-hook" >/dev/null 2>&1
check "missing notification hook is rejected" test $? -eq 3

STUB_PUBLISH="$TMP/case-publish-fail"; make_stubs "$STUB_PUBLISH" none 0
REP_PUBLISH="$TMP/reports-publish-fail"
PUBLISH_TARGET="$REP_PUBLISH/2026-07-10-report.md"
cat > "$STUB_PUBLISH/scripts/sdlc-doctor" <<EOF
#!/bin/sh
mkdir -p '$PUBLISH_TARGET'
exit 0
EOF
chmod +x "$STUB_PUBLISH/scripts/sdlc-doctor"
MARK_PUBLISH="$TMP/notify-publish.marker"
HOOK_PUBLISH="$TMP/notify-publish"
make_probe_hook "$HOOK_PUBLISH" "$MARK_PUBLISH" "$PUBLISH_TARGET" 0
"$SM" --test-mode --as-of 2026-07-10 --scripts-dir "$STUB_PUBLISH/scripts" \
  --report-dir "$REP_PUBLISH" --notify-hook "$HOOK_PUBLISH" >/dev/null 2>&1
check "report publication collision exits IO error" test $? -eq 3
check "report publication failure does not invoke hook" test ! -e "$MARK_PUBLISH"

STUB_LONG="$TMP/case-long"; make_stubs "$STUB_LONG" none 0
cat > "$STUB_LONG/scripts/approvals-pending" <<'EOF'
#!/bin/sh
printf '# Pending approvals\n\n'
printf '%s\n' 'OLDEST-OWNER-APPROVAL'
i=1
while [ "$i" -le 55 ]; do
  printf 'owner approval row %s\n' "$i"
  i=$((i + 1))
done
printf '%s\n' 'NEWEST-OWNER-APPROVAL'
EOF
chmod +x "$STUB_LONG/scripts/approvals-pending"
REP_LONG="$TMP/reports-long"
"$SM" --test-mode --as-of 2026-07-10 --scripts-dir "$STUB_LONG/scripts" --report-dir "$REP_LONG" >/dev/null 2>&1
check "long approval queue run succeeds" test $? -eq 0
check "report preserves oldest owner approval beyond forty lines" grep -q 'OLDEST-OWNER-APPROVAL' "$REP_LONG/2026-07-10-report.md"
check "report preserves complete approval queue tail" grep -q 'NEWEST-OWNER-APPROVAL' "$REP_LONG/2026-07-10-report.md"

if [ "$MODE" = "full" ]; then
  before="$(git -C "$ROOT" status --porcelain)"
  "$SM" --quiet --as-of 2026-07-10 >/dev/null 2>&1
  check "real maintenance run succeeds" test $? -eq 0
  after="$(git -C "$ROOT" status --porcelain)"
  check "real run changes no tracked or visible untracked files" test "$before" = "$after"
  check "real report lands under ignored local state" test -f "$ROOT/.sdlc/maintenance/2026-07-10-report.md"
fi

printf 'test-sdlc-maintain: %s passed, %s failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
