#!/usr/bin/env bash
set -u
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
printf '# Iteration Ledger\n\n## Runs\n' > "$TMP/RUNS.md"

"$ROOT/scripts/campaign-ledger" fixture --feature-dir "$TMP" --campaign merge-train-20260712 \
  --iteration 0 --mode fast --routing resume-claimed:TASK-001 --task TASK-001 \
  --files-changed 2 --diff-hash abc123 --verification pass --stop-reason continue \
  --stop-code NONE --as-of '2026-07-12 12:00 UTC' >/dev/null || exit 1

grep -q '^### RUN-001' "$TMP/RUNS.md" &&
grep -q '^- Campaign: merge-train-20260712$' "$TMP/RUNS.md" &&
grep -q '^- Routing: resume-claimed:TASK-001$' "$TMP/RUNS.md" &&
grep -q '^- Verification: fast = pass$' "$TMP/RUNS.md" || exit 1
printf 'test-campaign-ledger: 4 passed, 0 failed\n'
