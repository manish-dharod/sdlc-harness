#!/usr/bin/env bash
# scripts/feature-reflect — gather a feature's durable artifacts into a
# context bundle for the /feature-reflect slash command to mine.
#
# Usage:
#   scripts/feature-reflect <feature-slug> [--dry-run]
#
# Behavior:
#   - Validates the feature directory exists.
#   - Gathers SPEC.md, DESIGN.md, TASKS.md, EVIDENCE.md, LEARNINGS.md,
#     recent learnings/*.learning.md captures, RUNS.md (large), FINDINGS.md
#     (large), FEATURE.md (small), plus framework-level CLAUDE.md /
#     AGENTS.md / docs/principles/README.md into a single timestamped
#     context file at
#     docs/features/<slug>/reflect/<timestamp>.context.md.
#   - Returns exit 0 (wrote artifact) / 3 (missing feature or usage error).
#   - Does NOT invoke any LLM. The slash command reads the artifact path
#     this script prints to stdout and dispatches the reviewer +
#     synthesizer subagents itself.
#
# Tier awareness: large tier has RUNS.md + FINDINGS.md as separate files;
# medium tier inlines findings into EVIDENCE.md and has no RUNS.md; small
# tier has FEATURE.md only.
#
# Idempotency (NFR-002): on the same feature with unchanged source files,
# two consecutive runs produce byte-identical artifacts modulo the
# timestamp comment in the header. Verified by scripts/test-framework-v3.

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 3

# Load per-project sdlc.config.yml (no-op if absent)
. "$ROOT/scripts/load-config"

# Shared sensitive-data sanitizer — applied to the assembled bundle
# before it lands at $OUT_FILE. Per SEC-FND-002 from the framework-v3
# PR security review: /feature-reflect copies EVIDENCE / FINDINGS /
# APPROVALS / QUESTIONS / CLAUDE.md / AGENTS.md into a bundle that
# subagents read; without the scan, an operator mistake elsewhere
# (a card / secret / PII pattern landed in EVIDENCE somehow) would be
# silently replicated into prompt-consumed artifacts. Refuses with
# exit 6 if any pattern matches.
# shellcheck source=lib-sanitize.sh
. "$ROOT/scripts/lib-sanitize.sh"
# shellcheck source=lib-learning-artifacts.sh
. "$ROOT/scripts/lib-learning-artifacts.sh"

CALLER="scripts/feature-reflect"
ROOT_REAL=$(sdlc_learning_realpath "$ROOT") || exit 3

SLUG="${1:-}"
DRY_RUN=0

usage() {
  cat <<'EOF'
Usage: scripts/feature-reflect <feature-slug> [--dry-run|--full]

  feature-slug  required; must match docs/features/<slug>/
  --dry-run     gather context only; deterministic context-gathering tag
                used by the test harness for idempotency probes.
  --full        documented mode from SPEC.md AC-004; an alias for the
                default behavior, since the wrapper itself never invokes
                an LLM. The slash command (.claude/commands/feature-reflect.md)
                is what consumes this script's bundle and dispatches
                the synthesizer subagents.

Exit codes:
  0  — wrote context artifact; printed path on stdout
  3  — usage error or missing feature
EOF
}

if [ -z "$SLUG" ] || [ "$SLUG" = "-h" ] || [ "$SLUG" = "--help" ]; then
  usage
  exit 3
fi

if ! sdlc_learning_validate_slug "$SLUG" "$CALLER"; then
  exit 3
fi

shift
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --full)
      # `--full` is documented in SPEC.md AC-004 as the default mode for
      # this wrapper. The wrapper itself never invokes an LLM — it only
      # builds the context bundle. `--full` is therefore a no-op alias
      # for "no flag"; the slash command (.claude/commands/feature-reflect.md)
      # is what consumes the bundle and dispatches synthesizer subagents.
      # Per ADV-FND-003 from the 2026-05-26 Phase-3 Codex adversary review.
      shift
      ;;
    *)
      printf 'scripts/feature-reflect: unknown arg: %s\n' "$1" >&2
      usage >&2
      exit 3
      ;;
  esac
done

DIR="docs/features/$SLUG"
if ! FEATURE_REAL=$(sdlc_learning_validate_feature_dir "$ROOT_REAL" "$DIR" "$CALLER"); then
  exit 3
fi

TIER="large"
SLICE_DIR=$(mktemp -d -t feature-reflect-slices-XXXXXX) || exit 5
LEARNING_LIST=$(mktemp -t feature-reflect-list-XXXXXX) || {
  rm -rf "$SLICE_DIR"
  exit 5
}
TMP_BUNDLE=""
cleanup_feature_reflect() {
  [ -n "$LEARNING_LIST" ] && rm -f "$LEARNING_LIST"
  [ -n "$TMP_BUNDLE" ] && rm -f "$TMP_BUNDLE"
  [ -n "$SLICE_DIR" ] && rm -rf "$SLICE_DIR"
}
trap cleanup_feature_reflect EXIT

if [ -e "$DIR/.tier" ] || [ -L "$DIR/.tier" ]; then
  TIER_SLICE="$SLICE_DIR/tier"
  if ! sdlc_learning_materialize_text_slice "$CALLER" "tier marker" \
    "$DIR/.tier" "$FEATURE_REAL" 32 0 "$TIER_SLICE" >/dev/null; then
    exit 3
  fi
  TIER=$(tr -d '[:space:]' < "$TIER_SLICE")
  case "$TIER" in
    small|medium|large) ;;
    *)
      printf 'scripts/feature-reflect: invalid tier marker: %s\n' "$DIR/.tier" >&2
      exit 3
      ;;
  esac
fi

# Pre-materialize every prompt-consumed feature input into a bounded, validated
# slice before creating reflect/. Append-only logs use tails; fixed contracts
# use bounded whole-file slices. Emission below reads only these staged slices.
FEATURE_PATHS=(
  "$DIR/FEATURE.md" "$DIR/SPEC.md" "$DIR/DESIGN.md" "$DIR/TASKS.md"
  "$DIR/EVIDENCE.md" "$DIR/FINDINGS.md" "$DIR/RUNS.md" "$DIR/STATE.md"
  "$DIR/DECISIONS.md" "$DIR/TRACEABILITY.md" "$DIR/AMENDMENTS.md"
  "$DIR/APPROVALS.md" "$DIR/RELEASE_GATES.md" "$DIR/QUESTIONS.md"
  "$DIR/LEARNINGS.md"
)
FEATURE_LABELS=(
  "FEATURE.md (small-tier)" "SPEC.md" "DESIGN.md" "TASKS.md"
  "EVIDENCE.md" "FINDINGS.md" "RUNS.md" "STATE.md"
  "DECISIONS.md" "TRACEABILITY.md" "AMENDMENTS.md"
  "APPROVALS.md" "RELEASE_GATES.md" "QUESTIONS.md" "LEARNINGS.md"
)
FEATURE_TAILS=(0 0 0 0 200 200 300 0 200 0 0 0 0 0 200)
FEATURE_STAGES=()
for input_index in "${!FEATURE_PATHS[@]}"; do
  input_path="${FEATURE_PATHS[$input_index]}"
  if [ -e "$input_path" ] || [ -L "$input_path" ]; then
    input_stage="$SLICE_DIR/feature-$input_index"
    if ! sdlc_learning_materialize_text_slice "$CALLER" \
      "included feature artifact" "$input_path" "$FEATURE_REAL" \
      "$SDLC_LEARNING_MAX_INCLUDED_BYTES" "${FEATURE_TAILS[$input_index]}" \
      "$input_stage" >/dev/null; then
      exit 3
    fi
    FEATURE_STAGES[$input_index]="$input_stage"
  else
    FEATURE_STAGES[$input_index]=""
  fi
done

LEARNING_PATHS=()
LEARNING_STAGES=()
if [ -e "$DIR/learnings" ] || [ -L "$DIR/learnings" ]; then
  if [ -L "$DIR/learnings" ] || [ ! -d "$DIR/learnings" ]; then
    printf 'scripts/feature-reflect: learnings must be a real directory inside the feature\n' >&2
    exit 3
  fi
  if find "$DIR/learnings" -type l -name '*.learning.md' ! -name '._*' -print -quit | grep -q .; then
    printf 'scripts/feature-reflect: symlinked learning captures are not allowed\n' >&2
    exit 3
  fi
  find "$DIR/learnings" -type f -name '*.learning.md' ! -name '._*' 2>/dev/null \
    | sort | tail -5 > "$LEARNING_LIST"
  learning_index=0
  while IFS= read -r learning_path; do
    [ -n "$learning_path" ] || continue
    if ! [[ "$learning_path" =~ ^[A-Za-z0-9._/-]+$ ]]; then
      printf 'scripts/feature-reflect: learning capture path contains unsafe metadata characters\n' >&2
      exit 3
    fi
    learning_stage="$SLICE_DIR/learning-$learning_index"
    if ! sdlc_learning_materialize_text_slice "$CALLER" "learning capture" \
      "$learning_path" "$FEATURE_REAL" "$SDLC_LEARNING_MAX_INCLUDED_BYTES" \
      120 "$learning_stage" >/dev/null; then
      exit 3
    fi
    LEARNING_PATHS[$learning_index]="$learning_path"
    LEARNING_STAGES[$learning_index]="$learning_stage"
    learning_index=$((learning_index + 1))
  done < "$LEARNING_LIST"
fi

FRAMEWORK_PATHS=(CLAUDE.md AGENTS.md docs/principles/README.md)
FRAMEWORK_STAGES=()
for framework_index in "${!FRAMEWORK_PATHS[@]}"; do
  framework_path="${FRAMEWORK_PATHS[$framework_index]}"
  if [ -e "$framework_path" ] || [ -L "$framework_path" ]; then
    framework_stage="$SLICE_DIR/framework-$framework_index"
    if ! sdlc_learning_materialize_text_slice "$CALLER" "framework artifact" \
      "$framework_path" "$ROOT_REAL" "$SDLC_LEARNING_MAX_INCLUDED_BYTES" \
      0 "$framework_stage" >/dev/null; then
      exit 3
    fi
    FRAMEWORK_STAGES[$framework_index]="$framework_stage"
  else
    FRAMEWORK_STAGES[$framework_index]=""
  fi
done
PRINCIPLE_PATHS=()
PRINCIPLE_STAGES=()
if [ -e docs/principles ] || [ -L docs/principles ]; then
  if [ -L docs/principles ] || [ ! -d docs/principles ]; then
    printf 'scripts/feature-reflect: docs/principles must be a real directory\n' >&2
    exit 3
  fi
  principle_index=0
  for principle_path in docs/principles/principle-*.md; do
    [ -e "$principle_path" ] || [ -L "$principle_path" ] || continue
    if ! [[ "$principle_path" =~ ^[A-Za-z0-9._/-]+$ ]]; then
      printf 'scripts/feature-reflect: principle path contains unsafe metadata characters\n' >&2
      exit 3
    fi
    principle_stage="$SLICE_DIR/principle-$principle_index"
    if ! sdlc_learning_materialize_text_slice "$CALLER" "principle artifact" \
      "$principle_path" "$ROOT_REAL" "$SDLC_LEARNING_MAX_INCLUDED_BYTES" \
      0 "$principle_stage" >/dev/null; then
      exit 3
    fi
    PRINCIPLE_PATHS[$principle_index]="$principle_path"
    PRINCIPLE_STAGES[$principle_index]="$principle_stage"
    principle_index=$((principle_index + 1))
  done
fi

TS=$(date -u +%Y-%m-%dT%H%M%SZ)
OUT_DIR="$DIR/reflect"
# Build in a temp file first so the sanitizer can refuse before the
# bundle lands at $OUT_FILE (and before any subagent consumes it).
TMP_BUNDLE=$(mktemp -t feature-reflect-XXXXXX) || exit 5

# Emit only a prevalidated staged slice; never reopen the source during bundle
# assembly. A positive tail-lines value records the deterministic slice bound.
emit_staged_file() {
  local label="$1"
  local display_path="$2"
  local staged_slice="$3"
  local tail_n="$4"
  [ -n "$staged_slice" ] && [ -f "$staged_slice" ] || return 0
  printf '== %s (%s) ==\n' "$label" "$display_path"
  if [ "$tail_n" -gt 0 ]; then
    printf '<!-- validated tail: last up to %s lines; maximum %s bytes -->\n' \
      "$tail_n" "$SDLC_LEARNING_MAX_INCLUDED_BYTES"
  fi
  cat "$staged_slice"
  printf '\n\n'
}

{
  printf '<!-- /feature-reflect context bundle -->\n'
  printf '<!-- Feature: %s -->\n' "$SLUG"
  printf '<!-- Tier: %s -->\n' "$TIER"
  printf '<!-- Generated: %s -->\n' "$TS"
  printf '<!-- Dry-run: %s -->\n\n' "$DRY_RUN"

  printf '== Feature directory listing ==\n'
  ( cd "$DIR" && ls -1 | grep -v '^\._' | sort )
  printf '\n\n'

  for input_index in "${!FEATURE_PATHS[@]}"; do
    emit_staged_file "${FEATURE_LABELS[$input_index]}" \
      "${FEATURE_PATHS[$input_index]}" "${FEATURE_STAGES[$input_index]:-}" \
      "${FEATURE_TAILS[$input_index]}"
  done

  if [ "${#LEARNING_PATHS[@]}" -gt 0 ]; then
    printf '== Learning capture artifacts (latest 5) ==\n'
    for learning_index in "${!LEARNING_PATHS[@]}"; do
      emit_staged_file "learning capture" "${LEARNING_PATHS[$learning_index]}" \
        "${LEARNING_STAGES[$learning_index]}" 120
    done
    printf '\n\n'
  fi

  # Framework-level context.
  printf '== Framework-level: docs/principles/ index ==\n'
  if [ -d docs/principles ]; then
    ls -1 docs/principles | sort
    printf '\n'
    [ -n "${FRAMEWORK_STAGES[2]:-}" ] && cat "${FRAMEWORK_STAGES[2]}"
  else
    printf '(docs/principles/ not yet present)\n'
  fi
  printf '\n\n'

  printf '== Framework-level: principle file index (frontmatter only) ==\n'
  if [ -d docs/principles ]; then
    for principle_index in "${!PRINCIPLE_PATHS[@]}"; do
      printf -- '--- %s ---\n' "${PRINCIPLE_PATHS[$principle_index]}"
      awk 'BEGIN{fm=0} /^---$/{fm++; print; if (fm==2) exit; next} fm==1{print}' \
        "${PRINCIPLE_STAGES[$principle_index]}"
      printf '\n'
    done
  else
    printf '(docs/principles/ not yet present)\n'
  fi
  printf '\n\n'

  emit_staged_file "CLAUDE.md (framework rules)" "CLAUDE.md" \
    "${FRAMEWORK_STAGES[0]:-}" 0
  emit_staged_file "AGENTS.md (framework overview)" "AGENTS.md" \
    "${FRAMEWORK_STAGES[1]:-}" 0
} > "$TMP_BUNDLE"

if ! sdlc_learning_validate_output_size "$CALLER" "reflection bundle" \
  "$TMP_BUNDLE" "$SDLC_REFLECT_MAX_BUNDLE_BYTES"; then
  exit 5
fi

# Per SEC-FND-002 from the PR security review: scan the assembled
# bundle BEFORE landing it at $OUT_FILE. If any sensitive pattern
# matches (secret / card / CVV / expiry / PII), refuse with exit 6 and
# leave no artifact behind. The trap above removes $TMP_BUNDLE on exit.
if ! sg_sanitize_scan_file "$TMP_BUNDLE"; then
  cat <<EOF >&2
scripts/feature-reflect: REFUSING to write context bundle.

The assembled bundle (SPEC / DESIGN / TASKS / EVIDENCE / FINDINGS /
LEARNINGS / learnings/*.learning.md / APPROVALS / RELEASE_GATES /
QUESTIONS / RUNS / STATE / DECISIONS / AMENDMENTS / TRACEABILITY /
CLAUDE.md / AGENTS.md / docs/principles/)
contains a sensitive-data pattern. The matched category + redacted
line is shown above (categories: secret-* | card-* | pii-*).

This is per SEC-FND-002 from the framework-v3 PR security review:
/feature-reflect feeds this bundle to reviewer subagents, so any
operator mistake elsewhere (sensitive value landed in EVIDENCE or
FINDINGS) would be replicated into prompt context. Refusing here.

Either:
  1. False positive: refine scripts/lib-sanitize.sh sg_sanitize_patterns().
  2. Real match: scrub the value from the offending feature file
     (typically EVIDENCE.md / FINDINGS.md / QUESTIONS.md), then re-run.
EOF
  exit 6
fi

if ! sdlc_learning_prepare_output_dir "$CALLER" "reflection output directory" \
  "$OUT_DIR" "$FEATURE_REAL" >/dev/null; then
  exit 5
fi
if ! OUT_FILE=$(sdlc_learning_atomic_publish "$CALLER" "$TMP_BUNDLE" \
  "$OUT_DIR" "$TS" "context.md"); then
  exit 5
fi
printf '%s\n' "$OUT_FILE"
rm -f "$LEARNING_LIST" "$TMP_BUNDLE"
LEARNING_LIST=""
TMP_BUNDLE=""
rm -rf "$SLICE_DIR"
SLICE_DIR=""
trap - EXIT
exit 0
