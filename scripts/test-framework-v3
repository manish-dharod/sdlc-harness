if printf '%s' "$ready_feedback_out" | grep -qF 'increment acceptance gate blocked' && \
   printf '%s' "$ready_feedback_out" | grep -qF 'unaccepted increment(s)'; then
  log_check "SHIP-INC-002" pass "feature-ready blocks unaccepted increments"
else
  log_check "SHIP-INC-002" fail "feature-ready increment gate missing: $(printf '%s' "$ready_feedback_out" | tail -20 | tr '\n' ' ')"
fi

reconcile_valid_out=$(scripts/feature-reconcile "$INC_FIXTURE_SLUG" 2>&1)
if printf '%s' "$reconcile_valid_out" | grep -qF 'Shippable increment sequencing' && \
   printf '%s' "$reconcile_valid_out" | grep -qF 'increment state valid'; then
  log_check "SHIP-INC-003" pass "feature-reconcile validates opted-in increment state"
else
  log_check "SHIP-INC-003" fail "reconcile increment section missing: $(printf '%s' "$reconcile_valid_out" | head -30 | tr '\n' ' ')"
fi

awk '
  !changed && /^- Status: Backlog$/ { print "- Status: Open"; changed=1; next }
  { print }
' "$INC_FIXTURE/TASKS.md" > "$INC_FIXTURE/TASKS.tmp"
mv "$INC_FIXTURE/TASKS.tmp" "$INC_FIXTURE/TASKS.md"
next_ahead_out=$(HYGIENE_BYPASS=1 scripts/feature-next-task "$INC_FIXTURE_SLUG" 2>&1)
