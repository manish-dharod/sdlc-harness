#!/usr/bin/env bash
# scripts/test-framework-v3 — verification harness for the
# example-feature-medium feature.
#
# Validates AC-001 through AC-007 plus AC-009 (/feature-why),
# AC-010 (/feature-arena), AC-011 (builder pre-review self-audit), and
# AC-012 (practical agentic intake/orchestration) from
# docs/features/example-feature-medium/SPEC.md.
# AC-008 (Codex adversary artifacts) is verified by inspecting
# EVIDENCE.md, not here.
#
# Usage:
#   scripts/test-framework-v3 [--verbose]
#
# Exit codes:
#   0  — all checks pass
#   1  — at least one check failed
#   3  — usage error
#
# AC-008 (Codex adversary review artifacts) is verified by inspecting
# EVIDENCE.md, not by this harness — it requires a network round-trip.

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 3

VERBOSE=0
if [ "${1:-}" = "--verbose" ]; then VERBOSE=1; fi

PASS=0
FAIL=0
SKIP=0
FAILED_ACS=""

# Detect whether we're running inside the sdlc-harness framework repo
# itself (in which case framework-self-checks like MIGRATING.md presence
# and plugin manifest apply) OR inside an adopter's project that
# imported the framework via template-clone (in which case those
# framework-self-checks must be skipped — adopters don't ship them).
#
# Detection: the .claude-plugin/plugin.json with name "sdlc-harness" is
# unique to the framework repo. So is docs/MIGRATING_v1.0_to_v1.1.md.
IS_FRAMEWORK_REPO=0
if [ -f .claude-plugin/plugin.json ] && grep -q '"name": *"sdlc-harness"' .claude-plugin/plugin.json 2>/dev/null; then
  IS_FRAMEWORK_REPO=1
fi
if [ -f docs/MIGRATING_v1.0_to_v1.1.md ]; then
  IS_FRAMEWORK_REPO=1
fi

# Detect whether the example-feature / example-feature-medium fixtures
# exist (the harness uses them for fixture-dependent tests of
# scripts/feature-{reflect,why,arena,reconcile}). Adopters typically
# don't ship them — that's why those tests are guarded.
HAS_EXAMPLE_FEATURE=0
[ -d docs/features/example-feature ] && HAS_EXAMPLE_FEATURE=1
HAS_EXAMPLE_FEATURE_MEDIUM=0
[ -d docs/features/example-feature-medium ] && HAS_EXAMPLE_FEATURE_MEDIUM=1

# log <ac-id> <result> <message>
log_check() {
  local ac="$1"
  local result="$2"
  local msg="${3:-}"
  if [ "$result" = "pass" ]; then
    PASS=$((PASS + 1))
    [ "$VERBOSE" = "1" ] && printf '  PASS [%s] %s\n' "$ac" "$msg"
  elif [ "$result" = "fail" ]; then
    FAIL=$((FAIL + 1))
    FAILED_ACS="$FAILED_ACS $ac"
    printf '  FAIL [%s] %s\n' "$ac" "$msg" >&2
  elif [ "$result" = "skip" ]; then
    SKIP=$((SKIP + 1))
    [ "$VERBOSE" = "1" ] && printf '  SKIP [%s] %s\n' "$ac" "$msg"
  fi
}

# require_file <ac-id> <path> <description>
require_file() {
  local ac="$1"
  local path="$2"
  local desc="$3"
  if [ -f "$path" ]; then
    log_check "$ac" pass "$desc — $path"
  else
    log_check "$ac" fail "missing $desc — $path"
  fi
}

# --------------------------------------------------------------------------
# AC-001: docs/principles/ exists with the agreed initial set
# --------------------------------------------------------------------------
printf '== AC-001: principles directory + 7 principle files + valid frontmatter ==\n'

require_file "AC-001" "docs/principles/README.md" "principles README index"

REQUIRED_PRINCIPLES=(
  "principle-encode-lessons-in-structure"
  "principle-prove-it-works"
  "principle-fix-root-causes"
  "principle-boundary-discipline"
  "principle-no-sensitive-domain-data"
  "principle-preserve-domain-invariants"
  "principle-no-production-deploys-from-loop"
)

for p in "${REQUIRED_PRINCIPLES[@]}"; do
  path="docs/principles/${p}.md"
  if [ ! -f "$path" ]; then
    log_check "AC-001" fail "missing principle file: $path"
    continue
  fi

  # frontmatter sanity: starts with ---, has a name: line and a description: line,
  # closes with ---
  has_open=$(head -1 "$path")
  if [ "$has_open" != "---" ]; then
    log_check "AC-001" fail "$path: missing opening --- delimiter"
    continue
  fi
  if ! awk 'BEGIN{fm=0} /^---$/{fm++; if (fm==2) exit} fm==1 && /^name:/{has_name=1} END{exit !has_name}' "$path"; then
    log_check "AC-001" fail "$path: missing 'name:' in frontmatter"
    continue
  fi
  if ! awk 'BEGIN{fm=0} /^---$/{fm++; if (fm==2) exit} fm==1 && /^description:/{has_desc=1} END{exit !has_desc}' "$path"; then
    log_check "AC-001" fail "$path: missing 'description:' in frontmatter"
    continue
  fi

  # body length 30-130 lines total (per AC-001 + TDEC-003)
  total=$(wc -l < "$path" | tr -d '[:space:]')
  if [ "$total" -lt 30 ] || [ "$total" -gt 130 ]; then
    log_check "AC-001" fail "$path: total lines $total out of bounds [30, 130]"
    continue
  fi

  log_check "AC-001" pass "$path: frontmatter OK, $total lines"
done

# --------------------------------------------------------------------------
# AC-002: the meta-principle is callable by name (link resolves)
# AC-007(b): every [[principle-*]] wiki-link in scanned docs resolves to a
# real file. Per ADV-FND-001 of the 2026-05-26 implementation adversary
# pass: the original check only inspected the meta-principle file; the
# generic wikilink resolver below closes that false-confidence gap.
# --------------------------------------------------------------------------
printf '\n== AC-002: meta-principle resolvable by name + AC-007(b) wikilink resolver ==\n'

META="docs/principles/principle-encode-lessons-in-structure.md"
if [ ! -f "$META" ]; then
  log_check "AC-002" fail "meta-principle file missing: $META"
else
  log_check "AC-002" pass "meta-principle resolves: $META"
fi

if grep -q 'principle-encode-lessons-in-structure' docs/principles/README.md 2>/dev/null; then
  log_check "AC-002" pass "README index references the meta-principle"
else
  log_check "AC-002" fail "README index does not reference principle-encode-lessons-in-structure"
fi

# AC-007(b): scan all framework files that may cite a principle for
# [[principle-*]] wiki-links. Every named principle must resolve to a
# docs/principles/<name>.md file. A broken or typo'd link is a
# P1-equivalent harness failure — the whole point of the principles
# layer is to be reliably citable by name.
#
# Scope (expanded in Phase 3 of framework-v3 when sg-* agents started
# citing principles directly): role-agent prompts and slash-command
# files are first-class citation surfaces and must be scanned too.
SCAN_PATHS="docs/principles CLAUDE.md AGENTS.md .claude/agents .claude/commands"
for sp in $SCAN_PATHS; do
  [ -e "$sp" ] || continue
  # Collect all referenced principle slugs.
  while IFS=: read -r linkfile linkline slug; do
    [ -z "$slug" ] && continue
    target="docs/principles/${slug}.md"
    if [ -f "$target" ]; then
      log_check "AC-002" pass "wikilink $linkfile:$linkline → [[${slug}]] resolves to $target"
    else
      log_check "AC-002" fail "wikilink $linkfile:$linkline → [[${slug}]] does NOT resolve (no $target)"
    fi
  done < <(grep -rHnEo '\[\[principle-[a-z0-9-]+\]\]' "$sp" 2>/dev/null \
             | sed -E 's/^([^:]+):([0-9]+):\[\[(principle-[a-z0-9-]+)\]\]$/\1:\2:\3/')
done

# AC-007(b) negative-path probe: a synthetic unresolved-link fixture
# would fail. We don't actually create a real fixture (would dirty the
# repo); instead we sanity-check the resolver logic by ensuring at least
# one wikilink was scanned in the first place. A harness that runs the
# resolver but never finds a single link to check would falsely pass.
SCANNED_COUNT=$(grep -rEoh '\[\[principle-[a-z0-9-]+\]\]' $SCAN_PATHS 2>/dev/null | wc -l | tr -d '[:space:]')
if [ "$SCANNED_COUNT" -lt 1 ]; then
  log_check "AC-002" fail "wikilink resolver scanned zero [[principle-*]] links across $SCAN_PATHS — resolver has nothing to validate"
else
  log_check "AC-002" pass "wikilink resolver examined $SCANNED_COUNT [[principle-*]] reference(s) across scanned paths"
fi

# --------------------------------------------------------------------------
# AC-003: /feature-reflect slash command exists with required sections
# --------------------------------------------------------------------------
printf '\n== AC-003: /feature-reflect slash command file present + structured ==\n'

CMD_FILE=".claude/commands/feature-reflect.md"
require_file "AC-003" "$CMD_FILE" "slash command file"

if [ -f "$CMD_FILE" ]; then
  for section in "Safety boundary" "Steps" "Step 0 — Gather context" "Step 1 — Dispatch three reviewer subagents" "Step 2 — Synthesize" "Step 3 — Present to user" "Step 4 — Apply approved items" "Step 5 — Record the reflect run"; do
    if grep -qF "$section" "$CMD_FILE"; then
      log_check "AC-003" pass "section present: $section"
    else
      log_check "AC-003" fail "section missing: $section"
    fi
  done
fi

# --------------------------------------------------------------------------
# AC-004: scripts/feature-reflect deterministic wrapper
# --------------------------------------------------------------------------
printf '\n== AC-004: scripts/feature-reflect exit codes + context artifact ==\n'

if [ ! -x scripts/feature-reflect ]; then
  log_check "AC-004" fail "scripts/feature-reflect not executable"
else
  log_check "AC-004" pass "scripts/feature-reflect is executable"

  if [ "$HAS_EXAMPLE_FEATURE" = "1" ]; then
    # Happy path: real feature → exit 0 + prints artifact path
    out=$(scripts/feature-reflect example-feature --dry-run 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && [ -f "$out" ]; then
      log_check "AC-004" pass "happy-path run exits 0 and writes $out"
    else
      log_check "AC-004" fail "happy-path run failed (rc=$rc, out='$out')"
    fi

    # Per ADV-FND-003 from Phase-3 Codex review: SPEC documents `--full`
    # as a mode; the script must accept it (as a no-op alias for the
    # default LLM-less context-gathering behavior).
    out_full=$(scripts/feature-reflect example-feature --full 2>/dev/null)
    rc_full=$?
    if [ "$rc_full" -eq 0 ] && [ -f "$out_full" ]; then
      log_check "AC-004" pass "--full mode (documented in SPEC AC-004) exits 0 and writes $out_full"
    else
      log_check "AC-004" fail "--full mode failed (rc=$rc_full)"
    fi
  else
    log_check "AC-004" skip "happy-path / --full mode tests need example-feature fixture (not present in adopter projects by default)"
  fi

  # Missing feature: exit 3 (this test doesn't need a fixture — it tests the absent-feature error path)
  scripts/feature-reflect nonexistent-fake-slug > /dev/null 2>&1
  rc=$?
  if [ "$rc" -eq 3 ]; then
    log_check "AC-004" pass "missing-feature run exits 3 as expected"
  else
    log_check "AC-004" fail "missing-feature run returned $rc (expected 3)"
  fi

  # Usage error: no args
  scripts/feature-reflect > /dev/null 2>&1
  rc=$?
  if [ "$rc" -eq 3 ]; then
    log_check "AC-004" pass "no-args usage exits 3 as expected"
  else
    log_check "AC-004" fail "no-args usage returned $rc (expected 3)"
  fi

  if [ "$HAS_EXAMPLE_FEATURE" = "1" ]; then
    # Idempotency (NFR-002 / AC-007e):
    # Two consecutive runs differ only in the timestamp comment + filename.
    # We forcibly sleep 1 second between runs to ensure different timestamps.
    out1=$(scripts/feature-reflect example-feature --dry-run 2>/dev/null)
    sleep 1
    out2=$(scripts/feature-reflect example-feature --dry-run 2>/dev/null)
    if [ ! -f "$out1" ] || [ ! -f "$out2" ]; then
      log_check "AC-004" fail "idempotency probe: one of the artifacts missing"
    elif [ "$out1" = "$out2" ]; then
      log_check "AC-004" fail "idempotency probe: timestamps collided ($out1 = $out2); harness needs longer sleep"
    else
      # Diff after stripping the Generated comment line.
      if diff <(grep -v '^<!-- Generated:' "$out1") <(grep -v '^<!-- Generated:' "$out2") > /dev/null 2>&1; then
        log_check "AC-004" pass "idempotency: two consecutive runs differ only in Generated timestamp"
      else
        log_check "AC-004" fail "idempotency: artifacts differ beyond the timestamp"
      fi
    fi
  else
    log_check "AC-004" skip "idempotency probe needs example-feature fixture"
  fi
fi

# --------------------------------------------------------------------------
# AC-005: structural-enforcement check is the keystone (semantic, by grep)
# --------------------------------------------------------------------------
printf '\n== AC-005: synthesizer prompt names the structural-enforcement pass ==\n'

if [ -f "$CMD_FILE" ]; then
  if grep -qiE 'structural[- ]enforcement (check|pass)' "$CMD_FILE"; then
    log_check "AC-005" pass "structural-enforcement check named in command file"
  else
    log_check "AC-005" fail "structural-enforcement check not named in command file"
  fi

  if grep -qF 'encode-in-structure' "$CMD_FILE"; then
    log_check "AC-005" pass "encode-in-structure routing tag named"
  else
    log_check "AC-005" fail "encode-in-structure routing tag missing"
  fi

  if grep -qF 'principle-encode-lessons-in-structure' "$CMD_FILE"; then
    log_check "AC-005" pass "meta-principle cited in command file"
  else
    log_check "AC-005" fail "meta-principle not cited in command file"
  fi

  # AC-005 Then-clause: the slash command MUST emit both pre- and
  # post-enforcement Accepted lists so a reviewer can audit what was
  # re-routed by the structural-enforcement pass. Per ADV-FND-001 from
  # the Phase-3 Codex adversary review: the original check only grepped
  # for terms; this asserts the actual contract.
  if grep -qF 'Pre-enforcement Accepted' "$CMD_FILE"; then
    log_check "AC-005" pass "Pre-enforcement Accepted section required by synth prompt"
  else
    log_check "AC-005" fail "Pre-enforcement Accepted section not required by synth prompt"
  fi

  if grep -qF 'Post-enforcement Accepted' "$CMD_FILE"; then
    log_check "AC-005" pass "Post-enforcement Accepted section required by synth prompt"
  else
    log_check "AC-005" fail "Post-enforcement Accepted section not required by synth prompt"
  fi

  if grep -qiE 'side by side|side-by-side' "$CMD_FILE"; then
    log_check "AC-005" pass "side-by-side framing present (pre/post comparability)"
  else
    log_check "AC-005" fail "side-by-side framing missing (pre/post lists not visibly comparable)"
  fi
fi

# --------------------------------------------------------------------------
# AC-006: human approval gate is mandatory (semantic, by grep)
# --------------------------------------------------------------------------
printf '\n== AC-006: approval gate enforced in command file ==\n'

if [ -f "$CMD_FILE" ]; then
  if grep -qiF 'auto-apply is forbidden' "$CMD_FILE"; then
    log_check "AC-006" pass "auto-apply explicitly forbidden"
  else
    log_check "AC-006" fail "auto-apply not explicitly forbidden"
  fi

  if grep -qiE 'approval gate|approval[- ]gated|wait for explicit approval|AskUserQuestion' "$CMD_FILE"; then
    log_check "AC-006" pass "approval gate language present"
  else
    log_check "AC-006" fail "approval gate language missing"
  fi
fi

# --------------------------------------------------------------------------
# Phase 4: per-task-type artifact requirements (scripts/feature-reconcile)
# --------------------------------------------------------------------------
printf '\n== Phase 4: per-task-type artifact check in scripts/feature-reconcile ==\n'

if [ -f scripts/feature-reconcile ]; then
  for marker in 'Per-task-type artifact requirements' \
                'Type: bug' 'Type: perf' 'Type: ui' 'Type: migration' \
                'Repro pre-fix:' 'Baseline:' 'Before:' 'Backfill evidence:'; do
    if grep -qF "$marker" scripts/feature-reconcile; then
      log_check "AC-007" pass "feature-reconcile knows about: $marker"
    else
      log_check "AC-007" fail "feature-reconcile missing marker: $marker"
    fi
  done

  # Functional smoke fixtures: prove the large-tier "no typed Done tasks"
  # path and medium-tier advisory skip without depending on optional
  # example-feature directories being present in the repo checkout.
  reconcile_large_smoke="docs/features/_test-fixture-reconcile-large-smoke"
  reconcile_medium_smoke="docs/features/_test-fixture-reconcile-medium-smoke"
  cleanup_reconcile_smoke() {
    rm -rf "$reconcile_large_smoke" "$reconcile_medium_smoke"
  }
  cleanup_reconcile_smoke
  trap cleanup_reconcile_smoke EXIT

  for f in "$reconcile_large_smoke" "$reconcile_medium_smoke"; do
    mkdir -p "$f"
    cat > "$f/STATE.md" <<'EOF'
```yaml
verdict: implementation
open_tasks: 1
claimed_tasks: 0
blocked_tasks: 0
open_p0: 0
open_p1: 0
ac_total: 1
ac_passing: 1
nfr_total: 0
nfr_passing: 0
```
EOF
    cat > "$f/TASKS.md" <<'EOF'
# Feature Task Queue

### TASK-001: Smoke fixture task

- Status: Open
- AC IDs: AC-001
- Risk: low
- Owner/session: test-fixture
EOF
    cat > "$f/TRACEABILITY.md" <<'EOF'
AC total: 1
AC with passing tests: 1
NFR total: 0
NFR measured and passing: 0
EOF
    : > "$f/FINDINGS.md"
    : > "$f/EVIDENCE.md"
  done
  printf 'large' > "$reconcile_large_smoke/.tier"
  printf 'medium' > "$reconcile_medium_smoke/.tier"

  large_out=$(scripts/feature-reconcile _test-fixture-reconcile-large-smoke 2>&1)
  if printf '%s' "$large_out" | grep -qF 'no Done tasks with declared Type'; then
    log_check "AC-007" pass "reconcile per-type on large tier without typed tasks → OK row"
  else
    log_check "AC-007" fail "reconcile per-type on large tier did not emit 'no Done tasks with declared Type'"
  fi

  med_out=$(scripts/feature-reconcile _test-fixture-reconcile-medium-smoke 2>&1)
  if printf '%s' "$med_out" | grep -qF 'INFO: skipped — tier=medium; per-task-type artifact gate'; then
    log_check "AC-007" pass "reconcile per-type on medium tier → INFO skip (not DRIFT)"
  else
    log_check "AC-007" fail "reconcile per-type on medium tier did not emit the medium-tier INFO skip line"
  fi

  cleanup_reconcile_smoke
  trap - EXIT

  # Static check: all 3 templates document the Type: field.
  # We use `-- '- Type:'` so a leading dash isn't parsed as a flag by
  # ugrep (which the user has aliased to grep).
  for tpl in docs/features/_template/TASKS.md docs/features/_template-medium/TASKS.md docs/features/_template-small/FEATURE.md; do
    if grep -qF -- '- Type:' "$tpl"; then
      log_check "AC-007" pass "$tpl declares the Type: field"
    else
      log_check "AC-007" fail "$tpl missing Type: field declaration"
    fi
  done

  # Static check: large-tier EVIDENCE template documents artifact shapes
  for marker in 'Type: bug — failing-then-passing repro' \
                'Type: perf — baseline / post / delta / trace' \
                'Type: ui — before / after screenshots' \
                'Type: migration — backfill + rollback evidence'; do
    if grep -qF "$marker" docs/features/_template/EVIDENCE.md; then
      log_check "AC-007" pass "EVIDENCE template documents: $marker"
    else
      log_check "AC-007" fail "EVIDENCE template missing: $marker"
    fi
  done

  # ------------------------------------------------------------------
  # Phase 4 positive + negative FIXTURE tests (added per ADV-FND-004
  # from the Phase-4 Codex adversary review). The static marker checks
  # above prove the script *contains* the gate; these tests prove the
  # gate actually FIRES on typed Done tasks.
  #
  # We create disposable fixture feature dirs under docs/features/ with
  # a `_test-fixture-` prefix (gitignored), run reconcile, verify the
  # expected drift / pass behavior, then clean up.
  # ------------------------------------------------------------------

  fixture_pass="docs/features/_test-fixture-typed-bug-pass"
  fixture_fail="docs/features/_test-fixture-typed-bug-fail"

  cleanup_fixtures() {
    rm -rf "$fixture_pass" "$fixture_fail"
  }
  # Make sure stale fixtures from prior failed runs don't poison the test.
  cleanup_fixtures
  trap cleanup_fixtures EXIT

  mkdir -p "$fixture_pass" "$fixture_fail"
  printf 'large' > "$fixture_pass/.tier"
  printf 'large' > "$fixture_fail/.tier"

  # Both fixtures need the file set the script touches. We populate the
  # minimum: STATE.md, TASKS.md, EVIDENCE.md, FINDINGS.md, TRACEABILITY.md.
  for f in "$fixture_pass" "$fixture_fail"; do
    cat > "$f/STATE.md" <<EOF
\`\`\`yaml
verdict: implementation
open_tasks: 0
claimed_tasks: 0
blocked_tasks: 0
open_p0: 0
open_p1: 0
ac_total: 1
ac_passing: 1
nfr_total: 0
nfr_passing: 0
\`\`\`
EOF
    cat > "$f/TRACEABILITY.md" <<EOF
| AC | Test | Status |
|---|---|---|
| AC-001 | tests/fixture | Passing |
EOF
    : > "$f/FINDINGS.md"
  done

  # Use the dated-Done convention (Done (YYYY-MM-DD)) to also exercise
  # the ADV-FND-001 regex fix.
  cat > "$fixture_pass/TASKS.md" <<'EOF'
# Feature Task Queue

### TASK-001: Pass fixture (typed bug with repro)

- Status: Done (2026-05-26)
- AC IDs: AC-001
- Type: bug
- Owner/session: test-fixture
EOF

  cat > "$fixture_pass/EVIDENCE.md" <<'EOF'
# Feature Evidence Log

## 2026-05-26 - Bug fix evidence: TASK-001

- Task: TASK-001
- Type: bug
- Repro pre-fix:
  - Command: pytest tests/fixture.py::test_foo
  - Output: AssertionError: expected 1 got 0
- Repro post-fix:
  - Command: pytest tests/fixture.py::test_foo
  - Output: . ok
EOF

  cat > "$fixture_fail/TASKS.md" <<'EOF'
# Feature Task Queue

### TASK-001: Fail fixture (typed bug without repro)

- Status: Done (2026-05-26)
- AC IDs: AC-001
- Type: bug
- Owner/session: test-fixture
EOF

  cat > "$fixture_fail/EVIDENCE.md" <<'EOF'
# Feature Evidence Log

## 2026-05-26 - Generic evidence: TASK-001

- Task: TASK-001
- Type: bug
- Notes: someone forgot to capture the repro
EOF

  pass_out=$(scripts/feature-reconcile _test-fixture-typed-bug-pass 2>&1)
  pass_exit=$?
  fail_out=$(scripts/feature-reconcile _test-fixture-typed-bug-fail 2>&1)
  fail_exit=$?

  # Positive fixture: typed Done with proper repro markers in its block.
  if printf '%s' "$pass_out" | grep -qF 'TASK-001 (Type: bug) — failing-then-passing repro recorded in task block'; then
    log_check "AC-007" pass "positive fixture: typed Done (dated) with proper repro passes the gate"
  else
    log_check "AC-007" fail "positive fixture should pass; got: $(printf '%s' "$pass_out" | grep -E 'TASK-001|Type: bug')"
  fi

  # Negative fixture: typed Done WITHOUT repro markers → DRIFT.
  if printf '%s' "$fail_out" | grep -qF 'TASK-001 (Type: bug) Done — EVIDENCE.md task block missing failing-then-passing repro'; then
    log_check "AC-007" pass "negative fixture: typed Done (dated) missing repro is flagged as DRIFT"
  else
    log_check "AC-007" fail "negative fixture should drift on missing repro; reconcile output did not flag it"
  fi

  # Dated-Done detection (ADV-FND-001 fix): both fixtures used 'Done (2026-05-26)'.
  # The fact that both fixtures were even considered by the per-type
  # walker proves the regex fix took. A naive `status == "Done"` parser
  # would have skipped both. So if either of the two assertions above
  # passed, the dated-Done parser worked.
  if printf '%s' "$pass_out" | grep -qF 'Type: bug' || \
     printf '%s' "$fail_out" | grep -qF 'Type: bug'; then
    log_check "AC-007" pass "dated 'Done (YYYY-MM-DD)' status reaches the per-type artifact walker"
  else
    log_check "AC-007" fail "dated Done status appears to bypass the per-type walker"
  fi

  cleanup_fixtures
  trap - EXIT
else
  log_check "AC-007" fail "scripts/feature-reconcile missing"
fi

# --------------------------------------------------------------------------
# Phase 4b: builder pre-review self-audit gate (scripts/feature-reconcile)
# --------------------------------------------------------------------------
printf '\n== Phase 4b: pre-review self-audit check in scripts/feature-reconcile ==\n'

if [ -f scripts/feature-reconcile ]; then
  for marker in 'Pre-review self-audit evidence' \
                'Plausible miss 1:[[:space:]]*[^[:space:]]' \
                'Plausible miss 2:[[:space:]]*[^[:space:]]' \
                'Plausible miss 3:[[:space:]]*[^[:space:]]' \
                'SELF_AUDIT_CUTOFF_DATE' 'missing Type' 'missing Claimed at' \
                '[^A-Za-z0-9_-]'; do
    if grep -qF "$marker" scripts/feature-reconcile; then
      log_check "AC-011" pass "feature-reconcile enforces self-audit marker: $marker"
    else
      log_check "AC-011" fail "feature-reconcile missing self-audit marker: $marker"
    fi
  done

  for marker in 'Pre-review self-audit' 'Plausible miss 1' 'Plausible miss 2' 'Plausible miss 3'; do
    if grep -qF "$marker" docs/features/_template/EVIDENCE.md && \
       grep -qF "$marker" docs/features/_template-medium/EVIDENCE.md && \
       grep -qF "$marker" docs/features/_template-small/FEATURE.md; then
      log_check "AC-011" pass "templates document self-audit marker: $marker"
    else
      log_check "AC-011" fail "templates missing self-audit marker: $marker"
    fi
  done

  self_audit_pass="docs/features/_test-fixture-self-audit-pass"
  self_audit_missing_fail="docs/features/_test-fixture-self-audit-missing-fail"
  self_audit_malformed_fail="docs/features/_test-fixture-self-audit-malformed-fail"
  self_audit_untyped_fail="docs/features/_test-fixture-self-audit-untyped-fail"
  self_audit_suffix_fail="docs/features/_test-fixture-self-audit-suffix-fail"

  cleanup_self_audit_fixtures() {
    rm -rf "$self_audit_pass" "$self_audit_missing_fail" "$self_audit_malformed_fail" "$self_audit_untyped_fail" "$self_audit_suffix_fail"
  }
  cleanup_self_audit_fixtures
  trap cleanup_self_audit_fixtures EXIT

  mkdir -p "$self_audit_pass" "$self_audit_missing_fail" "$self_audit_malformed_fail" "$self_audit_untyped_fail" "$self_audit_suffix_fail"
  for f in "$self_audit_pass" "$self_audit_missing_fail" "$self_audit_malformed_fail" "$self_audit_untyped_fail" "$self_audit_suffix_fail"; do
    printf 'large' > "$f/.tier"
    cat > "$f/STATE.md" <<EOF
\`\`\`yaml
verdict: implementation
open_tasks: 0
claimed_tasks: 0
blocked_tasks: 0
open_p0: 0
open_p1: 0
ac_total: 1
ac_passing: 1
nfr_total: 0
nfr_passing: 0
\`\`\`
EOF
    cat > "$f/TRACEABILITY.md" <<EOF
| AC | Test | Status |
|---|---|---|
| AC-001 | tests/fixture | Passing |
EOF
    : > "$f/FINDINGS.md"
    printf 'TASK-001\nTASK-107\nTASK-107b\n' > "$f/.adversarial-exempt"
  done

  cat > "$self_audit_pass/TASKS.md" <<'EOF'
# Feature Task Queue

### TASK-001: Pass fixture (typed feature with self-audit)

- Status: Review
- AC IDs: AC-001
- Type: feature
- Owner/session: test-fixture
- Claimed at: 2026-06-01
EOF

  cat > "$self_audit_pass/EVIDENCE.md" <<'EOF'
# Feature Evidence Log

## 2026-06-01 - Pre-review self-audit: TASK-001

- Task: TASK-001
- Source: builder
- Plausible miss 1: The reconcile parser could skip Review status.
  - Check: Ran fixture with `Status: Review`.
- Plausible miss 2: The markers could be satisfied globally instead of task-scoped.
  - Check: Markers live inside this TASK-001 block.
- Plausible miss 3: The check count could accept fewer than three concrete checks.
  - Check: Recorded one check for each plausible miss.
EOF

  cat > "$self_audit_missing_fail/TASKS.md" <<'EOF'
# Feature Task Queue

### TASK-001: Missing self-audit fail fixture

- Status: Review
- AC IDs: AC-001
- Type: feature
- Owner/session: test-fixture
- Claimed at: 2026-06-01
EOF

  cat > "$self_audit_missing_fail/EVIDENCE.md" <<'EOF'
# Feature Evidence Log

## 2026-06-01 - Generic evidence: TASK-001

- Task: TASK-001
- Notes: someone forgot the pre-review self-audit
EOF

  cat > "$self_audit_malformed_fail/TASKS.md" <<'EOF'
# Feature Task Queue

### TASK-001: Malformed self-audit fail fixture

- Status: Done
- AC IDs: AC-001
- Type: feature
- Owner/session: test-fixture
- Claimed at: 2026-06-01
EOF

  cat > "$self_audit_malformed_fail/EVIDENCE.md" <<'EOF'
# Feature Evidence Log

## 2026-06-01 - Pre-review self-audit: TASK-001

- Task: TASK-001
- Source: builder
- Plausible miss 1:
  - Check: Has content but the miss description is blank.
- Plausible miss 2: Empty check markers could satisfy the parser.
  - Check:
- Plausible miss 3: All checks could live under one miss.
  - Result: malformed
EOF

  cat > "$self_audit_untyped_fail/TASKS.md" <<'EOF'
# Feature Task Queue

### TASK-001: Untyped fail fixture

- Status: Done
- AC IDs: AC-001
- Owner/session: test-fixture
EOF

  cat > "$self_audit_untyped_fail/EVIDENCE.md" <<'EOF'
# Feature Evidence Log

## 2026-06-01 - Generic evidence: TASK-001

- Task: TASK-001
- Notes: missing Type plus missing Claimed at should drift.
EOF

  cat > "$self_audit_suffix_fail/TASKS.md" <<'EOF'
# Feature Task Queue

### TASK-107: Suffix-collision base task

- Status: Done
- AC IDs: AC-001
- Type: feature
- Owner/session: test-fixture
- Claimed at: 2026-06-01

### TASK-107b: Suffix task with valid self-audit

- Status: Done
- AC IDs: AC-001
- Type: feature
- Owner/session: test-fixture
- Claimed at: 2026-06-01
EOF

  cat > "$self_audit_suffix_fail/EVIDENCE.md" <<'EOF'
# Feature Evidence Log

## 2026-06-01 - Pre-review self-audit: TASK-107b

- Task: TASK-107b
- Source: builder
- Plausible miss 1: Exact task matching could accept suffix IDs.
  - Check: This block belongs only to TASK-107b.
- Plausible miss 2: TASK-107 could falsely borrow TASK-107b evidence.
  - Check: TASK-107 intentionally has no self-audit block.
- Plausible miss 3: The extractor needs an alphanumeric boundary.
  - Check: TASK-107b suffix exercises the boundary.
EOF

  self_audit_pass_out=$(scripts/feature-reconcile _test-fixture-self-audit-pass 2>&1)
  self_audit_missing_fail_out=$(scripts/feature-reconcile _test-fixture-self-audit-missing-fail 2>&1)
  self_audit_malformed_fail_out=$(scripts/feature-reconcile _test-fixture-self-audit-malformed-fail 2>&1)
  self_audit_untyped_fail_out=$(scripts/feature-reconcile _test-fixture-self-audit-untyped-fail 2>&1)
  self_audit_suffix_fail_out=$(scripts/feature-reconcile _test-fixture-self-audit-suffix-fail 2>&1)

  if printf '%s' "$self_audit_pass_out" | grep -qF 'TASK-001 (Review, Type: feature) — pre-review self-audit recorded in task block'; then
    log_check "AC-011" pass "positive fixture: Review typed feature with self-audit passes the gate"
  else
    log_check "AC-011" fail "positive self-audit fixture should pass"
  fi

  if printf '%s' "$self_audit_missing_fail_out" | grep -qF 'TASK-001 (Review, Type: feature) — EVIDENCE.md task block missing pre-review self-audit'; then
    log_check "AC-011" pass "negative fixture: missing self-audit is flagged as DRIFT"
  else
    log_check "AC-011" fail "missing self-audit fixture should drift"
  fi

  if printf '%s' "$self_audit_malformed_fail_out" | grep -qF 'TASK-001 (Done, Type: feature) — EVIDENCE.md task block missing pre-review self-audit'; then
    log_check "AC-011" pass "negative fixture: malformed self-audit is flagged as DRIFT"
  else
    log_check "AC-011" fail "malformed self-audit fixture should drift"
  fi

  if printf '%s' "$self_audit_untyped_fail_out" | grep -qF 'TASK-001 (Done) — missing Type and missing Claimed at'; then
    log_check "AC-011" pass "negative fixture: missing Type plus missing Claimed at is flagged as DRIFT"
  else
    log_check "AC-011" fail "untyped unknown-date fixture should drift"
  fi

  if printf '%s' "$self_audit_suffix_fail_out" | grep -qF 'TASK-107 (Done, Type: feature) — EVIDENCE.md task block missing pre-review self-audit' && \
     printf '%s' "$self_audit_suffix_fail_out" | grep -qF 'TASK-107b (Done, Type: feature) — pre-review self-audit recorded in task block'; then
    log_check "AC-011" pass "negative fixture: TASK-107 does not borrow TASK-107b self-audit evidence"
  else
    log_check "AC-011" fail "suffix collision fixture should drift TASK-107 while accepting TASK-107b"
  fi

  cleanup_self_audit_fixtures
  trap - EXIT
else
  log_check "AC-011" fail "scripts/feature-reconcile missing"
fi

