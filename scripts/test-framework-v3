printf '\n== Phase 5: /feature-why command + scripts/feature-why (AC-009) ==\n'

WHY_CMD=".claude/commands/feature-why.md"
WHY_SCRIPT="scripts/feature-why"

if [ -f "$WHY_CMD" ]; then
  log_check "AC-009" pass "$WHY_CMD present"
  for section in 'Operating posture' 'Step 0 — Gather context' 'Step 1 — Enumerate evidence categories' 'Step 2 — Dispatch parallel investigators' 'Step 3 — Synthesize' 'Step 4 — Present' 'When planner (Phase: intake) invokes this command'; do
    if grep -qF "$section" "$WHY_CMD"; then
      log_check "AC-009" pass "feature-why command has section: $section"
    else
      log_check "AC-009" fail "feature-why command missing section: $section"
    fi
  done

  # Epistemic discipline must be explicit in the command file
  for marker in 'null results are first-class evidence' 'every claim has a citation' 'appears to' 'over "because"'; do
    if grep -qiF "$marker" "$WHY_CMD"; then
      log_check "AC-009" pass "feature-why epistemic discipline: '$marker'"
    else
      log_check "AC-009" fail "feature-why epistemic discipline missing: '$marker'"
    fi
  done
else
  log_check "AC-009" fail "$WHY_CMD missing"
fi

if [ -x "$WHY_SCRIPT" ]; then
  log_check "AC-009" pass "$WHY_SCRIPT is executable"

  # Usage: no args → exit 3
  "$WHY_SCRIPT" > /dev/null 2>&1
  if [ $? -eq 3 ]; then
    log_check "AC-009" pass "feature-why: no-args usage exits 3"
  else
    log_check "AC-009" fail "feature-why: no-args usage did not exit 3"
  fi

  # Missing feature → exit 3
  "$WHY_SCRIPT" nonexistent-fake-slug "test" > /dev/null 2>&1
  if [ $? -eq 3 ]; then
    log_check "AC-009" pass "feature-why: missing-feature exits 3"
  else
    log_check "AC-009" fail "feature-why: missing-feature did not exit 3"
  fi

  if [ "$HAS_EXAMPLE_FEATURE_MEDIUM" = "1" ]; then
    # Happy path: produce a bundle with the three always-available categories
    out=$("$WHY_SCRIPT" example-feature-medium "Why are principles enforced via citations?" 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && [ -f "$out" ]; then
      log_check "AC-009" pass "feature-why: happy-path exits 0 + writes $out"

      # Bundle must mention each always-available category
      for cat in 'Category 1: Source control' 'Category 2: GitHub' 'Category 3: Repo docs' 'Categories 4-7: MCP-backed'; do
        if grep -qF "$cat" "$out"; then
          log_check "AC-009" pass "bundle includes: $cat"
        else
          log_check "AC-009" fail "bundle missing: $cat"
        fi
      done
      rm -f "$out"
    else
      log_check "AC-009" fail "feature-why happy-path failed (rc=$rc, out='$out')"
    fi

    # ------------------------------------------------------------------
    # Phase-5 null-result fixture (per ADV-FND-002 from Phase-5 Codex review).
    # Run with a guaranteed-absent keyword. The bundle MUST emit explicit
    # NULL RESULT or "(no … matches)" markers — null results are first-
    # class evidence per the /feature-why contract.
    # ------------------------------------------------------------------
    null_out=$("$WHY_SCRIPT" example-feature-medium \
      "What is xyzabcdefnonexistent12345 used for here?" 2>/dev/null)
    if [ -f "$null_out" ]; then
      if grep -qE '(no commit-message matches|NULL RESULT)' "$null_out"; then
        log_check "AC-009" pass "null-result probe: bundle emits explicit no-hit marker for absent keyword"
      else
        log_check "AC-009" fail "null-result probe: bundle silently dropped absent keyword (violates ADV-FND-002 contract)"
      fi
      rm -f "$null_out"
    else
      log_check "AC-009" fail "null-result probe: bundle file missing"
    fi
  else
    log_check "AC-009" skip "feature-why happy-path + null-result tests need example-feature-medium fixture"
  fi
else
  log_check "AC-009" fail "$WHY_SCRIPT missing or not executable"
fi

# planner (intake phase) must reference the /feature-why pre-question check
# v1.1: was sdlc-product.md → planner.md (3 phases merged); the intake phase
# section of planner.md must still cite /feature-why.
if grep -qiF '/feature-why' .claude/agents/planner.md; then
  log_check "AC-009" pass "planner references /feature-why in its intake phase"
else
  log_check "AC-009" fail "planner does not reference /feature-why"
fi

# ------------------------------------------------------------------
# SEC-FND-002 fix: scripts/feature-reflect and scripts/feature-why
# must source lib-sanitize.sh and refuse to land their bundle if a
# sensitive pattern is present. Per the PR security review on the
# SEC-FND-001 fix: same defect class existed in the sibling bundle
# writers.
# ------------------------------------------------------------------
if grep -qF 'lib-sanitize.sh' scripts/feature-reflect; then
  log_check "AC-009" pass "SEC-FND-002 fix: feature-reflect sources lib-sanitize.sh"
else
  log_check "AC-009" fail "SEC-FND-002 fix: feature-reflect does not source lib-sanitize.sh"
fi
if grep -qF 'lib-sanitize.sh' scripts/feature-why; then
  log_check "AC-009" pass "SEC-FND-002 fix: feature-why sources lib-sanitize.sh"
else
  log_check "AC-009" fail "SEC-FND-002 fix: feature-why does not source lib-sanitize.sh"
fi

# feature-why: refuse on a question containing a card-PAN pattern
# (contiguous form). Per SEC-FND-002 fix.
# String-fragment concatenation so this source file does not contain a
# literal contiguous PAN that the wrappers' diff scan would trip on.
# These require example-feature-medium as the target feature.
if [ "$HAS_EXAMPLE_FEATURE_MEDIUM" = "1" ]; then
  _pan_c="41""11111111111111"
  "$WHY_SCRIPT" example-feature-medium "What about test card $_pan_c handling?" > /dev/null 2>&1
  why_pan_exit=$?
  if [ "$why_pan_exit" -eq 6 ]; then
    log_check "AC-009" pass "SEC-FND-002 fix: feature-why refuses contiguous card-PAN question with exit 6"
  else
    log_check "AC-009" fail "SEC-FND-002 fix: feature-why contiguous card-PAN question should exit 6 (got $why_pan_exit)"
  fi

  # SEC-FND-003 fix: separator-form PANs (spaced + hyphenated) must
  # also be blocked. The original sanitizer only matched contiguous
  # digits, so an operator pasting a spaced or hyphenated PAN form would
  # have slipped through. String-fragment concatenation prevents this
  # source file from itself containing a literal PAN-shape that the
  # wrapper's diff scan would catch.
  _pan_s="41""11 1111 1111 1111"
  _pan_h="41""11-1111-1111-1111"
  "$WHY_SCRIPT" example-feature-medium "What about test card $_pan_s handling?" > /dev/null 2>&1
  why_spaced_exit=$?
  if [ "$why_spaced_exit" -eq 6 ]; then
    log_check "AC-009" pass "SEC-FND-003 fix: feature-why refuses spaced-PAN question with exit 6"
  else
    log_check "AC-009" fail "SEC-FND-003 fix: feature-why spaced-PAN question should exit 6 (got $why_spaced_exit)"
  fi
  "$WHY_SCRIPT" example-feature-medium "What about test card $_pan_h handling?" > /dev/null 2>&1
  why_hyphen_exit=$?
  if [ "$why_hyphen_exit" -eq 6 ]; then
    log_check "AC-009" pass "SEC-FND-003 fix: feature-why refuses hyphenated-PAN question with exit 6"
  else
    log_check "AC-009" fail "SEC-FND-003 fix: feature-why hyphenated-PAN question should exit 6 (got $why_hyphen_exit)"
  fi
else
  log_check "AC-009" skip "SEC-FND-002/003 PAN-refusal tests need example-feature-medium fixture"
fi

# feature-reflect: refuse on a feature whose EVIDENCE.md contains a
# card-PAN value. Synthetic fixture, gitignored as _test-fixture-*.
reflect_secfx="docs/features/_test-fixture-reflect-pan"
cleanup_reflect_secfx() {
  rm -rf "$reflect_secfx"
}
cleanup_reflect_secfx
trap cleanup_reflect_secfx EXIT
mkdir -p "$reflect_secfx"
printf 'medium' > "$reflect_secfx/.tier"
# Minimal feature files for the wrapper to walk.
cat > "$reflect_secfx/SPEC.md" <<'EOF'
# fixture spec
EOF
cat > "$reflect_secfx/TASKS.md" <<'EOF'
# fixture tasks
EOF
# String-fragment concat so this source file has no literal contiguous
# PAN. The fixture EVIDENCE.md is written with the concatenated runtime
# value, which the sanitizer regex DOES match.
_pan_evidence="41""11111111111111"
cat > "$reflect_secfx/EVIDENCE.md" <<EOF
# fixture evidence
- A card-shape value smuggled into evidence: $_pan_evidence
EOF

scripts/feature-reflect _test-fixture-reflect-pan > /dev/null 2>&1
reflect_pan_exit=$?
if [ "$reflect_pan_exit" -eq 6 ]; then
  log_check "AC-009" pass "SEC-FND-002 fix: feature-reflect refuses fixture EVIDENCE with card-PAN with exit 6"
else
  log_check "AC-009" fail "SEC-FND-002 fix: feature-reflect should exit 6 on card-PAN fixture (got $reflect_pan_exit)"
fi
# Verify no bundle was created
if [ -d "$reflect_secfx/reflect" ] && ls "$reflect_secfx/reflect"/*.context.md 2>/dev/null | grep -q .; then
  log_check "AC-009" fail "SEC-FND-002 fix: bundle was created despite sanitization refusal"
else
  log_check "AC-009" pass "SEC-FND-002 fix: no feature-reflect bundle created on refusal"
fi
cleanup_reflect_secfx
trap - EXIT

# --------------------------------------------------------------------------
# Phase 6: /feature-arena constructive-parallelism command
# --------------------------------------------------------------------------
printf '\n== Phase 6: /feature-arena command + scripts/feature-arena (AC-010) ==\n'

ARENA_CMD=".claude/commands/feature-arena.md"
ARENA_SCRIPT="scripts/feature-arena"

if [ -f "$ARENA_CMD" ]; then
  log_check "AC-010" pass "$ARENA_CMD present"
  for section in 'Safety boundary' 'Step 0 — Run the coordinator script' 'Phase A — Frame' 'Phase B — Fan out' 'Phase C — Cross-judge' 'Phase D — Pick a base' 'Phase E — Graft' 'Phase F — Verify' 'Cost notes'; do
    if grep -qF "$section" "$ARENA_CMD"; then
      log_check "AC-010" pass "feature-arena command has section: $section"
    else
      log_check "AC-010" fail "feature-arena command missing section: $section"
    fi
  done

  # Constructive vs adversarial framing must be explicit
  for marker in 'constructive parallelism' 'distinct from'; do
    if grep -qiF "$marker" "$ARENA_CMD"; then
      log_check "AC-010" pass "feature-arena distinguishes constructive vs adversarial: '$marker'"
    else
      log_check "AC-010" fail "feature-arena missing framing marker: '$marker'"
    fi
  done
else
  log_check "AC-010" fail "$ARENA_CMD missing"
fi

if [ -x "$ARENA_SCRIPT" ]; then
  log_check "AC-010" pass "$ARENA_SCRIPT is executable"

  # Usage: no args → exit 3
  "$ARENA_SCRIPT" > /dev/null 2>&1
  if [ $? -eq 3 ]; then
    log_check "AC-010" pass "feature-arena: no-args usage exits 3"
  else
    log_check "AC-010" fail "feature-arena: no-args usage did not exit 3"
  fi

  # Missing feature → exit 3
  "$ARENA_SCRIPT" nonexistent-fake-slug TASK-001 > /dev/null 2>&1
  if [ $? -eq 3 ]; then
    log_check "AC-010" pass "feature-arena: missing-feature exits 3"
  else
    log_check "AC-010" fail "feature-arena: missing-feature did not exit 3"
  fi

  # Low-risk fixture: prove the eligibility gate, --force escape hatch,
  # and N validation without depending on optional example fixtures.
  arena_low_fixture="docs/features/_test-fixture-arena-low-risk"
  cleanup_arena_low_fixture() {
    rm -rf "$arena_low_fixture" "/tmp/sg-arena-_test-fixture-arena-low-risk-TASK-101"*
  }
  cleanup_arena_low_fixture
  trap cleanup_arena_low_fixture EXIT

  mkdir -p "$arena_low_fixture"
  printf 'medium' > "$arena_low_fixture/.tier"
  cat > "$arena_low_fixture/TASKS.md" <<'EOF'
# Fixture: arena low-risk task

### TASK-101: Update copy on a readme page

- Status: Open
- AC IDs: AC-001
- Type: docs
- Risk: low
- Owner/session: test-fixture
- Intended file ownership:
  - docs/README.md
EOF

  "$ARENA_SCRIPT" _test-fixture-arena-low-risk TASK-101 > /dev/null 2>&1
  if [ $? -eq 4 ]; then
    log_check "AC-010" pass "feature-arena: low-risk task without --force exits 4 (eligibility gate)"
  else
    log_check "AC-010" fail "feature-arena: eligibility gate did not fire on low-risk task"
  fi

  out=$("$ARENA_SCRIPT" _test-fixture-arena-low-risk TASK-101 --force 2>/dev/null)
  rc=$?
  if [ "$rc" -eq 0 ] && [ -f "$out" ]; then
    log_check "AC-010" pass "feature-arena: --force override produces coordinator manifest"
    work_dir=$(grep '<!-- Arena work dir:' "$out" | sed -E 's/.*: ([^ ]+) -->.*/\1/')
    [ -d "$work_dir" ] && rm -rf "$work_dir"
    rm -f "$out"
    rmdir "$(dirname "$out")" 2>/dev/null
  else
    log_check "AC-010" fail "feature-arena: --force override failed (rc=$rc)"
  fi

  "$ARENA_SCRIPT" _test-fixture-arena-low-risk TASK-101 1 --force > /dev/null 2>&1
  if [ $? -eq 3 ]; then
    log_check "AC-010" pass "feature-arena: N=1 rejected with exit 3"
  else
    log_check "AC-010" fail "feature-arena: N=1 did not exit 3"
  fi

  "$ARENA_SCRIPT" _test-fixture-arena-low-risk TASK-101 6 --force > /dev/null 2>&1
  if [ $? -eq 3 ]; then
    log_check "AC-010" pass "feature-arena: N=6 rejected with exit 3 (capped at 5)"
  else
    log_check "AC-010" fail "feature-arena: N=6 not capped at 5"
  fi

  cleanup_arena_low_fixture
  trap - EXIT

  # ------------------------------------------------------------------
  # Phase-6 positive fixture: a real high-risk + qualifying-surface
  # task should succeed without --force (per ADV-FND-002 from the
  # Phase-6 Codex adversary review: the original Phase-6 harness only
  # tested low-risk refusal and forced bypass; a regression that
  # refused all real arena tasks would still satisfy the existing
  # checks).
  # ------------------------------------------------------------------
  arena_fixture="docs/features/_test-fixture-arena-eligible"
  cleanup_arena_fixture() {
    rm -rf "$arena_fixture" "/tmp/sg-arena-_test-fixture-arena-eligible-TASK-901"*
  }
  cleanup_arena_fixture
  trap cleanup_arena_fixture EXIT

  mkdir -p "$arena_fixture"
  printf 'large' > "$arena_fixture/.tier"
  cat > "$arena_fixture/TASKS.md" <<'EOF'
# Fixture: arena-eligible high-risk task

### TASK-901: Migrate refund records to per-row secrets vault tokens

- Status: Open
- AC IDs: AC-001
- Type: migration
- Risk: high
- Owner/session: test-fixture
- Intended file ownership:
  - db/migrations/0042_refund_secrets-vault.sql
  - app/Services/PaymentGateway.php
- Verification:
  - command
  - mode: full
EOF

  # Per v1.0 architecture review: arena now requires an explicit eligibility regex.
  # Set one that matches the fixture so this test still proves the gate fires.
  export SDLC_ARENA_ELIGIBILITY_REGEX="(db/migrations/|PaymentGateway)"
  arena_pass_out=$("$ARENA_SCRIPT" _test-fixture-arena-eligible TASK-901 3 2>&1)
  arena_pass_exit=$?
  if [ "$arena_pass_exit" -eq 0 ] && [ -f "$arena_pass_out" ]; then
    log_check "AC-010" pass "positive fixture: Risk:high + qualifying-surface task accepted without --force"
    # Cleanup the work-dir referenced by the manifest
    work_dir=$(grep '<!-- Arena work dir:' "$arena_pass_out" | sed -E 's/.*: ([^ ]+) -->.*/\1/')
    [ -d "$work_dir" ] && rm -rf "$work_dir"
  else
    log_check "AC-010" fail "positive fixture should succeed without --force (rc=$arena_pass_exit, out='$arena_pass_out')"
  fi

  cleanup_arena_fixture
  trap - EXIT

  # ------------------------------------------------------------------
  # SEC-FND-001 fix: scripts/feature-arena must refuse to dispatch a
  # task whose block contains a card / secret / PII-shaped pattern.
  # Synthetic fixture with a card-shape value in the task title; arena
  # must exit 6 without writing /tmp candidate dirs.
  # ------------------------------------------------------------------
  arena_secfx="docs/features/_test-fixture-arena-pan"
  cleanup_arena_secfx() { rm -rf "$arena_secfx" "/tmp/sg-arena-_test-fixture-arena-pan-TASK-902"*; }
  cleanup_arena_secfx
  trap cleanup_arena_secfx EXIT

  mkdir -p "$arena_secfx"
  printf 'large' > "$arena_secfx/.tier"
  # Use a known test-PAN pattern (4111... is the canonical Visa test
  # number; matches the card-pan-visa pattern in lib-sanitize.sh).
  # Same string-fragment concat pattern (avoids literal-PAN-in-source).
  _pan_arena="41""11111111111111"
  cat > "$arena_secfx/TASKS.md" <<EOF
# Fixture: arena task with card-shape PAN in body

### TASK-902: Migrate refund flow — note customer card $_pan_arena

- Status: Open
- AC IDs: AC-001
- Type: migration
- Risk: high
- Owner/session: test-fixture
- Intended file ownership:
  - db/migrations/0099_refund_flow.sql
EOF
  "$ARENA_SCRIPT" _test-fixture-arena-pan TASK-902 2 > /dev/null 2>&1
  pan_exit=$?
  if [ "$pan_exit" -eq 6 ]; then
    log_check "AC-010" pass "SEC-FND-001 fix: card-PAN in task body refused with exit 6"
  else
    log_check "AC-010" fail "SEC-FND-001 fix: card-PAN should exit 6 (got $pan_exit)"
  fi
  if ls /tmp/sg-arena-_test-fixture-arena-pan-TASK-902* 2>/dev/null | grep -q .; then
    log_check "AC-010" fail "SEC-FND-001 fix: /tmp work-dir was created despite sanitization refusal"
  else
    log_check "AC-010" pass "SEC-FND-001 fix: no /tmp work-dir created (refused before any write)"
  fi
  cleanup_arena_secfx
  trap - EXIT

  # ------------------------------------------------------------------
  # SEC-FND-001 fix: lib-sanitize.sh self-test (the patterns library
  # must catch card / secret / PII shapes when invoked directly).
  # ------------------------------------------------------------------
  if [ -x scripts/lib-sanitize.sh ]; then
    if scripts/lib-sanitize.sh 2>&1 | grep -q 'All self-tests passed'; then
      log_check "AC-010" pass "scripts/lib-sanitize.sh self-test: card PAN blocked + clean string allowed"
    else
      log_check "AC-010" fail "scripts/lib-sanitize.sh self-test did not report all-passed"
    fi
  else
    log_check "AC-010" fail "scripts/lib-sanitize.sh missing or not executable"
  fi
else
  log_check "AC-010" fail "$ARENA_SCRIPT missing or not executable"
fi

# planner (plan phase) must reference /feature-arena for high-risk diffs
# v1.1: was sdlc-tech-lead.md → planner.md; the plan phase section of
# planner.md must still cite /feature-arena.
if grep -qiF '/feature-arena' .claude/agents/planner.md; then
  log_check "AC-010" pass "planner references /feature-arena for high-risk diffs"
else
  log_check "AC-010" fail "planner does not reference /feature-arena"
fi

