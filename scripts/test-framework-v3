if [ "$next_feedback_rc" -eq 5 ] && printf '%s' "$next_feedback_out" | grep -qF 'feedback-required:INC-001'; then
  log_check "SHIP-INC-001" pass "feature-next-task stops with feedback-required:INC-001"
else
  log_check "SHIP-INC-001" fail "feedback route missing (rc=$next_feedback_rc): $next_feedback_out"
