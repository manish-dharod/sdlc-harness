# feature-why: refuse on a question containing a card-PAN pattern
# (contiguous form). Per SEC-FND-002 fix.
# String-fragment concatenation so this source file does not contain a
# literal contiguous PAN that the wrappers' diff scan would trip on.
# These require example-feature-medium as the target feature.
if [ "$HAS_EXAMPLE_FEATURE_MEDIUM" = "1" ]; then
  _pan_c="41""11111111111111"
  "$WHY_SCRIPT" example-feature-medium "What about test card $_pan_c handling?" > /dev/null 2>&1
  why_pan_exit=$?
  if [ "$why_pan_exit" -eq 6 ]; then
    log_check "AC-009" pass "SEC-FND-002 fix: feature-why refuses contiguous card-PAN question with exit 6"
  else
    log_check "AC-009" fail "SEC-FND-002 fix: feature-why contiguous card-PAN question should exit 6 (got $why_pan_exit)"
  fi

  # SEC-FND-003 fix: separator-form PANs (spaced + hyphenated) must
  # also be blocked. The original sanitizer only matched contiguous
  # digits, so an operator pasting a spaced or hyphenated PAN form would
  # have slipped through. String-fragment concatenation prevents this
  # source file from itself containing a literal PAN-shape that the
  # wrapper's diff scan would catch.
  _pan_s="41""11 1111 1111 1111"
  _pan_h="41""11-1111-1111-1111"
  "$WHY_SCRIPT" example-feature-medium "What about test card $_pan_s handling?" > /dev/null 2>&1
  why_spaced_exit=$?
  if [ "$why_spaced_exit" -eq 6 ]; then
    log_check "AC-009" pass "SEC-FND-003 fix: feature-why refuses spaced-PAN question with exit 6"
  else
    log_check "AC-009" fail "SEC-FND-003 fix: feature-why spaced-PAN question should exit 6 (got $why_spaced_exit)"
  fi
  "$WHY_SCRIPT" example-feature-medium "What about test card $_pan_h handling?" > /dev/null 2>&1
  why_hyphen_exit=$?
  if [ "$why_hyphen_exit" -eq 6 ]; then
    log_check "AC-009" pass "SEC-FND-003 fix: feature-why refuses hyphenated-PAN question with exit 6"
  else
    log_check "AC-009" fail "SEC-FND-003 fix: feature-why hyphenated-PAN question should exit 6 (got $why_hyphen_exit)"
  fi
else
  log_check "AC-009" skip "SEC-FND-002/003 PAN-refusal tests need example-feature-medium fixture"
fi

# feature-reflect: refuse on a feature whose EVIDENCE.md contains a
# card-PAN value. The canonical fixture slug is per-process, gitignored, and
# refused if a pre-existing or tracked path would make cleanup unsafe.
reflect_secfx_slug="test-learning-fixture-reflect-pan-$$-$RANDOM"
reflect_secfx="docs/features/$reflect_secfx_slug"
reflect_secfx_created=0
cleanup_reflect_secfx() {
  if [ "$reflect_secfx_created" -eq 1 ]; then
    rm -rf "$reflect_secfx"
  fi
}
trap cleanup_reflect_secfx EXIT
if [ -e "$reflect_secfx" ] || git ls-files "$reflect_secfx" | grep -q . || \
   ! git check-ignore -q "$reflect_secfx/probe"; then
  log_check "AC-009" fail "refusing unsafe pre-existing, tracked, or non-ignored reflect fixture: $reflect_secfx"
else
  mkdir -p "$reflect_secfx"
  reflect_secfx_created=1
  printf 'medium' > "$reflect_secfx/.tier"
  # Minimal feature files for the wrapper to walk.
  cat > "$reflect_secfx/SPEC.md" <<'EOF'
# fixture spec
EOF
  cat > "$reflect_secfx/TASKS.md" <<'EOF'
# fixture tasks
EOF
  # String-fragment concat so this source file has no literal contiguous
  # PAN. The fixture EVIDENCE.md is written with the concatenated runtime
  # value, which the sanitizer regex DOES match.
  _pan_evidence="41""11111111111111"
  cat > "$reflect_secfx/EVIDENCE.md" <<EOF
# fixture evidence
- A card-shape value smuggled into evidence: $_pan_evidence
EOF

  scripts/feature-reflect "$reflect_secfx_slug" > /dev/null 2>&1
  reflect_pan_exit=$?
  if [ "$reflect_pan_exit" -eq 6 ]; then
    log_check "AC-009" pass "SEC-FND-002 fix: feature-reflect refuses fixture EVIDENCE with card-PAN with exit 6"
  else
    log_check "AC-009" fail "SEC-FND-002 fix: feature-reflect should exit 6 on card-PAN fixture (got $reflect_pan_exit)"
  fi
  # Verify no bundle was created.
  if [ -d "$reflect_secfx/reflect" ] && ls "$reflect_secfx/reflect"/*.context.md 2>/dev/null | grep -q .; then
    log_check "AC-009" fail "SEC-FND-002 fix: bundle was created despite sanitization refusal"
  else
    log_check "AC-009" pass "SEC-FND-002 fix: no feature-reflect bundle created on refusal"
  fi
fi
cleanup_reflect_secfx
trap - EXIT

