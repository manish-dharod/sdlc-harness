# --------------------------------------------------------------------------
# Regression: project-neutrality + config-driven engine (from main's
# 5e61b90 fix — adopted into v1.1 via the merge). These check the
# framework code itself against rules the v1.0 work was supposed to
# enforce. They run in framework-mode only; adopter projects don't
# typically have all these script files (and shouldn't be punished if
# they don't).
# --------------------------------------------------------------------------
if [ "$IS_FRAMEWORK_REPO" = "1" ]; then
  printf '\n== Regression: project-neutrality + config-driven engine ==\n'

  # Regression 1: no project-specific scrub-targets in framework code.
  # Allowed paths (legitimate framework-internal artifacts that reference
  # the framework's own GitHub identity or are auto-generated dogfood
  # evidence — neither leaks into adopters' projects):
  #   - the harness itself (it references the regex in its own assertion)
  #   - the dogfood feature's review trail records
  #   - docs/features/*/reflect/*.context.md (auto-generated bundles)
  #   - docs/features/*/SPEC.md + DESIGN.md (dogfood specs may cite
  #     framework's actual GitHub URL for /plugin install examples)
  #   - the migration doc (describes the source repo by name)
  #   - VALIDATION.md (records the foreign-repo install runs)
  SCRUB_HITS=$(grep -rlE 'simplyglobal|trawick|imglobal|patriot|INSURANCE_CHECKOUT' \
    .claude docs scripts 2>/dev/null \
    | grep -vE '/sdlc-doctor-health-check/(EVIDENCE|adversary)|scripts/test-framework-v3$|docs/MIGRATING_v1\.0_to_v1\.1\.md|docs/VALIDATION\.md|/reflect/.*\.context\.md|/(SPEC|DESIGN)\.md' || true)
  if [ -z "$SCRUB_HITS" ]; then
    log_check "AC-V13-001" pass "no project-specific scrub-targets in framework code"
  else
    log_check "AC-V13-001" fail "project-specific scrub-targets still present: $SCRUB_HITS"
  fi

  # Regression 2: scripts use SDLC_BASE_BRANCH, not literal `master..HEAD`.
  BAD_MASTER=$(grep -lE 'git diff.*master\.\.HEAD|git diff --name-only master\.\.HEAD' \
    scripts/feature-ready scripts/adversary-review scripts/security-review \
    scripts/feature-arena scripts/feature-reflect scripts/feature-why 2>/dev/null || true)
  if [ -z "$BAD_MASTER" ]; then
    log_check "AC-V13-002" pass "scripts use SDLC_BASE_BRANCH, not literal master..HEAD"
  else
    log_check "AC-V13-002" fail "scripts still hardcode master..HEAD: $BAD_MASTER"
  fi

  # Regression 3: scripts that read config source load-config.
  NO_LOADER=""
  for s in scripts/feature-ready scripts/feature-arena scripts/feature-verify \
           scripts/adversary-review scripts/security-review \
           scripts/feature-reflect scripts/feature-why scripts/sdlc-doctor; do
    if [ -f "$s" ] && grep -qE 'SDLC_(BASE_BRANCH|ARENA_ELIGIBILITY_REGEX|ARTIFACT_HYGIENE_PATTERNS|PROTECTED_PATHS|DOMAIN_PACK)' "$s"; then
      if ! grep -q 'load-config' "$s"; then
        NO_LOADER="$NO_LOADER $s"
      fi
    fi
  done
  if [ -z "$NO_LOADER" ]; then
    log_check "AC-V13-003" pass "config-aware scripts all source load-config"
  else
    log_check "AC-V13-003" fail "config-aware scripts missing load-config:$NO_LOADER"
  fi

  # Regression 4: scripts/feature-arena default eligibility regex is empty.
  ARENA_DEFAULT=$(grep -oE 'ARENA_ELIGIBILITY_REGEX="\$\{SDLC_ARENA_ELIGIBILITY_REGEX:-[^}]*\}"' scripts/feature-arena 2>/dev/null | head -1)
  if [ "$ARENA_DEFAULT" = 'ARENA_ELIGIBILITY_REGEX="${SDLC_ARENA_ELIGIBILITY_REGEX:-}"' ]; then
    log_check "AC-V13-004" pass "feature-arena default eligibility regex is empty (adopter MUST configure)"
  else
    log_check "AC-V13-004" fail "feature-arena still ships a default eligibility regex: $ARENA_DEFAULT"
  fi

  # Regression 5: scripts/feature-ready artifact hygiene is config-driven.
  if grep -q '\^<your-app>/js/' scripts/feature-ready 2>/dev/null; then
    log_check "AC-V13-005" fail "feature-ready still has '^<your-app>/js/' placeholder (config-driven hygiene not applied)"
  else
    log_check "AC-V13-005" pass "feature-ready artifact hygiene has no placeholder regex (config-driven)"
  fi

  # Regression 6 (NEW from PR-2 review): no master..HEAD in agent / command
  # prompts. The scripts side was fixed, but agent prompts still told agents
  # to run `git diff master..HEAD` as a procedure step, which produces empty
  # diffs in main-based repos.
  BAD_PROMPT_MASTER=$(grep -lE '\bgit diff[^|]*master\.\.HEAD\b' \
    .claude/agents/*.md .claude/commands/*.md 2>/dev/null || true)
  if [ -z "$BAD_PROMPT_MASTER" ]; then
    log_check "AC-V13-006" pass "no master..HEAD in agent/command prompts"
  else
    log_check "AC-V13-006" fail "agent/command prompts still hardcode master..HEAD: $BAD_PROMPT_MASTER"
  fi

  # Regression 7: feature-ready detects scaffolded-but-unpopulated files.
  TMP_SLUG="tmp-template-population-$$"
  TMP_DIR="docs/features/$TMP_SLUG"
  rm -rf "$TMP_DIR"
  cp -R docs/features/_template "$TMP_DIR"
  printf 'large\n' > "$TMP_DIR/.tier"
  TEMPLATE_READY_OUT=$(scripts/feature-ready "$TMP_SLUG" 2>&1 || true)
  rm -rf "$TMP_DIR"
  if printf '%s\n' "$TEMPLATE_READY_OUT" | grep -q 'still byte-identical'; then
    log_check "AC-V13-007" pass "feature-ready flags byte-identical scaffold files"
  else
    log_check "AC-V13-007" fail "feature-ready did not flag byte-identical scaffold files"
  fi

  # Regression 8: credential preflight runs declared commands and propagates
  # failure without requiring any provider-specific tooling.
  TMP_SLUG="tmp-credential-preflight-$$"
  TMP_DIR="docs/features/$TMP_SLUG"
  rm -rf "$TMP_DIR"
  mkdir -p "$TMP_DIR"
  cat > "$TMP_DIR/DESIGN.md" <<'EOF'
# Design

## Credentials & external APIs

- Provider: Fixture
  - Endpoint/action: passing check
  - Required scopes/roles: fixture-pass
  - Secret source: none
  - Preflight command: true
EOF
  if scripts/preflight-credentials "$TMP_SLUG" >/dev/null 2>&1; then
    log_check "AC-V13-008" pass "preflight-credentials passes a declared successful command"
  else
    log_check "AC-V13-008" fail "preflight-credentials failed a declared successful command"
  fi
  cat > "$TMP_DIR/DESIGN.md" <<'EOF'
# Design

## Credentials & external APIs

- Provider: Fixture
  - Endpoint/action: failing check
  - Required scopes/roles: fixture-fail
  - Secret source: none
  - Preflight command: false
EOF
  if scripts/preflight-credentials "$TMP_SLUG" >/dev/null 2>&1; then
    log_check "AC-V13-008" fail "preflight-credentials passed a declared failing command"
  else
    log_check "AC-V13-008" pass "preflight-credentials fails a declared failing command"
  fi
  cat > "$TMP_DIR/local.env" <<'EOF'
LOCAL_ONLY_KEY=fixture_value_123
EOF
  cat > "$TMP_DIR/DESIGN.md" <<EOF
# Design

## Required capabilities / credentials

- env-file: $TMP_DIR/local.env LOCAL_ONLY_KEY
- file: $TMP_DIR/DESIGN.md
- dir-writable: $TMP_DIR
- command: sh
- setup-script: scripts/preflight-credentials
EOF
  DECL_OUT=$(scripts/preflight-credentials "$TMP_SLUG" 2>&1)
  if printf '%s' "$DECL_OUT" | grep -qF 'credential preflight passed'; then
    log_check "AC-V13-008" pass "preflight-credentials passes declarative env-file/file/dir/command/setup-script checks"
  else
    log_check "AC-V13-008" fail "preflight-credentials failed declarative checks"
  fi
  if printf '%s' "$DECL_OUT" | grep -qF 'fixture_value_123'; then
    log_check "AC-V13-008" fail "preflight-credentials leaked env-file value"
  else
    log_check "AC-V13-008" pass "preflight-credentials does not print env-file values"
  fi
  if printf '%s' "$DECL_OUT" | grep -qF 'setup-script executable: scripts/preflight-credentials'; then
    log_check "AC-V13-008" pass "preflight-credentials checks setup-script executability without running it"
  else
    log_check "AC-V13-008" fail "preflight-credentials did not check setup-script declaration"
  fi

  for tpl in docs/features/_template/DESIGN.md docs/features/_template-medium/DESIGN.md docs/features/_template-small/FEATURE.md; do
    if grep -qF 'Required capabilities / credentials' "$tpl"; then
      log_check "AC-V13-008" pass "$tpl documents Required capabilities / credentials"
    else
      log_check "AC-V13-008" fail "$tpl missing Required capabilities / credentials"
    fi
  done

  for marker in 'UI/full verification' 'Source-grounded test plan' 'Step annotations' 'Anti-cheating note' 'Wait/poll strategy'; do
    if grep -qF "$marker" docs/features/_template/EVIDENCE.md && \
       grep -qF "$marker" docs/features/_template-medium/EVIDENCE.md; then
      log_check "AC-V13-008" pass "EVIDENCE templates document UI/full marker: $marker"
    else
      log_check "AC-V13-008" fail "EVIDENCE templates missing UI/full marker: $marker"
    fi
  done

  for marker in 'UI/full verification' 'Source-grounded test plan' 'Step annotations' 'Anti-cheating note'; do
    if grep -qF "$marker" .claude/agents/reviewer.md; then
      log_check "AC-V13-008" pass "reviewer qa mode references UI/full marker: $marker"
    else
      log_check "AC-V13-008" fail "reviewer qa mode missing UI/full marker: $marker"
    fi
  done
  rm -rf "$TMP_DIR"
fi

# --------------------------------------------------------------------------
# Summary
# --------------------------------------------------------------------------
TOTAL=$((PASS + FAIL))
printf '\n== Summary ==\n'
printf '  Passed: %d / %d\n' "$PASS" "$TOTAL"
printf '  Failed: %d\n' "$FAIL"
if [ "$SKIP" -gt 0 ]; then
  if [ "$IS_FRAMEWORK_REPO" = "1" ]; then
    printf '  Skipped: %d  (fixture-dependent checks where the fixture is absent)\n' "$SKIP"
  else
    printf '  Skipped: %d  (framework-self-checks + fixture-dependent checks; expected in an adopter project — see scripts/test-framework-v3 IS_FRAMEWORK_REPO + HAS_EXAMPLE_FEATURE guards)\n' "$SKIP"
  fi
fi
if [ "$FAIL" -gt 0 ]; then
  printf '  Failed ACs:%s\n' "$FAILED_ACS"
  exit 1
fi
if [ "$IS_FRAMEWORK_REPO" = "1" ]; then
  printf '\nAll current framework AC and regression checks pass.\n'
else
  printf '\nAdopter-mode checks pass. Framework-self-checks and fixture-dependent tests were skipped — see the skip rows above.\n'
fi
printf '(AC-008 — codex adversary artifacts — verified by inspecting EVIDENCE.md.)\n'
exit 0
