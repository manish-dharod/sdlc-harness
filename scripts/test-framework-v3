if [ "$next_ahead_rc" -eq 1 ] && printf '%s' "$next_ahead_out" | grep -qF 'future increment INC-002 task TASK-002 must remain Backlog'; then
  log_check "SHIP-INC-004" pass "feature-next-task fails closed on future-increment build-ahead"
else
  log_check "SHIP-INC-004" fail "build-ahead was not blocked (rc=$next_ahead_rc): $next_ahead_out"
fi

reconcile_ahead_out=$(scripts/feature-reconcile "$INC_FIXTURE_SLUG" 2>&1)
if printf '%s' "$reconcile_ahead_out" | grep -qF 'DRIFT: shippable increment state invalid' && \
   printf '%s' "$reconcile_ahead_out" | grep -qF 'future increment INC-002 task TASK-002 must remain Backlog'; then
  log_check "SHIP-INC-005" pass "feature-reconcile reports build-ahead as drift"
