if [ -f "$DEFAULT_MEDIUM_DIR/.incremental-delivery" ] && \
   [ "$(tr -d '[:space:]' < "$DEFAULT_MEDIUM_DIR/.incremental-delivery")" = "v1" ] && \
   [ -f "$DEFAULT_MEDIUM_DIR/INCREMENTS.md" ] && \
   grep -qF 'Current increment: INC-001' "$DEFAULT_MEDIUM_DIR/INCREMENTS.md" && \
   grep -qF -- '- Status: Planned' "$DEFAULT_MEDIUM_DIR/INCREMENTS.md" && \
   [ "$default_medium_next_rc" -eq 5 ] && \
   printf '%s' "$default_medium_next_out" | grep -qF 'start-increment:INC-001' && \
   [ "$default_medium_ready_rc" -ne 0 ] && \
   printf '%s' "$default_medium_ready_out" | grep -qF 'not Done' && \
   [ "$default_medium_verify_rc" -eq 0 ] && \
   [ "$default_medium_missing_rc" -ne 0 ] && \
   printf '%s' "$default_medium_missing_out" | grep -qF 'INCREMENTS.md'; then
  log_check "SHIP-DEFAULT-002" pass "medium INC-001 is Planned, not ready, planner-routed, and verify-required"
else
  log_check "SHIP-DEFAULT-002" fail "medium scaffold missing activated INC-001 ledger"
fi

if [ -f "$DEFAULT_LARGE_DIR/.incremental-delivery" ] && \
   [ "$(tr -d '[:space:]' < "$DEFAULT_LARGE_DIR/.incremental-delivery")" = "v1" ] && \
   [ -f "$DEFAULT_LARGE_DIR/INCREMENTS.md" ] && \
   grep -qF 'Current increment: INC-001' "$DEFAULT_LARGE_DIR/INCREMENTS.md" && \
   grep -qF -- '- Status: Planned' "$DEFAULT_LARGE_DIR/INCREMENTS.md"; then
  log_check "SHIP-DEFAULT-003" pass "new large features activate a Planned INC-001"
else
  log_check "SHIP-DEFAULT-003" fail "large scaffold missing activated INC-001 ledger"
fi

if [ ! -e "$DEFAULT_SMALL_DIR/.incremental-delivery" ] && \
   [ ! -e "$DEFAULT_SMALL_DIR/INCREMENTS.md" ]; then
  log_check "SHIP-DEFAULT-004" pass "small-tier scaffold remains marker-free"
else
  log_check "SHIP-DEFAULT-004" fail "small-tier scaffold unexpectedly activated incremental delivery"
fi

ledger_fields_ok=1
for ledger in "$DEFAULT_MEDIUM_DIR/INCREMENTS.md" "$DEFAULT_LARGE_DIR/INCREMENTS.md"; do
  for marker in '- Outcome:' '- User journey:' '- Experience surface:' '- Ship target:' \
    '- Task IDs:' '- Verification:' '- Rollback:' '- Evidence:' \
    '- Owner verdict: Pending' '- Owner feedback evidence:' 'Source: owner' \
    'Verdict: Accepted | Changes requested'; do
    if [ ! -f "$ledger" ] || ! grep -qF -- "$marker" "$ledger"; then
      ledger_fields_ok=0
    fi
  done
done
if [ "$ledger_fields_ok" -eq 1 ]; then
  log_check "SHIP-DEFAULT-005" pass "increment templates carry proof and owner-feedback schemas"
else
  log_check "SHIP-DEFAULT-005" fail "increment templates are missing required proof/feedback fields"
fi

task_schema_ok=1
for tasks in "$DEFAULT_MEDIUM_DIR/TASKS.md" "$DEFAULT_LARGE_DIR/TASKS.md"; do
  if ! grep -qF -- '- Increment: INC-###' "$tasks" || \
     ! grep -qF -- '- Increment: INC-001' "$tasks"; then
    task_schema_ok=0
  fi
done
if [ "$task_schema_ok" -eq 1 ]; then
  log_check "SHIP-DEFAULT-006" pass "medium/large task schemas require increment ownership"
else
  log_check "SHIP-DEFAULT-006" fail "task template missing increment schema or INC-001 example mapping"
fi

if grep -qF 'Plan INC-001 as the smallest experiential MVP' scripts/feature-init && \
   grep -qF 'INCREMENTS.md' scripts/feature-init; then
  log_check "SHIP-DEFAULT-007" pass "feature-init handoff starts with the experiential MVP ledger"
else
  log_check "SHIP-DEFAULT-007" fail "feature-init handoff does not prioritize INC-001"
fi

if grep -qF 'smallest experiential MVP' .claude/agents/planner.md && \
   grep -qF 'future-increment tasks remain `Backlog`' .claude/agents/planner.md && \
   grep -qF 'Never write an owner verdict' .claude/agents/builder.md && \
   grep -qF 'Experience surface' .claude/agents/builder.md; then
  log_check "SHIP-DEFAULT-008" pass "planner and builder enforce increment scope and owner provenance"
else
  log_check "SHIP-DEFAULT-008" fail "planner/builder increment guidance incomplete"
fi

if grep -qF 'current increment' .claude/agents/reviewer.md && \
   grep -qF 'Experience surface' .claude/agents/reviewer.md && \
   grep -qF 'Ship target' .claude/agents/reviewer.md && \
   grep -qF 'scripts/feature-increment final' .claude/agents/release.md && \
   grep -qF 'owner-accepted' .claude/agents/release.md; then
  log_check "SHIP-DEFAULT-009" pass "reviewer and release require experiential proof and acceptance"
else
  log_check "SHIP-DEFAULT-009" fail "reviewer/release increment guidance incomplete"
