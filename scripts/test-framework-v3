route_case() {
  local fixture="$1"
  local expected="$2"

  WORKTREE_HYGIENE_TEST_MODE=1 WORKTREE_HYGIENE_ROUTE_FIXTURE="$fixture" \
    scripts/worktree-hygiene _template \
    > /tmp/sdlc-route-$$.out 2>&1 &&
    grep -Eq "Routing suggestion: $expected" /tmp/sdlc-route-$$.out
}

