#!/usr/bin/env bash
# scripts/feature-learn - capture a bounded post-run learning artifact for a
# feature/task run without auto-applying any harness changes.
#
# Usage:
#   scripts/feature-learn <feature-slug> [task-id] [--run-kind kind]
#     [--status pass|fail|blocked|skipped|unknown] [--mode fast|unit|full|manual]
#     [--source path]
#
# Exit codes:
#   0  wrote learning artifact; printed path on stdout
#   3  usage error or missing feature
#   5  filesystem/write error
#   6  sensitive-data sanitizer refused the assembled artifact

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 3

. "$ROOT/scripts/load-config"
# shellcheck source=lib-sanitize.sh
. "$ROOT/scripts/lib-sanitize.sh"
# shellcheck source=lib-learning-artifacts.sh
. "$ROOT/scripts/lib-learning-artifacts.sh"

CALLER="scripts/feature-learn"
ROOT_REAL=$(sdlc_learning_realpath "$ROOT") || exit 3

usage() {
  cat <<'EOF'
Usage: scripts/feature-learn <feature-slug> [task-id] [--run-kind kind]
       [--status pass|fail|blocked|skipped|unknown] [--mode fast|unit|full|manual]
       [--source path]

Examples:
  scripts/feature-learn seo-rebuild TASK-123 --run-kind feature-loop --status pass --mode fast --source docs/features/seo-rebuild/RUNS.md
  scripts/feature-learn seo-rebuild --run-kind feature-orchestrate --status unknown

Behavior:
  - Writes docs/features/<slug>/learnings/<timestamp>.<task>.<nonce>.learning.md.
  - Creates/appends docs/features/<slug>/LEARNINGS.md as the feature's
    learning ledger.
  - Captures bounded tails of source/EVIDENCE/FINDINGS/RUNS so a later
    /feature-reflect run can mine repeat patterns.
  - Does not invoke an LLM and never edits role prompts, skills, CLAUDE.md,
    scripts, templates, or product code.

Exit codes:
  0  wrote learning artifact; printed path on stdout
  3  usage error or missing feature
  5  filesystem/write error
  6  sensitive-data sanitizer refused the assembled artifact
EOF
}

SLUG="${1:-}"
if [ -z "$SLUG" ] || [ "$SLUG" = "-h" ] || [ "$SLUG" = "--help" ]; then
  usage
  exit 3
fi
shift

if ! sdlc_learning_validate_slug "$SLUG" "$CALLER"; then
  exit 3
fi

TASK_ID=""
if [ $# -gt 0 ] && [ "${1#--}" = "$1" ]; then
  TASK_ID="$1"
  shift
fi

if ! sdlc_learning_validate_task_id "$TASK_ID" "$CALLER"; then
  exit 3
fi

RUN_KIND="manual"
STATUS="unknown"
MODE="manual"
SOURCE_PATH=""

while [ $# -gt 0 ]; do
  case "$1" in
    --run-kind)
      [ $# -ge 2 ] || { usage >&2; exit 3; }
      RUN_KIND="$2"
      shift 2
      ;;
    --status)
      [ $# -ge 2 ] || { usage >&2; exit 3; }
      STATUS="$2"
      shift 2
      ;;
    --mode)
      [ $# -ge 2 ] || { usage >&2; exit 3; }
      MODE="$2"
      shift 2
      ;;
    --source)
      [ $# -ge 2 ] || { usage >&2; exit 3; }
      SOURCE_PATH="$2"
      shift 2
      ;;
    *)
      printf 'scripts/feature-learn: unknown arg: %s\n' "$1" >&2
      usage >&2
      exit 3
      ;;
  esac
done

case "$STATUS" in
  pass|fail|blocked|skipped|unknown) ;;
  *)
    printf 'scripts/feature-learn: invalid --status: %s\n' "$STATUS" >&2
    usage >&2
    exit 3
    ;;
esac

case "$MODE" in
  fast|unit|full|manual|none|unknown) ;;
  *)
    printf 'scripts/feature-learn: invalid --mode: %s\n' "$MODE" >&2
    usage >&2
    exit 3
    ;;
esac

case "$RUN_KIND" in
  *[!A-Za-z0-9._-]*|'')
    printf 'scripts/feature-learn: --run-kind must use only letters, numbers, dot, underscore, or dash\n' >&2
    exit 3
    ;;
esac

DIR="docs/features/$SLUG"
if ! FEATURE_REAL=$(sdlc_learning_validate_feature_dir "$ROOT_REAL" "$DIR" "$CALLER"); then
  exit 3
fi

TIER="large"
SLICE_DIR=$(mktemp -d -t feature-learn-slices-XXXXXX) || exit 5
TMP_CAPTURE=""
LOCK_DIR=""
OUT_FILE=""
INDEX_TMP=""
cleanup_feature_learn() {
  [ -n "$TMP_CAPTURE" ] && rm -f "$TMP_CAPTURE"
  [ -n "$INDEX_TMP" ] && rm -f "$INDEX_TMP"
  [ -n "$SLICE_DIR" ] && rm -rf "$SLICE_DIR"
  [ -n "$LOCK_DIR" ] && \
    sdlc_learning_lock_release "$CALLER" "$LOCK_DIR" >/dev/null 2>&1 || true
}
trap cleanup_feature_learn EXIT

if [ -e "$DIR/.tier" ] || [ -L "$DIR/.tier" ]; then
  TIER_SLICE="$SLICE_DIR/tier"
  if ! sdlc_learning_materialize_text_slice "$CALLER" "tier marker" \
    "$DIR/.tier" "$FEATURE_REAL" 32 0 "$TIER_SLICE" >/dev/null; then
    exit 3
  fi
  TIER=$(tr -d '[:space:]' < "$TIER_SLICE")
  case "$TIER" in
    small|medium|large) ;;
    *)
      printf 'scripts/feature-learn: invalid tier marker: %s\n' "$DIR/.tier" >&2
      exit 3
      ;;
  esac
fi

case "$SOURCE_PATH" in
  auto:*)
    SOURCE_PURPOSE=${SOURCE_PATH#auto:}
    if ! SOURCE_PATH=$(sdlc_learning_resolve_source "$TIER" "$DIR" "$SOURCE_PURPOSE"); then
      printf 'scripts/feature-learn: invalid tier-aware source selector: auto:%s\n' "$SOURCE_PURPOSE" >&2
      exit 3
    fi
    ;;
esac

# Validate every prompt-consumed input before creating the output directory or
# touching LEARNINGS.md. Explicitly supplied missing sources are errors, not
# advisory text inside an otherwise-successful capture.
SOURCE_DISPLAY="none"
SOURCE_SLICE=""
if [ -n "$SOURCE_PATH" ]; then
  SOURCE_SLICE="$SLICE_DIR/source"
  if ! SOURCE_REAL=$(sdlc_learning_materialize_text_slice \
    "$CALLER" "source artifact" "$SOURCE_PATH" "$FEATURE_REAL" \
    "$SDLC_LEARNING_MAX_SOURCE_BYTES" 120 "$SOURCE_SLICE"); then
    exit 3
  fi
  SOURCE_DISPLAY=${SOURCE_REAL#"$ROOT_REAL"/}
  if ! [[ "$SOURCE_DISPLAY" =~ ^[A-Za-z0-9._/-]+$ ]]; then
    printf 'scripts/feature-learn: source path contains unsafe metadata characters\n' >&2
    exit 3
  fi
fi

EVIDENCE_SLICE=""
FINDINGS_SLICE=""
RUNS_SLICE=""
if [ -e "$DIR/EVIDENCE.md" ] || [ -L "$DIR/EVIDENCE.md" ]; then
  EVIDENCE_SLICE="$SLICE_DIR/evidence"
  if ! sdlc_learning_materialize_text_slice "$CALLER" "included artifact" \
    "$DIR/EVIDENCE.md" "$FEATURE_REAL" "$SDLC_LEARNING_MAX_INCLUDED_BYTES" \
    100 "$EVIDENCE_SLICE" >/dev/null; then
    exit 3
  fi
fi
if [ -e "$DIR/FINDINGS.md" ] || [ -L "$DIR/FINDINGS.md" ]; then
  FINDINGS_SLICE="$SLICE_DIR/findings"
  if ! sdlc_learning_materialize_text_slice "$CALLER" "included artifact" \
    "$DIR/FINDINGS.md" "$FEATURE_REAL" "$SDLC_LEARNING_MAX_INCLUDED_BYTES" \
    80 "$FINDINGS_SLICE" >/dev/null; then
    exit 3
  fi
fi
if [ -e "$DIR/RUNS.md" ] || [ -L "$DIR/RUNS.md" ]; then
  RUNS_SLICE="$SLICE_DIR/runs"
  if ! sdlc_learning_materialize_text_slice "$CALLER" "included artifact" \
    "$DIR/RUNS.md" "$FEATURE_REAL" "$SDLC_LEARNING_MAX_INCLUDED_BYTES" \
    80 "$RUNS_SLICE" >/dev/null; then
    exit 3
  fi
fi

TS=$(date -u +%Y-%m-%dT%H%M%SZ)
OUT_DIR="$DIR/learnings"
SAFE_TASK="${TASK_ID:-feature}"
TMP_CAPTURE=$(mktemp -t feature-learn-XXXXXX) || exit 5

GIT_HEAD=$(git rev-parse --short HEAD 2>/dev/null || printf 'unknown')
DIRTY=$(sdlc_learning_dirty_state "$ROOT_REAL")

emit_slice() {
  local label="$1"
  local display_path="$2"
  local staged_slice="$3"
  local tail_n="$4"
  local max_bytes="$5"
  [ -n "$staged_slice" ] && [ -f "$staged_slice" ] || return 0
  printf '== %s (%s) ==\n' "$label" "$display_path"
  printf '<!-- validated tail: last up to %s lines; maximum %s bytes -->\n' \
    "$tail_n" "$max_bytes"
  cat "$staged_slice"
  printf '\n\n'
}

{
  printf '<!-- /feature-learn capture -->\n'
  printf '<!-- Feature: %s -->\n' "$SLUG"
  printf '<!-- Task: %s -->\n' "${TASK_ID:-feature-wide}"
  printf '<!-- Tier: %s -->\n' "$TIER"
  printf '<!-- Run kind: %s -->\n' "$RUN_KIND"
  printf '<!-- Status: %s -->\n' "$STATUS"
  printf '<!-- Mode: %s -->\n' "$MODE"
  printf '<!-- Source: %s -->\n' "$SOURCE_DISPLAY"
  printf '<!-- Git head: %s -->\n' "$GIT_HEAD"
  printf '<!-- Dirty worktree: %s -->\n' "$DIRTY"
  printf '<!-- Generated: %s -->\n\n' "$TS"

  printf '# Post-run Learning Capture\n\n'
  printf '## Run Metadata\n\n'
  printf '| Field | Value |\n'
  printf '|---|---|\n'
  printf '| Feature | `%s` |\n' "$SLUG"
  printf '| Task | `%s` |\n' "${TASK_ID:-feature-wide}"
  printf '| Tier | `%s` |\n' "$TIER"
  printf '| Run kind | `%s` |\n' "$RUN_KIND"
  printf '| Status | `%s` |\n' "$STATUS"
  printf '| Mode | `%s` |\n' "$MODE"
  printf '| Source | `%s` |\n' "$SOURCE_DISPLAY"
  printf '| Git head | `%s` |\n' "$GIT_HEAD"
  printf '| Dirty worktree | `%s` |\n\n' "$DIRTY"

  printf '## Observed Signal\n\n'
  printf '%s\n' '- Result summary: TODO - summarize the concrete signal from this run.'
  printf '%s\n' '- Surprise or repeated friction: TODO - name only evidence-backed patterns.'
  printf '%s\n\n' '- What should change next time: TODO - leave as `none` for one-off noise.'

  if [ -n "$SOURCE_SLICE" ]; then
    emit_slice "Source artifact tail" "$SOURCE_DISPLAY" "$SOURCE_SLICE" 120 \
      "$SDLC_LEARNING_MAX_SOURCE_BYTES"
  fi

  emit_slice "Recent EVIDENCE.md tail" "$DIR/EVIDENCE.md" "$EVIDENCE_SLICE" \
    100 "$SDLC_LEARNING_MAX_INCLUDED_BYTES"
  emit_slice "Recent FINDINGS.md tail" "$DIR/FINDINGS.md" "$FINDINGS_SLICE" \
    80 "$SDLC_LEARNING_MAX_INCLUDED_BYTES"
  emit_slice "Recent RUNS.md tail" "$DIR/RUNS.md" "$RUNS_SLICE" \
    80 "$SDLC_LEARNING_MAX_INCLUDED_BYTES"

  printf '## Candidate Learning Items\n\n'
  printf '### LRN-001\n\n'
  printf '%s\n' '- Pattern: TODO - concise generalized lesson, or `none`.'
  printf '%s\n' '- Evidence: TODO - cite source artifact, EVIDENCE row, finding ID, or command output.'
  printf '%s\n' '- Generality: one-off | repeated | systemic'
  printf '%s\n' '- Routing: no-change | docs-note | role-prompt-edit | add-or-update-principle | encode-in-structure'
  printf '%s\n' '- Target: TODO - exact file/script/template/prompt if promoted.'
  printf '%s\n' '- Confidence: low | medium | high'
  printf '%s\n' '- Safety: no-secrets/no-PII/no-production-impact confirmed | concern: TODO'
  printf '%s\n\n' '- Next action: none | include in next /feature-reflect | open task | ask owner'

  printf '## Promotion Rules\n\n'
  printf '%s\n' '- Capture after every material run, including pass, fail, blocked, skipped, and review-only runs.'
  printf '%s\n' '- Do not promote one-off events unless the risk is high and the target is narrow.'
  printf '%s\n' '- Prefer `encode-in-structure` for repeatable checks: scripts, lints, hooks, templates, reconcile rules, or verify profiles.'
  printf '%s\n' '- Use `role-prompt-edit` or `add-or-update-principle` only for judgment that cannot be made deterministic.'
  printf '%s\n' '- Never auto-apply captured learnings to role prompts, skills, CLAUDE.md, scripts, templates, or product code. Promotion happens through `/feature-reflect` synthesis plus normal review.'
  printf '%s\n\n' '- Do not store secrets, tokens, raw card data, PII, customer payloads, or production-only values in this file.'

  printf '## Capture Status\n\n'
  printf '%s\n' '- Promotion state: captured'
  printf '%s\n' '- Reviewed by /feature-reflect: no'
} > "$TMP_CAPTURE"

if ! sdlc_learning_validate_output_size "$CALLER" "learning capture" \
  "$TMP_CAPTURE" "$SDLC_LEARNING_MAX_CAPTURE_BYTES"; then
  exit 5
fi

if ! sg_sanitize_scan_file "$TMP_CAPTURE"; then
  cat <<EOF >&2
scripts/feature-learn: REFUSING to write learning artifact.

The assembled capture contains a sensitive-data pattern. The matched
category and file location were printed above. Scrub the source feature
artifact first, then re-run the capture.
EOF
  exit 6
fi

if ! sdlc_learning_prepare_output_dir "$CALLER" "learning output directory" \
  "$OUT_DIR" "$FEATURE_REAL" >/dev/null; then
  exit 5
fi

if ! LOCK_DIR=$(sdlc_learning_lock_acquire "$CALLER" "$ROOT_REAL" "$DIR"); then
  exit 5
fi

if ! OUT_FILE=$(sdlc_learning_atomic_publish "$CALLER" "$TMP_CAPTURE" \
  "$OUT_DIR" "${TS}.${SAFE_TASK}" "learning.md"); then
  exit 5
fi

INDEX_FILE="$DIR/LEARNINGS.md"
if [ -e "$INDEX_FILE" ] || [ -L "$INDEX_FILE" ]; then
  if ! sdlc_learning_validate_utf8_stream "$CALLER" "learning ledger" \
    "$INDEX_FILE" "$FEATURE_REAL" >/dev/null; then
    rm -f "$OUT_FILE"
    exit 5
  fi
fi
INDEX_TMP=$(mktemp "$DIR/.LEARNINGS.md.tmp.XXXXXX") || {
  rm -f "$OUT_FILE"
  printf 'scripts/feature-learn: failed to stage %s\n' "$INDEX_FILE" >&2
  exit 5
}
if [ -f "$INDEX_FILE" ]; then
  cat "$INDEX_FILE" > "$INDEX_TMP" || {
    rm -f "$OUT_FILE"
    printf 'scripts/feature-learn: failed to copy %s\n' "$INDEX_FILE" >&2
    exit 5
  }
else
  {
    printf '# Feature Learning Ledger\n\n'
    printf 'This file indexes post-run learning captures. It is evidence input for `/feature-reflect`, not an auto-apply queue.\n\n'
    printf '| Timestamp | Task | Run kind | Status | Mode | Artifact | Promotion state |\n'
    printf '|---|---|---|---|---|---|---|\n'
  } > "$INDEX_TMP" || {
    rm -f "$OUT_FILE"
    printf 'scripts/feature-learn: failed to stage %s\n' "$INDEX_FILE" >&2
    exit 5
  }
fi

printf '| %s | `%s` | `%s` | `%s` | `%s` | `%s` | captured |\n' \
  "$TS" "${TASK_ID:-feature-wide}" "$RUN_KIND" "$STATUS" "$MODE" "$OUT_FILE" >> "$INDEX_TMP" || {
  rm -f "$OUT_FILE"
  printf 'scripts/feature-learn: failed to append %s\n' "$INDEX_FILE" >&2
  exit 5
}

if ! COPYFILE_DISABLE=1 mv "$INDEX_TMP" "$INDEX_FILE"; then
  rm -f "$OUT_FILE"
  printf 'scripts/feature-learn: failed to publish %s\n' "$INDEX_FILE" >&2
  exit 5
fi
rm -f "$DIR/._$(basename "$INDEX_TMP")" "$DIR/._LEARNINGS.md"
INDEX_TMP=""

rm -f "$TMP_CAPTURE"
TMP_CAPTURE=""
rm -rf "$SLICE_DIR"
SLICE_DIR=""
if ! sdlc_learning_lock_release "$CALLER" "$LOCK_DIR"; then
  exit 5
fi
LOCK_DIR=""
printf '%s\n' "$OUT_FILE"
trap - EXIT
exit 0
