run_case "security reviewer rejects unpinned model" pass model_mismatch_is_rejected
run_case "security reviewer timeout is bounded and classified" pass timeout_is_bounded
run_case "invalid timeout is rejected" pass invalid_timeout_is_rejected
run_case "private security temp context is cleaned on failure and success" pass private_temp_context_is_always_cleaned
run_case "security resume preserves the full canonical diff ceiling" pass review_resume_preserves_full_canonical_diff
run_case "invalid positional base is rejected" pass invalid_base_is_rejected
run_case "untracked task-owned diff fails closed" pass untracked_task_owned_change_is_rejected
run_case "unrelated dirty path does not pollute committed security review" pass unrelated_dirty_path_is_allowed
run_case "staged task-owned diff is detected" pass staged_task_owned_change_is_detected
run_case "security clear cannot coexist with SEC-FND records" pass security_clear_with_finding_record_is_invalid
run_case "HEAD no-op security review is rejected before invocation" pass empty_head_review_is_rejected
run_case "oversized security context fails without terminal receipt" pass oversized_context_is_rejected_without_receipt
run_case "missing positional security implementer model is rejected" pass missing_positional_implementer_model_is_rejected
run_case "ambient security implementer-tool override is rejected" pass ambient_implementer_tool_override_is_rejected
run_case "security wrapper rejects Codex implementer model" pass wrong_security_implementer_model_family_is_rejected
run_case "security receipt failure leaves retryable incomplete sidecar" pass receipt_failure_writes_retryable_incomplete_sidecar
run_case "security INT and TERM preserve 130/143 and kill reviewer groups" pass security_signal_preserves_exit_and_kills_group

printf 'security-review tests: %s passed, %s failed\n' "$PASS_COUNT" "$FAIL_COUNT"
[ "$FAIL_COUNT" -eq 0 ]
