#!/usr/bin/env bash
# Focused regression tests for scripts/security-review.

set -u

SOURCE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TEST_ROOT="$(mktemp -d)"
git clone --quiet --shared "$SOURCE_ROOT" "$TEST_ROOT/repo"
ROOT="$TEST_ROOT/repo"
mkdir -p "$TEST_ROOT/runtime"
TMPDIR="$TEST_ROOT/runtime"
git -C "$ROOT" config user.name sdlc-test
git -C "$ROOT" config user.email sdlc-test@example.invalid
BASE_SHA=$(git -C "$ROOT" rev-parse HEAD)
RUNNER="$ROOT/scripts/security-review"
FEATURE="_test-security-review-wrapper-$$"
TASK_ID="TASK-SECURITY-TEST-$$"
CLAIM_FEATURE="_test-security-claim-base-$$"
CLAIM_TASK="TASK-SEC-CLAIM-$$"
CLAIM_REL="docs/features/$CLAIM_FEATURE"
CLAIM_DIR="$ROOT/$CLAIM_REL"
PASS_COUNT=0
FAIL_COUNT=0

mkdir -p "$ROOT/docs/features/$FEATURE"
printf 'medium\n' > "$ROOT/docs/features/$FEATURE/.tier"
cat > "$ROOT/docs/features/$FEATURE/TASKS.md" <<EOF
### $TASK_ID: focused wrapper fixture

- Status: Review
- AC IDs: AC-016
- Type: workflow
- Intended file ownership:
  - docs/features/$FEATURE/
- Verification:
  - scripts/test-security-review
EOF
git -C "$ROOT" add "docs/features/$FEATURE"
git -C "$ROOT" commit --quiet -m 'test: add security review fixture'
PRIMARY_SHA=$(git -C "$ROOT" rev-parse HEAD)
LARGE_FEATURE="_test-security-review-large-$$"
mkdir -p "$ROOT/docs/features/$LARGE_FEATURE"
printf 'medium\n' > "$ROOT/docs/features/$LARGE_FEATURE/.tier"
cat > "$ROOT/docs/features/$LARGE_FEATURE/TASKS.md" <<EOF
### TASK-LARGE: oversized security fixture

- Status: Review
- AC IDs: AC-LARGE
- Type: workflow
- Intended file ownership:
  - docs/features/$LARGE_FEATURE/
- Verification:
  - scripts/test-security-review
EOF
awk 'BEGIN { for (i=0; i<15000; i++) printf "owned security review line %06d abcdefghijklmnopqrstuvwxyz\n", i }' > "$ROOT/docs/features/$LARGE_FEATURE/large.txt"
git -C "$ROOT" add "docs/features/$LARGE_FEATURE"
git -C "$ROOT" commit --quiet -m 'test: add security oversized fixture'
LARGE_SHA=$(git -C "$ROOT" rev-parse HEAD)
git -C "$ROOT" checkout --quiet --detach "$BASE_SHA"
mkdir -p "$CLAIM_DIR"
printf 'medium\n' > "$CLAIM_DIR/.tier"
cat > "$CLAIM_DIR/TASKS.md" <<EOF
### $CLAIM_TASK: post-cutoff security base fixture

- Status: Open
- Intended file ownership:
  - docs/features/$CLAIM_FEATURE/
EOF
printf 'SEC_PRE_CLAIM_DELETE_MARKER\n' > "$CLAIM_DIR/deleted-owned.txt"
git -C "$ROOT" add "$CLAIM_REL" && git -C "$ROOT" commit --quiet -m 'test: add security claim-base fixture'
CLAIM_B=$(git -C "$ROOT" rev-parse HEAD)
cat > "$CLAIM_DIR/TASKS.md" <<EOF
### $CLAIM_TASK: post-cutoff security base fixture

- Status: Claimed
- Claimed at: 2026-07-10 14:00 PDT
- Intended file ownership:
  - docs/features/$CLAIM_FEATURE/
EOF
git -C "$ROOT" add "$CLAIM_REL/TASKS.md" && git -C "$ROOT" commit --quiet -m 'test: dedicated security claim'
CLAIM_C0=$(git -C "$ROOT" rev-parse HEAD)
git -C "$ROOT" rm --quiet "$CLAIM_REL/deleted-owned.txt" && git -C "$ROOT" commit --quiet -m 'test: delete security owned file'
CLAIM_C1=$(git -C "$ROOT" rev-parse HEAD)
printf 'SEC_C2_NEW_OWNED_MARKER\n' > "$CLAIM_DIR/cosmetic-owned.txt"
git -C "$ROOT" add "$CLAIM_REL/cosmetic-owned.txt" && git -C "$ROOT" commit --quiet -m 'test: add security owned cosmetic change'
CLAIM_C2=$(git -C "$ROOT" rev-parse HEAD)
git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
git -C "$ROOT" update-ref refs/remotes/origin/master "$BASE_SHA"

cleanup() {
  rm -rf "$TEST_ROOT"
}
trap cleanup EXIT

write_valid_codex() {
  local file="$1"
  cat > "$file" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$@" > "$TMPDIR/codex-args"
cat > "$TMPDIR/codex-prompt"
cat <<'OUT'
## Security review: fake

### STRIDE + privacy walk
- spoofing: n/a: fixture
- tampering: n/a: fixture
- repudiation: n/a: fixture
- information-disclosure: n/a: fixture
- denial-of-service: n/a: fixture
- elevation-of-privilege: n/a: fixture
- pci-card-data: n/a: fixture
- pii-logging: n/a: fixture
- secrets: n/a: fixture
- auth-session: n/a: fixture
- webhook-signature: n/a: fixture
- migration-safety: n/a: fixture
- dependency-risk: n/a: fixture
- threat-model-coverage: n/a: fixture

### Findings
(no findings)

### Verdict
- SECURITY CLEAR
- Reason: fake clear for wrapper regression test
OUT
EOF
  chmod +x "$file"
}

write_sleeping_codex() {
  local file="$1"
  cat > "$file" <<EOF
#!/usr/bin/env bash
cat >/dev/null
sleep 30 &
printf '%s\n' "\$!" > "$TMPDIR/sleep-child-pid"
wait
EOF
  chmod +x "$file"
}

cleanup_generated() {
  local output="$1"
  local artifact receipt sidecar
  artifact=$(printf '%s\n' "$output" | sed -n -e 's/^Artifact:[[:space:]]*//p' -e 's/.*Artifact written to //p' | sed 's/[[:space:]]*$//' | head -1)
  receipt=$(printf '%s\n' "$output" | sed -n 's/^Review receipt:[[:space:]]*//p' | head -1)
  sidecar=$(printf '%s\n' "$output" | sed -n 's/^Attempt JSON:[[:space:]]*//p' | head -1)
  for path in "$artifact" "$receipt" "$sidecar"; do
    case "$path" in
      docs/features/*/adversary/*|docs/features/*/security/*|docs/features/*/review-receipts/*)
        rm -f "$ROOT/$path" "$ROOT/${path%/*}/._${path##*/}"
        ;;
    esac
  done
}

run_case() {
  local name="$1"
  local expected="$2"
  shift 2
  local output status

  output="$("$@" 2>&1)"
  status=$?
  if { [ "$expected" = "pass" ] && [ "$status" -eq 0 ]; } || { [ "$expected" = "fail" ] && [ "$status" -ne 0 ]; }; then
    printf 'ok - %s\n' "$name"
    PASS_COUNT=$((PASS_COUNT + 1))
  else
    printf 'not ok - %s\n' "$name" >&2
    printf 'expected: %s, status: %s\n%s\n' "$expected" "$status" "$output" >&2
    FAIL_COUNT=$((FAIL_COUNT + 1))
  fi
}

valid_review_writes_receipt() {
  local fake output status artifact receipt sidecar result
  fake="$TMPDIR/codex-valid"
  write_valid_codex "$fake"
  rm -f "$TMPDIR/codex-args" "$TMPDIR/codex-prompt"

  output="$(
    cd "$ROOT" &&
      CODEX_BIN="$fake" \
      SECURITY_REVIEW_TIMEOUT_SECONDS=30 \
      "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 claude-opus-4-8 2>&1
  )"
  status=$?
  artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)
  receipt=$(printf '%s\n' "$output" | sed -n 's/^Review receipt:[[:space:]]*//p' | head -1)
  sidecar=$(printf '%s\n' "$output" | sed -n 's/^Attempt JSON:[[:space:]]*//p' | head -1)

  [ "$status" -eq 0 ] &&
    [ -f "$ROOT/$artifact" ] &&
    [ -f "$ROOT/$receipt" ] &&
    [ -f "$ROOT/$sidecar" ] &&
    grep -Fxq -- '--model' "$TMPDIR/codex-args" &&
    grep -Fxq -- 'gpt-5.5' "$TMPDIR/codex-args" &&
    grep -q '"review_kind": "security"' "$ROOT/$receipt" &&
    grep -q '"status": "clear"' "$ROOT/$receipt" &&
    grep -q '"schema_version": 2' "$ROOT/$receipt" &&
    grep -q '"scope_hash":' "$ROOT/$receipt" &&
    grep -q '"scope_paths":' "$ROOT/$receipt" &&
    grep -q '"reviewed_candidate_sha":' "$ROOT/$receipt" &&
    "$ROOT/scripts/review-attempt" validate-receipt "$receipt" --require-scoped >/dev/null 2>&1 &&
    ! git -C "$ROOT" check-ignore -q "$receipt" &&
    git -C "$ROOT" check-ignore -q "$artifact" &&
    git -C "$ROOT" check-ignore -q "$sidecar"
  result=$?
  cleanup_generated "$output"
  return "$result"
}

remote_first_base_is_used() {
  local fake output status receipt expected result
  fake="$TMPDIR/codex-remote-first"
  write_valid_codex "$fake"
  expected=$(git -C "$ROOT" merge-base HEAD origin/master)

  output="$(
    cd "$ROOT" &&
      CODEX_BIN="$fake" \
      SECURITY_REVIEW_TIMEOUT_SECONDS=30 \
      "$RUNNER" "$FEATURE" "$TASK_ID" review "" claude-opus-test 2>&1
  )"
  status=$?
  receipt=$(printf '%s\n' "$output" | sed -n 's/^Review receipt:[[:space:]]*//p' | head -1)
  [ "$status" -eq 0 ] &&
    grep -q "BASE SHA: $expected" "$TMPDIR/codex-prompt" &&
    grep -q "\"base_sha\": \"$expected\"" "$ROOT/$receipt"
  result=$?
  cleanup_generated "$output"
  return "$result"
}

post_cutoff_claim_base_rejects_partial_assertion() {
  local fake invalid_output output result status
  fake="$TMPDIR/codex-claim-base"
  write_valid_codex "$fake"
  git -C "$ROOT" checkout --quiet --detach "$CLAIM_C2"
  rm -f "$TMPDIR/codex-args" "$TMPDIR/codex-prompt"
  invalid_output="$(cd "$ROOT" && CODEX_BIN="$fake" "$RUNNER" "$CLAIM_FEATURE" "$CLAIM_TASK" review "$CLAIM_C1" claude-opus-test 2>&1)"
  status=$?; result=0
  [ "$status" -eq 3 ] && [ ! -f "$TMPDIR/codex-args" ] \
    && printf '%s\n' "$invalid_output" | grep -q "expected derived review base $CLAIM_C0" \
    && { [ ! -d "$CLAIM_DIR/review-receipts" ] || [ -z "$(find "$CLAIM_DIR/review-receipts" -type f -print -quit)" ]; } || result=1
  if [ "$result" -ne 0 ]; then git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"; return 1; fi
  output="$(cd "$ROOT" && CODEX_BIN="$fake" "$RUNNER" "$CLAIM_FEATURE" "$CLAIM_TASK" review "$CLAIM_C0" claude-opus-test 2>&1)"
  status=$?
  [ "$status" -eq 0 ] && grep -q "BASE SHA: $CLAIM_C0" "$TMPDIR/codex-prompt" \
    && grep -q 'deleted file mode' "$TMPDIR/codex-prompt" \
    && grep -q 'SEC_PRE_CLAIM_DELETE_MARKER' "$TMPDIR/codex-prompt" \
    && grep -q 'SEC_C2_NEW_OWNED_MARKER' "$TMPDIR/codex-prompt"
  result=$?
  cleanup_generated "$output"
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  return "$result"
}

