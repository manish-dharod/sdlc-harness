model_mismatch_is_rejected() {
  local fake status
  fake="$TMPDIR/codex-model-mismatch"
  write_valid_codex "$fake"
  rm -f "$TMPDIR/codex-args"
  (
    cd "$ROOT" &&
      CODEX_BIN="$fake" \
      SECURITY_REVIEW_MODEL=gpt-unpinned \
      "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 claude-opus-test
  ) >/dev/null 2>&1
  status=$?
  [ "$status" -eq 3 ] && [ ! -f "$TMPDIR/codex-args" ]
}

timeout_is_bounded() {
  local fake output status artifact sidecar child_pid result
  fake="$TMPDIR/codex-sleep"
  write_sleeping_codex "$fake"

  output="$(
    cd "$ROOT" &&
      CODEX_BIN="$fake" \
      SECURITY_REVIEW_TIMEOUT_SECONDS=1 \
      "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 claude-opus-test 2>&1
  )"
  status=$?
  artifact=$(printf '%s\n' "$output" | sed -n 's/.*Artifact written to //p' | sed 's/[[:space:]]*$//' | head -1)
  sidecar="${artifact%.md}.attempt.json"
  child_pid=$(cat "$TMPDIR/sleep-child-pid" 2>/dev/null || true)
  sleep 1

  [ "$status" -eq 124 ] &&
    [ -f "$ROOT/$artifact" ] &&
    [ -f "$ROOT/$sidecar" ] &&
    grep -q '"status": "timeout"' "$ROOT/$sidecar" &&
    grep -q '"exit_code": 124' "$ROOT/$sidecar" &&
    grep -q 'timed out after 1s' "$ROOT/$artifact" &&
    [ -n "$child_pid" ] &&
    ! kill -0 "$child_pid" 2>/dev/null
  result=$?
  cleanup_generated "$output"
  return "$result"
}

invalid_timeout_is_rejected() {
  local fake status
  fake="$TMPDIR/codex-invalid-timeout"
  write_valid_codex "$fake"
  rm -f "$TMPDIR/codex-args"
  (
    cd "$ROOT" &&
      CODEX_BIN="$fake" \
      SECURITY_REVIEW_TIMEOUT_SECONDS=abc \
      "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 claude-opus-test
  ) >/dev/null 2>&1
  status=$?
  [ "$status" -eq 3 ] && [ ! -f "$TMPDIR/codex-args" ]
}

private_temp_context_is_always_cleaned() {
  local artifact fake isolated output receipt status
  isolated="$TMPDIR/private-temp-security"
  fake="$TMPDIR/codex-temp-cleanup"
  rm -rf "$isolated"; mkdir -p "$isolated"
  write_valid_codex "$fake"
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  printf '\nsecurity dirty temp probe\n' >> "$ROOT/docs/features/$FEATURE/TASKS.md"
  rm -f "$TMPDIR/codex-args"
  output="$(cd "$ROOT" && TMPDIR="$isolated" CODEX_BIN="$fake" "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 claude-opus-test 2>&1)"
  status=$?
  git -C "$ROOT" restore --worktree --staged "docs/features/$FEATURE/TASKS.md"
  [ "$status" -eq 3 ] && [ ! -f "$TMPDIR/codex-args" ] && [ -z "$(find "$isolated" -mindepth 1 -print -quit)" ] || return 1
  output="$(cd "$ROOT" && TMPDIR="$isolated" CODEX_BIN="$fake" "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 claude-opus-test 2>&1)"
  status=$?
  artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)
  receipt=$(printf '%s\n' "$output" | sed -n 's/^Review receipt:[[:space:]]*//p' | head -1)
  [ "$status" -eq 0 ] && [ -z "$(find "$isolated" -mindepth 1 -print -quit)" ]
  status=$?
  cleanup_generated "$output"
  return "$status"
}

review_resume_preserves_full_canonical_diff() {
  local diff_bytes fake output result status
  fake="$TMPDIR/codex-resume-large-diff"
  write_valid_codex "$fake"
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  python3 -c 'print("r" * 185000)' > "$ROOT/docs/features/$FEATURE/resume-large-diff.txt"
  git -C "$ROOT" add "docs/features/$FEATURE/resume-large-diff.txt"
  git -C "$ROOT" commit --quiet -m 'test: security resume large diff candidate'
  output="$(cd "$ROOT" && CODEX_BIN="$fake" "$RUNNER" "$FEATURE" "$TASK_ID" review-resume HEAD~1 claude-opus-test 2>&1)"
  status=$?
  diff_bytes=$(sed -n 's/.*; \([0-9][0-9]*\) canonical diff bytes.*/\1/p' "$TMPDIR/codex-prompt" | head -1)
  [ "$status" -eq 0 ] && grep -q '^MODE: review-resume$' "$TMPDIR/codex-prompt" \
    && [ "${diff_bytes:-0}" -gt 150000 ]
  result=$?
  cleanup_generated "$output"
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  return "$result"
}

invalid_base_is_rejected() {
  local fake status
  fake="$TMPDIR/codex-invalid-base"
  write_valid_codex "$fake"
  rm -f "$TMPDIR/codex-args"
  (
    cd "$ROOT" &&
      CODEX_BIN="$fake" \
      "$RUNNER" "$FEATURE" "$TASK_ID" review refs/heads/does-not-exist-$$ claude-opus-test
  ) >/dev/null 2>&1
  status=$?
  [ "$status" -eq 3 ] && [ ! -f "$TMPDIR/codex-args" ]
}

untracked_task_owned_change_is_rejected() {
  local fake output owned_path status
  fake="$TMPDIR/codex-dirty"
  write_valid_codex "$fake"
  rm -f "$TMPDIR/codex-args"
  owned_path="$ROOT/docs/features/$FEATURE/owned-untracked.txt"
  printf 'fixture\n' > "$owned_path"

  output="$(
    cd "$ROOT" &&
      CODEX_BIN="$fake" \
      "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 claude-opus-test 2>&1
  )"
  status=$?
  rm -f "$owned_path"
  [ "$status" -eq 3 ] &&
    printf '%s\n' "$output" | grep -Eq 'task-scoped staged|owned-untracked' &&
    [ ! -f "$TMPDIR/codex-args" ]
}

unrelated_dirty_path_is_allowed() {
  local fake output status unrelated
  fake="$TMPDIR/codex-unrelated-dirty"
  unrelated="$ROOT/unrelated-user-work-$$.txt"
  write_valid_codex "$fake"
  printf 'preserve unrelated user work\n' > "$unrelated"
  output="$((
    cd "$ROOT" &&
      CODEX_BIN="$fake" \
      "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 claude-opus-test
  ) 2>&1)"
  status=$?
  rm -f "$unrelated"
  cleanup_generated "$output"
  [ "$status" -eq 0 ] && [ -f "$TMPDIR/codex-args" ]
}

staged_task_owned_change_is_detected() {
  local fake_bin feature_dir output slug status
  slug="_test-security-review-staged-$$"
  feature_dir="$ROOT/docs/features/$slug"
  fake_bin="$TMPDIR/fake-git-bin"
  mkdir -p "$feature_dir" "$fake_bin"
  printf 'medium\n' > "$feature_dir/.tier"
  cat > "$feature_dir/TASKS.md" <<EOF
### TASK-STAGED: staged-scope fixture

- Status: Review
- Intended file ownership:
  - scripts/staged-fixture.txt
- Verification:
  - scripts/test-security-review
EOF
  cat > "$fake_bin/git" <<'EOF'
#!/usr/bin/env bash
if [ "${1:-}" = "diff" ] && [ "${2:-}" = "--cached" ]; then
  printf 'scripts/staged-fixture.txt\0'
fi
exit 0
EOF
  chmod +x "$fake_bin/git"
  output=$(PATH="$fake_bin:$PATH" "$ROOT/scripts/review-attempt" dirty-owned "$slug" TASK-STAGED 2>&1)
  status=$?
  rm -rf "$feature_dir"
  [ "$status" -eq 1 ] && [ "$output" = "staged|scripts/staged-fixture.txt" ]
}

security_clear_with_finding_record_is_invalid() {
  local artifact status
  artifact="$TMPDIR/security-clear-with-finding.md"
  cat > "$artifact" <<'EOF'
### Findings
#### SEC-FND-001
- Severity: P1

### Verdict
- SECURITY CLEAR
- Reason: contradictory fixture
EOF
  status=$("$ROOT/scripts/review-attempt" status security "$artifact" 2>/dev/null || true)
  [ "$status" = "invalid-output" ]
}

empty_head_review_is_rejected() {
  local fake output status
  fake="$TMPDIR/codex-empty-head"
  write_valid_codex "$fake"
  rm -f "$TMPDIR/codex-args" "$TMPDIR/codex-prompt"
  output="$((
    cd "$ROOT" &&
      CODEX_BIN="$fake" \
      "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD claude-opus-test
  ) 2>&1)"
  status=$?
  [ "$status" -eq 3 ] &&
    printf '%s\n' "$output" | grep -Eq 'canonical diff is empty|no owned committed change' &&
    [ ! -f "$TMPDIR/codex-args" ] &&
    ! printf '%s\n' "$output" | grep -q '^Review receipt:'
}

oversized_context_is_rejected_without_receipt() {
  local base fake output status
  fake="$TMPDIR/codex-context-too-large"
  base=$(git -C "$ROOT" rev-list --max-parents=0 HEAD | head -1)
  write_valid_codex "$fake"
  rm -f "$TMPDIR/codex-args" "$TMPDIR/codex-prompt"
  git -C "$ROOT" checkout --quiet --detach "$LARGE_SHA"
  output="$((
    cd "$ROOT" &&
      CODEX_BIN="$fake" \
      "$RUNNER" "$LARGE_FEATURE" TASK-LARGE review HEAD~1 claude-opus-test
  ) 2>&1)"
  status=$?
  local result
  [ "$status" -eq 3 ] &&
    printf '%s\n' "$output" | grep -Eq 'canonical diff exceeds hard 280000 byte limit|refusing a truncated review' &&
    [ ! -f "$TMPDIR/codex-args" ] &&
    ! printf '%s\n' "$output" | grep -q '^Review receipt:'
  result=$?
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  return "$result"
}

