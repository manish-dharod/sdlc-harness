receipt_failure_writes_retryable_incomplete_sidecar() {
  local artifact blocker fake output result sidecar status
  fake="$TMPDIR/codex-receipt-error"
  blocker="$ROOT/docs/features/$FEATURE/review-receipts"
  write_valid_codex "$fake"
  rm -rf "$blocker"
  mkdir -p "$blocker"
  chmod 500 "$blocker"

  output="$((
    cd "$ROOT" &&
      CODEX_BIN="$fake" \
      "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 claude-opus-test
  ) 2>&1)"
  status=$?
  artifact=$(printf '%s\n' "$output" | sed -n 's/.*Artifact written to //p' | sed 's/[[:space:]]*$//' | head -1)
  sidecar=$(printf '%s\n' "$output" | sed -n 's/^Attempt sidecar: \([^[:space:]]*\).*/\1/p' | tail -1)

  [ "$status" -eq 2 ] &&
    [ -n "$sidecar" ] && [ -f "$ROOT/$sidecar" ] &&
    grep -q '"status": "incomplete"' "$ROOT/$sidecar" &&
    grep -q '"failure_reason": "receipt-error"' "$ROOT/$sidecar" &&
    grep -q '"retryable": true' "$ROOT/$sidecar" &&
    ! grep -q '"status": "clear"' "$ROOT/$sidecar"
  result=$?

  chmod 700 "$blocker" 2>/dev/null || true
  rmdir "$blocker" 2>/dev/null || true
  [ -n "$artifact" ] && rm -f "$ROOT/$artifact" "$ROOT/${artifact%/*}/._${artifact##*/}"
  [ -n "$sidecar" ] && rm -f "$ROOT/$sidecar" "$ROOT/${sidecar%/*}/._${sidecar##*/}"
  return "$result"
}

security_signal_preserves_exit_and_kills_group() {
  local expected fake output signal_name
  for signal_name in INT TERM; do
    [ "$signal_name" = "INT" ] && expected=130 || expected=143
    fake="$TMPDIR/codex-signal-${signal_name}"
    output="$TMPDIR/security-signal-${signal_name}.out"
    rm -f "$TMPDIR/sleep-child-pid"
    write_sleeping_codex "$fake"
    python3 - "$ROOT" "$RUNNER" "$FEATURE" "$TASK_ID" "$fake" "$TMPDIR/sleep-child-pid" "$output" "$signal_name" "$expected" <<'PY' || return 1
import os, signal, subprocess, sys, time
root, runner, feature, task, fake, child_file, output, signal_name, expected = sys.argv[1:]
env = os.environ.copy()
env.update({"CODEX_BIN": fake, "SECURITY_REVIEW_TIMEOUT_SECONDS": "30"})
with open(output, "wb") as handle:
    proc = subprocess.Popen(
        [runner, feature, task, "review", "HEAD~1", "claude-opus-test"],
        cwd=root, env=env, stdout=handle, stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    for _ in range(100):
        if os.path.exists(child_file) and os.path.getsize(child_file):
            break
        time.sleep(0.05)
    else:
        proc.kill(); proc.wait(); raise SystemExit(1)
    child = int(open(child_file, encoding="ascii").read().strip())
    os.killpg(proc.pid, getattr(signal, "SIG" + signal_name))
    status = proc.wait(timeout=10)
    time.sleep(0.2)
    try:
        os.kill(child, 0)
    except ProcessLookupError:
        alive = False
    else:
        alive = True
        try: os.kill(child, signal.SIGKILL)
        except ProcessLookupError: pass
    if status != int(expected) or alive:
        raise SystemExit(1)
PY
    find "$ROOT/docs/features/$FEATURE/security" -type f -name "*${TASK_ID}*" -delete 2>/dev/null || true
  done
}

