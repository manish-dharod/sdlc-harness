  [ "$status" -eq 3 ] && printf '%s\n' "$output" | grep -q 'info/grafts'
}

scoped_receipt_schema_and_hash_sanitizer() {
  local backup diff_hash extra_human extra_pan extra_receipt human receipt scope status weird_hash weird_prefix
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  scope="$TMPDIR/scope.json"
  receipt="docs/features/$FEATURE/review-receipts/scoped-fixture.json"
  mkdir -p "$ROOT/docs/features/$FEATURE/review-receipts"
  "$ROOT/scripts/review-attempt" scope-json "$FEATURE" "$TASK_ID" "$BASE_SHA" "$PRIMARY_SHA" > "$scope" || return 1
  diff_hash=$("$ROOT/scripts/review-attempt" canonical-diff-hash "$BASE_SHA" "$PRIMARY_SHA" "$FEATURE" "$TASK_ID") || return 1
  weird_prefix="41111111""11111111"
  weird_hash="${weird_prefix}aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  "$ROOT/scripts/review-attempt" write-receipt "$receipt" \
    schema_version=2 feature="$FEATURE" task_id="$TASK_ID" \
    review_kind=adversary status=clear \
    implementer_tool=codex-app implementer_model=gpt-5-test \
    reviewer_tool=claude-code reviewer_model=claude-opus-4-8 \
    base_sha="$BASE_SHA" reviewed_candidate_sha="$PRIMARY_SHA" \
    canonical_diff_hash="$diff_hash" prompt_hash="$weird_hash" \
    transcript_hash=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb \
    reviewed_at=2026-07-10T20:00:00Z scope_json_file="$scope" >/dev/null || return 1
  human="$TMPDIR/receipt-human.txt"
  "$ROOT/scripts/review-attempt" validate-receipt "$receipt" --require-scoped >/dev/null 2>&1 &&
    "$ROOT/scripts/review-attempt" validate-receipt "$receipt" --schema-only >/dev/null 2>&1 &&
    ! "$ROOT/scripts/review-attempt" validate-receipt "$receipt" --require-scoped --schema-only >/dev/null 2>&1 &&
    ! "$ROOT/scripts/review-attempt" validate-receipt "$receipt" --schema-only --require-scoped >/dev/null 2>&1 &&
    ! "$ROOT/scripts/review-attempt" validate-receipt "$receipt" --schema-only --schema-only >/dev/null 2>&1 &&
    ! "$ROOT/scripts/review-attempt" validate-receipt "$receipt" --unknown-option >/dev/null 2>&1 &&
    "$ROOT/scripts/review-attempt" receipt-human-fields "$ROOT/$receipt" > "$human" &&
    ! grep -q "$weird_prefix" "$human" &&
    grep -q '^schema_version=2$' "$human" &&
    grep -q '^feature=' "$human" &&
    grep -q '^task_id=' "$human" &&
    grep -q '^scope_path=' "$human" &&
    sg_result=0 || sg_result=1
  . "$ROOT/scripts/lib-sanitize.sh"
  git -C "$ROOT" replace "$PRIMARY_SHA" "$BASE_SHA"
  "$ROOT/scripts/review-attempt" validate-receipt "$receipt" --require-scoped >/dev/null 2>&1 || sg_result=1
  git -C "$ROOT" replace -d "$PRIMARY_SHA" >/dev/null
  sg_sanitize_scan_file "$human" >/dev/null 2>&1 || sg_result=1
  sg_sanitize_scan_file "$ROOT/$receipt" >/dev/null 2>&1 && sg_result=1 || true
  "$ROOT/scripts/sanitize-check" "$ROOT/$receipt" >/dev/null 2>&1 || sg_result=1
  extra_receipt="docs/features/$FEATURE/review-receipts/scoped-extra-field-fixture.json"
  extra_human="$TMPDIR/scoped-extra-field-human.txt"
  extra_pan="55""00000000000004"
  python3 - "$ROOT/$receipt" "$ROOT/$extra_receipt" "$extra_pan" <<'PY' || sg_result=1
import json, sys
source, destination, value = sys.argv[1:]
with open(source, encoding="utf-8") as handle:
    receipt = json.load(handle)
receipt["operator_note"] = value
with open(destination, "w", encoding="utf-8") as handle:
    json.dump(receipt, handle, indent=2, sort_keys=True)
    handle.write("\n")
PY
  "$ROOT/scripts/review-attempt" receipt-human-fields "$ROOT/$extra_receipt" > "$extra_human" || sg_result=1
  grep -q "^operator_note=$extra_pan$" "$extra_human" || sg_result=1
  sg_sanitize_scan_file "$extra_human" >/dev/null 2>&1 && sg_result=1 || true
  "$ROOT/scripts/sanitize-check" "$ROOT/$extra_receipt" >/dev/null 2>&1 && sg_result=1 || true
  rm -f "$ROOT/$extra_receipt"
  git -C "$ROOT" checkout --quiet --detach "$BASE_SHA" || sg_result=1
  "$ROOT/scripts/sanitize-check" "$ROOT/$receipt" >/dev/null 2>&1 || sg_result=1
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA" || sg_result=1
  backup="$TMPDIR/scoped-receipt-backup.json"
  mv "$ROOT/$receipt" "$backup" || sg_result=1
  ln -s "$backup" "$ROOT/$receipt" || sg_result=1
  "$ROOT/scripts/sanitize-check" "$ROOT/$receipt" >/dev/null 2>&1 && sg_result=1 || true
  rm -f "$ROOT/$receipt"
  mv "$backup" "$ROOT/$receipt" || sg_result=1
  mv "$ROOT/$receipt" "$backup" || sg_result=1
  ln -s "$TMPDIR/nonexistent-receipt-target.json" "$ROOT/$receipt" || sg_result=1
  "$ROOT/scripts/sanitize-check" "$ROOT/$receipt" >/dev/null 2>&1 && sg_result=1 || true
  rm -f "$ROOT/$receipt"
  mv "$backup" "$ROOT/$receipt" || sg_result=1
  "$ROOT/scripts/sanitize-check" \
    "$ROOT/docs/features/$FEATURE/review-receipts/missing-explicit-receipt.json" >/dev/null 2>&1 && sg_result=1 || true
  rm -f "$ROOT/$receipt"
  return "$sg_result"
}

