run_case "default review base is remote-first merge base" pass remote_first_merge_base_is_used
run_case "positional base override selects its merge base" pass positional_base_override_is_used
run_case "invalid positional base fails closed" pass invalid_positional_base_rejected
run_case "untracked task-owned diff fails closed" pass untracked_task_owned_change_rejected

