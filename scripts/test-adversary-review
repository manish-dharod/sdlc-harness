candidate_attributes_and_hostile_config_are_stable() {
  local attr_backup baseline changed global_attrs global_config result
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  baseline=$("$ROOT/scripts/review-attempt" canonical-diff-hash "$BASE_SHA" "$PRIMARY_SHA" "$FEATURE" "$TASK_ID") || return 1
  attr_backup="$TMPDIR/gitattributes.backup"
  if git -C "$ROOT" cat-file -e "$PRIMARY_SHA:.gitattributes" 2>/dev/null; then
    git -C "$ROOT" cat-file -p "$PRIMARY_SHA:.gitattributes" > "$attr_backup"
  else
    : > "$attr_backup.absent"
  fi
  printf '* diff=hostile\n' > "$ROOT/.gitattributes"
  global_attrs="$TMPDIR/global-attributes"
  global_config="$TMPDIR/global-gitconfig"
  printf '* diff=global-hostile\n' > "$global_attrs"
  cat > "$global_config" <<EOF
[core]
  attributesFile = $global_attrs
[diff]
  context = 99
  renames = copies
EOF
  changed=$(GIT_CONFIG_GLOBAL="$global_config" GIT_EXTERNAL_DIFF=/bin/false \
    "$ROOT/scripts/review-attempt" canonical-diff-hash "$BASE_SHA" "$PRIMARY_SHA" "$FEATURE" "$TASK_ID")
  result=0
  [ "$baseline" = "$changed" ] || result=1
  if [ -f "$attr_backup.absent" ]; then
    rm -f "$ROOT/.gitattributes"
  else
    cp "$attr_backup" "$ROOT/.gitattributes"
  fi
  return "$result"
}

info_attributes_fail_closed() {
