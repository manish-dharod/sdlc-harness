#!/usr/bin/env bash
# Regression tests for scripts/adversary-review wrapper behavior.

set -u

SOURCE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TEST_ROOT="$(mktemp -d)"
git clone --quiet --shared "$SOURCE_ROOT" "$TEST_ROOT/repo"
ROOT="$TEST_ROOT/repo"
mkdir -p "$TEST_ROOT/runtime"
TMPDIR="$TEST_ROOT/runtime"
git -C "$ROOT" config user.name sdlc-test
git -C "$ROOT" config user.email sdlc-test@example.invalid
BASE_SHA=$(git -C "$ROOT" rev-parse HEAD)
RUNNER="$ROOT/scripts/claude-adversary-review"
FEATURE="_test-adversary-review-wrapper-$$"
TASK_ID="TASK-272-TEST-$$"
ADVERSARY_DIR="$ROOT/docs/features/$FEATURE/adversary"
SNAPSHOT_FEATURE="_test-adversary-review-snapshot-$$"
SNAPSHOT_TASK="TASK-SNAPSHOT-$$"
SNAPSHOT_DIR="$ROOT/docs/features/$SNAPSHOT_FEATURE"
SNAPSHOT_OWNED_A_REL="docs/features/$SNAPSHOT_FEATURE/000-snapshot-owned-a.txt"
SNAPSHOT_OWNED_B_REL="docs/features/$SNAPSHOT_FEATURE/001-snapshot-owned-b.txt"
SNAPSHOT_HUGE_REL="docs/features/$SNAPSHOT_FEATURE/999-huge-single-line.txt"
SNAPSHOT_OWNED_A="$ROOT/$SNAPSHOT_OWNED_A_REL"
SNAPSHOT_OWNED_B="$ROOT/$SNAPSHOT_OWNED_B_REL"
SANITIZER_FEATURE="_test-adversary-review-sanitize-$$"
SANITIZER_DIR="$ROOT/docs/features/$SANITIZER_FEATURE"
LARGE_FEATURE="_test-adversary-review-large-$$"
LARGE_DIR="$ROOT/docs/features/$LARGE_FEATURE"
TIER_FEATURE="_test-adversary-review-tier-$$"
TIER_TASK="TASK-TIER-$$"
TIER_DIR="$ROOT/docs/features/$TIER_FEATURE"
CLAIM_FEATURE="_test-adversary-claim-base-$$"
CLAIM_TASK="TASK-CLAIM-$$"
CLAIM_REL="docs/features/$CLAIM_FEATURE"
CLAIM_DIR="$ROOT/$CLAIM_REL"
RUN_MARKER="$TMPDIR/run-marker"
PASS_COUNT=0
FAIL_COUNT=0
touch "$RUN_MARKER"
mkdir -p "$ROOT/docs/features/$FEATURE"
printf 'medium\n' > "$ROOT/docs/features/$FEATURE/.tier"
cat > "$ROOT/docs/features/$FEATURE/TASKS.md" <<EOF
### $TASK_ID: focused wrapper fixture

- Status: Review
- AC IDs: AC-016
- Type: workflow
- Intended file ownership:
  - docs/features/$FEATURE/
- Verification:
  - scripts/test-adversary-review
EOF
git -C "$ROOT" add "docs/features/$FEATURE"
git -C "$ROOT" commit --quiet -m 'test: add adversary primary fixture'
PRIMARY_SHA=$(git -C "$ROOT" rev-parse HEAD)

mkdir -p "$SNAPSHOT_DIR"
awk 'BEGIN { for (i=0; i<80000; i++) printf "bounded-committed-blob-%06d-abcdefghijklmnopqrstuvwxyz", i }' > "$ROOT/$SNAPSHOT_HUGE_REL"
git -C "$ROOT" add "$SNAPSHOT_HUGE_REL"
git -C "$ROOT" commit --quiet -m 'test: add pre-existing huge snapshot blob'
SNAPSHOT_BASE_SHA=$(git -C "$ROOT" rev-parse HEAD)
printf 'medium\n' > "$SNAPSHOT_DIR/.tier"
cat > "$SNAPSHOT_DIR/TASKS.md" <<EOF
### $SNAPSHOT_TASK: isolated snapshot fixture

- Status: Review
- AC IDs: AC-016
- Type: workflow
- Intended file ownership:
  - docs/features/$SNAPSHOT_FEATURE/
- Verification:
  - scripts/test-adversary-review
EOF
printf 'SNAPSHOT_FIXTURE_MARKER\n' > "$SNAPSHOT_OWNED_A"
: > "$SNAPSHOT_OWNED_B"
snapshot_line=0
while [ "$snapshot_line" -lt 300 ]; do
  printf 'snapshot fixture line %03d with deterministic bounded content\n' "$snapshot_line" >> "$SNAPSHOT_OWNED_B"
  snapshot_line=$((snapshot_line + 1))
done
git -C "$ROOT" add "docs/features/$SNAPSHOT_FEATURE"
git -C "$ROOT" commit --quiet -m 'test: add adversary snapshot fixture'
SNAPSHOT_SHA=$(git -C "$ROOT" rev-parse HEAD)

mkdir -p "$SANITIZER_DIR"
printf 'medium\n' > "$SANITIZER_DIR/.tier"
cat > "$SANITIZER_DIR/TASKS.md" <<EOF
### TASK-SAN: sanitizer fixture

- Status: Review
- AC IDs: AC-SAN
- Type: infra
- Intended file ownership:
  - docs/features/$SANITIZER_FEATURE/
- Verification:
  - scripts/test-adversary-review
EOF
printf '%s\n' "api_key=ABCD""EFGHIJKLMNOPQRSTUVWXYZ" > "$SANITIZER_DIR/owned-sensitive.txt"
git -C "$ROOT" add "docs/features/$SANITIZER_FEATURE"
git -C "$ROOT" commit --quiet -m 'test: add adversary sanitizer fixture'
SANITIZER_SHA=$(git -C "$ROOT" rev-parse HEAD)

mkdir -p "$LARGE_DIR"
printf 'medium\n' > "$LARGE_DIR/.tier"
cat > "$LARGE_DIR/TASKS.md" <<EOF
### TASK-LARGE: oversized fixture

- Status: Review
- AC IDs: AC-LARGE
- Type: workflow
- Intended file ownership:
  - docs/features/$LARGE_FEATURE/
- Verification:
  - scripts/test-adversary-review
EOF
awk 'BEGIN { for (i=0; i<15000; i++) printf "owned canonical review line %06d abcdefghijklmnopqrstuvwxyz\n", i }' > "$LARGE_DIR/large.txt"
git -C "$ROOT" add "docs/features/$LARGE_FEATURE"
git -C "$ROOT" commit --quiet -m 'test: add adversary oversized fixture'
LARGE_SHA=$(git -C "$ROOT" rev-parse HEAD)
git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
mkdir -p "$TIER_DIR"
printf 'medium\n' > "$TIER_DIR/.tier"
git -C "$ROOT" add "docs/features/$TIER_FEATURE/.tier"
git -C "$ROOT" commit --quiet -m 'test: add committed tier fixture base'
TIER_BASE_SHA=$(git -C "$ROOT" rev-parse HEAD)
cat > "$TIER_DIR/TASKS.md" <<EOF
### $TIER_TASK: committed tier context fixture

- Status: Review
- AC IDs: AC-TIER
- Type: workflow
- Intended file ownership:
  - docs/features/$TIER_FEATURE/TASKS.md
- Verification:
  - scripts/test-adversary-review
EOF
git -C "$ROOT" add "docs/features/$TIER_FEATURE/TASKS.md"
git -C "$ROOT" commit --quiet -m 'test: add committed tier fixture task'
TIER_SHA=$(git -C "$ROOT" rev-parse HEAD)
git -C "$ROOT" checkout --quiet --detach "$BASE_SHA"
mkdir -p "$CLAIM_DIR"
printf 'medium\n' > "$CLAIM_DIR/.tier"
cat > "$CLAIM_DIR/TASKS.md" <<EOF
### $CLAIM_TASK: post-cutoff base fixture

- Status: Open
- Intended file ownership:
  - docs/features/$CLAIM_FEATURE/
EOF
printf 'PRE_CLAIM_DELETE_MARKER\n' > "$CLAIM_DIR/deleted-owned.txt"
git -C "$ROOT" add "docs/features/$CLAIM_FEATURE" && git -C "$ROOT" commit --quiet -m 'test: add claim-base fixture'
CLAIM_B=$(git -C "$ROOT" rev-parse HEAD)
cat > "$CLAIM_DIR/TASKS.md" <<EOF
### $CLAIM_TASK: post-cutoff base fixture

- Status: Claimed
- Claimed at: 2026-07-10 14:00 PDT
- Intended file ownership:
  - docs/features/$CLAIM_FEATURE/
EOF
git -C "$ROOT" add "$CLAIM_REL/TASKS.md" && git -C "$ROOT" commit --quiet -m 'test: dedicated post-cutoff claim'
CLAIM_C0=$(git -C "$ROOT" rev-parse HEAD)
git -C "$ROOT" rm --quiet "$CLAIM_REL/deleted-owned.txt" && git -C "$ROOT" commit --quiet -m 'test: delete owned file after claim'
CLAIM_C1=$(git -C "$ROOT" rev-parse HEAD)
printf 'C2_NEW_OWNED_MARKER\n' > "$CLAIM_DIR/cosmetic-owned.txt"
git -C "$ROOT" add "$CLAIM_REL/cosmetic-owned.txt" && git -C "$ROOT" commit --quiet -m 'test: add owned cosmetic change'
CLAIM_C2=$(git -C "$ROOT" rev-parse HEAD)
git -C "$ROOT" update-ref refs/remotes/origin/master "$BASE_SHA"
git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"

cleanup() {
  rm -rf "$TEST_ROOT"
}
trap cleanup EXIT

write_sleeping_claude() {
  local file="$1"
  cat > "$file" <<EOF
#!/usr/bin/env bash
cat >/dev/null
sleep 30 &
printf '%s\n' "\$!" > "$TMPDIR/sleep-child-pid"
wait
EOF
  chmod +x "$file"
}

write_valid_claude() {
  local file="$1"
  cat > "$file" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$@" > "$TMPDIR/claude-args"
cat > "$TMPDIR/claude-prompt"
cat <<'OUT'
\`\`\`markdown
## Adversarial review: fake

### Routing
- Mode: review-narrow
- Diff scope: fake

### Categories
- false-confidence: n/a: fake test reviewer
- missed-edge: n/a: fake test reviewer
- spec-loophole: n/a: fake test reviewer
- hidden-coupling: n/a: fake test reviewer
- negative-path: n/a: fake test reviewer
- env-assumption: n/a: fake test reviewer
- rollback-gap: n/a: fake test reviewer
- stale-evidence: n/a: fake test reviewer
- traceability-mismatch: n/a: fake test reviewer
- tests-pass-behavior-wrong: n/a: fake test reviewer

### Findings (only validated hypotheses)
(no findings)

### Verdict
- ADVERSARIAL CLEAR
- Reason: fake clear for wrapper regression test
\`\`\`
OUT
EOF
  chmod +x "$file"
}

run_case() {
  local name="$1"
  local expected="$2"
  shift 2
  local output status

  output="$("$@" 2>&1)"
  status=$?

  if { [ "$expected" = "pass" ] && [ "$status" -eq 0 ]; } || { [ "$expected" = "fail" ] && [ "$status" -ne 0 ]; }; then
    printf 'ok - %s\n' "$name"
    PASS_COUNT=$((PASS_COUNT + 1))
  else
    printf 'not ok - %s\n' "$name" >&2
    printf 'expected: %s, status: %s\n%s\n' "$expected" "$status" "$output" >&2
    FAIL_COUNT=$((FAIL_COUNT + 1))
  fi
}

timeout_reports_unavailable() {
  local artifact fake generated_artifacts marker output status child_pid sidecar
  fake="$TMPDIR/claude-sleep"
  marker="$TMPDIR/before-timeout"
  write_sleeping_claude "$fake"
  touch "$marker"

  output="$((
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      ADVERSARY_REVIEW_TIMEOUT_SECONDS=1 \
      CLAUDE_ADVERSARY_EFFORT=max \
      "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test
  ) 2>&1)"
  status=$?

  generated_artifacts=$(printf '%s\n' "$output" | sed -n 's/.*Artifact written to //p' | sed 's/[[:space:]]*$//' | sort -u)
  artifact=$(printf '%s\n' "$generated_artifacts" | head -1)
  sidecar="${artifact%.md}.attempt.json"
  child_pid=""
  if [ -f "$TMPDIR/sleep-child-pid" ]; then
    child_pid="$(cat "$TMPDIR/sleep-child-pid")"
  fi
  sleep 1

  [ "$status" -eq 124 ] &&
    [ -n "$artifact" ] &&
    [ -f "$ROOT/$artifact" ] &&
    [ -f "$ROOT/$sidecar" ] &&
    printf '%s\n' "$artifact" | grep -Eq "/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{6}Z-${TASK_ID}-claude-code-attempt-[0-9]+-[0-9a-f]+\\.md$" &&
    grep -q 'timed out after 1s' "$ROOT/$artifact" &&
    grep -q 'ADVERSARY_REVIEW_TIMEOUT_SECONDS=900 scripts/claude-adversary-review' "$ROOT/$sidecar" &&
    printf '%s\n' "$output" | grep -q 'cross-model reviewer unavailable' &&
    [ -n "$child_pid" ] &&
    ! kill -0 "$child_pid" 2>/dev/null
  result=$?

  if [ "$result" -ne 0 ]; then
    printf '%s\n' "$output" >&2
  fi

  if [ -n "$generated_artifacts" ]; then
    while IFS= read -r artifact; do
      case "$artifact" in
        docs/features/*/adversary/*.md) rm -f "$ROOT/$artifact" "$ROOT/${artifact%.md}.attempt.json" "$ROOT/${artifact%/*}/._${artifact##*/}" ;;
      esac
    done <<< "$generated_artifacts"
  fi
  find "$ADVERSARY_DIR" -type f -newer "$marker" -name "*${TASK_ID}*.md" ! -name '._*' -exec rm -f {} +
  find "$ADVERSARY_DIR" -type f -newer "$marker" -name "*${TASK_ID}*.attempt.json" -exec rm -f {} +
  find "$ADVERSARY_DIR" -type f -newer "$marker" -name "._*${TASK_ID}*" -exec rm -f {} + 2>/dev/null || true

  return "$result"
}

context_only_prompt_for_claude() {
  local artifact fake marker output receipt status
  fake="$TMPDIR/claude-valid"
  marker="$TMPDIR/before-context-only"
  write_valid_claude "$fake"
  touch "$marker"

  output="$((
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      ADVERSARY_REVIEW_TIMEOUT_SECONDS=30 \
      CLAUDE_ADVERSARY_EFFORT=max \
      "$RUNNER" "$FEATURE" "$TASK_ID" review-narrow HEAD~1 gpt-5-test
  ) 2>&1)"
  status=$?

  artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)
  receipt=$(printf '%s\n' "$output" | sed -n 's/^Review receipt:[[:space:]]*//p' | head -1)
  sed '/^================ CONTEXT ================/,$d' "$TMPDIR/claude-prompt" > "$TMPDIR/claude-prompt-instructions"

  [ "$status" -eq 0 ] &&
    [ -f "$TMPDIR/claude-args" ] &&
    [ -f "$TMPDIR/claude-prompt" ] &&
    grep -q -- '--append-system-prompt' "$TMPDIR/claude-args" &&
    grep -q -- 'No tools are available' "$TMPDIR/claude-prompt-instructions" &&
    grep -q -- 'Do NOT request file reads or output tool-call markup' "$TMPDIR/claude-prompt-instructions" &&
    grep -q -- 'Do NOT wrap the whole response in a Markdown code fence' "$TMPDIR/claude-prompt-instructions" &&
    grep -q -- 'keep Evidence inline or indented rather than fenced' "$TMPDIR/claude-args" &&
    [ -n "$artifact" ] &&
    [ -f "$ROOT/$artifact" ] &&
    [ -n "$receipt" ] &&
    [ -f "$ROOT/$receipt" ] &&
    "$ROOT/scripts/review-attempt" validate-receipt "$receipt" --require-scoped >/dev/null 2>&1 &&
    grep -q '"schema_version": 2' "$ROOT/$receipt" &&
    grep -q '"scope_hash":' "$ROOT/$receipt" &&
    grep -q '"review_kind": "adversary"' "$ROOT/$receipt" &&
    grep -q '"status": "clear"' "$ROOT/$receipt" &&
    ! git -C "$ROOT" check-ignore -q "$receipt" &&
    git -C "$ROOT" check-ignore -q "${receipt%/*}/._fixture.json"
  result=$?

  if [ "$result" -ne 0 ]; then
    printf '%s\n' "$output" >&2
  fi

  if [ -n "$artifact" ]; then
    case "$artifact" in
      docs/features/*/adversary/*.md) rm -f "$ROOT/$artifact" "$ROOT/${artifact%.md}.attempt.json" "$ROOT/${artifact%/*}/._${artifact##*/}" ;;
    esac
  fi
  if [ -n "$receipt" ]; then
    case "$receipt" in
      docs/features/*/review-receipts/*.json) rm -f "$ROOT/$receipt" "$ROOT/${receipt%/*}/._${receipt##*/}" ;;
    esac
  fi
  find "$ADVERSARY_DIR" -type f -newer "$marker" -name "*${TASK_ID}*.md" ! -name '._*' -exec rm -f {} +
  find "$ADVERSARY_DIR" -type f -newer "$marker" -name "*${TASK_ID}*.attempt.json" -exec rm -f {} +
  find "$ADVERSARY_DIR" -type f -newer "$marker" -name "._*${TASK_ID}*" -exec rm -f {} + 2>/dev/null || true

  return "$result"
}

task_owned_snapshots_included_for_claude() {
  local artifact fake marker output status snapshot_adversary_dir
  fake="$TMPDIR/claude-valid-snapshot"
  marker="$TMPDIR/before-snapshot"
  snapshot_adversary_dir="$SNAPSHOT_DIR/adversary"
  write_valid_claude "$fake"
  touch "$marker"
  git -C "$ROOT" checkout --quiet --detach "$SNAPSHOT_SHA"

  output="$((
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      ADVERSARY_REVIEW_TIMEOUT_SECONDS=30 \
      CLAUDE_ADVERSARY_EFFORT=max \
      "$RUNNER" "$SNAPSHOT_FEATURE" "$SNAPSHOT_TASK" review-narrow HEAD~1 gpt-5-test
  ) 2>&1)"
  status=$?

  artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)

  [ "$status" -eq 0 ] &&
    [ -f "$TMPDIR/claude-prompt" ] &&
    grep -q -- '----- task-owned file snapshots (bounded; tools disabled) -----' "$TMPDIR/claude-prompt" &&
    grep -q -- "===== $SNAPSHOT_OWNED_A_REL " "$TMPDIR/claude-prompt" &&
    grep -q -- 'SNAPSHOT_FIXTURE_MARKER' "$TMPDIR/claude-prompt" &&
    grep -q -- "===== $SNAPSHOT_OWNED_B_REL " "$TMPDIR/claude-prompt"
  result=$?

  if [ "$result" -ne 0 ]; then
    printf '%s\n' "$output" >&2
  fi

  if [ -n "$artifact" ]; then
    case "$artifact" in
      docs/features/*/adversary/*.md) rm -f "$ROOT/$artifact" "$ROOT/${artifact%.md}.attempt.json" "$ROOT/${artifact%/*}/._${artifact##*/}" ;;
    esac
  fi
  find "$snapshot_adversary_dir" -type f -newer "$marker" -name "*${SNAPSHOT_TASK}*.md" ! -name '._*' -exec rm -f {} +
  find "$snapshot_adversary_dir" -type f -newer "$marker" -name "*${SNAPSHOT_TASK}*.attempt.json" -exec rm -f {} +
  find "$snapshot_adversary_dir" -type f -newer "$marker" -name "._*${SNAPSHOT_TASK}*" -exec rm -f {} + 2>/dev/null || true
  find "$SNAPSHOT_DIR/review-receipts" -type f -newer "$marker" -name "*${SNAPSHOT_TASK}*.json" -delete 2>/dev/null || true
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"

  return "$result"
}

review_narrow_snapshot_bounds_apply() {
  local artifact fake marker output result status
  fake="$TMPDIR/claude-valid-bounds"
  marker="$TMPDIR/before-bounds"
  write_valid_claude "$fake"
  touch "$marker"
  git -C "$ROOT" checkout --quiet --detach "$SNAPSHOT_SHA"

  output="$((
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      ADVERSARY_REVIEW_TIMEOUT_SECONDS=30 \
      ADVERSARY_REVIEW_SNAPSHOT_MAX_BYTES=1200 \
      CLAUDE_ADVERSARY_EFFORT=max \
      "$RUNNER" "$SNAPSHOT_FEATURE" "$SNAPSHOT_TASK" review-narrow HEAD~1 gpt-5-test
  ) 2>&1)"
  status=$?

  artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)

  [ "$status" -eq 0 ] &&
    [ -f "$TMPDIR/claude-prompt" ] &&
    grep -q -- "===== $SNAPSHOT_OWNED_A_REL " "$TMPDIR/claude-prompt" &&
    grep -q -- 'committed task snapshots truncated at 1200 bytes' "$TMPDIR/claude-prompt"
  result=$?

  if [ "$result" -ne 0 ]; then
    printf '%s\n' "$output" >&2
  fi

  if [ -n "$artifact" ]; then
    case "$artifact" in
      docs/features/*/adversary/*.md) rm -f "$ROOT/$artifact" "$ROOT/${artifact%.md}.attempt.json" "$ROOT/${artifact%/*}/._${artifact##*/}" ;;
    esac
  fi
  find "$SNAPSHOT_DIR/adversary" -type f -newer "$marker" -name "*${SNAPSHOT_TASK}*.md" ! -name '._*' -exec rm -f {} +
  find "$SNAPSHOT_DIR/adversary" -type f -newer "$marker" -name "*${SNAPSHOT_TASK}*.attempt.json" -exec rm -f {} +
  find "$SNAPSHOT_DIR/adversary" -type f -newer "$marker" -name "._*${SNAPSHOT_TASK}*" -exec rm -f {} + 2>/dev/null || true
  find "$SNAPSHOT_DIR/review-receipts" -type f -newer "$marker" -name "*${SNAPSHOT_TASK}*.json" -delete 2>/dev/null || true
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"

  return "$result"
}

private_temp_context_is_always_cleaned() {
  local artifact fake isolated output receipt status
  isolated="$TMPDIR/private-temp-adversary"
  fake="$TMPDIR/claude-temp-cleanup"
  rm -rf "$isolated"; mkdir -p "$isolated"
  write_valid_claude "$fake"
  rm -f "$TMPDIR/claude-args"
  output="$(cd "$ROOT" && TMPDIR="$isolated" CLAUDE_BIN="$fake" ADVERSARY_REVIEW_SNAPSHOT_MAX_BYTES=999999 \
    "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test 2>&1)"
  status=$?
  [ "$status" -eq 3 ] && [ ! -f "$TMPDIR/claude-args" ] && [ -z "$(find "$isolated" -mindepth 1 -print -quit)" ] || return 1
  output="$(cd "$ROOT" && TMPDIR="$isolated" CLAUDE_BIN="$fake" "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test 2>&1)"
  status=$?
  artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)
  receipt=$(printf '%s\n' "$output" | sed -n 's/^Review receipt:[[:space:]]*//p' | head -1)
  [ "$status" -eq 0 ] && [ -z "$(find "$isolated" -mindepth 1 -print -quit)" ]
  status=$?
  rm -f "$ROOT/$artifact" "$ROOT/${artifact%.md}.attempt.json" "$ROOT/$receipt"
  return "$status"
}

huge_committed_snapshot_stream_is_bounded() {
  local bytes output result
  git -C "$ROOT" checkout --quiet --detach "$SNAPSHOT_SHA"
  output="$TMPDIR/huge-snapshot.out"
  python3 "$ROOT/scripts/lib-review-scope.py" snapshots \
    "$SNAPSHOT_FEATURE" "$SNAPSHOT_TASK" "$SNAPSHOT_BASE_SHA" "$SNAPSHOT_SHA" 2 4096 > "$output" || return 1
  bytes=$(LC_ALL=C wc -c < "$output" | tr -d '[:space:]')
  [ "$bytes" -le 4096 ] &&
    grep -q "$SNAPSHOT_HUGE_REL" "$output" &&
    grep -Eq 'blob preview truncated|task snapshots truncated' "$output"
  result=$?
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  return "$result"
}

snapshot_sanitizer_tripwire_blocks_claude() {
  local fake output result status
  fake="$TMPDIR/claude-valid-sanitize"
  write_valid_claude "$fake"
  rm -f "$TMPDIR/claude-args" "$TMPDIR/claude-prompt"
  git -C "$ROOT" checkout --quiet --detach "$SANITIZER_SHA"

  output="$((
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      ADVERSARY_REVIEW_TIMEOUT_SECONDS=30 \
      CLAUDE_ADVERSARY_EFFORT=max \
      "$RUNNER" "$SANITIZER_FEATURE" TASK-SAN review-narrow HEAD~1 gpt-5-test
  ) 2>&1)"
  status=$?

  [ "$status" -eq 4 ] &&
    printf '%s\n' "$output" | grep -q 'sanitize: blocked by secret-apikey pattern' &&
    [ ! -f "$TMPDIR/claude-args" ] &&
    [ ! -f "$TMPDIR/claude-prompt" ]
  result=$?

  if [ "$result" -ne 0 ]; then
    printf '%s\n' "$output" >&2
  fi

  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  return "$result"
}

invalid_timeout_rejected() {
  local fake
  fake="$TMPDIR/claude-sleep-invalid"
  write_sleeping_claude "$fake"
  (
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      ADVERSARY_REVIEW_TIMEOUT_SECONDS=abc \
      "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test
  ) >/dev/null 2>&1
}

revised_or_multiple_verdict_is_invalid() {
  local artifact status
  artifact="$TMPDIR/findings-first.md"
  cat > "$artifact" <<'EOF'
OUTPUT FORMAT:
- ADVERSARIAL CLEAR | ADVERSARIAL FINDINGS OPENED

### Verdict
- ADVERSARIAL CLEAR

### Revised verdict
- ADVERSARIAL FINDINGS OPENED
- Reason: later inspection found a defect
EOF
  status=$("$ROOT/scripts/review-attempt" status adversary "$artifact" 2>/dev/null || true)
  [ "$status" = "invalid-output" ]
}

