positional_base_override_is_used() {
  local artifact expected fake output receipt result status
  fake="$TMPDIR/claude-base-override"
  write_valid_claude "$fake"
  expected=$(git -C "$ROOT" merge-base HEAD HEAD~1)
  output="$(
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      ADVERSARY_REVIEW_TIMEOUT_SECONDS=30 \
      CLAUDE_ADVERSARY_EFFORT=max \
      "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test 2>&1
  )"
  status=$?
  artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)
  receipt=$(printf '%s\n' "$output" | sed -n 's/^Review receipt:[[:space:]]*//p' | head -1)
  [ "$status" -eq 0 ] &&
    grep -q "BASE SHA: $expected" "$TMPDIR/claude-prompt" &&
    grep -q "\"base_sha\": \"$expected\"" "$ROOT/$receipt"
  result=$?
  rm -f "$ROOT/$artifact" "$ROOT/${artifact%/*}/._${artifact##*/}" \
    "$ROOT/${artifact%.md}.attempt.json" "$ROOT/$receipt" "$ROOT/${receipt%/*}/._${receipt##*/}"
  return "$result"
