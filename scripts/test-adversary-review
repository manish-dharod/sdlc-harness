glob_directory_scope_preserves_boundary() {
  local candidate output status
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  python3 - "$ROOT/docs/features/$FEATURE/TASKS.md" "$FEATURE" <<'PY'
import sys

path, feature = sys.argv[1:]
text = open(path, encoding="utf-8").read()
old = f"  - docs/features/{feature}/\n"
new = (
    f"  - docs/features/{feature}/TASKS.md\n"
    f"  - docs/features/{feature}/owned-*/\n"
)
if text.count(old) != 1:
    raise SystemExit("fixture ownership declaration was not unique")
open(path, "w", encoding="utf-8").write(text.replace(old, new, 1))
PY
  mkdir -p "$ROOT/docs/features/$FEATURE/owned-a"
  printf 'owned glob descendant\n' > "$ROOT/docs/features/$FEATURE/owned-a/inside.txt"
  git -C "$ROOT" add "docs/features/$FEATURE"
  git -C "$ROOT" commit --quiet -m 'test: create glob-directory scope candidate'
  candidate=$(git -C "$ROOT" rev-parse HEAD)
  "$ROOT/scripts/review-attempt" scope-json "$FEATURE" "$TASK_ID" "$PRIMARY_SHA" "$candidate" >/dev/null 2>&1 || {
    git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
    return 1
  }

  printf 'prefix sibling must stay outside directory glob\n' > "$ROOT/docs/features/$FEATURE/owned-aevil.txt"
  git -C "$ROOT" add "docs/features/$FEATURE/owned-aevil.txt"
  git -C "$ROOT" commit --quiet -m 'test: add prefix sibling outside glob directory'
  candidate=$(git -C "$ROOT" rev-parse HEAD)
  output=$("$ROOT/scripts/review-attempt" scope-json "$FEATURE" "$TASK_ID" "$PRIMARY_SHA" "$candidate" 2>&1)
  status=$?
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  [ "$status" -eq 3 ] && printf '%s\n' "$output" | grep -q 'owned-aevil.txt'
}

