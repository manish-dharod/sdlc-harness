candidate_attributes_and_hostile_config_are_stable() {
  local attr_backup baseline changed global_attrs global_config result
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  baseline=$("$ROOT/scripts/review-attempt" canonical-diff-hash "$BASE_SHA" "$PRIMARY_SHA" "$FEATURE" "$TASK_ID") || return 1
  attr_backup="$TMPDIR/gitattributes.backup"
  if git -C "$ROOT" cat-file -e "$PRIMARY_SHA:.gitattributes" 2>/dev/null; then
    git -C "$ROOT" cat-file -p "$PRIMARY_SHA:.gitattributes" > "$attr_backup"
  else
    : > "$attr_backup.absent"
  fi
  printf '* diff=hostile\n' > "$ROOT/.gitattributes"
  global_attrs="$TMPDIR/global-attributes"
  global_config="$TMPDIR/global-gitconfig"
  printf '* diff=global-hostile\n' > "$global_attrs"
  cat > "$global_config" <<EOF
[core]
  attributesFile = $global_attrs
[diff]
  context = 99
  renames = copies
EOF
  changed=$(GIT_CONFIG_GLOBAL="$global_config" GIT_EXTERNAL_DIFF=/bin/false \
    "$ROOT/scripts/review-attempt" canonical-diff-hash "$BASE_SHA" "$PRIMARY_SHA" "$FEATURE" "$TASK_ID")
  result=0
  [ "$baseline" = "$changed" ] || result=1
  if [ -f "$attr_backup.absent" ]; then
    rm -f "$ROOT/.gitattributes"
  else
    cp "$attr_backup" "$ROOT/.gitattributes"
  fi
  return "$result"
}

info_attributes_fail_closed() {
  local info output status
  info=$(git -C "$ROOT" rev-parse --git-path info/attributes)
  [ "${info#/}" = "$info" ] && info="$ROOT/$info"
  mkdir -p "${info%/*}"
  printf '* diff=clone-local\n' > "$info"
  output=$("$ROOT/scripts/review-attempt" canonical-diff-hash "$BASE_SHA" "$PRIMARY_SHA" "$FEATURE" "$TASK_ID" 2>&1)
  status=$?
  rm -f "$info"
  [ "$status" -eq 3 ] && printf '%s\n' "$output" | grep -q 'info/attributes'
}

missing_candidate_attribute_capability_fails_closed() {
  local fake_bin output real_git status
  fake_bin="$TMPDIR/fake-old-git"
  real_git=$(command -v git)
  mkdir -p "$fake_bin"
  cat > "$fake_bin/git" <<EOF
#!/usr/bin/env bash
if [ "\${1:-}" = "check-attr" ]; then
  for arg in "\$@"; do
    case "\$arg" in --source=*) exit 129 ;; esac
  done
fi
exec "$real_git" "\$@"
EOF
  chmod +x "$fake_bin/git"
  output=$(PATH="$fake_bin:$PATH" "$ROOT/scripts/review-attempt" canonical-diff-hash \
    "$BASE_SHA" "$PRIMARY_SHA" "$FEATURE" "$TASK_ID" 2>&1)
  status=$?
  [ "$status" -eq 3 ] && printf '%s\n' "$output" | grep -q 'Git 2.42+.*check-attr --source'
}

oversized_committed_task_ledger_is_rejected_before_read() {
  local candidate output status
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  awk 'BEGIN { for (i=0; i<110000; i++) print "ledger-padding-abcdefghij" }' >> "$ROOT/docs/features/$FEATURE/TASKS.md"
  git -C "$ROOT" add "docs/features/$FEATURE/TASKS.md"
