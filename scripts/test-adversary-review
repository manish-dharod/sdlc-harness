cleanup() {
  rm -rf "$TEST_ROOT"
}
trap cleanup EXIT

write_sleeping_claude() {
  local file="$1"
  cat > "$file" <<EOF
#!/usr/bin/env bash
cat >/dev/null
sleep 30 &
printf '%s\n' "\$!" > "$TMPDIR/sleep-child-pid"
wait
EOF
  chmod +x "$file"
}

group_hash_for_prompt() {
  LC_ALL=C awk -v value="$1" 'BEGIN {
    for (i = 1; i <= length(value); i += 8) {
      if (i > 1) printf "-"
      printf "%s", substr(value, i, 8)
    }
    printf "\n"
  }'
}

write_valid_claude() {
  local file="$1"
  cat > "$file" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$@" > "$TMPDIR/claude-args"
cat > "$TMPDIR/claude-prompt"
cat <<'OUT'
\`\`\`markdown
## Adversarial review: fake

### Routing
- Mode: review-narrow
- Diff scope: fake

### Categories
- false-confidence: n/a: fake test reviewer
- missed-edge: n/a: fake test reviewer
- spec-loophole: n/a: fake test reviewer
- hidden-coupling: n/a: fake test reviewer
- negative-path: n/a: fake test reviewer
- env-assumption: n/a: fake test reviewer
- rollback-gap: n/a: fake test reviewer
- stale-evidence: n/a: fake test reviewer
- traceability-mismatch: n/a: fake test reviewer
- tests-pass-behavior-wrong: n/a: fake test reviewer

### Findings (only validated hypotheses)
(no findings)

### Verdict
- ADVERSARIAL CLEAR
- Reason: fake clear for wrapper regression test
\`\`\`
OUT
EOF
  chmod +x "$file"
}

write_finding_claude() {
  local file="$1"
  local severity="$2"
  cat > "$file" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$@" > "$TMPDIR/claude-args"
cat > "$TMPDIR/claude-prompt"
cat <<'OUT'
## Adversarial review: severity fixture

### Findings (only validated hypotheses)

#### ADV-FND-001
- Severity: $severity
- Status: Confirmed
- Category: false-confidence
- File/line: scripts/review-attempt:1
- Failure mode: fixture observation remains visible
- Evidence: deterministic fixture
- Minimal fix: none for nonblocking observations
- Owner: sdlc-swe

### Verdict
- ADVERSARIAL FINDINGS OPENED
- Reason: severity-routing fixture
OUT
EOF
  chmod +x "$file"
}

run_case() {
  local name="$1"
  local expected="$2"
  shift 2
  local common_dir output status

  common_dir=$(git -C "$ROOT" rev-parse --git-common-dir)
  case "$common_dir" in
    /*) ;;
    *) common_dir="$ROOT/$common_dir" ;;
  esac
  rm -rf "$common_dir/sdlc-review-call-budgets"

  output="$("$@" 2>&1)"
  status=$?

  if { [ "$expected" = "pass" ] && [ "$status" -eq 0 ]; } || { [ "$expected" = "fail" ] && [ "$status" -ne 0 ]; }; then
    printf 'ok - %s\n' "$name"
    PASS_COUNT=$((PASS_COUNT + 1))
  else
    printf 'not ok - %s\n' "$name" >&2
    printf 'expected: %s, status: %s\n%s\n' "$expected" "$status" "$output" >&2
    FAIL_COUNT=$((FAIL_COUNT + 1))
  fi
}

review_call_budget_is_atomic_and_shared() {
  local common_dir exhausted helper i linked output rc reservations successes
  helper="$ROOT/scripts/review-attempt"
  common_dir=$(git -C "$ROOT" rev-parse --git-common-dir)
  case "$common_dir" in
    /*) ;;
    *) common_dir="$ROOT/$common_dir" ;;
  esac

  for i in 1 2 3; do
    output=$("$helper" reserve-call "$FEATURE" "$TASK_ID" adversary 2>&1)
    [ "$?" -eq 0 ] && [ "$output" = "reserved|$i|3" ] || return 1
  done
  output=$("$helper" reserve-call "$FEATURE" "$TASK_ID" adversary 2>&1)
  [ "$?" -eq 2 ] && [ "$output" = 'exhausted|3|3' ] || return 1
  "$helper" reserve-call "$FEATURE" "$TASK_ID" security >/dev/null 2>&1 || return 1

  rm -rf "$common_dir/sdlc-review-call-budgets"
  i=1
  while [ "$i" -le 4 ]; do
    (
      "$helper" reserve-call "$FEATURE" "$TASK_ID" adversary > "$TMPDIR/budget-parallel-$i.out" 2>&1
      printf '%s\n' "$?" > "$TMPDIR/budget-parallel-$i.rc"
    ) &
    i=$((i + 1))
  done
  wait
  successes=0
  exhausted=0
  reservations=""
  i=1
  while [ "$i" -le 4 ]; do
    rc=$(cat "$TMPDIR/budget-parallel-$i.rc")
    if [ "$rc" -eq 0 ]; then
      successes=$((successes + 1))
      reservations="${reservations}$(cat "$TMPDIR/budget-parallel-$i.out")\n"
    fi
    [ "$rc" -eq 2 ] && exhausted=$((exhausted + 1))
    i=$((i + 1))
  done
  [ "$successes" -eq 3 ] && [ "$exhausted" -eq 1 ] &&
    [ "$(printf '%b' "$reservations" | LC_ALL=C sort)" = $'reserved|1|3\nreserved|2|3\nreserved|3|3' ] || return 1

  rm -rf "$common_dir/sdlc-review-call-budgets"
  linked="$TEST_ROOT/linked-budget-worktree"
  git -C "$ROOT" worktree add --quiet --detach "$linked" HEAD || return 1
  "$helper" reserve-call "$FEATURE" "$TASK_ID" adversary >/dev/null 2>&1 || return 1
  "$linked/scripts/review-attempt" reserve-call "$FEATURE" "$TASK_ID" adversary >/dev/null 2>&1 || return 1
  "$helper" reserve-call "$FEATURE" "$TASK_ID" adversary >/dev/null 2>&1 || return 1
  output=$("$linked/scripts/review-attempt" reserve-call "$FEATURE" "$TASK_ID" adversary 2>&1)
  rc=$?
  git -C "$ROOT" worktree remove "$linked" >/dev/null 2>&1 || return 1
  [ "$rc" -eq 2 ] && [ "$output" = 'exhausted|3|3' ]
}

wrapper_budget_exhaustion_makes_no_fourth_model_call_or_receipt() {
  local artifact count fake i output receipt sidecar status valid
  valid="$TMPDIR/claude-budget-valid"
  fake="$TMPDIR/claude-budget-counting"
  count="$TMPDIR/claude-budget-calls"
  write_valid_claude "$valid"
  cat > "$fake" <<EOF
#!/usr/bin/env bash
printf 'call\n' >> "$count"
exec "$valid" "\$@"
EOF
  chmod +x "$fake"
  : > "$count"
  i=1
  while [ "$i" -le 4 ]; do
    output="$(cd "$ROOT" && CLAUDE_BIN="$fake" "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test 2>&1)"
    status=$?
    if [ "$i" -le 3 ]; then
      [ "$status" -eq 0 ] || return 1
      artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)
      receipt=$(printf '%s\n' "$output" | sed -n 's/^Review receipt:[[:space:]]*//p' | head -1)
      sidecar=$(printf '%s\n' "$output" | sed -n 's/^Attempt JSON:[[:space:]]*//p' | head -1)
      rm -f "$ROOT/$artifact" "$ROOT/$receipt" "$ROOT/$sidecar"
    else
      [ "$status" -eq 2 ] &&
        printf '%s\n' "$output" | grep -q 'NEEDS_TASK_SPLIT: external adversary-review call budget exhausted' &&
        ! printf '%s\n' "$output" | grep -q '^Review receipt:' || return 1
    fi
    i=$((i + 1))
  done
  [ "$(wc -l < "$count" | tr -d '[:space:]')" -eq 3 ]
}

third_failed_adversary_call_has_no_fourth_call_recommendation() {
  local artifact fake i output sidecar status
  fake="$TMPDIR/claude-invalid-budget"
  cat > "$fake" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$@" > "$TMPDIR/claude-args"
cat > "$TMPDIR/claude-prompt"
printf 'invalid reviewer output\n'
EOF
  chmod +x "$fake"
  i=1
  while [ "$i" -le 3 ]; do
    output="$(cd "$ROOT" && CLAUDE_BIN="$fake" "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test 2>&1)"
    status=$?
    sidecar=$(printf '%s\n' "$output" | sed -n 's/^Attempt sidecar:[[:space:]]*//p' | head -1)
    artifact="${sidecar%.attempt.json}.md"
    [ "$status" -eq 2 ] && [ -f "$ROOT/$sidecar" ] || return 1
    if [ "$i" -lt 3 ]; then
      grep -q '"retryable": true' "$ROOT/$sidecar" &&
        printf '%s\n' "$output" | grep -q 'Recommended next command: scripts/' || return 1
    else
      grep -q '"retryable": false' "$ROOT/$sidecar" &&
        ! printf '%s\n' "$output" | grep -q 'Recommended next command: scripts/' || return 1
    fi
    rm -f "$ROOT/$sidecar" "$ROOT/$artifact"
    i=$((i + 1))
  done
}

timeout_reports_unavailable() {
  local artifact fake generated_artifacts marker output status child_pid sidecar
  fake="$TMPDIR/claude-sleep"
  marker="$TMPDIR/before-timeout"
  write_sleeping_claude "$fake"
  touch "$marker"

  output="$((
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      ADVERSARY_REVIEW_TIMEOUT_SECONDS=1 \
      CLAUDE_ADVERSARY_EFFORT=max \
      "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test
  ) 2>&1)"
  status=$?

  generated_artifacts=$(printf '%s\n' "$output" | sed -n 's/.*Artifact written to //p' | sed 's/[[:space:]]*$//' | sort -u)
  artifact=$(printf '%s\n' "$generated_artifacts" | head -1)
  sidecar="${artifact%.md}.attempt.json"
  child_pid=""
  if [ -f "$TMPDIR/sleep-child-pid" ]; then
    child_pid="$(cat "$TMPDIR/sleep-child-pid")"
  fi
  sleep 1

  [ "$status" -eq 124 ] &&
    [ -n "$artifact" ] &&
    [ -f "$ROOT/$artifact" ] &&
    [ -f "$ROOT/$sidecar" ] &&
    printf '%s\n' "$artifact" | grep -Eq "/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{6}Z-${TASK_ID}-claude-code-attempt-[0-9]+-[0-9a-f]+\\.md$" &&
    grep -q 'timed out after 1s' "$ROOT/$artifact" &&
    grep -q 'scripts/claude-adversary-review' "$ROOT/$sidecar" &&
    ! grep -q 'ADVERSARY_REVIEW_TIMEOUT_SECONDS=900' "$ROOT/$sidecar" &&
    printf '%s\n' "$output" | grep -q 'cross-model reviewer unavailable' &&
    [ -n "$child_pid" ] &&
    ! kill -0 "$child_pid" 2>/dev/null
  result=$?

  if [ "$result" -ne 0 ]; then
    printf '%s\n' "$output" >&2
  fi

  if [ -n "$generated_artifacts" ]; then
    while IFS= read -r artifact; do
      case "$artifact" in
        docs/features/*/adversary/*.md) rm -f "$ROOT/$artifact" "$ROOT/${artifact%.md}.attempt.json" "$ROOT/${artifact%/*}/._${artifact##*/}" ;;
      esac
    done <<< "$generated_artifacts"
  fi
  find "$ADVERSARY_DIR" -type f -newer "$marker" -name "*${TASK_ID}*.md" ! -name '._*' -exec rm -f {} +
  find "$ADVERSARY_DIR" -type f -newer "$marker" -name "*${TASK_ID}*.attempt.json" -exec rm -f {} +
  find "$ADVERSARY_DIR" -type f -newer "$marker" -name "._*${TASK_ID}*" -exec rm -f {} + 2>/dev/null || true

  return "$result"
}

context_only_prompt_for_claude() {
  local artifact fake human marker output receipt status
  fake="$TMPDIR/claude-valid"
  marker="$TMPDIR/before-context-only"
  write_valid_claude "$fake"
  touch "$marker"

  output="$((
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      ADVERSARY_REVIEW_TIMEOUT_SECONDS=30 \
      CLAUDE_ADVERSARY_EFFORT=max \
      "$RUNNER" "$FEATURE" "$TASK_ID" review-narrow HEAD~1 gpt-5-test
  ) 2>&1)"
  status=$?

  artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)
  receipt=$(printf '%s\n' "$output" | sed -n 's/^Review receipt:[[:space:]]*//p' | head -1)
  human="$TMPDIR/adversary-clear-receipt-human"
  sed '/^================ CONTEXT ================/,$d' "$TMPDIR/claude-prompt" > "$TMPDIR/claude-prompt-instructions"

  [ "$status" -eq 0 ] &&
    [ -f "$TMPDIR/claude-args" ] &&
    [ -f "$TMPDIR/claude-prompt" ] &&
    grep -q -- '--append-system-prompt' "$TMPDIR/claude-args" &&
    grep -q -- 'No tools are available' "$TMPDIR/claude-prompt-instructions" &&
    grep -q -- 'Do NOT request file reads or output tool-call markup' "$TMPDIR/claude-prompt-instructions" &&
    grep -q -- 'Do NOT wrap the whole response in a Markdown code fence' "$TMPDIR/claude-prompt-instructions" &&
    grep -q -- 'keep Evidence inline or indented rather than fenced' "$TMPDIR/claude-args" &&
    [ -n "$artifact" ] &&
    [ -f "$ROOT/$artifact" ] &&
    [ -n "$receipt" ] &&
    [ -f "$ROOT/$receipt" ] &&
    "$ROOT/scripts/review-attempt" validate-receipt "$receipt" --require-scoped >/dev/null 2>&1 &&
    "$ROOT/scripts/review-attempt" receipt-human-fields "$ROOT/$receipt" > "$human" &&
    grep -q '"schema_version": 3' "$ROOT/$receipt" &&
    grep -q '"finding_records": \[\]' "$ROOT/$receipt" &&
    grep -q '^severity_count_P0=0$' "$human" &&
    grep -q '^severity_count_P1=0$' "$human" &&
    grep -q '^severity_count_P2=0$' "$human" &&
    grep -q '^severity_count_P3=0$' "$human" &&
    grep -q '"scope_hash":' "$ROOT/$receipt" &&
    grep -q '"review_kind": "adversary"' "$ROOT/$receipt" &&
    grep -q '"status": "clear"' "$ROOT/$receipt" &&
    ! git -C "$ROOT" check-ignore -q "$receipt" &&
    git -C "$ROOT" check-ignore -q "${receipt%/*}/._fixture.json"
  result=$?

  if [ "$result" -ne 0 ]; then
    printf '%s\n' "$output" >&2
  fi

  if [ -n "$artifact" ]; then
    case "$artifact" in
      docs/features/*/adversary/*.md) rm -f "$ROOT/$artifact" "$ROOT/${artifact%.md}.attempt.json" "$ROOT/${artifact%/*}/._${artifact##*/}" ;;
    esac
  fi
  if [ -n "$receipt" ]; then
    case "$receipt" in
      docs/features/*/review-receipts/*.json) rm -f "$ROOT/$receipt" "$ROOT/${receipt%/*}/._${receipt##*/}" ;;
    esac
  fi
  find "$ADVERSARY_DIR" -type f -newer "$marker" -name "*${TASK_ID}*.md" ! -name '._*' -exec rm -f {} +
  find "$ADVERSARY_DIR" -type f -newer "$marker" -name "*${TASK_ID}*.attempt.json" -exec rm -f {} +
  find "$ADVERSARY_DIR" -type f -newer "$marker" -name "._*${TASK_ID}*" -exec rm -f {} + 2>/dev/null || true

  return "$result"
}

task_owned_snapshots_included_for_claude() {
  local artifact fake grouped_snapshot_sha marker output status snapshot_adversary_dir
  fake="$TMPDIR/claude-valid-snapshot"
  marker="$TMPDIR/before-snapshot"
  snapshot_adversary_dir="$SNAPSHOT_DIR/adversary"
  write_valid_claude "$fake"
  touch "$marker"
  git -C "$ROOT" checkout --quiet --detach "$SNAPSHOT_SHA"

  output="$((
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      ADVERSARY_REVIEW_TIMEOUT_SECONDS=30 \
      CLAUDE_ADVERSARY_EFFORT=max \
      "$RUNNER" "$SNAPSHOT_FEATURE" "$SNAPSHOT_TASK" review-narrow HEAD~1 gpt-5-test
  ) 2>&1)"
  status=$?
  grouped_snapshot_sha=$(group_hash_for_prompt "$SNAPSHOT_SHA")

  artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)

  [ "$status" -eq 0 ] &&
    [ -f "$TMPDIR/claude-prompt" ] &&
    grep -q -- '----- task-owned file snapshots (bounded; tools disabled) -----' "$TMPDIR/claude-prompt" &&
    grep -q -- "===== $SNAPSHOT_OWNED_A_REL " "$TMPDIR/claude-prompt" &&
    grep -q -- 'SNAPSHOT_FIXTURE_MARKER' "$TMPDIR/claude-prompt" &&
    grep -q -- "===== $SNAPSHOT_OWNED_B_REL " "$TMPDIR/claude-prompt" &&
    grep -Fq -- "committed $grouped_snapshot_sha) =====" "$TMPDIR/claude-prompt" &&
    ! grep -Fq -- "committed $SNAPSHOT_SHA) =====" "$TMPDIR/claude-prompt"
  result=$?

  if [ "$result" -ne 0 ]; then
    printf '%s\n' "$output" >&2
  fi

  if [ -n "$artifact" ]; then
    case "$artifact" in
      docs/features/*/adversary/*.md) rm -f "$ROOT/$artifact" "$ROOT/${artifact%.md}.attempt.json" "$ROOT/${artifact%/*}/._${artifact##*/}" ;;
    esac
  fi
  find "$snapshot_adversary_dir" -type f -newer "$marker" -name "*${SNAPSHOT_TASK}*.md" ! -name '._*' -exec rm -f {} +
  find "$snapshot_adversary_dir" -type f -newer "$marker" -name "*${SNAPSHOT_TASK}*.attempt.json" -exec rm -f {} +
  find "$snapshot_adversary_dir" -type f -newer "$marker" -name "._*${SNAPSHOT_TASK}*" -exec rm -f {} + 2>/dev/null || true
  find "$SNAPSHOT_DIR/review-receipts" -type f -newer "$marker" -name "*${SNAPSHOT_TASK}*.json" -delete 2>/dev/null || true
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"

  return "$result"
}

review_narrow_snapshot_bounds_apply() {
  local artifact fake marker output result status
  fake="$TMPDIR/claude-valid-bounds"
  marker="$TMPDIR/before-bounds"
  write_valid_claude "$fake"
  touch "$marker"
  git -C "$ROOT" checkout --quiet --detach "$SNAPSHOT_SHA"

  output="$((
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      ADVERSARY_REVIEW_TIMEOUT_SECONDS=30 \
      ADVERSARY_REVIEW_SNAPSHOT_MAX_BYTES=1200 \
      CLAUDE_ADVERSARY_EFFORT=max \
      "$RUNNER" "$SNAPSHOT_FEATURE" "$SNAPSHOT_TASK" review-narrow HEAD~1 gpt-5-test
  ) 2>&1)"
  status=$?

  artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)

  [ "$status" -eq 0 ] &&
    [ -f "$TMPDIR/claude-prompt" ] &&
    grep -q -- "===== $SNAPSHOT_OWNED_A_REL " "$TMPDIR/claude-prompt" &&
    grep -q -- 'committed task snapshots truncated at 1200 bytes' "$TMPDIR/claude-prompt"
  result=$?

  if [ "$result" -ne 0 ]; then
    printf '%s\n' "$output" >&2
  fi

  if [ -n "$artifact" ]; then
    case "$artifact" in
      docs/features/*/adversary/*.md) rm -f "$ROOT/$artifact" "$ROOT/${artifact%.md}.attempt.json" "$ROOT/${artifact%/*}/._${artifact##*/}" ;;
    esac
  fi
  find "$SNAPSHOT_DIR/adversary" -type f -newer "$marker" -name "*${SNAPSHOT_TASK}*.md" ! -name '._*' -exec rm -f {} +
  find "$SNAPSHOT_DIR/adversary" -type f -newer "$marker" -name "*${SNAPSHOT_TASK}*.attempt.json" -exec rm -f {} +
  find "$SNAPSHOT_DIR/adversary" -type f -newer "$marker" -name "._*${SNAPSHOT_TASK}*" -exec rm -f {} + 2>/dev/null || true
  find "$SNAPSHOT_DIR/review-receipts" -type f -newer "$marker" -name "*${SNAPSHOT_TASK}*.json" -delete 2>/dev/null || true
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"

  return "$result"
}

private_temp_context_is_always_cleaned() {
  local artifact fake isolated output receipt status
  isolated="$TMPDIR/private-temp-adversary"
  fake="$TMPDIR/claude-temp-cleanup"
  rm -rf "$isolated"; mkdir -p "$isolated"
  write_valid_claude "$fake"
  rm -f "$TMPDIR/claude-args"
  output="$(cd "$ROOT" && TMPDIR="$isolated" CLAUDE_BIN="$fake" ADVERSARY_REVIEW_SNAPSHOT_MAX_BYTES=999999 \
    "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test 2>&1)"
  status=$?
  [ "$status" -eq 3 ] && [ ! -f "$TMPDIR/claude-args" ] && [ -z "$(find "$isolated" -mindepth 1 -print -quit)" ] || return 1
  output="$(cd "$ROOT" && TMPDIR="$isolated" CLAUDE_BIN="$fake" "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test 2>&1)"
  status=$?
  artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)
  receipt=$(printf '%s\n' "$output" | sed -n 's/^Review receipt:[[:space:]]*//p' | head -1)
  [ "$status" -eq 0 ] && [ -z "$(find "$isolated" -mindepth 1 -print -quit)" ]
  status=$?
  rm -f "$ROOT/$artifact" "$ROOT/${artifact%.md}.attempt.json" "$ROOT/$receipt"
  return "$status"
}

huge_committed_snapshot_stream_is_bounded() {
  local bytes output result
  git -C "$ROOT" checkout --quiet --detach "$SNAPSHOT_SHA"
  output="$TMPDIR/huge-snapshot.out"
  python3 "$ROOT/scripts/lib-review-scope.py" snapshots \
    "$SNAPSHOT_FEATURE" "$SNAPSHOT_TASK" "$SNAPSHOT_BASE_SHA" "$SNAPSHOT_SHA" 2 4096 > "$output" || return 1
  bytes=$(LC_ALL=C wc -c < "$output" | tr -d '[:space:]')
  [ "$bytes" -le 4096 ] &&
    grep -q "$SNAPSHOT_HUGE_REL" "$output" &&
    grep -Eq 'blob preview truncated|task snapshots truncated' "$output"
  result=$?
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  return "$result"
}

snapshot_sanitizer_tripwire_blocks_claude() {
  local fake output reservation result status
  fake="$TMPDIR/claude-valid-sanitize"
  write_valid_claude "$fake"
  rm -f "$TMPDIR/claude-args" "$TMPDIR/claude-prompt"
  git -C "$ROOT" checkout --quiet --detach "$SANITIZER_SHA"

  output="$((
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      ADVERSARY_REVIEW_TIMEOUT_SECONDS=30 \
      CLAUDE_ADVERSARY_EFFORT=max \
      "$RUNNER" "$SANITIZER_FEATURE" TASK-SAN review-narrow HEAD~1 gpt-5-test
  ) 2>&1)"
  status=$?

  [ "$status" -eq 4 ] &&
    printf '%s\n' "$output" | grep -q 'sanitize: blocked by secret-apikey pattern' &&
    [ ! -f "$TMPDIR/claude-args" ] &&
    [ ! -f "$TMPDIR/claude-prompt" ] &&
    ! printf '%s\n' "$output" | grep -q '^Review receipt:'
  result=$?

  reservation=$("$ROOT/scripts/review-attempt" reserve-call "$SANITIZER_FEATURE" TASK-SAN adversary 2>/dev/null) || result=1
  [ "$reservation" = 'reserved|1|3' ] || result=1

  if [ "$result" -ne 0 ]; then
    printf '%s\n' "$output" >&2
  fi

  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  return "$result"
}

timeout_bounds_are_rejected_before_model_or_reservation() {
  local fake invalid output reservation status
  fake="$TMPDIR/claude-invalid-timeout"
  write_valid_claude "$fake"
  for invalid in 0 301 900; do
    rm -f "$TMPDIR/claude-args" "$TMPDIR/claude-prompt"
    output="$(cd "$ROOT" && CLAUDE_BIN="$fake" ADVERSARY_REVIEW_TIMEOUT_SECONDS="$invalid" \
      "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test 2>&1)"
    status=$?
    [ "$status" -eq 3 ] &&
      printf '%s\n' "$output" | grep -q 'expected 1..300 seconds' &&
      [ ! -f "$TMPDIR/claude-args" ] && [ ! -f "$TMPDIR/claude-prompt" ] || return 1
  done
  reservation=$("$ROOT/scripts/review-attempt" reserve-call "$FEATURE" "$TASK_ID" adversary 2>/dev/null) || return 1
  [ "$reservation" = 'reserved|1|3' ]
}

