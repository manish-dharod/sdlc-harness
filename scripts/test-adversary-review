receipt_failure_writes_retryable_incomplete_sidecar() {
  local artifact blocker fake output result sidecar status
  fake="$TMPDIR/claude-receipt-error"
  blocker="$ROOT/docs/features/$FEATURE/review-receipts"
  write_valid_claude "$fake"
  rm -rf "$blocker"
  printf 'receipt directory blocker\n' > "$blocker"

  output="$((
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test
  ) 2>&1)"
  status=$?
  artifact=$(printf '%s\n' "$output" | sed -n 's/.*Artifact written to //p' | sed 's/[[:space:]]*$//' | head -1)
  sidecar=$(printf '%s\n' "$output" | sed -n 's/^Attempt sidecar: \([^[:space:]]*\).*/\1/p' | tail -1)

  [ "$status" -eq 2 ] &&
    [ -n "$sidecar" ] && [ -f "$ROOT/$sidecar" ] &&
    grep -q '"status": "incomplete"' "$ROOT/$sidecar" &&
    grep -q '"failure_reason": "receipt-error"' "$ROOT/$sidecar" &&
    grep -q '"retryable": true' "$ROOT/$sidecar" &&
    ! grep -q '"status": "clear"' "$ROOT/$sidecar"
  result=$?

  rm -f "$blocker"
  [ -n "$artifact" ] && rm -f "$ROOT/$artifact" "$ROOT/${artifact%/*}/._${artifact##*/}"
  [ -n "$sidecar" ] && rm -f "$ROOT/$sidecar" "$ROOT/${sidecar%/*}/._${sidecar##*/}"
  return "$result"
}

remote_first_merge_base_is_used() {
  local artifact base_name expected fake output receipt result status
  fake="$TMPDIR/claude-remote-first"
  base_name="_test-review-base-$$"
  write_valid_claude "$fake"
  git -C "$ROOT" update-ref "refs/remotes/origin/$base_name" HEAD~1
  git -C "$ROOT" update-ref "refs/heads/$base_name" HEAD~2
  expected=$(git -C "$ROOT" merge-base HEAD "origin/$base_name")
  output="$(
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      ADVERSARY_REVIEW_TIMEOUT_SECONDS=30 \
      CLAUDE_ADVERSARY_EFFORT=max \
      SDLC_BASE_BRANCH="$base_name" \
      "$RUNNER" "$FEATURE" "$TASK_ID" review "" gpt-5-test 2>&1
  )"
  status=$?
  artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)
  receipt=$(printf '%s\n' "$output" | sed -n 's/^Review receipt:[[:space:]]*//p' | head -1)
  [ "$status" -eq 0 ] &&
    grep -q "BASE SHA: $expected" "$TMPDIR/claude-prompt" &&
    grep -q "\"base_sha\": \"$expected\"" "$ROOT/$receipt"
  result=$?
  [ -n "$artifact" ] && rm -f "$ROOT/$artifact" "$ROOT/${artifact%/*}/._${artifact##*/}" \
    "$ROOT/${artifact%.md}.attempt.json"
  [ -n "$receipt" ] && rm -f "$ROOT/$receipt" "$ROOT/${receipt%/*}/._${receipt##*/}"
  git -C "$ROOT" update-ref -d "refs/remotes/origin/$base_name"
  git -C "$ROOT" update-ref -d "refs/heads/$base_name"
  return "$result"
}

positional_base_override_is_used() {
  local artifact expected fake output receipt result status
  fake="$TMPDIR/claude-base-override"
  write_valid_claude "$fake"
  expected=$(git -C "$ROOT" merge-base HEAD HEAD~1)
  output="$(
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      ADVERSARY_REVIEW_TIMEOUT_SECONDS=30 \
      CLAUDE_ADVERSARY_EFFORT=max \
      "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test 2>&1
  )"
  status=$?
  artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)
  receipt=$(printf '%s\n' "$output" | sed -n 's/^Review receipt:[[:space:]]*//p' | head -1)
  [ "$status" -eq 0 ] &&
    grep -q "BASE SHA: $expected" "$TMPDIR/claude-prompt" &&
    grep -q "\"base_sha\": \"$expected\"" "$ROOT/$receipt"
  result=$?
  rm -f "$ROOT/$artifact" "$ROOT/${artifact%/*}/._${artifact##*/}" \
    "$ROOT/${artifact%.md}.attempt.json" "$ROOT/$receipt" "$ROOT/${receipt%/*}/._${receipt##*/}"
  return "$result"
}

invalid_positional_base_rejected() {
  local fake status
  fake="$TMPDIR/claude-invalid-base"
  write_valid_claude "$fake"
  rm -f "$TMPDIR/claude-args" "$TMPDIR/claude-prompt"
  (
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      "$RUNNER" "$FEATURE" "$TASK_ID" review refs/heads/does-not-exist-$$ gpt-5-test
  ) >/dev/null 2>&1
  status=$?
  [ "$status" -eq 3 ] && [ ! -f "$TMPDIR/claude-args" ]
}

untracked_task_owned_change_rejected() {
  local fake feature_dir output slug status
  slug="_test-adversary-review-dirty-$$"
  feature_dir="$ROOT/docs/features/$slug"
  fake="$TMPDIR/claude-dirty"
  write_valid_claude "$fake"
  rm -f "$TMPDIR/claude-args" "$TMPDIR/claude-prompt"
  mkdir -p "$feature_dir"
  printf 'medium\n' > "$feature_dir/.tier"
  cat > "$feature_dir/TASKS.md" <<EOF
### TASK-DIRTY: dirty-scope fixture

- Status: Review
- Intended file ownership:
  - docs/features/$slug/owned-untracked.txt
- Verification:
  - scripts/test-adversary-review
EOF
  printf 'fixture\n' > "$feature_dir/owned-untracked.txt"
  output="$(
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      "$RUNNER" "$slug" TASK-DIRTY review HEAD gpt-5-test 2>&1
  )"
  status=$?
  rm -rf "$feature_dir"
  [ "$status" -eq 3 ] &&
    printf '%s\n' "$output" | grep -q 'untracked|docs/features/' &&
    [ ! -f "$TMPDIR/claude-args" ]
}

