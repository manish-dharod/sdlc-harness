contract_adopted_claim_base_rejects_partial_assertion() {
  local artifact fake invalid_output output receipt result sidecar status
  fake="$TMPDIR/claude-claim-base"
  write_valid_claude "$fake"
  git -C "$ROOT" checkout --quiet --detach "$CLAIM_C2"
  rm -f "$TMPDIR/claude-args" "$TMPDIR/claude-prompt"
  invalid_output="$(cd "$ROOT" && CLAUDE_BIN="$fake" "$RUNNER" "$CLAIM_FEATURE" "$CLAIM_TASK" review "$CLAIM_C1" gpt-5-test 2>&1)"
  status=$?
  result=0
  [ "$status" -eq 3 ] && [ ! -f "$TMPDIR/claude-args" ] \
    && printf '%s\n' "$invalid_output" | grep -q "expected derived review base $CLAIM_C0" \
    && { [ ! -d "$CLAIM_DIR/review-receipts" ] || [ -z "$(find "$CLAIM_DIR/review-receipts" -type f -print -quit)" ]; } || result=1
  if [ "$result" -ne 0 ]; then git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"; return 1; fi
  output="$(cd "$ROOT" && CLAUDE_BIN="$fake" "$RUNNER" "$CLAIM_FEATURE" "$CLAIM_TASK" review "$CLAIM_C0" gpt-5-test 2>&1)"
  status=$?
  artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)
  receipt=$(printf '%s\n' "$output" | sed -n 's/^Review receipt:[[:space:]]*//p' | head -1)
  sidecar="${artifact%.md}.attempt.json"
  [ "$status" -eq 0 ] && grep -Fq "BASE SHA: $(group_hash_for_prompt "$CLAIM_C0")" "$TMPDIR/claude-prompt" \
    && grep -q 'deleted file mode' "$TMPDIR/claude-prompt" \
    && grep -q 'PRE_CLAIM_DELETE_MARKER' "$TMPDIR/claude-prompt" \
    && grep -q 'C2_NEW_OWNED_MARKER' "$TMPDIR/claude-prompt"
  result=$?
  rm -f "$ROOT/$artifact" "$ROOT/$sidecar" "$ROOT/$receipt"
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  return "$result"
}

claim_contract_adoption_is_history_derived() {
  local legacy_base legacy_candidate legacy_feature legacy_result
  local post_candidate post_feature post_output post_status
  legacy_feature="_test-legacy-parallel-claim-$$"
  post_feature="_test-post-contract-missing-claim-$$"
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA" || return 1
  python3 - "$ROOT/scripts/lib-review-scope.py" <<'PY' || return 1
from pathlib import Path
import sys

path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
marker = "# sdlc-claim-base-contract:v1"
if text.count(marker) != 1:
    raise SystemExit(1)
path.write_text(text.replace(marker, "# pre-contract parallel-branch fixture"), encoding="utf-8")
PY
  git -C "$ROOT" add scripts/lib-review-scope.py \
    && git -C "$ROOT" commit --quiet -m 'test: model pre-contract parallel base' || return 1
  legacy_base=$(git -C "$ROOT" rev-parse HEAD)
  mkdir -p "$ROOT/docs/features/$legacy_feature"
  printf 'medium\n' > "$ROOT/docs/features/$legacy_feature/.tier"
  cat > "$ROOT/docs/features/$legacy_feature/TASKS.md" <<EOF
### TASK-LEGACY: parallel task created before contract adoption

- Status: Review
- Claimed at: 2026-07-10
- Intended file ownership:
  - docs/features/$legacy_feature/
EOF
  git -C "$ROOT" add "docs/features/$legacy_feature" \
    && git -C "$ROOT" commit --quiet -m 'test: add pre-contract parallel task' || return 1
  legacy_candidate=$(git -C "$ROOT" rev-parse HEAD)
  legacy_result=$(python3 "$ROOT/scripts/lib-review-scope.py" review-base \
    "$legacy_feature" TASK-LEGACY "$legacy_base" "$legacy_candidate") || return 1

  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA" || return 1
  mkdir -p "$ROOT/docs/features/$post_feature"
  printf 'medium\n' > "$ROOT/docs/features/$post_feature/.tier"
  cat > "$ROOT/docs/features/$post_feature/TASKS.md" <<EOF
### TASK-POST: task skipped dedicated claim after contract adoption

- Status: Review
- Claimed at: 2026-07-10 18:00 PDT
- Intended file ownership:
  - docs/features/$post_feature/
EOF
  git -C "$ROOT" add "docs/features/$post_feature" \
    && git -C "$ROOT" commit --quiet -m 'test: add post-contract unclaimed task' || return 1
  post_candidate=$(git -C "$ROOT" rev-parse HEAD)
  post_output=$(python3 "$ROOT/scripts/lib-review-scope.py" review-base \
    "$post_feature" TASK-POST "$PRIMARY_SHA" "$post_candidate" 2>&1)
  post_status=$?
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  [ "$legacy_result" = legacy ] && [ "$post_status" -eq 3 ] \
    && printf '%s\n' "$post_output" | grep -q 'after claim-base contract adoption'
}

