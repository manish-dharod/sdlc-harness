run_case "findings verdict requires a finding record" pass findings_verdict_requires_record
run_case "code-fenced examples are ignored and terminal findings grade" pass terminal_findings_verdict_with_record_is_valid
run_case "single whole-response outer fence is safely unwrapped" pass whole_response_outer_fence_is_unwrapped
run_case "outer response with nested Evidence can grade clear" pass outer_fence_with_nested_evidence_clear_is_valid
run_case "outer response with nested Evidence can grade findings" pass outer_fence_with_nested_evidence_findings_is_valid
run_case "unbalanced nested fence fails closed" pass unbalanced_nested_fence_is_invalid
run_case "separate first and last code blocks cannot expose fake clear" pass separate_first_and_last_code_blocks_are_invalid
run_case "substantive tail after verdict fails closed" pass substantive_tail_after_verdict_is_invalid
run_case "indented bullet after verdict reason fails closed" pass indented_bullet_after_reason_is_invalid
run_case "HEAD no-op review is rejected before reviewer invocation" pass empty_head_review_is_rejected
run_case "empty descendant receipt is rejected during validation" pass empty_descendant_receipt_is_rejected
run_case "canonical receipt bytes ignore hostile user git config" pass canonical_hash_ignores_hostile_git_config
