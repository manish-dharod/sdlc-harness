  rm -f "$TMPDIR/claude-args"
  output=$(SDLC_BASE_BRANCH=other "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test 2>&1)
  status_a=$?
  SDLC_CONFIG_FILE="$TMPDIR/other-config.yml" "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test >/dev/null 2>&1
  status_b=$?
  [ "$status_a" -eq 3 ] && [ "$status_b" -eq 3 ] &&
    printf '%s\n' "$output" | grep -q 'ambient SDLC_BASE_BRANCH is not accepted' &&
    [ ! -f "$TMPDIR/claude-args" ]
}

