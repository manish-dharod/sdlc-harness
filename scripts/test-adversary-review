replacement_refs_are_ignored_for_canonical_objects() {
  local baseline replaced result
  baseline=$("$ROOT/scripts/review-attempt" canonical-diff-hash "$BASE_SHA" "$PRIMARY_SHA" "$FEATURE" "$TASK_ID") || return 1
  git -C "$ROOT" replace "$PRIMARY_SHA" "$BASE_SHA"
  replaced=$("$ROOT/scripts/review-attempt" canonical-diff-hash "$BASE_SHA" "$PRIMARY_SHA" "$FEATURE" "$TASK_ID")
  result=0
  [ "$baseline" = "$replaced" ] || result=1
  git -C "$ROOT" replace -d "$PRIMARY_SHA" >/dev/null
  return "$result"
}

scope_hash_changes_when_owned_candidate_blob_changes() {
  local candidate_one candidate_two hash_one hash_two
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  printf 'owned context version one\n' > "$ROOT/docs/features/$FEATURE/context.txt"
  git -C "$ROOT" add "docs/features/$FEATURE/context.txt"
  git -C "$ROOT" commit --quiet -m 'test: add first owned context blob'
  candidate_one=$(git -C "$ROOT" rev-parse HEAD)
  printf 'owned context version two\n' > "$ROOT/docs/features/$FEATURE/context.txt"
  git -C "$ROOT" add "docs/features/$FEATURE/context.txt"
  git -C "$ROOT" commit --quiet -m 'test: change owned context blob'
  candidate_two=$(git -C "$ROOT" rev-parse HEAD)
  hash_one=$("$ROOT/scripts/review-attempt" scope-json "$FEATURE" "$TASK_ID" "$PRIMARY_SHA" "$candidate_one" | python3 -c 'import json,sys; print(json.load(sys.stdin)["scope_hash"])') || return 1
  hash_two=$("$ROOT/scripts/review-attempt" scope-json "$FEATURE" "$TASK_ID" "$PRIMARY_SHA" "$candidate_two" | python3 -c 'import json,sys; print(json.load(sys.stdin)["scope_hash"])') || return 1
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  [ "$hash_one" != "$hash_two" ]
}

