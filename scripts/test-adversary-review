trusted_machine_hash_formatting_keeps_user_pan_blocked() {
  local context_line formatted function_source helper_formatted index_source machine_hash machine_pan prompt_diff raw_index
  function_source=$(awk '/^format_trusted_hash_for_prompt\(\) \{/,/^}/' "$ROOT/scripts/adversary-review") || return 1
  index_source=$(awk '/^format_trusted_git_index_lines\(\) \{/,/^}/' "$ROOT/scripts/adversary-review") || return 1
  [ -n "$function_source" ] && [ -n "$index_source" ] || return 1
  eval "$function_source"
  eval "$index_source"
  machine_pan="55""00000000000004"
  machine_hash="${machine_pan}aaaaaaaaaaaaaaaaaaaaaaaa"
  formatted=$(format_trusted_hash_for_prompt "$machine_hash") || return 1
  [ "$formatted" = "55000000-00000004-aaaaaaaa-aaaaaaaa-aaaaaaaa" ] || return 1
  helper_formatted=$(python3 - "$ROOT/scripts/lib-review-scope.py" <<'PY'
import importlib.util
import io
import sys

spec = importlib.util.spec_from_file_location("review_scope_fixture", sys.argv[1])
module = importlib.util.module_from_spec(spec)
assert spec.loader is not None
spec.loader.exec_module(module)
value = "55" + "00000000000004" + ("a" * 24)
formatted = module.format_trusted_hash_for_prompt(value)
content = (f"===== user-controlled ; committed {value}) =====\n").encode()

class FakeProcess:
    def __init__(self, *args, **kwargs):
        self.stdout = io.BytesIO(content)
    def poll(self):
        return 0
    def terminate(self):
        return None
    def wait(self, timeout=None):
        return 0

module.tree_entries = lambda candidate: {"owned.txt": ("100644", "blob", "fixture-oid")}
module.git = lambda args, candidate_attrs=None: str(len(content)).encode()
module.subprocess.Popen = FakeProcess
scope = {"candidate_sha": value, "scope_paths": ["owned.txt"]}
full = module.snapshots(scope, 20, 4096)
assert f"committed {formatted}) =====".encode() in full
assert content in full  # blob bytes that mimic a delimiter remain unchanged
truncated = module.snapshots(scope, 20, 100)
assert ("55" + "00000000000004").encode() not in truncated
print(formatted)
PY
  ) || return 1
  [ "$helper_formatted" = "$formatted" ] || return 1
  raw_index="$TMPDIR/pan-shaped-index.diff"
  context_line=" index ${machine_hash}..${machine_hash} user-content"
  printf 'index %s..%s 100644\n%s\n' "$machine_hash" "$machine_hash" "$context_line" > "$raw_index"
  prompt_diff=$(format_trusted_git_index_lines "$raw_index") || return 1
  . "$ROOT/scripts/lib-sanitize.sh"
  sg_sanitize_scan_string "BASE SHA: $formatted" >/dev/null 2>&1 &&
    printf '%s\n' "$prompt_diff" | grep -Fqx "$context_line" &&
    [ "$(printf '%s\n' "$prompt_diff" | tail -1)" = "$context_line" ] &&
    ! sg_sanitize_scan_string "$prompt_diff" >/dev/null 2>&1 &&
    ! sg_sanitize_scan_string "user context: $machine_pan" >/dev/null 2>&1
}

review_signal_preserves_exit_and_kills_group() {
  local fake output signal_name expected
  for signal_name in INT TERM; do
    [ "$signal_name" = "INT" ] && expected=130 || expected=143
    fake="$TMPDIR/claude-signal-${signal_name}"
    output="$TMPDIR/signal-${signal_name}.out"
    rm -f "$TMPDIR/sleep-child-pid"
    write_sleeping_claude "$fake"
    python3 - "$ROOT" "$RUNNER" "$FEATURE" "$TASK_ID" "$fake" "$TMPDIR/sleep-child-pid" "$output" "$signal_name" "$expected" <<'PY' || return 1
import os, signal, subprocess, sys, time
root, runner, feature, task, fake, child_file, output, signal_name, expected = sys.argv[1:]
env = os.environ.copy()
env.update({"CLAUDE_BIN": fake, "ADVERSARY_REVIEW_TIMEOUT_SECONDS": "30", "CLAUDE_ADVERSARY_EFFORT": "max"})
with open(output, "wb") as handle:
    proc = subprocess.Popen(
        [runner, feature, task, "review", "HEAD~1", "gpt-5-test"],
        cwd=root, env=env, stdout=handle, stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    launch_deadline = time.monotonic() + 20
    while time.monotonic() < launch_deadline:
        if os.path.exists(child_file) and os.path.getsize(child_file):
            break
        return_code = proc.poll()
        if return_code is not None:
            handle.flush()
            detail = open(output, "rb").read()[-2000:].decode("utf-8", "replace")
            raise SystemExit(f"wrapper exited before reviewer launch: rc={return_code}\n{detail}")
        time.sleep(0.05)
    else:
        os.killpg(proc.pid, signal.SIGKILL)
        proc.wait()
        raise SystemExit("wrapper did not launch reviewer within 20s")
    child = int(open(child_file, encoding="ascii").read().strip())
    child_pgid = os.getpgid(child)
    os.killpg(proc.pid, getattr(signal, "SIG" + signal_name))
    status = proc.wait(timeout=10)
    alive = True
    child_state = "unknown"
    death_deadline = time.monotonic() + 5
    while time.monotonic() < death_deadline:
        try:
            current_pgid = os.getpgid(child)
        except ProcessLookupError:
            alive = False
            child_state = "gone"
            break
        if current_pgid != child_pgid:
            alive = False
            child_state = "pid-reused"
            break
        state = subprocess.run(
            ["ps", "-o", "stat=", "-p", str(child)],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
        ).stdout.strip()
        if not state or state.startswith("Z"):
            alive = False
            child_state = state or "gone"
            break
        child_state = state
        time.sleep(0.05)
    if alive:
        try:
            if os.getpgid(child) == child_pgid:
                os.kill(child, signal.SIGKILL)
        except ProcessLookupError:
            alive = False
    if status != int(expected) or alive:
        raise SystemExit(
            f"signal assertion failed: signal={signal_name} status={status} "
            f"expected={expected} child_state={child_state}"
        )
PY
    find "$ADVERSARY_DIR" -type f -name "*${TASK_ID}*" -delete 2>/dev/null || true
  done
}

output_allocation_and_retry_metadata_are_safe() {
  local backup="$TMPDIR/adversary-dir-backup" escape="$TMPDIR/output-escape" first second third a1 s1 r1 a2 s2 r2 a3 s3 r3 latest status
  local retry_task="${TASK_ID}-RETRY"
  rm -rf "$backup" "$escape"
  mkdir -p "$escape"
  [ -e "$ADVERSARY_DIR" ] && mv "$ADVERSARY_DIR" "$backup"
  ln -s "$escape" "$ADVERSARY_DIR"
  "$ROOT/scripts/review-attempt" allocate "$FEATURE" adversary "$TASK_ID" claude-code 1 >/dev/null 2>&1
  status=$?
  rm -f "$ADVERSARY_DIR"
  [ -e "$backup" ] && mv "$backup" "$ADVERSARY_DIR"
  [ "$status" -eq 3 ] && [ -z "$(find "$escape" -type f -print -quit)" ] || return 1
  first=$("$ROOT/scripts/review-attempt" allocate "$FEATURE" adversary "$retry_task" claude-code 1) || return 1
  second=$("$ROOT/scripts/review-attempt" allocate "$FEATURE" adversary "$retry_task" claude-code 2) || return 1
  third=$("$ROOT/scripts/review-attempt" allocate "$FEATURE" adversary "$retry_task" claude-code 3) || return 1
  IFS='|' read -r a1 s1 r1 <<< "$first"
  IFS='|' read -r a2 s2 r2 <<< "$second"
  IFS='|' read -r a3 s3 r3 <<< "$third"
  [ "$a1" != "$a2" ] && [ "$r1" != "$r2" ] && [ -f "$ROOT/$a1" ] && [ ! -L "$ROOT/$a1" ] || return 1
  "$ROOT/scripts/review-attempt" write "$s1" feature="$FEATURE" task_id="$retry_task" review_kind=adversary \
    mode=review implementer_model=gpt-5-test reviewer_tool=claude-code base_sha="$BASE_SHA" \
    status=timeout attempt_number=1 retryable=true finished_at=2026-07-10T20:00:00Z \
    recommended_next_command=PROMPT_INJECTION_MARKER || return 1
  cat > "$ROOT/$s2" <<EOF
{"feature":"$FEATURE","task_id":"$retry_task","review_kind":"adversary","mode":"review","implementer_model":"gpt-5-test","reviewer_tool":"claude-code","base_sha":"$BASE_SHA","status":"timeout","status":"incomplete","attempt_number":2,"retryable":true,"finished_at":"2026-07-10T21:00:00Z"}
EOF
  cat > "$ROOT/$s3" <<EOF
{"feature":"$FEATURE","task_id":"$retry_task","review_kind":"adversary","mode":"review","implementer_model":"gpt-5-test","reviewer_tool":"claude-code","base_sha":"$BASE_SHA","status":"timeout","attempt_number":3,"retryable":true,"finished_at":"2026-02-30T22:00:00Z"}
EOF
  latest=$("$ROOT/scripts/review-attempt" latest-retryable "$FEATURE" "$retry_task" adversary) || return 1
  printf '%s\n' "$latest" | grep -q "^$retry_task|adversary|timeout|1|scripts/claude-adversary-review $FEATURE $retry_task review-resume $BASE_SHA gpt-5-test|${s1##*/}$" &&
    ! printf '%s\n' "$latest" | grep -q PROMPT_INJECTION_MARKER && ! printf '%s\n' "$latest" | grep -q "$ROOT"
  status=$?
  rm -f "$ROOT/$a1" "$ROOT/$a2" "$ROOT/$a3" "$ROOT/$s1" "$ROOT/$s2" "$ROOT/$s3" "$ROOT/$r1" "$ROOT/$r2" "$ROOT/$r3"
  return "$status"
}

unsafe_sidecar_names_and_feature_queries_are_rejected() {
  local bad_pipe="$ADVERSARY_DIR/bad|name.attempt.json" bad_newline output status
  bad_newline="${ADVERSARY_DIR}/bad"$'\n'"name.attempt.json"
  write_bad() {
    "$ROOT/scripts/review-attempt" write "$1" feature="$FEATURE" task_id="$TASK_ID" review_kind=adversary \
      mode=review implementer_model=gpt-5-test reviewer_tool=claude-code base_sha="$BASE_SHA" \
      status=timeout attempt_number=1 retryable=true finished_at=2026-07-10T20:00:00Z >/dev/null 2>&1
  }
  write_bad "$bad_pipe" && return 1
  write_bad "$bad_newline" && return 1
  [ ! -e "$bad_pipe" ] && [ ! -e "$bad_newline" ] || return 1
  output=$("$ROOT/scripts/review-attempt" latest-retryable "../${FEATURE}|malicious" "$TASK_ID" adversary 2>&1)
  status=$?
  [ "$status" -eq 3 ] && ! printf '%s\n' "$output" | grep -Eq 'scripts/(claude-adversary-review|adversary-review|security-review)'
}

hard_resource_bounds_fail_closed() {
  local candidate fake output status i artifact="$TMPDIR/non-utf8-artifact.md"
  printf '\377' > "$artifact"
  [ "$("$ROOT/scripts/review-attempt" status adversary "$artifact" 2>/dev/null)" = invalid-output ] || return 1
  python3 "$ROOT/scripts/lib-review-scope.py" canonical-diff "$BASE_SHA" "$PRIMARY_SHA" "$FEATURE" "$TASK_ID" 280001 >/dev/null 2>&1 && return 1
  fake="$TMPDIR/claude-snapshot-raise"
  write_valid_claude "$fake"
  rm -f "$TMPDIR/claude-args"
  (cd "$ROOT" && CLAUDE_BIN="$fake" ADVERSARY_REVIEW_SNAPSHOT_MAX_BYTES=90001 \
    "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test) >/dev/null 2>&1
  [ "$?" -eq 3 ] && [ ! -f "$TMPDIR/claude-args" ] || return 1
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  mkdir -p "$ROOT/docs/features/$FEATURE/scope-many"
  i=0; while [ "$i" -lt 513 ]; do : > "$ROOT/docs/features/$FEATURE/scope-many/p$(printf '%03d' "$i")"; i=$((i + 1)); done
  git -C "$ROOT" add "docs/features/$FEATURE/scope-many"
  git -C "$ROOT" commit --quiet -m 'test: exceed scope path bound'
  candidate=$(git -C "$ROOT" rev-parse HEAD)
  output=$("$ROOT/scripts/review-attempt" scope-json "$FEATURE" "$TASK_ID" "$PRIMARY_SHA" "$candidate" 2>&1)
  status=$?
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  [ "$status" -eq 3 ] && printf '%s\n' "$output" | grep -q '512 path limit'
}

bounded_git_helper_drains_oversized_stderr() {
  local fake_bin="$TMPDIR/fake-git-stderr"
  mkdir -p "$fake_bin"
  cat > "$fake_bin/git" <<'EOF'
#!/usr/bin/env bash
python3 - <<'PY'
import os
os.write(2, b"e" * 70000)
os.write(1, b"late stdout")
PY
EOF
  chmod +x "$fake_bin/git"
  python3 - "$ROOT" "$fake_bin" <<'PY'
import importlib.util, os, sys, time
root, fake_bin = sys.argv[1:]
spec = importlib.util.spec_from_file_location("bounded_review_scope", os.path.join(root, "scripts", "lib-review-scope.py"))
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
os.environ["PATH"] = fake_bin + os.pathsep + os.environ["PATH"]
started = time.monotonic()
try:
    module.git_bounded(["fixture"], stdout_limit=64, stdout_label="fixture stdout", stderr_limit=65536, timeout=3)
except module.ScopeError as exc:
    if "git stderr exceeds hard 65536 byte limit" not in str(exc):
        raise SystemExit(1)
else:
    raise SystemExit(1)
if time.monotonic() - started > 5:
    raise SystemExit(1)
PY
}

git_context_redirection_and_local_diff_config_are_neutralized() {
  local baseline redirected other output status
  baseline=$(python3 "$ROOT/scripts/lib-review-scope.py" canonical-hash "$BASE_SHA" "$PRIMARY_SHA" "$FEATURE" "$TASK_ID") || return 1
  other="$TMPDIR/other-git-context"
  mkdir -p "$other/work"
  git -C "$other/work" init --quiet
  redirected=$(GIT_DIR="$other/work/.git" GIT_WORK_TREE="$other/work" python3 "$ROOT/scripts/lib-review-scope.py" canonical-hash \
    "$BASE_SHA" "$PRIMARY_SHA" "$FEATURE" "$TASK_ID") || return 1
  [ "$baseline" = "$redirected" ] || return 1
  git -C "$ROOT" config extensions.worktreeConfig true
  git -C "$ROOT" config --worktree diff.hostile.binary true
  output=$(python3 "$ROOT/scripts/lib-review-scope.py" canonical-hash "$BASE_SHA" "$PRIMARY_SHA" "$FEATURE" "$TASK_ID" 2>&1)
  status=$?
  git -C "$ROOT" config --worktree --unset-all diff.hostile.binary >/dev/null 2>&1 || true
  git -C "$ROOT" config --unset-all extensions.worktreeConfig >/dev/null 2>&1 || true
  [ "$status" -eq 3 ] && printf '%s\n' "$output" | grep -q 'clone-local Git config'
}

reviewer_drift_and_output_overflow_issue_no_receipt() {
  local valid fake mode output status sidecar artifact
  valid="$TMPDIR/claude-valid-after-mutation"
  write_valid_claude "$valid"
  fake="$TMPDIR/claude-mutating"
  cat > "$fake" <<EOF
#!/usr/bin/env bash
cat >/dev/null
if [ "\${DRIFT_MODE:-dirty}" = commit ]; then
  drift_tree=\$(git rev-parse 'HEAD^{tree}')
  drift_head=\$(printf '%s\n' reviewer-drift | git commit-tree "\$drift_tree" -p HEAD)
  git update-ref HEAD "\$drift_head"
else
  printf '\nreviewer mutation\n' >> "docs/features/$FEATURE/TASKS.md"
fi
"$valid" </dev/null
EOF
  chmod +x "$fake"
  for mode in dirty commit; do
    git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
    git -C "$ROOT" restore --worktree --staged "docs/features/$FEATURE/TASKS.md"
    output="$(cd "$ROOT" && DRIFT_MODE="$mode" CLAUDE_BIN="$fake" "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test 2>&1)"
    status=$?
    sidecar=$(printf '%s\n' "$output" | sed -n 's/^Attempt sidecar:[[:space:]]*//p' | head -1)
    [ "$status" -eq 2 ] && [ -f "$ROOT/$sidecar" ] && grep -q 'candidate-drift' "$ROOT/$sidecar" || return 1
    artifact="${sidecar%.attempt.json}.md"; rm -f "$ROOT/$sidecar" "$ROOT/$artifact"
  done
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  fake="$TMPDIR/claude-output-overflow"
  cat > "$fake" <<'EOF'
#!/usr/bin/env bash
cat >/dev/null
python3 -c 'import sys; sys.stdout.write("x" * 400000)'
EOF
  chmod +x "$fake"
  output="$(cd "$ROOT" && CLAUDE_BIN="$fake" "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test 2>&1)"
  status=$?
  sidecar=$(printf '%s\n' "$output" | sed -n 's/^Attempt sidecar:[[:space:]]*//p' | head -1)
  artifact="${sidecar%.attempt.json}.md"
  [ "$status" -eq 2 ] && grep -q 'reviewer-output-limit' "$ROOT/$sidecar" && [ "$(wc -c < "$ROOT/$artifact")" -le 300000 ]
  status=$?
  rm -f "$ROOT/$sidecar" "$ROOT/$artifact"
  return "$status"
}

reviewer_owned_file_is_not_captured_output() {
  local artifact fake output receipt result session status valid
  valid="$TMPDIR/claude-valid-session-file"
  fake="$TMPDIR/claude-session-file"
  session="$TMPDIR/reviewer-session.log"
  write_valid_claude "$valid"
  cat > "$fake" <<EOF
#!/usr/bin/env bash
cat >/dev/null
python3 -c 'open("$session", "wb").write(b"s" * 400000)'
"$valid" </dev/null
EOF
  chmod +x "$fake"
  output="$(cd "$ROOT" && CLAUDE_BIN="$fake" "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test 2>&1)"
  status=$?
  artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)
  receipt=$(printf '%s\n' "$output" | sed -n 's/^Review receipt:[[:space:]]*//p' | head -1)
  [ "$status" -eq 0 ] && [ "$(wc -c < "$session")" -eq 400000 ]
  result=$?
  rm -f "$ROOT/$artifact" "$ROOT/${artifact%.md}.attempt.json" "$ROOT/$receipt"
  return "$result"
}

small_output_child_exit_125_is_reviewer_exit() {
  local artifact fake output result sidecar status
  fake="$TMPDIR/claude-small-exit-125"
  cat > "$fake" <<'EOF'
#!/usr/bin/env bash
cat >/dev/null
printf 'small reviewer failure\n'
exit 125
EOF
  chmod +x "$fake"
  output="$(cd "$ROOT" && CLAUDE_BIN="$fake" "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test 2>&1)"
  status=$?
  sidecar=$(printf '%s\n' "$output" | sed -n 's/^Attempt sidecar:[[:space:]]*//p' | head -1)
  artifact="${sidecar%.attempt.json}.md"
  [ "$status" -eq 2 ] && [ -f "$ROOT/$sidecar" ] && \
    grep -q '"status": "unavailable"' "$ROOT/$sidecar" && \
    grep -q '"exit_code": 125' "$ROOT/$sidecar" && \
    grep -q '"failure_reason": "reviewer-exit"' "$ROOT/$sidecar" && \
    ! grep -q 'reviewer-output-limit' "$ROOT/$sidecar" && \
    ! printf '%s\n' "$output" | grep -q 'reviewer output reached the hard'
  result=$?
  case "$sidecar" in
    docs/features/*/adversary/*.attempt.json)
      rm -f "$ROOT/$sidecar" "$ROOT/$artifact"
      ;;
  esac
  return "$result"
}

prompt_limits_require_split_before_model_and_keep_absolute_ceiling() {
  local base fake output reservation result status
  fake="$TMPDIR/claude-prompt-limits"
  write_valid_claude "$fake"
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  python3 -c 'print("e" * 260000)' > "$ROOT/docs/features/$FEATURE/EVIDENCE.md"
  : > "$ROOT/docs/features/$FEATURE/FINDINGS.md"
  git -C "$ROOT" add "docs/features/$FEATURE/EVIDENCE.md" "docs/features/$FEATURE/FINDINGS.md" && git -C "$ROOT" commit --quiet -m 'test: normal prompt limit context'
  base=$(git -C "$ROOT" rev-parse HEAD)
  printf '\nnormal prompt limit candidate\n' >> "$ROOT/docs/features/$FEATURE/TASKS.md"
  git -C "$ROOT" add "docs/features/$FEATURE/TASKS.md" && git -C "$ROOT" commit --quiet -m 'test: normal prompt limit candidate'
  rm -f "$TMPDIR/claude-args" "$TMPDIR/claude-prompt"
  output="$(cd "$ROOT" && CLAUDE_BIN="$fake" "$RUNNER" "$FEATURE" "$TASK_ID" review "$base" gpt-5-test 2>&1)"
  status=$?
  [ "$status" -eq 2 ] && [ ! -f "$TMPDIR/claude-args" ] &&
    printf '%s\n' "$output" | grep -q 'NEEDS_TASK_SPLIT: assembled task-review prompt' &&
    ! printf '%s\n' "$output" | grep -q '^Review receipt:' || return 1
  reservation=$("$ROOT/scripts/review-attempt" reserve-call "$FEATURE" "$TASK_ID" adversary 2>/dev/null) || return 1
  [ "$reservation" = 'reserved|1|3' ] || return 1

  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  python3 -c 'print("e" * 410000)' > "$ROOT/docs/features/$FEATURE/EVIDENCE.md"
  : > "$ROOT/docs/features/$FEATURE/FINDINGS.md"
  git -C "$ROOT" add "docs/features/$FEATURE/EVIDENCE.md" "docs/features/$FEATURE/FINDINGS.md" && git -C "$ROOT" commit --quiet -m 'test: absolute prompt ceiling context'
  base=$(git -C "$ROOT" rev-parse HEAD)
  printf '\nabsolute prompt ceiling candidate\n' >> "$ROOT/docs/features/$FEATURE/TASKS.md"
  git -C "$ROOT" add "docs/features/$FEATURE/TASKS.md" && git -C "$ROOT" commit --quiet -m 'test: absolute prompt ceiling candidate'
  rm -f "$TMPDIR/claude-args" "$TMPDIR/claude-prompt"
  output="$(cd "$ROOT" && CLAUDE_BIN="$fake" "$RUNNER" "$FEATURE" "$TASK_ID" review "$base" gpt-5-test 2>&1)"
  status=$?
  [ "$status" -eq 3 ] && [ ! -f "$TMPDIR/claude-args" ] &&
    printf '%s\n' "$output" | grep -q 'assembled prompt exceeds hard 400000-byte limit'
  result=$?
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  return "$result"
}

