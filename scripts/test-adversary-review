run_case "invalid timeout value is rejected" fail invalid_timeout_rejected
run_case "multiple or revised verdict blocks fail closed" pass revised_or_multiple_verdict_is_invalid
run_case "echoed verdict enum is not graded clear" pass echoed_enum_does_not_grade_clear
