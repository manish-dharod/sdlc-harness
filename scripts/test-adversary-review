empty_head_review_is_rejected() {
  local fake output status
  fake="$TMPDIR/claude-empty-head"
  write_valid_claude "$fake"
  rm -f "$TMPDIR/claude-args" "$TMPDIR/claude-prompt"
  output="$((
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD gpt-5-test
  ) 2>&1)"
  status=$?
  [ "$status" -eq 3 ] &&
    printf '%s\n' "$output" | grep -Eq 'canonical diff is empty|no owned committed change' &&
    [ ! -f "$TMPDIR/claude-args" ] &&
    ! printf '%s\n' "$output" | grep -q '^Review receipt:'
}

empty_descendant_receipt_is_rejected() {
  local candidate receipt status tree
  tree=$(git -C "$ROOT" rev-parse 'HEAD^{tree}')
  candidate=$(printf 'empty descendant fixture\n' | \
    GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.invalid \
    GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.invalid \
    git -C "$ROOT" commit-tree "$tree" -p HEAD)
  receipt="docs/features/$FEATURE/review-receipts/empty-descendant.json"
  mkdir -p "$ROOT/docs/features/$FEATURE/review-receipts"
  "$ROOT/scripts/review-attempt" write-receipt "$receipt" \
    schema_version=1 feature="$FEATURE" task_id="$TASK_ID" \
    review_kind=adversary status=clear \
    implementer_tool=codex-app implementer_model=gpt-5-test \
    reviewer_tool=claude-code reviewer_model=claude-opus-4-8 \
    base_sha="$(git -C "$ROOT" rev-parse HEAD)" \
    reviewed_candidate_sha="$candidate" \
    canonical_diff_hash=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855 \
    prompt_hash=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
    transcript_hash=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb \
    reviewed_at=2026-07-10T00:00:00Z >/dev/null
  "$ROOT/scripts/review-attempt" validate-receipt "$receipt" >/dev/null 2>&1
  status=$?
  rm -f "$ROOT/$receipt"
  [ "$status" -ne 0 ]
}

canonical_hash_ignores_hostile_git_config() {
  local base candidate normal order_file receipt result hostile
  base=$(git -C "$ROOT" rev-parse HEAD~1)
  candidate=$(git -C "$ROOT" rev-parse HEAD)
  order_file="$TMPDIR/diff-order"
  printf '%s\n' 'scripts/test-adversary-review' 'docs/features/README.md' > "$order_file"
  normal=$("$ROOT/scripts/review-attempt" canonical-diff-hash "$base" "$candidate")
  receipt="docs/features/$FEATURE/review-receipts/hostile-config.json"
  "$ROOT/scripts/review-attempt" write-receipt "$receipt" \
    schema_version=1 feature="$FEATURE" task_id="$TASK_ID" \
    review_kind=adversary status=clear \
    implementer_tool=codex-app implementer_model=gpt-5-test \
    reviewer_tool=claude-code reviewer_model=claude-opus-4-8 \
    base_sha="$base" reviewed_candidate_sha="$candidate" \
    canonical_diff_hash="$normal" \
    prompt_hash=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
    transcript_hash=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb \
    reviewed_at=2026-07-10T00:00:00Z >/dev/null
  hostile=$(env \
    GIT_CONFIG_COUNT=8 \
    GIT_CONFIG_KEY_0=core.quotePath GIT_CONFIG_VALUE_0=false \
    GIT_CONFIG_KEY_1=diff.algorithm GIT_CONFIG_VALUE_1=histogram \
    GIT_CONFIG_KEY_2=diff.context GIT_CONFIG_VALUE_2=19 \
    GIT_CONFIG_KEY_3=diff.noprefix GIT_CONFIG_VALUE_3=true \
    GIT_CONFIG_KEY_4=diff.mnemonicPrefix GIT_CONFIG_VALUE_4=true \
    GIT_CONFIG_KEY_5=diff.indentHeuristic GIT_CONFIG_VALUE_5=false \
    GIT_CONFIG_KEY_6=diff.suppressBlankEmpty GIT_CONFIG_VALUE_6=true \
    GIT_CONFIG_KEY_7=diff.orderFile GIT_CONFIG_VALUE_7="$order_file" \
    "$ROOT/scripts/review-attempt" canonical-diff-hash "$base" "$candidate")
  env \
    GIT_CONFIG_COUNT=8 \
    GIT_CONFIG_KEY_0=core.quotePath GIT_CONFIG_VALUE_0=false \
    GIT_CONFIG_KEY_1=diff.algorithm GIT_CONFIG_VALUE_1=histogram \
    GIT_CONFIG_KEY_2=diff.context GIT_CONFIG_VALUE_2=19 \
    GIT_CONFIG_KEY_3=diff.noprefix GIT_CONFIG_VALUE_3=true \
    GIT_CONFIG_KEY_4=diff.mnemonicPrefix GIT_CONFIG_VALUE_4=true \
    GIT_CONFIG_KEY_5=diff.indentHeuristic GIT_CONFIG_VALUE_5=false \
    GIT_CONFIG_KEY_6=diff.suppressBlankEmpty GIT_CONFIG_VALUE_6=true \
    GIT_CONFIG_KEY_7=diff.orderFile GIT_CONFIG_VALUE_7="$order_file" \
    "$ROOT/scripts/review-attempt" validate-receipt "$receipt" >/dev/null 2>&1
  result=$?
  rm -f "$ROOT/$receipt"
  [ "$result" -eq 0 ] && [ "$hostile" = "$normal" ]
}

normal_diff_requires_task_split_without_model() {
  local fake output reservation result status
  fake="$TMPDIR/claude-normal-diff-limit"
  write_valid_claude "$fake"
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  python3 -c 'print("r" * 185000)' > "$ROOT/docs/features/$FEATURE/normal-large-diff.txt"
  git -C "$ROOT" add "docs/features/$FEATURE/normal-large-diff.txt"
  git -C "$ROOT" commit --quiet -m 'test: adversary normal diff limit candidate'
  rm -f "$TMPDIR/claude-args" "$TMPDIR/claude-prompt"
  output="$(cd "$ROOT" && CLAUDE_BIN="$fake" "$RUNNER" "$FEATURE" "$TASK_ID" review-resume HEAD~1 gpt-5-test 2>&1)"
  status=$?
  [ "$status" -eq 2 ] &&
    printf '%s\n' "$output" | grep -q 'NEEDS_TASK_SPLIT: canonical task diff' &&
    [ ! -f "$TMPDIR/claude-args" ] &&
    ! printf '%s\n' "$output" | grep -q '^Review receipt:'
  result=$?
  reservation=$("$ROOT/scripts/review-attempt" reserve-call "$FEATURE" "$TASK_ID" adversary 2>/dev/null) || result=1
  [ "$reservation" = 'reserved|1|3' ] || result=1
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  return "$result"
}

