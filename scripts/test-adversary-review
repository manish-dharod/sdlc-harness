severity_aware_adversary_grading_is_strict() {
  local artifact status

  artifact="$TMPDIR/adversary-p3.md"
  cat > "$artifact" <<'EOF'
#### ADV-FND-001
- Severity: P3

### Verdict
- ADVERSARIAL FINDINGS OPENED
- Reason: visibility-only observation
EOF
  status=$("$ROOT/scripts/review-attempt" status adversary "$artifact" 2>/dev/null || true)
  [ "$status" = "clear" ] || return 1

  artifact="$TMPDIR/adversary-mixed.md"
  cat > "$artifact" <<'EOF'
#### ADV-FND-001
- Severity: P3

#### ADV-FND-002
- Severity: P1

### Verdict
- ADVERSARIAL FINDINGS OPENED
- Reason: one blocking finding remains
EOF
  status=$("$ROOT/scripts/review-attempt" status adversary "$artifact" 2>/dev/null || true)
  [ "$status" = "findings" ] || return 1

  artifact="$TMPDIR/adversary-p0.md"
  cat > "$artifact" <<'EOF'
#### ADV-FND-001
- Severity: P0

### Verdict
- ADVERSARIAL FINDINGS OPENED
- Reason: blocking finding remains
EOF
  status=$("$ROOT/scripts/review-attempt" status adversary "$artifact" 2>/dev/null || true)
  [ "$status" = "findings" ] || return 1

  for invalid_shape in missing duplicate malformed out-of-block; do
    artifact="$TMPDIR/adversary-$invalid_shape.md"
    case "$invalid_shape" in
      missing)
        cat > "$artifact" <<'EOF'
#### ADV-FND-001
- Status: Confirmed
EOF
        ;;
      duplicate)
        cat > "$artifact" <<'EOF'
#### ADV-FND-001
- Severity: P2
- Severity: P3
EOF
        ;;
      malformed)
        cat > "$artifact" <<'EOF'
#### ADV-FND-001
- Severity: P4
EOF
        ;;
      out-of-block)
        cat > "$artifact" <<'EOF'
- Severity: P2

#### ADV-FND-001
- Severity: P3
EOF
        ;;
    esac
    cat >> "$artifact" <<'EOF'

### Verdict
- ADVERSARIAL FINDINGS OPENED
- Reason: malformed fixture must fail closed
EOF
    status=$("$ROOT/scripts/review-attempt" status adversary "$artifact" 2>/dev/null || true)
    [ "$status" = "invalid-output" ] || return 1
  done
}

adversary_wrapper_routes_severity_to_receipts_without_retry() {
  local artifact expected fake human output receipt result severity sidecar status tampered
  for severity_expected in P2:clear P1:findings; do
    severity=${severity_expected%%:*}
    expected=${severity_expected#*:}
    fake="$TMPDIR/claude-$severity"
    write_finding_claude "$fake" "$severity"
    output="$(cd "$ROOT" && CLAUDE_BIN="$fake" "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test 2>&1)"
    status=$?
    artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)
    receipt=$(printf '%s\n' "$output" | sed -n 's/^Review receipt:[[:space:]]*//p' | head -1)
    sidecar=$(printf '%s\n' "$output" | sed -n 's/^Attempt JSON:[[:space:]]*//p' | head -1)
    human="$TMPDIR/adversary-$severity-human"
    tampered="$ROOT/${receipt%.json}-tampered.json"
    result=0
    [ "$status" -eq 0 ] &&
      grep -q -- "- Severity: $severity" "$ROOT/$artifact" &&
      grep -q -- '"schema_version": 3' "$ROOT/$receipt" &&
      grep -q -- "${severity}\"" "$ROOT/$receipt" &&
      grep -q -- "\"status\": \"$expected\"" "$ROOT/$receipt" &&
      grep -q -- "\"status\": \"$expected\"" "$ROOT/$sidecar" &&
      grep -q -- '"retryable": false' "$ROOT/$sidecar" || result=1
    rm -f "$ROOT/$artifact" "$ROOT/$sidecar"
    "$ROOT/scripts/review-attempt" validate-receipt "$receipt" --require-scoped >/dev/null 2>&1 || result=1
    "$ROOT/scripts/review-attempt" receipt-human-fields "$ROOT/$receipt" > "$human" || result=1
    grep -q -- "^finding_id=ADV-FND-001 severity=$severity$" "$human" || result=1
    grep -q -- "^severity_count_${severity}=1$" "$human" || result=1
    python3 - "$ROOT/$receipt" "$tampered" <<'PY' || result=1
import json, sys
source, destination = sys.argv[1:]
with open(source, encoding="utf-8") as handle:
    data = json.load(handle)
data["severity_counts"]["P0"] += 1
with open(destination, "w", encoding="utf-8") as handle:
    json.dump(data, handle, indent=2, sort_keys=True)
    handle.write("\n")
PY
    "$ROOT/scripts/review-attempt" validate-receipt "${tampered#$ROOT/}" --schema-only >/dev/null 2>&1 && result=1
    rm -f "$ROOT/$receipt" "$tampered"
    [ "$result" -eq 0 ] || return 1
  done
}

