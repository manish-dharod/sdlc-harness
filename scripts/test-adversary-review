#!/usr/bin/env bash
# Regression tests for scripts/adversary-review wrapper behavior.

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Receipt wrappers bind the repository's current HEAD. Run the focused suite in
# a disposable clone with a tiny committed candidate so the test is independent
# of the caller's PR/merge diff size while still exercising real Git history.
if [ "${SDLC_REVIEW_TEST_ISOLATED:-0}" != "1" ]; then
  ISOLATION_TMP="$(mktemp -d)"
  trap 'rm -rf "$ISOLATION_TMP"' EXIT
  ISOLATION_REPO="$ISOLATION_TMP/repo"
  git clone --quiet --no-local "$ROOT" "$ISOLATION_REPO" || {
    printf 'test-adversary-review: failed to create isolated fixture clone\n' >&2
    exit 1
  }
  printf '\nReview wrapper isolated candidate.\n' >> "$ISOLATION_REPO/docs/START_HERE.md"
  git -C "$ISOLATION_REPO" add -- docs/START_HERE.md
  GIT_AUTHOR_NAME=sdlc-test GIT_AUTHOR_EMAIL=sdlc-test@example.invalid \
    GIT_COMMITTER_NAME=sdlc-test GIT_COMMITTER_EMAIL=sdlc-test@example.invalid \
    git -C "$ISOLATION_REPO" commit --quiet -m "test: isolate adversary wrapper candidate" || exit 1
  SDLC_REVIEW_TEST_ISOLATED=1 "$ISOLATION_REPO/scripts/test-adversary-review"
  exit $?
fi

SDLC_CONFIG_FILE="$ROOT/sdlc.config.yml" . "$ROOT/scripts/load-config"
RUNNER="$ROOT/scripts/claude-adversary-review"
FEATURE="_test-adversary-review-wrapper-$$"
TASK_ID="TASK-272-TEST-$$"
ADVERSARY_DIR="$ROOT/docs/features/$FEATURE/adversary"
TMPDIR="$(mktemp -d)"
SNAPSHOT_FEATURE="_test-adversary-review-snapshot-$$"
SNAPSHOT_TASK="TASK-SNAPSHOT-$$"
SNAPSHOT_DIR="$ROOT/docs/features/$SNAPSHOT_FEATURE"
SNAPSHOT_OWNED_A="$TMPDIR/snapshot-owned-a.txt"
SNAPSHOT_OWNED_B="$TMPDIR/snapshot-owned-b.txt"
RUN_MARKER="$TMPDIR/run-marker"
PASS_COUNT=0
FAIL_COUNT=0
touch "$RUN_MARKER"
mkdir -p "$ROOT/docs/features/$FEATURE"
printf 'medium\n' > "$ROOT/docs/features/$FEATURE/.tier"
cat > "$ROOT/docs/features/$FEATURE/TASKS.md" <<EOF
### $TASK_ID: focused wrapper fixture

- Status: Review
- AC IDs: AC-016
- Type: workflow
- Intended file ownership:
  - docs/START_HERE.md
- Verification:
  - scripts/test-adversary-review
EOF
mkdir -p "$SNAPSHOT_DIR"
printf 'medium\n' > "$SNAPSHOT_DIR/.tier"
cat > "$SNAPSHOT_DIR/TASKS.md" <<EOF
### $SNAPSHOT_TASK: isolated snapshot fixture

- Status: Review
- AC IDs: AC-016
- Type: workflow
- Intended file ownership:
  - $SNAPSHOT_OWNED_A
  - $SNAPSHOT_OWNED_B
- Verification:
  - scripts/test-adversary-review
EOF
printf 'SNAPSHOT_FIXTURE_MARKER\n' > "$SNAPSHOT_OWNED_A"
: > "$SNAPSHOT_OWNED_B"
snapshot_line=0
while [ "$snapshot_line" -lt 300 ]; do
  printf 'snapshot fixture line %03d with deterministic bounded content\n' "$snapshot_line" >> "$SNAPSHOT_OWNED_B"
  snapshot_line=$((snapshot_line + 1))
done

cleanup() {
  for dir in \
    "$ROOT/docs/features/$FEATURE/review-receipts" \
    "$SNAPSHOT_DIR/review-receipts"; do
    [ -d "$dir" ] || continue
    find "$dir" -type f -newer "$RUN_MARKER" \( -name "*${TASK_ID}*" -o -name "*${SNAPSHOT_TASK}*" -o -name "._*${TASK_ID}*" -o -name "._*${SNAPSHOT_TASK}*" \) -delete
    rmdir "$dir" 2>/dev/null || true
  done
  rm -rf "$ROOT/docs/features/$FEATURE"
  rm -rf "$SNAPSHOT_DIR"
  rm -rf "$ROOT/docs/features/_test-adversary-review-dirty-$$"
  rm -rf "$TMPDIR"
}
trap cleanup EXIT

write_sleeping_claude() {
  local file="$1"
  cat > "$file" <<EOF
#!/usr/bin/env bash
cat >/dev/null
sleep 30 &
printf '%s\n' "\$!" > "$TMPDIR/sleep-child-pid"
wait
EOF
  chmod +x "$file"
}

write_valid_claude() {
  local file="$1"
  cat > "$file" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$@" > "$TMPDIR/claude-args"
cat > "$TMPDIR/claude-prompt"
cat <<'OUT'
\`\`\`markdown
## Adversarial review: fake

### Routing
- Mode: review-narrow
- Diff scope: fake

### Categories
- false-confidence: n/a: fake test reviewer
- missed-edge: n/a: fake test reviewer
- spec-loophole: n/a: fake test reviewer
- hidden-coupling: n/a: fake test reviewer
- negative-path: n/a: fake test reviewer
- env-assumption: n/a: fake test reviewer
- rollback-gap: n/a: fake test reviewer
- stale-evidence: n/a: fake test reviewer
- traceability-mismatch: n/a: fake test reviewer
- tests-pass-behavior-wrong: n/a: fake test reviewer

### Findings (only validated hypotheses)
(no findings)

### Verdict
- ADVERSARIAL CLEAR
- Reason: fake clear for wrapper regression test
\`\`\`
OUT
EOF
  chmod +x "$file"
}

run_case() {
  local name="$1"
  local expected="$2"
  shift 2
  local output status

  output="$("$@" 2>&1)"
  status=$?

  if { [ "$expected" = "pass" ] && [ "$status" -eq 0 ]; } || { [ "$expected" = "fail" ] && [ "$status" -ne 0 ]; }; then
    printf 'ok - %s\n' "$name"
    PASS_COUNT=$((PASS_COUNT + 1))
  else
    printf 'not ok - %s\n' "$name" >&2
    printf 'expected: %s, status: %s\n%s\n' "$expected" "$status" "$output" >&2
    FAIL_COUNT=$((FAIL_COUNT + 1))
  fi
}

timeout_reports_unavailable() {
  local artifact fake generated_artifacts marker output status child_pid sidecar
  fake="$TMPDIR/claude-sleep"
  marker="$TMPDIR/before-timeout"
  write_sleeping_claude "$fake"
  touch "$marker"

  output="$((
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      ADVERSARY_REVIEW_TIMEOUT_SECONDS=1 \
      CLAUDE_ADVERSARY_EFFORT=max \
      "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test
  ) 2>&1)"
  status=$?

  generated_artifacts=$(printf '%s\n' "$output" | sed -n 's/.*Artifact written to //p' | sed 's/[[:space:]]*$//' | sort -u)
  artifact=$(printf '%s\n' "$generated_artifacts" | head -1)
  sidecar="${artifact%.md}.attempt.json"
  child_pid=""
  if [ -f "$TMPDIR/sleep-child-pid" ]; then
    child_pid="$(cat "$TMPDIR/sleep-child-pid")"
  fi
  sleep 1

  [ "$status" -eq 2 ] &&
    [ -n "$artifact" ] &&
    [ -f "$ROOT/$artifact" ] &&
    [ -f "$ROOT/$sidecar" ] &&
    printf '%s\n' "$artifact" | grep -Eq "/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{6}Z-${TASK_ID}-claude-code-attempt-[0-9]+\\.md$" &&
    grep -q 'timed out after 1s' "$ROOT/$artifact" &&
    grep -q 'ADVERSARY_REVIEW_TIMEOUT_SECONDS=900 scripts/claude-adversary-review' "$ROOT/$sidecar" &&
    printf '%s\n' "$output" | grep -q 'cross-model reviewer unavailable' &&
    [ -n "$child_pid" ] &&
    ! kill -0 "$child_pid" 2>/dev/null
  result=$?

  if [ "$result" -ne 0 ]; then
    printf '%s\n' "$output" >&2
  fi

  if [ -n "$generated_artifacts" ]; then
    while IFS= read -r artifact; do
      case "$artifact" in
        docs/features/*/adversary/*.md) rm -f "$ROOT/$artifact" "$ROOT/${artifact%.md}.attempt.json" "$ROOT/${artifact%/*}/._${artifact##*/}" ;;
      esac
    done <<< "$generated_artifacts"
  fi
  find "$ADVERSARY_DIR" -type f -newer "$marker" -name "*${TASK_ID}*.md" ! -name '._*' -exec rm -f {} +
  find "$ADVERSARY_DIR" -type f -newer "$marker" -name "*${TASK_ID}*.attempt.json" -exec rm -f {} +
  find "$ADVERSARY_DIR" -type f -newer "$marker" -name "._*${TASK_ID}*" -exec rm -f {} + 2>/dev/null || true

  return "$result"
}

context_only_prompt_for_claude() {
  local artifact fake marker output receipt status
  fake="$TMPDIR/claude-valid"
  marker="$TMPDIR/before-context-only"
  write_valid_claude "$fake"
  touch "$marker"

  output="$((
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      ADVERSARY_REVIEW_TIMEOUT_SECONDS=30 \
      CLAUDE_ADVERSARY_EFFORT=max \
      "$RUNNER" "$FEATURE" "$TASK_ID" review-narrow HEAD~1 gpt-5-test
  ) 2>&1)"
  status=$?

  artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)
  receipt=$(printf '%s\n' "$output" | sed -n 's/^Review receipt:[[:space:]]*//p' | head -1)
  sed '/^================ CONTEXT ================/,$d' "$TMPDIR/claude-prompt" > "$TMPDIR/claude-prompt-instructions"

  [ "$status" -eq 0 ] &&
    [ -f "$TMPDIR/claude-args" ] &&
    [ -f "$TMPDIR/claude-prompt" ] &&
    grep -q -- '--append-system-prompt' "$TMPDIR/claude-args" &&
    grep -q -- 'No tools are available' "$TMPDIR/claude-prompt-instructions" &&
    grep -q -- 'Do NOT request file reads or output tool-call markup' "$TMPDIR/claude-prompt-instructions" &&
    grep -q -- 'Do NOT wrap the whole response in a Markdown code fence' "$TMPDIR/claude-prompt-instructions" &&
    grep -q -- 'keep Evidence inline or indented rather than fenced' "$TMPDIR/claude-args" &&
    [ -n "$artifact" ] &&
    [ -f "$ROOT/$artifact" ] &&
    [ -n "$receipt" ] &&
    [ -f "$ROOT/$receipt" ] &&
    "$ROOT/scripts/review-attempt" validate-receipt "$receipt" >/dev/null 2>&1 &&
    grep -q '"review_kind": "adversary"' "$ROOT/$receipt" &&
    grep -q '"status": "clear"' "$ROOT/$receipt" &&
    ! git -C "$ROOT" check-ignore -q "$receipt" &&
    git -C "$ROOT" check-ignore -q "${receipt%/*}/._fixture.json"
  result=$?

  if [ "$result" -ne 0 ]; then
    printf '%s\n' "$output" >&2
  fi

  if [ -n "$artifact" ]; then
    case "$artifact" in
      docs/features/*/adversary/*.md) rm -f "$ROOT/$artifact" "$ROOT/${artifact%.md}.attempt.json" "$ROOT/${artifact%/*}/._${artifact##*/}" ;;
    esac
  fi
  if [ -n "$receipt" ]; then
    case "$receipt" in
      docs/features/*/review-receipts/*.json) rm -f "$ROOT/$receipt" "$ROOT/${receipt%/*}/._${receipt##*/}" ;;
    esac
  fi
  find "$ADVERSARY_DIR" -type f -newer "$marker" -name "*${TASK_ID}*.md" ! -name '._*' -exec rm -f {} +
  find "$ADVERSARY_DIR" -type f -newer "$marker" -name "*${TASK_ID}*.attempt.json" -exec rm -f {} +
  find "$ADVERSARY_DIR" -type f -newer "$marker" -name "._*${TASK_ID}*" -exec rm -f {} + 2>/dev/null || true

  return "$result"
}

task_owned_snapshots_included_for_claude() {
  local artifact fake marker output status snapshot_adversary_dir
  fake="$TMPDIR/claude-valid-snapshot"
  marker="$TMPDIR/before-snapshot"
  snapshot_adversary_dir="$SNAPSHOT_DIR/adversary"
  write_valid_claude "$fake"
  touch "$marker"

  output="$((
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      ADVERSARY_REVIEW_TIMEOUT_SECONDS=30 \
      CLAUDE_ADVERSARY_EFFORT=max \
      "$RUNNER" "$SNAPSHOT_FEATURE" "$SNAPSHOT_TASK" review-narrow HEAD~1 gpt-5-test
  ) 2>&1)"
  status=$?

  artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)

  [ "$status" -eq 0 ] &&
    [ -f "$TMPDIR/claude-prompt" ] &&
    grep -q -- '----- task-owned file snapshots (bounded; tools disabled) -----' "$TMPDIR/claude-prompt" &&
    grep -q -- "===== $SNAPSHOT_OWNED_A " "$TMPDIR/claude-prompt" &&
    grep -q -- 'SNAPSHOT_FIXTURE_MARKER' "$TMPDIR/claude-prompt" &&
    grep -q -- "===== $SNAPSHOT_OWNED_B " "$TMPDIR/claude-prompt"
  result=$?

  if [ "$result" -ne 0 ]; then
    printf '%s\n' "$output" >&2
  fi

  if [ -n "$artifact" ]; then
    case "$artifact" in
      docs/features/*/adversary/*.md) rm -f "$ROOT/$artifact" "$ROOT/${artifact%.md}.attempt.json" "$ROOT/${artifact%/*}/._${artifact##*/}" ;;
    esac
  fi
  find "$snapshot_adversary_dir" -type f -newer "$marker" -name "*${SNAPSHOT_TASK}*.md" ! -name '._*' -exec rm -f {} +
  find "$snapshot_adversary_dir" -type f -newer "$marker" -name "*${SNAPSHOT_TASK}*.attempt.json" -exec rm -f {} +
  find "$snapshot_adversary_dir" -type f -newer "$marker" -name "._*${SNAPSHOT_TASK}*" -exec rm -f {} + 2>/dev/null || true

  return "$result"
}

review_narrow_snapshot_bounds_apply() {
  local artifact fake marker output result status
  fake="$TMPDIR/claude-valid-bounds"
  marker="$TMPDIR/before-bounds"
  write_valid_claude "$fake"
  touch "$marker"

  output="$((
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      ADVERSARY_REVIEW_TIMEOUT_SECONDS=30 \
      ADVERSARY_REVIEW_SNAPSHOT_MAX_BYTES=1200 \
      CLAUDE_ADVERSARY_EFFORT=max \
      "$RUNNER" "$SNAPSHOT_FEATURE" "$SNAPSHOT_TASK" review-narrow HEAD~1 gpt-5-test
  ) 2>&1)"
  status=$?

  artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)

  [ "$status" -eq 0 ] &&
    [ -f "$TMPDIR/claude-prompt" ] &&
    grep -q -- "===== $SNAPSHOT_OWNED_A " "$TMPDIR/claude-prompt" &&
    grep -q -- 'task-owned file snapshots truncated at 1200 bytes' "$TMPDIR/claude-prompt"
  result=$?

  if [ "$result" -ne 0 ]; then
    printf '%s\n' "$output" >&2
  fi

  if [ -n "$artifact" ]; then
    case "$artifact" in
      docs/features/*/adversary/*.md) rm -f "$ROOT/$artifact" "$ROOT/${artifact%.md}.attempt.json" "$ROOT/${artifact%/*}/._${artifact##*/}" ;;
    esac
  fi
  find "$SNAPSHOT_DIR/adversary" -type f -newer "$marker" -name "*${SNAPSHOT_TASK}*.md" ! -name '._*' -exec rm -f {} +
  find "$SNAPSHOT_DIR/adversary" -type f -newer "$marker" -name "*${SNAPSHOT_TASK}*.attempt.json" -exec rm -f {} +
  find "$SNAPSHOT_DIR/adversary" -type f -newer "$marker" -name "._*${SNAPSHOT_TASK}*" -exec rm -f {} + 2>/dev/null || true

  return "$result"
}

snapshot_sanitizer_tripwire_blocks_claude() {
  local fake feature_dir output owned_path result slug status
  slug="_test-fixture-adversary-review-sanitize-$$"
  feature_dir="$ROOT/docs/features/$slug"
  owned_path="$TMPDIR/owned-sensitive.txt"
  fake="$TMPDIR/claude-valid-sanitize"
  write_valid_claude "$fake"
  rm -f "$TMPDIR/claude-args" "$TMPDIR/claude-prompt"

  mkdir -p "$feature_dir"
  printf 'large\n' > "$feature_dir/.tier"
  cat > "$feature_dir/TASKS.md" <<EOF
### TASK-SAN: sanitizer fixture

- Status: Review
- AC IDs: AC-SAN
- NFR IDs:
- Type: infra
- Design anchor: DESIGN.md#sanitizer-fixture
- Owner/session: test
- Branch/worktree: test
- Claimed at: 2026-06-21 00:00 UTC
- Depends-on:
- Risk: low
- Intended file ownership:
  - $owned_path
- Acceptance criteria (task-local):
  - sanitizer fixture
- Verification:
  - scripts/test-adversary-review
  - mode: unit
- Tests added:
  - scripts/test-adversary-review
- Evidence:
  - pending
- Traceability:
  - TRACEABILITY.md row updated: no
EOF

  # Runtime concatenation keeps this test file itself free of a literal
  # secret-shaped token while still planting one in the owned-file snapshot.
  printf '%s\n' "api_key=ABCD""EFGHIJKLMNOPQRSTUVWXYZ" > "$owned_path"

  output="$((
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      ADVERSARY_REVIEW_TIMEOUT_SECONDS=30 \
      CLAUDE_ADVERSARY_EFFORT=max \
      "$RUNNER" "$slug" TASK-SAN review-narrow HEAD~1 gpt-5-test
  ) 2>&1)"
  status=$?

  [ "$status" -eq 4 ] &&
    printf '%s\n' "$output" | grep -q 'sanitize: blocked by secret-apikey pattern' &&
    [ ! -f "$TMPDIR/claude-args" ] &&
    [ ! -f "$TMPDIR/claude-prompt" ]
  result=$?

  if [ "$result" -ne 0 ]; then
    printf '%s\n' "$output" >&2
  fi

  rm -rf "$feature_dir"
  rm -f "$owned_path"
  return "$result"
}

invalid_timeout_rejected() {
  local fake
  fake="$TMPDIR/claude-sleep-invalid"
  write_sleeping_claude "$fake"
  (
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      ADVERSARY_REVIEW_TIMEOUT_SECONDS=abc \
      "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test
  ) >/dev/null 2>&1
}

revised_or_multiple_verdict_is_invalid() {
  local artifact status
  artifact="$TMPDIR/findings-first.md"
  cat > "$artifact" <<'EOF'
OUTPUT FORMAT:
- ADVERSARIAL CLEAR | ADVERSARIAL FINDINGS OPENED

### Verdict
- ADVERSARIAL CLEAR

### Revised verdict
- ADVERSARIAL FINDINGS OPENED
- Reason: later inspection found a defect
EOF
  status=$("$ROOT/scripts/review-attempt" status adversary "$artifact" 2>/dev/null || true)
  [ "$status" = "invalid-output" ]
}

echoed_enum_does_not_grade_clear() {
  local artifact status
  artifact="$TMPDIR/enum-only.md"
  printf '%s\n' '- ADVERSARIAL CLEAR | ADVERSARIAL FINDINGS OPENED' > "$artifact"
  status=$("$ROOT/scripts/review-attempt" status adversary "$artifact" 2>/dev/null || true)
  [ "$status" = "invalid-output" ]
}

