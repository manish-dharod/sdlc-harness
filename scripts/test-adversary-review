unrelated_dirty_path_is_allowed() {
  local artifact fake output receipt status unrelated
  fake="$TMPDIR/claude-unrelated-dirty"
  unrelated="$ROOT/unrelated-user-work-$$.txt"
  write_valid_claude "$fake"
  printf 'preserve unrelated user work\n' > "$unrelated"
  output="$((
    cd "$ROOT" &&
      CLAUDE_BIN="$fake" \
      "$RUNNER" "$FEATURE" "$TASK_ID" review HEAD~1 gpt-5-test
  ) 2>&1)"
  status=$?
  artifact=$(printf '%s\n' "$output" | sed -n 's/^Artifact:[[:space:]]*//p' | head -1)
  receipt=$(printf '%s\n' "$output" | sed -n 's/^Review receipt:[[:space:]]*//p' | head -1)
  rm -f "$unrelated"
  [ -n "$artifact" ] && rm -f "$ROOT/$artifact" "$ROOT/${artifact%.md}.attempt.json"
  [ -n "$receipt" ] && rm -f "$ROOT/$receipt"
  [ "$status" -eq 0 ] && [ -f "$TMPDIR/claude-args" ]
}

outside_committed_path_is_rejected() {
  local candidate output status
  git -C "$ROOT" checkout --quiet --detach "$PRIMARY_SHA"
  printf '\n- fixture owned change\n' >> "$ROOT/docs/features/$FEATURE/TASKS.md"
  printf 'outside fixture\n' > "$ROOT/task110b-outside.txt"
  git -C "$ROOT" add "docs/features/$FEATURE/TASKS.md" task110b-outside.txt
