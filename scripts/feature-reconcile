#!/usr/bin/env bash
# Validate that a feature's control plane is internally consistent.
#
# Checks that the YAML status block in STATE.md matches what TASKS.md /
# FINDINGS.md / TRACEABILITY.md actually say. If they disagree, prints the
# divergence and exits non-zero so the caller knows to invoke
# planner (Phase: plan) to reconcile (the plan phase owns STATE.md
# transitions).
#
# Also detects stale Claimed tasks (>24h) and dangling Depends-on references
# (a Depends-on pointing at a task ID that doesn't exist).
#
# As of ADVERSARIAL_CUTOFF_DATE (see constant below), every Done task in a
# large-tier feature must also have an adversarial-review trail (either an
# EVIDENCE.md "Adversarial review clear/skipped" entry for the task, or
# FINDINGS.md entries from the adversarial reviewer for the task where all P0/P1 are
# Fixed/False positive). To grandfather historical Done tasks that landed
# before the framework added this gate, list their task IDs (one per line,
# `#` comments allowed) in docs/features/<slug>/.adversarial-exempt.
#
# Large-tier code-bearing tasks in Review or Done must also have a task-scoped
# pre-review self-audit in EVIDENCE.md. This makes the sg-swe "but for real"
# check deterministic instead of prompt-only.
#
# Exits 0 if consistent; 1 if drift detected; 3 on usage error.

# As of this date, large-tier features must record an adversarial review
# trail for every Done task. Tasks transitioned to Done before this date
# can be grandfathered via the per-feature .adversarial-exempt file (see
# header above). This constant exists for documentation; the script does
# not compare timestamps because TASKS.md does not store a Done-at date.
ADVERSARIAL_CUTOFF_DATE="2026-05-24"
SELF_AUDIT_CUTOFF_DATE="2026-06-01"

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 3

# Load sdlc.config.yml (no-op if absent). Exposes
# SDLC_CROSS_MODEL_ADVERSARIAL_REQUIRED and friends.
if [ -f "$ROOT/scripts/load-config" ]; then
  # shellcheck source=load-config
  . "$ROOT/scripts/load-config"
fi

SLUG=""
INSIGHTS_ITEMS_DIR_ARG=""
INSIGHTS_APPLIED_LEDGER_ARG=""
INSIGHTS_APPROVALS_FILE_ARG=""
PRINT_INSIGHT_TRAIL_PATHS=0

usage() {
  cat <<'EOF'
Usage: scripts/feature-reconcile <feature-slug> [options]

Validates internal consistency of the feature control plane. Exits 0 if
consistent, 1 if drift detected, 3 on usage error.

Options:
  --insights-items-dir DIR       explicit test/review input for applied INS items
  --insights-applied-ledger FILE explicit test/review input for APPLIED.md
  --insights-approvals-file FILE explicit test/review input for APPROVALS.md
  --print-insight-trail-paths    print resolved insight-trail inputs and exit
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 3
      ;;
    --insights-items-dir)
      if [ -z "${2:-}" ]; then
        printf 'feature-reconcile: --insights-items-dir requires a value\n' >&2
        exit 3
      fi
      INSIGHTS_ITEMS_DIR_ARG="$2"
      shift 2
      ;;
    --insights-applied-ledger)
      if [ -z "${2:-}" ]; then
        printf 'feature-reconcile: --insights-applied-ledger requires a value\n' >&2
        exit 3
      fi
      INSIGHTS_APPLIED_LEDGER_ARG="$2"
      shift 2
      ;;
    --insights-approvals-file)
      if [ -z "${2:-}" ]; then
        printf 'feature-reconcile: --insights-approvals-file requires a value\n' >&2
        exit 3
      fi
      INSIGHTS_APPROVALS_FILE_ARG="$2"
      shift 2
      ;;
    --print-insight-trail-paths)
      PRINT_INSIGHT_TRAIL_PATHS=1
      shift
      ;;
    --*)
      printf 'feature-reconcile: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 3
      ;;
    *)
      if [ -z "$SLUG" ]; then
        SLUG="$1"
        shift
      else
        printf 'feature-reconcile: unexpected argument: %s\n' "$1" >&2
        usage >&2
        exit 3
      fi
      ;;
  esac
done

if [ -z "$SLUG" ]; then
  usage
  exit 3
fi

DIR="docs/features/$SLUG"
if [ ! -d "$DIR" ]; then
  printf 'Feature not found: %s\n' "$DIR" >&2
  exit 3
fi

if [ "$PRINT_INSIGHT_TRAIL_PATHS" -eq 1 ]; then
  printf 'items=%s\n' "${INSIGHTS_ITEMS_DIR_ARG:-$ROOT/docs/insights/items}"
  printf 'ledger=%s\n' "${INSIGHTS_APPLIED_LEDGER_ARG:-$ROOT/docs/insights/APPLIED.md}"
  printf 'approvals=%s\n' "${INSIGHTS_APPROVALS_FILE_ARG:-$DIR/APPROVALS.md}"
  exit 0
fi

DRIFT=0
section() { printf '\n== %s ==\n' "$1"; }
ok()      { printf '  OK: %s\n' "$1"; }
drift()   { printf '  DRIFT: %s\n' "$1"; DRIFT=$((DRIFT + 1)); }

TIER_FILE="$DIR/.tier"
FEATURE_TIER="large"  # default for back-compat with v1 features lacking .tier
if [ -f "$TIER_FILE" ]; then
  FEATURE_TIER=$(cat "$TIER_FILE" 2>/dev/null | tr -d '[:space:]')
  case "$FEATURE_TIER" in
    small|medium|large) ;;
    *) FEATURE_TIER="large" ;;
  esac
fi

# 1. Parse machine-readable block from STATE.md (the YAML inside ```yaml ... ```).
section "STATE.md machine-readable block"
if [ "$FEATURE_TIER" != "large" ]; then
  printf '  INFO: skipped — tier=%s; STATE.md machine-readable block is large-tier only.\n' "$FEATURE_TIER"
else
state_yaml=$(awk '/^```yaml$/{flag=1; next} /^```$/{flag=0} flag' "$DIR/STATE.md" 2>/dev/null)

if [ -z "$state_yaml" ]; then
  drift "STATE.md is missing the machine-readable yaml block"
else
  ok "yaml block found"
fi

state_field() {
  printf '%s\n' "$state_yaml" | awk -v k="$1" '
    $1 == k":" { sub(/^[^:]+:[[:space:]]*/, ""); sub(/[[:space:]]*#.*$/, ""); print; exit }
  '
}

claimed_state=$(state_field claimed_tasks)
open_state=$(state_field open_tasks)
blocked_state=$(state_field blocked_tasks)
p0_state=$(state_field open_p0)
p1_state=$(state_field open_p1)
ac_total_state=$(state_field ac_total)
ac_pass_state=$(state_field ac_passing)
nfr_total_state=$(state_field nfr_total)
nfr_pass_state=$(state_field nfr_passing)
fi

# 2. Real counts from TASKS.md.
# grep -c always prints a single integer (0 on no match); using `|| echo 0`
# would double-print and break comparison.
section "TASKS.md vs STATE.md task counts"
if [ "$FEATURE_TIER" != "large" ]; then
  printf '  INFO: skipped — tier=%s; STATE.md task-count reconciliation is large-tier only.\n' "$FEATURE_TIER"
else
# Use awk with code-fence awareness so the schema-documentation block in
# TASKS.md is not double-counted alongside real task entries. Also excludes
# tasks whose ID contains EXAMPLE (template placeholders).
count_status() {
  if [ ! -f "$DIR/TASKS.md" ]; then printf '0'; return; fi
  awk -v target="$1" '
    /^```/ { in_code = !in_code; next }
    in_code { next }
    /^### / {
      hdr=$0; sub(/^### /, "", hdr); n=split(hdr, a, ":"); id=a[1]
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", id)
      example = (id ~ /EXAMPLE/)
    }
    /^- Status: / {
      s=$0; sub(/^- Status: /, "", s); gsub(/`/, "", s); gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
      if (!example && s == target) c++
    }
    END { print c+0 }
  ' "$DIR/TASKS.md"
}
real_open="$(count_status Open)"
real_claimed="$(count_status Claimed)"
real_blocked="$(count_status Blocked)"

[ "${open_state:-?}" = "$real_open" ]       && ok "open_tasks: $real_open"    || drift "open_tasks: STATE=$open_state TASKS=$real_open"
[ "${claimed_state:-?}" = "$real_claimed" ] && ok "claimed_tasks: $real_claimed" || drift "claimed_tasks: STATE=$claimed_state TASKS=$real_claimed"
[ "${blocked_state:-?}" = "$real_blocked" ] && ok "blocked_tasks: $real_blocked" || drift "blocked_tasks: STATE=$blocked_state TASKS=$real_blocked"
fi

# 3. Real P0/P1 counts from FINDINGS.md.
section "FINDINGS.md vs STATE.md severity counts"
if [ "$FEATURE_TIER" != "large" ]; then
  printf '  INFO: skipped — tier=%s; FINDINGS.md severity reconciliation is large-tier only.\n' "$FEATURE_TIER"
else
count_unresolved_findings() {
  awk -v sev_pat="$1" '
    /^```/ { in_code = !in_code; next }
    in_code { next }
    /^### / { sev=""; status=""; example=($0 ~ /EXAMPLE/) }
    /^- Severity: / { sev=$0 }
    /^- Status: / {
      status=$0
      if (!example && sev ~ sev_pat && status !~ /Fixed|False positive/) print
    }
  ' "$DIR/FINDINGS.md" 2>/dev/null | wc -l | tr -d ' '
}
unresolved_p0="$(count_unresolved_findings P0)"
unresolved_p1="$(count_unresolved_findings P1)"

[ "${p0_state:-?}" = "$unresolved_p0" ] && ok "open_p0: $unresolved_p0" || drift "open_p0: STATE=$p0_state FINDINGS=$unresolved_p0"
[ "${p1_state:-?}" = "$unresolved_p1" ] && ok "open_p1: $unresolved_p1" || drift "open_p1: STATE=$p1_state FINDINGS=$unresolved_p1"
fi

# 4. Real AC/NFR coverage from TRACEABILITY.md.
section "TRACEABILITY.md vs STATE.md coverage"
if [ "$FEATURE_TIER" != "large" ]; then
  printf '  INFO: skipped — tier=%s; TRACEABILITY.md coverage reconciliation is large-tier only.\n' "$FEATURE_TIER"
else
trace_field() {
  grep -E "^$1: " "$DIR/TRACEABILITY.md" 2>/dev/null | head -1 | awk '{print $NF}'
}
real_ac_total=$(trace_field "AC total")
real_ac_pass=$(trace_field "AC with passing tests")
real_nfr_total=$(trace_field "NFR total")
real_nfr_pass=$(trace_field "NFR measured and passing")

[ "${ac_total_state:-?}" = "${real_ac_total:-?}" ] && ok "ac_total: $real_ac_total" || drift "ac_total: STATE=$ac_total_state TRACEABILITY=$real_ac_total"
[ "${ac_pass_state:-?}" = "${real_ac_pass:-?}" ]   && ok "ac_passing: $real_ac_pass" || drift "ac_passing: STATE=$ac_pass_state TRACEABILITY=$real_ac_pass"
[ "${nfr_total_state:-?}" = "${real_nfr_total:-?}" ] && ok "nfr_total: $real_nfr_total" || drift "nfr_total: STATE=$nfr_total_state TRACEABILITY=$real_nfr_total"
[ "${nfr_pass_state:-?}" = "${real_nfr_pass:-?}" ]   && ok "nfr_passing: $real_nfr_pass" || drift "nfr_passing: STATE=$nfr_pass_state TRACEABILITY=$real_nfr_pass"
fi

# 4b. TRACEABILITY rows newly marked Passing must be backed by a green,
# current-enough scripts/feature-verify status artifact. This catches the
# "markdown says Passing, gate was red/stale" false-confidence class.
section "TRACEABILITY Passing verification status"

mode_rank() {
  case "$1" in
    fast) printf '1' ;;
    unit) printf '2' ;;
    full) printf '3' ;;
    *) printf '0' ;;
  esac
}

json_string_field() {
  local file="$1"
  local key="$2"
  sed -nE 's/^[[:space:]]*"'"$key"'"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p' "$file" 2>/dev/null | head -1
}

json_number_field() {
  local file="$1"
  local key="$2"
  sed -nE 's/^[[:space:]]*"'"$key"'"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' "$file" 2>/dev/null | head -1
}

task_required_mode() {
  local tid="$1"
  awk -v tid="$tid" '
    /^```/ { in_code = !in_code; next }
    in_code { next }
    /^### / {
      hdr=$0; sub(/^### /, "", hdr); split(hdr, a, ":"); id=a[1]
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", id)
      in_target = (id == tid)
      next
    }
    in_target && /^[[:space:]]*-[[:space:]]*mode:[[:space:]]*/ {
      line=$0
      sub(/^[[:space:]]*-[[:space:]]*mode:[[:space:]]*/, "", line)
      sub(/[[:space:]]*#.*$/, "", line)
      gsub(/`/, "", line)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
      if (line ~ /^(fast|unit|full)$/) { print line; exit }
    }
  ' "$DIR/TASKS.md" 2>/dev/null | head -1
}

collect_changed_passing_rows() {
  local trace_file="$DIR/TRACEABILITY.md"
  [ -f "$trace_file" ] || return 0

  if git ls-files --error-unmatch "$trace_file" >/dev/null 2>&1; then
    base="${BASE_REF:-${SDLC_BASE_BRANCH:-staging}}"
    if git rev-parse --verify --quiet "$base" >/dev/null 2>&1; then
      git diff --unified=0 "$base"...HEAD -- "$trace_file" 2>/dev/null || true
    fi
    git diff --unified=0 -- "$trace_file" 2>/dev/null || true
    git diff --cached --unified=0 -- "$trace_file" 2>/dev/null || true
  else
    sed 's/^/+/' "$trace_file"
  fi | awk '/^\+[^+]/ && /\|/ && /\|[[:space:]]*Passing[[:space:]]*\|/ { sub(/^\+/, ""); print }'
}

changed_passing_rows=$(collect_changed_passing_rows)
changed_passing_tasks=$(printf '%s\n' "$changed_passing_rows" | grep -Eo 'TASK-[A-Za-z0-9_-]*[0-9][A-Za-z0-9_-]*' | sort -u || true)

if [ -z "$changed_passing_rows" ]; then
  ok "no changed TRACEABILITY rows marked Passing"
else
  status_file="$DIR/.last-verify.json"
  if [ ! -f "$status_file" ]; then
    drift "TRACEABILITY row changed to Passing but $status_file is missing; run scripts/feature-verify $SLUG <mode>"
  else
    verify_exit=$(json_number_field "$status_file" exit_code)
    verify_mode=$(json_string_field "$status_file" mode)
    verify_sha=$(json_string_field "$status_file" head_sha)

    if [ "$verify_exit" != "0" ]; then
      drift "TRACEABILITY row changed to Passing but .last-verify.json is red (exit_code=${verify_exit:-missing})"
    fi

    if [ -z "$verify_sha" ] || ! git cat-file -e "$verify_sha^{commit}" 2>/dev/null; then
      drift "TRACEABILITY row changed to Passing but .last-verify.json head_sha is missing or not a commit (${verify_sha:-missing})"
    elif ! git merge-base --is-ancestor "$verify_sha" HEAD 2>/dev/null; then
      drift "TRACEABILITY row changed to Passing but .last-verify.json head_sha $verify_sha is not an ancestor of HEAD"
    fi

    required_mode="fast"
    required_rank=1
    if [ -n "$changed_passing_tasks" ]; then
      while IFS= read -r tid; do
        [ -z "$tid" ] && continue
        task_mode=$(task_required_mode "$tid")
        [ -z "$task_mode" ] && task_mode="fast"
        task_rank=$(mode_rank "$task_mode")
        if [ "$task_rank" -gt "$required_rank" ] 2>/dev/null; then
          required_mode="$task_mode"
          required_rank="$task_rank"
        fi
      done <<< "$changed_passing_tasks"
    fi

    verify_rank=$(mode_rank "$verify_mode")
    if [ "$verify_rank" -lt "$required_rank" ] 2>/dev/null; then
      drift "TRACEABILITY row changed to Passing but .last-verify.json mode=${verify_mode:-missing} is below required mode=$required_mode for changed task row(s)"
    fi

    if [ "$verify_exit" = "0" ] && [ "$verify_rank" -ge "$required_rank" ] 2>/dev/null && \
       [ -n "$verify_sha" ] && git cat-file -e "$verify_sha^{commit}" 2>/dev/null && \
       git merge-base --is-ancestor "$verify_sha" HEAD 2>/dev/null; then
      ok "changed Passing row(s) backed by green .last-verify.json (mode=$verify_mode, required=$required_mode)"
    fi
  fi
fi

# 5. Dangling Depends-on references. Skip code-fenced schema blocks and
# example tasks (any task ID containing EXAMPLE).
section "Depends-on integrity"
ids_present=$(awk '
  /^```/ { in_code = !in_code; next }
  in_code { next }
  /^### / {
    hdr=$0; sub(/^### /, "", hdr); n=split(hdr, a, ":"); id=a[1]
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", id)
    if (id !~ /EXAMPLE/) print id
  }
' "$DIR/TASKS.md" 2>/dev/null)

ids_in_deps=$(awk '
  /^```/ { in_code = !in_code; next }
  in_code { next }
  /^### / { example = ($0 ~ /EXAMPLE/) }
  /^- Depends-on:/ {
    if (example) next
    sub(/^- Depends-on:[[:space:]]*/, "")
    line = $0
    # Tolerate prose in Depends-on: extract machine IDs only (e.g. ICLR-020,
    # APR-001, CKO-051). Prose like "(none — root task)" yields zero IDs.
    while (match(line, /[A-Z][A-Z0-9]*-[0-9]+/)) {
      print substr(line, RSTART, RLENGTH)
      line = substr(line, RSTART + RLENGTH)
    }
  }
' "$DIR/TASKS.md" 2>/dev/null)

if [ -n "$ids_in_deps" ]; then
  missing=$(comm -23 <(printf '%s\n' "$ids_in_deps" | sort -u) <(printf '%s\n' "$ids_present" | sort -u))
  if [ -n "$missing" ]; then
    while IFS= read -r m; do
      [ -z "$m" ] && continue
      drift "Depends-on references nonexistent task: $m"
    done <<< "$missing"
  else
    ok "all Depends-on references resolve"
  fi
else
  ok "no Depends-on references to check"
fi

# 6. Stale Claimed tasks (> 24h since Claimed at). Code-fence-aware.
section "Stale Claimed tasks"
now=$(date +%s)
awk '
  /^```/ { in_code = !in_code; next }
  in_code { next }
  /^### / {
    hdr=$0; sub(/^### /, "", hdr); n=split(hdr, a, ":"); id=a[1]
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", id); status=""; claimed_at=""
    example = (id ~ /EXAMPLE/)
  }
  /^- Status: / { status=$0; sub(/^- Status: /, "", status); gsub(/`/, "", status); gsub(/^[[:space:]]+|[[:space:]]+$/, "", status) }
  /^- Claimed at: / {
    claimed_at=$0
    sub(/^- Claimed at: /, "", claimed_at)
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", claimed_at)
    if (!example && status == "Claimed" && claimed_at != "") print id "|" claimed_at
  }
' "$DIR/TASKS.md" 2>/dev/null | while IFS='|' read -r id claimed_at; do
  [ -z "$id" ] && continue
  ts=$(date -d "$claimed_at" +%s 2>/dev/null || date -j -f "%Y-%m-%d %H:%M %Z" "$claimed_at" +%s 2>/dev/null || echo "")
  if [ -z "$ts" ]; then
    printf '  WARN: cannot parse Claimed at for %s: %s\n' "$id" "$claimed_at"
    continue
  fi
  age=$(( now - ts ))
  if [ "$age" -gt 86400 ]; then
    drift "$id has been Claimed for $(( age / 3600 ))h (>24h) — reconcile or release"
  else
    ok "$id Claimed for $(( age / 3600 ))h (within 24h)"
  fi
done

# 7. Adversarial review trail for Done tasks.
#
# A Done task is only valid if it has one of:
#   (a) EVIDENCE.md entry whose section heading mentions both
#       "Adversarial review" and the task ID, AND whose body has
#       "Source: reviewer (Mode: adversarial)" (the "clear" or "skipped by
#       routing rule" shapes from .claude/agents/reviewer.md), or
#   (b) FINDINGS.md entries from the adversarial reviewer citing this task ID where
#       every P0/P1 entry has Status: Fixed or False positive, or
#   (c) the task ID is listed in docs/features/<slug>/.adversarial-exempt
#       (grandfathered pre-cutoff Done transitions).
#
# Tier gating: this check is enforced for LARGE-tier features only. Small
# and medium tiers do not have the canonical separate EVIDENCE / FINDINGS
# files that this check parses; templates document the adversarial gate
# as advisory for those tiers. We emit an INFO message instead of DRIFT
# so users see that the section ran and chose to no-op.
section "Adversarial review trail for Done tasks"

EXEMPT_FILE="$DIR/.adversarial-exempt"

if [ "$FEATURE_TIER" != "large" ]; then
  printf '  INFO: skipped — tier=%s; adversarial-trail gate is enforced for large tier only (advisory for %s; see _template-%s).\n' \
    "$FEATURE_TIER" "$FEATURE_TIER" "$FEATURE_TIER"
else

# Build exemption set from .adversarial-exempt (one task ID per line; `#` comments allowed).
exempt_ids=""
if [ -f "$EXEMPT_FILE" ]; then
  exempt_ids=$(awk '
    { sub(/#.*/, ""); gsub(/^[[:space:]]+|[[:space:]]+$/, "") }
    NF { print }
  ' "$EXEMPT_FILE")
fi

# Collect Done task IDs from TASKS.md (code-fence-aware, skips EXAMPLE).
done_task_ids=$(awk '
  /^```/ { in_code = !in_code; next }
  in_code { next }
  /^### / {
    hdr=$0; sub(/^### /, "", hdr); n=split(hdr, a, ":"); id=a[1]
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", id); status=""
    example = (id ~ /EXAMPLE/)
  }
  /^- Status: / {
    s=$0; sub(/^- Status: /, "", s); gsub(/`/, "", s); gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
    # FND-007 fix: match `Done` AND `Done (YYYY-MM-DD)`. The bare-string
    # equality was silently bypassing the adversarial-trail gate for every
    # task that recorded a Done date in parens (which is the documented
    # convention in CLAUDE.md and the template TASKS.md). Cross-cutting
    # fix — affects every feature in this repo. Bug was present since
    # the adversarial-trail gate was introduced.
    if (!example && s ~ /^Done([[:space:]]|$)/) print id
  }
' "$DIR/TASKS.md" 2>/dev/null)

if [ -z "$done_task_ids" ]; then
  ok "no Done tasks to check"
else
  # Pre-load EVIDENCE.md and FINDINGS.md once.
  EVIDENCE_CONTENT=""
  if [ -f "$DIR/EVIDENCE.md" ]; then
    EVIDENCE_CONTENT=$(cat "$DIR/EVIDENCE.md")
  fi
  FINDINGS_CONTENT=""
  if [ -f "$DIR/FINDINGS.md" ]; then
    FINDINGS_CONTENT=$(cat "$DIR/FINDINGS.md")
  fi

  while IFS= read -r tid; do
    [ -z "$tid" ] && continue

    # (c) Exemption?
    if [ -n "$exempt_ids" ] && printf '%s\n' "$exempt_ids" | grep -Fxq "$tid"; then
      ok "$tid Done — adversarial trail exempted via .adversarial-exempt"
      continue
    fi

    # (a) EVIDENCE clear/skip entry? Look for a `## ... Adversarial review ... <tid>`
    # heading whose body block (until next `## ` or EOF) contains either
    # `- Source: reviewer (Mode: adversarial)` (v1.1 shape) or
    # `- Source: sdlc-adversary` (v1.0 backward-compat shape).
    ev_trail=$(printf '%s\n' "$EVIDENCE_CONTENT" | awk -v tid="$tid" '
      BEGIN { found = 0; in_block = 0 }
      /^## / {
        if (in_block) { in_block = 0 }
        if ($0 ~ /[Aa]dversarial review/ && index($0, tid) > 0) { in_block = 1; next }
      }
      in_block && (index($0, "- Source: reviewer (Mode: adversarial") == 1 || index($0, "- Source: sdlc-adversary") == 1) { found = 1; exit }
      END { print (found ? "yes" : "") }
    ')
    if [ -n "$ev_trail" ]; then
      ok "$tid Done — adversarial trail in EVIDENCE.md"
      continue
    fi

    # (b) FINDINGS from the adversarial reviewer citing this task where P0/P1
    # all resolved? Walk finding blocks. A block is from the adversarial
    # reviewer for our task if Source matches either
    # "reviewer (Mode: adversarial)" (v1.1) or "sdlc-adversary" (v1.0
    # backward-compat) AND Task: <tid>. Track whether any block exists; if
    # any unresolved P0/P1 exists, that's a different drift signal (P0/P1
    # should already be caught by section 3 — but we still want to know
    # that "the adversary opened findings and they're not all closed").
    awk_result=$(printf '%s\n' "$FINDINGS_CONTENT" | awk -v tid="$tid" '
      function is_adv(s) {
        # Accept both v1.1 "reviewer (Mode: adversarial)" and v1.0 "sdlc-adversary".
        # Use substring match on the canonical form so trailing "(skipped)"
        # and similar suffixes still match.
        return (index(s, "reviewer (Mode: adversarial") > 0 || s == "sdlc-adversary")
      }
      function reset() {
        src=""; sev=""; status=""; task=""; in_block=0; example=0
      }
      /^### / {
        # End of previous block — score it.
        if (in_block && is_adv(src) && task == tid) {
          relevant_count++
          if (sev ~ /P0|P1/ && status !~ /Fixed|False positive/) unresolved_p01++
        }
        reset()
        in_block = 1
        example = ($0 ~ /EXAMPLE/)
        next
      }
      /^- Source: / { src=$0; sub(/^- Source: /, "", src); gsub(/[[:space:]]+$/, "", src) }
      /^- Severity: / { sev=$0; sub(/^- Severity: /, "", sev) }
      /^- Status: / { status=$0; sub(/^- Status: /, "", status) }
      /^- Task: / { task=$0; sub(/^- Task: /, "", task); gsub(/[[:space:]]+$/, "", task) }
      END {
        # Score the trailing block.
        if (in_block && !example && is_adv(src) && task == tid) {
          relevant_count++
          if (sev ~ /P0|P1/ && status !~ /Fixed|False positive/) unresolved_p01++
        }
        if (relevant_count > 0 && unresolved_p01 == 0) print "resolved"
        else if (unresolved_p01 > 0) print "unresolved"
      }
    ')
    if [ "$awk_result" = "resolved" ]; then
      ok "$tid Done — adversarial FINDINGS resolved"
      continue
    elif [ "$awk_result" = "unresolved" ]; then
      drift "$tid Done with unresolved P0/P1 adversarial findings — block the Done transition"
      continue
    fi

    # No (a), no (b), not (c).
    drift "$tid Done — no adversarial trail (need EVIDENCE clear/skip with 'Source: reviewer (Mode: adversarial)' citing $tid, OR adversarial-mode FINDINGS resolved, OR $tid in $EXEMPT_FILE)"
  done <<< "$done_task_ids"
fi

fi  # end large-tier-only adversarial-trail block

# 7b. Amendment adversarial review (added 2026-06-03).
#
# A spec amendment (AMENDMENTS.md AMD-###) changes a contract-level
# requirement — an AC/NFR equality sense, a threshold, a design contract.
# Per the "never skip adversarial review on consequential changes" rule, a
# spec amendment is exactly the spec-loophole case the adversary exists to
# catch ("did we move the goalposts instead of meeting them?"). So every
# amendment MUST carry a REAL adversarial-review trail — the docs-only
# "Adversarial review skipped by routing rule" path is NOT sufficient here:
#   (a) an EVIDENCE.md "Adversarial review" entry citing the AMD id whose
#       heading does NOT say "skip", with `- Source: reviewer (Mode: adversarial)`, OR
#   (b) FINDINGS.md entries from the adversarial reviewer citing the AMD id
#       where all P0/P1 are Fixed/False positive, OR
#   (c) the AMD id is listed in docs/features/<slug>/.adversarial-exempt
#       (grandfathering for amendments that predate this gate).
# Large-tier only (advisory for small/medium), matching the Done-task gate.
section "Amendment adversarial review"

if [ "$FEATURE_TIER" != "large" ]; then
  printf '  INFO: skipped — tier=%s; amendment adversarial gate is large-tier only.\n' "$FEATURE_TIER"
elif [ ! -f "$DIR/AMENDMENTS.md" ]; then
  ok "no AMENDMENTS.md"
else
  amd_exempt_ids=""
  if [ -f "$EXEMPT_FILE" ]; then
    amd_exempt_ids=$(awk '
      { sub(/#.*/, ""); gsub(/^[[:space:]]+|[[:space:]]+$/, "") }
      NF { print }
    ' "$EXEMPT_FILE")
  fi

  # Collect AMD ids from AMENDMENTS.md (code-fence-aware so the schema
  # `### AMD-### —` template inside the fenced block is skipped).
  amd_ids=$(awk '
    /^```/ { in_code = !in_code; next }
    in_code { next }
    /^### AMD-/ {
      hdr=$0; sub(/^### /, "", hdr); split(hdr, a, " "); id=a[1]
      gsub(/[^A-Za-z0-9-]/, "", id)
      if (id ~ /^AMD-[0-9]+$/) print id
    }
  ' "$DIR/AMENDMENTS.md" 2>/dev/null)

  if [ -z "$amd_ids" ]; then
    ok "no amendments to check"
  else
    AMD_EVIDENCE_CONTENT=""
    [ -f "$DIR/EVIDENCE.md" ] && AMD_EVIDENCE_CONTENT=$(cat "$DIR/EVIDENCE.md")
    AMD_FINDINGS_CONTENT=""
    [ -f "$DIR/FINDINGS.md" ] && AMD_FINDINGS_CONTENT=$(cat "$DIR/FINDINGS.md")

    while IFS= read -r aid; do
      [ -z "$aid" ] && continue

      # (c) Exemption (grandfathering)?
      if [ -n "$amd_exempt_ids" ] && printf '%s\n' "$amd_exempt_ids" | grep -Fxq "$aid"; then
        ok "$aid — adversarial review exempted via .adversarial-exempt"
        continue
      fi

      # (a) EVIDENCE adversarial review (NOT a "skip" entry) citing the AMD id.
      amd_ev=$(printf '%s\n' "$AMD_EVIDENCE_CONTENT" | awk -v aid="$aid" '
        BEGIN { found=0; in_block=0 }
        /^## / {
          in_block=0
          if (tolower($0) ~ /adversarial review/ && index($0, aid) > 0 && tolower($0) !~ /skip/) { in_block=1 }
          next
        }
        in_block && index($0, "- Source: reviewer (Mode: adversarial") == 1 { found=1; exit }
        END { print (found ? "yes" : "") }
      ')
      if [ -n "$amd_ev" ]; then
        ok "$aid — adversarial review recorded in EVIDENCE.md"
        continue
      fi

      # (b) FINDINGS from the adversarial reviewer citing the AMD id, P0/P1 resolved.
      amd_find=$(printf '%s\n' "$AMD_FINDINGS_CONTENT" | awk -v aid="$aid" '
        function is_adv(s) { return (index(s, "reviewer (Mode: adversarial") > 0 || s == "sdlc-adversary") }
        function reset() { src=""; sev=""; status=""; ref=""; in_block=0 }
        /^### / {
          if (in_block && is_adv(src) && index(ref, aid) > 0) {
            relevant++
            if (sev ~ /P0|P1/ && status !~ /Fixed|False positive/) unresolved++
          }
          reset(); in_block=1; next
        }
        /^- Source: / { src=$0; sub(/^- Source: /, "", src); gsub(/[[:space:]]+$/, "", src) }
        /^- Severity: / { sev=$0; sub(/^- Severity: /, "", sev) }
        /^- Status: / { status=$0; sub(/^- Status: /, "", status) }
        /^- (Task|Amendment|Cites): / { ref=$0; sub(/^- (Task|Amendment|Cites): /, "", ref); gsub(/[[:space:]]+$/, "", ref) }
        END {
          if (in_block && is_adv(src) && index(ref, aid) > 0) {
            relevant++
            if (sev ~ /P0|P1/ && status !~ /Fixed|False positive/) unresolved++
          }
          if (relevant > 0 && unresolved == 0) print "resolved"
          else if (unresolved > 0) print "unresolved"
        }
      ')
      if [ "$amd_find" = "resolved" ]; then
        ok "$aid — adversarial FINDINGS resolved"
        continue
      elif [ "$amd_find" = "unresolved" ]; then
        drift "$aid — unresolved P0/P1 adversarial findings on this amendment"
        continue
      fi

      drift "$aid — no adversarial-review trail. A spec amendment must be adversarially reviewed (spec-loophole check): add an EVIDENCE 'Adversarial review' entry (Source: reviewer (Mode: adversarial), NOT 'skipped') citing $aid, OR resolved adversarial FINDINGS, OR list $aid in $EXEMPT_FILE."
    done <<< "$amd_ids"
  fi
fi

# 7a. Cross-model adversarial review (added 2026-05-27).
#
# When SDLC_CROSS_MODEL_ADVERSARIAL_REQUIRED is true (default), every Done
# task's adversarial-trail entry MUST declare Implementer tool/model +
# Reviewer tool/model. Tool values MUST differ. If Reviewer tool is codex-cli
# or claude-code, the named artifact path must exist as a real file and its
# model header must match the pinned reviewer model (proves the wrapper
# actually ran with the intended reviewer, rather than the agent claiming
# success without invocation). Codex App-authored work is treated as Codex-family
# work and requires Claude Code CLI review.
#
# Pre-gate tasks may be grandfathered via .cross-model-exempt (separate
# from .adversarial-exempt; that one waives the entire adversarial trail,
# this one waives only the cross-model field requirement).
#
# This section runs ONLY when the previous adversarial-trail section
# already accepted the task — we layer the cross-model check on top of
# the basic trail requirement, never as a substitute.
section "Cross-model adversarial review (Implementer tool != Reviewer tool)"

CROSS_MODEL_ENABLED="${SDLC_CROSS_MODEL_ADVERSARIAL_REQUIRED:-true}"
CROSS_MODEL_EXEMPT_FILE="$DIR/.cross-model-exempt"
REQUIRED_CODEX_ADVERSARY_MODEL="${SDLC_CODEX_ADVERSARY_REQUIRED_MODEL:-gpt-5.5}"
REQUIRED_CLAUDE_ADVERSARY_MODEL="${SDLC_CLAUDE_ADVERSARY_REQUIRED_MODEL:-claude-opus-4-8}"

if [ "$CROSS_MODEL_ENABLED" != "true" ]; then
  printf '  INFO: SDLC_CROSS_MODEL_ADVERSARIAL_REQUIRED=%s; cross-model gate disabled.\n' "$CROSS_MODEL_ENABLED"
elif [ "$FEATURE_TIER" != "large" ]; then
  printf '  INFO: skipped — tier=%s; cross-model gate enforced for large tier only.\n' "$FEATURE_TIER"
elif [ -z "$done_task_ids" ]; then
  ok "no Done tasks to check"
else
  # Build cross-model exemption set.
  cross_exempt_ids=""
  if [ -f "$CROSS_MODEL_EXEMPT_FILE" ]; then
    cross_exempt_ids=$(awk '
      { sub(/#.*/, ""); gsub(/^[[:space:]]+|[[:space:]]+$/, "") }
      NF { print }
    ' "$CROSS_MODEL_EXEMPT_FILE")
  fi

  while IFS= read -r tid; do
    [ -z "$tid" ] && continue

    # Skip if already exempt under .adversarial-exempt (no trail to inspect).
    if [ -n "$exempt_ids" ] && printf '%s\n' "$exempt_ids" | grep -Fxq "$tid"; then
      continue
    fi

    # Skip if explicitly exempt under .cross-model-exempt.
    if [ -n "$cross_exempt_ids" ] && printf '%s\n' "$cross_exempt_ids" | grep -Fxq "$tid"; then
      ok "$tid Done — cross-model gate waived via .cross-model-exempt"
      continue
    fi

    # Pull the trail entry (EVIDENCE clear/skip OR FINDINGS) and parse the
    # cross-model fields. The EVIDENCE path is the common case; the FINDINGS
    # path also supports the same fields per the docs.
    block=$(printf '%s\n' "$EVIDENCE_CONTENT" | awk -v tid="$tid" '
      BEGIN { in_block = 0 }
      /^## / {
        if (in_block) exit
        if ($0 ~ /[Aa]dversarial review/ && index($0, tid) > 0) { in_block = 1; print; next }
      }
      in_block { print }
    ')

    if [ -z "$block" ]; then
      # No EVIDENCE block — fall back to FINDINGS lookup for the same fields.
      block=$(printf '%s\n' "$FINDINGS_CONTENT" | awk -v tid="$tid" '
        function reset() { task=""; buf=""; in_block=0 }
        /^### / {
          if (in_block && task == tid) { print buf; exit }
          reset()
          in_block = 1
          buf = $0 "\n"
          next
        }
        in_block {
          buf = buf $0 "\n"
          if ($0 ~ /^- Task: /) { task=$0; sub(/^- Task: /, "", task); gsub(/[[:space:]]+$/, "", task) }
        }
        END {
          if (in_block && task == tid) print buf
        }
      ')
    fi

    if [ -z "$block" ]; then
      drift "$tid Done — cross-model check could not locate the adversarial trail (this should have failed the trail check above; investigate)"
      continue
    fi

    impl_tool=$(printf '%s\n' "$block" | awk '/^- Implementer tool: / { sub(/^- Implementer tool: /, ""); gsub(/[[:space:]]+$/, ""); print; exit }' | sed 's/[.]$//')
    impl_model=$(printf '%s\n' "$block" | awk '/^- Implementer model: / { sub(/^- Implementer model: /, ""); gsub(/[[:space:]]+$/, ""); print; exit }' | sed 's/[.]$//')
    rev_tool=$(printf '%s\n' "$block" | awk '/^- Reviewer tool: / { sub(/^- Reviewer tool: /, ""); gsub(/[[:space:]]+$/, ""); print; exit }' | sed 's/[.]$//')
    rev_model=$(printf '%s\n' "$block" | awk '/^- Reviewer model: / { sub(/^- Reviewer model: /, ""); gsub(/[[:space:]]+$/, ""); print; exit }' | sed 's/[.]$//')
    codex_artifact=$(printf '%s\n' "$block" | awk '/^- Codex artifact: / { sub(/^- Codex artifact: /, ""); gsub(/[[:space:]]+$/, ""); print; exit }')
    claude_artifact=$(printf '%s\n' "$block" | awk '/^- Claude artifact: / { sub(/^- Claude artifact: /, ""); gsub(/[[:space:]]+$/, ""); print; exit }')
    is_routing_skip=$(printf '%s\n' "$block" | grep -q 'Mode: adversarial, skipped' && printf '1' || printf '0')

    if [ -z "$impl_tool" ]; then
      drift "$tid Done — adversarial trail missing '- Implementer tool: <claude-code|codex-cli|codex-app|other>' line (cross-model gate)"
      continue
    fi
    if [ -z "$impl_model" ]; then
      drift "$tid Done — adversarial trail missing '- Implementer model: <model-name>' line (cross-model gate)"
      continue
    fi
    if [ -z "$rev_tool" ]; then
      drift "$tid Done — adversarial trail missing '- Reviewer tool: <claude-code|codex-cli|routing-skip|other>' line (cross-model gate)"
      continue
    fi
    if [ -z "$rev_model" ]; then
      drift "$tid Done — adversarial trail missing '- Reviewer model: <model-name|n/a — routing-skip>' line (cross-model gate)"
      continue
    fi
    if [ "$rev_tool" = "routing-skip" ]; then
      if [ "$is_routing_skip" != "1" ]; then
        drift "$tid Done — Reviewer tool: routing-skip is only valid on an 'adversarial, skipped' trail entry"
        continue
      fi
      if ! printf '%s\n' "$block" | grep -q '^- Routing rule: '; then
        drift "$tid Done — routing-skip trail missing '- Routing rule:' line"
        continue
      fi
      ok "$tid Done — cross-model skipped by routing rule (Implementer: $impl_tool $impl_model)"
      continue
    fi
    if [ "$impl_tool" = "$rev_tool" ]; then
      drift "$tid Done — Implementer tool ($impl_tool) equals Reviewer tool ($rev_tool); same-tool review does not satisfy cross-model gate. Either run scripts/adversary-review and update the trail, or list $tid in $CROSS_MODEL_EXEMPT_FILE."
      continue
    fi
    if [ "$impl_tool" = "claude-code" ]; then
      if [ "$rev_tool" != "codex-cli" ]; then
        drift "$tid Done — Claude-authored task must be reviewed by Reviewer tool: codex-cli; got '$rev_tool'"
        continue
      fi
      if [ "$rev_model" != "$REQUIRED_CODEX_ADVERSARY_MODEL" ]; then
        drift "$tid Done — Claude-authored task reviewed by Codex with Reviewer model '$rev_model'; expected '$REQUIRED_CODEX_ADVERSARY_MODEL'"
        continue
      fi
    fi
    if [ "$impl_tool" = "codex-cli" ] || [ "$impl_tool" = "codex-app" ]; then
      if [ "$rev_tool" != "claude-code" ]; then
        drift "$tid Done — Codex-authored task must be reviewed by Reviewer tool: claude-code; got '$rev_tool'"
        continue
      fi
      if [ "$rev_model" != "$REQUIRED_CLAUDE_ADVERSARY_MODEL" ]; then
        drift "$tid Done — Codex-authored task reviewed by Claude with Reviewer model '$rev_model'; expected '$REQUIRED_CLAUDE_ADVERSARY_MODEL'"
        continue
      fi
    fi

    # If Reviewer tool is codex-cli or claude-code, the wrapper artifact path
    # must exist and its model header must match the claimed reviewer model.
    if [ "$rev_tool" = "codex-cli" ] || [ "$rev_tool" = "claude-code" ]; then
      artifact_label="Codex"
      reviewer_artifact="$codex_artifact"
      if [ "$rev_tool" = "claude-code" ]; then
        artifact_label="Claude"
        reviewer_artifact="$claude_artifact"
      fi
      if [ -z "$reviewer_artifact" ] || [ "$reviewer_artifact" = "n/a — direct" ] || [ "$reviewer_artifact" = "n/a" ]; then
        drift "$tid Done — Reviewer tool: $rev_tool but no '- $artifact_label artifact: <path>' line (cross-model gate; the wrapper writes a real artifact)"
        continue
      fi
      # Resolve relative to ROOT.
      artifact_path="$reviewer_artifact"
      case "$artifact_path" in
        /*) ;;  # absolute already
        *)  artifact_path="$ROOT/$artifact_path" ;;
      esac
      if [ ! -f "$artifact_path" ]; then
        drift "$tid Done — '- $artifact_label artifact: $reviewer_artifact' does not exist as a file (cross-model gate; the wrapper must have actually run)"
        continue
      fi
      artifact_model=$(awk -F'<!-- Model: | -->' '/<!-- Model:/ { print $2; exit }' "$artifact_path" 2>/dev/null)
      if [ -z "$artifact_model" ]; then
        drift "$tid Done — $artifact_label artifact '$reviewer_artifact' is missing '<!-- Model: ... -->' header"
        continue
      fi
      if [ "$artifact_model" != "$rev_model" ]; then
        drift "$tid Done — $artifact_label artifact model '$artifact_model' does not match Reviewer model '$rev_model'"
        continue
      fi
      if [ -x "$ROOT/scripts/review-attempt" ] && ! "$ROOT/scripts/review-attempt" validate adversary "$artifact_path" >/dev/null 2>&1; then
        artifact_status=$("$ROOT/scripts/review-attempt" status adversary "$artifact_path" 2>/dev/null || printf 'invalid-output')
        drift "$tid Done — $artifact_label artifact '$reviewer_artifact' does not contain a valid machine-readable adversarial verdict (status=$artifact_status). Artifact existence alone does not satisfy the Done gate; rerun the cross-model reviewer with review-resume/review-narrow."
        continue
      fi
    fi

    ok "$tid Done — cross-model OK (Implementer: $impl_tool $impl_model; Reviewer: $rev_tool $rev_model)"
  done <<< "$done_task_ids"
fi

# 7b. Per-task-type artifact requirements (added in framework-v3 Phase 4).
#
# When a Done task declares `Type: <type>` and that type has a documented
# artifact requirement, EVIDENCE.md must include the type-specific
# artifact rows tied to the task ID. Tasks without `Type:` (or with a
# type that has no artifact requirement, e.g. feature/refactor/docs/infra)
# are not affected. This is opt-in for new tasks; pre-existing tasks
# remain valid.
#
# This section is gated to large tier (consistent with the adversarial-trail
# check above). Medium and small tiers get an advisory INFO line.
section "Per-task-type artifact requirements"

if [ "$FEATURE_TIER" != "large" ]; then
  printf '  INFO: skipped — tier=%s; per-task-type artifact gate is enforced for large tier only (advisory for medium/small).\n' "$FEATURE_TIER"
else
  EVIDENCE_FILE="$DIR/EVIDENCE.md"
  if [ ! -f "$EVIDENCE_FILE" ]; then
    drift "Per-task-type artifact check: EVIDENCE.md missing"
  else
    # Walk Done tasks; extract task ID and Type. Same code-fence-aware
    # parser pattern as the rest of this script.
    #
    # Done status detection: match `Done`, `Done (YYYY-MM-DD)`, `Done`-with-
    # trailing-whitespace, etc. — same regex shape the adjacent
    # adversarial-trail parser uses (^Done([[:space:]]|$)). Per ADV-FND-001
    # from the 2026-05-26 Phase-4 Codex adversary review: the strict
    # `status == "Done"` check let dated Done statuses bypass the gate.
    type_pairs=$(awk '
      /^```/ { in_code = !in_code; next }
      in_code { next }
      /^### / {
        if (id != "" && status ~ /^Done([[:space:]]|$)/ && type_field != "" && !example) {
          print id "|" type_field
        }
        hdr=$0; sub(/^### /, "", hdr); n=split(hdr, a, ":"); id=a[1]
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", id)
        example = (id ~ /EXAMPLE/)
        status=""; type_field=""
      }
      /^- Status: / {
        status=$0; sub(/^- Status: /, "", status)
        gsub(/`/, "", status); gsub(/^[[:space:]]+|[[:space:]]+$/, "", status)
      }
      /^- Type: / {
        type_field=$0; sub(/^- Type: /, "", type_field)
        sub(/[[:space:]]*#.*$/, "", type_field)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", type_field)
      }
      END {
        if (id != "" && status ~ /^Done([[:space:]]|$)/ && type_field != "" && !example) {
          print id "|" type_field
        }
      }
    ' "$DIR/TASKS.md" 2>/dev/null)

    # Helper: extract EVIDENCE.md block for a specific task ID. A "block"
    # is the lines from the `## ... <Task ID>` heading (or any `##` whose
    # following lines include `- Task: <id>`) up to the next `## ` heading.
    # Per ADV-FND-002 from the Phase-4 Codex adversary review: artifact
    # markers must be scoped to the task's evidence block, not grepped
    # globally across the file (otherwise one task's markers can satisfy
    # another task's gate).
    extract_task_block() {
      local tid="$1"
      local file="$2"
      awk -v tid="$tid" '
        /^## / {
          # Hitting a new section heading. Close previous block.
          if (in_target) { exit }
          in_section = 1
          section_matched_by_heading = ($0 ~ "[[:space:]]" tid "([^A-Za-z0-9_-]|$)") || ($0 ~ "[[:space:]]" tid "[[:space:]]") || ($0 ~ tid "$")
          in_target = section_matched_by_heading
          next
        }
        in_section && /^- Task:[[:space:]]+/ {
          if ($0 ~ "Task:[[:space:]]+" tid "([^A-Za-z0-9_-]|$)") {
            in_target = 1
          }
        }
        in_target { print }
      ' "$file"
    }

    if [ -z "$type_pairs" ]; then
      ok "no Done tasks with declared Type — nothing to check (Type field is opt-in)"
    else
      while IFS='|' read -r tid ttype; do
        [ -z "$tid" ] && continue
        block=$(extract_task_block "$tid" "$EVIDENCE_FILE")
        case "$ttype" in
          bug)
            # Markers must appear INSIDE this task's evidence block.
            if [ -n "$block" ] && \
               printf '%s' "$block" | grep -qE 'Repro pre-fix:' && \
               printf '%s' "$block" | grep -qE 'Repro post-fix:'; then
              ok "$tid (Type: bug) — failing-then-passing repro recorded in task block"
            else
              drift "$tid (Type: bug) Done — EVIDENCE.md task block missing failing-then-passing repro (need 'Repro pre-fix:' + 'Repro post-fix:' inside the '## ... $tid' block)"
            fi
            ;;
          perf)
            if [ -n "$block" ] && \
               printf '%s' "$block" | grep -qE '^- Baseline:' && \
               printf '%s' "$block" | grep -qE '^- Post-fix:' && \
               printf '%s' "$block" | grep -qE '^- Delta:'; then
              ok "$tid (Type: perf) — baseline/post/delta recorded in task block"
            else
              drift "$tid (Type: perf) Done — EVIDENCE.md task block missing baseline/post/delta (need 'Baseline:' + 'Post-fix:' + 'Delta:' inside the '## ... $tid' block)"
            fi
            ;;
          ui)
            if [ -n "$block" ] && \
               printf '%s' "$block" | grep -qE '^- Before:' && \
               printf '%s' "$block" | grep -qE '^- After:'; then
              ok "$tid (Type: ui) — before/after screenshots recorded in task block"
            else
              drift "$tid (Type: ui) Done — EVIDENCE.md task block missing before/after screenshots (need 'Before:' + 'After:' inside the '## ... $tid' block)"
            fi
            ;;
          migration)
            if [ -n "$block" ] && \
               printf '%s' "$block" | grep -qE 'Backfill evidence:' && \
               printf '%s' "$block" | grep -qE 'Rollback evidence:'; then
              ok "$tid (Type: migration) — backfill + rollback evidence recorded in task block"
            else
              drift "$tid (Type: migration) Done — EVIDENCE.md task block missing backfill+rollback evidence (need 'Backfill evidence:' + 'Rollback evidence:' inside the '## ... $tid' block)"
            fi
            ;;
          feature|refactor|docs|infra)
            ok "$tid (Type: $ttype) — no extra artifact required for this type"
            ;;
          *)
            drift "$tid Done with unknown Type: '$ttype' — expected feature|bug|perf|ui|migration|docs|refactor|infra (see TASKS.md template)"
            ;;
        esac
      done <<< "$type_pairs"
    fi
  fi
fi

# 7c. Pre-review self-audit evidence.
#
# sg-swe must record a task-scoped self-audit before handing a code-bearing
# task to Review / Done. This is the deterministic half of the prompt gate:
# the prompt tells the builder to do it, and reconcile catches missing
# evidence before the task boundary is treated as clean.
section "Pre-review self-audit evidence"

if [ "$FEATURE_TIER" != "large" ]; then
  printf '  INFO: skipped — tier=%s; pre-review self-audit evidence gate is enforced for large tier only (advisory for medium/small).\n' "$FEATURE_TIER"
else
  EVIDENCE_FILE="$DIR/EVIDENCE.md"
  if [ ! -f "$EVIDENCE_FILE" ]; then
    drift "Pre-review self-audit check: EVIDENCE.md missing"
  else
    self_audit_pairs=$(awk '
      /^```/ { in_code = !in_code; next }
      in_code { next }
      function emit_current() {
        if (id != "" && status ~ /^(Review|Done)([[:space:]]|$)/ && !example) {
          print id "|" status "|" type_field "|" claimed_at
        }
      }
      /^### / {
        emit_current()
        hdr=$0; sub(/^### /, "", hdr); n=split(hdr, a, ":"); id=a[1]
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", id)
        example = (id ~ /EXAMPLE/)
        status=""; type_field=""; claimed_at=""
      }
      /^- Status: / {
        status=$0; sub(/^- Status: /, "", status)
        gsub(/`/, "", status); gsub(/^[[:space:]]+|[[:space:]]+$/, "", status)
      }
      /^- Claimed at: / {
        claimed_at=$0; sub(/^- Claimed at: /, "", claimed_at)
        gsub(/`/, "", claimed_at); gsub(/^[[:space:]]+|[[:space:]]+$/, "", claimed_at)
      }
      /^- Type: / {
        type_field=$0; sub(/^- Type: /, "", type_field)
        sub(/[[:space:]]*#.*$/, "", type_field)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", type_field)
      }
      END {
        emit_current()
      }
    ' "$DIR/TASKS.md" 2>/dev/null)

    task_has_self_audit() {
      local tid="$1"
      local file="$2"
      awk -v tid="$tid" '
        function reset_block() {
          title = 0
          miss1 = 0
          miss2 = 0
          miss3 = 0
          current = 0
          for (i = 1; i <= 3; i++) has_check[i] = 0
        }
        function score_block() {
          if (in_target && title && miss1 && miss2 && miss3 && has_check[1] && has_check[2] && has_check[3]) {
            found = 1
          }
        }
        BEGIN { reset_block() }
        /^## / {
          score_block()
          reset_block()
          in_section = 1
          section_matched_by_heading = ($0 ~ "[[:space:]]" tid "([^A-Za-z0-9_-]|$)") || ($0 ~ "[[:space:]]" tid "[[:space:]]") || ($0 ~ tid "$")
          in_target = section_matched_by_heading
          if (in_target && tolower($0) ~ /pre-review self-audit/) { title = 1 }
          next
        }
        in_section && /^- Task:[[:space:]]+/ {
          if ($0 ~ "Task:[[:space:]]+" tid "([^A-Za-z0-9_-]|$)") {
            in_target = 1
          }
        }
        in_target && tolower($0) ~ /pre-review self-audit/ { title = 1 }
        in_target && /Plausible miss 1:[[:space:]]*[^[:space:]]/ { miss1 = 1; current = 1; next }
        in_target && /Plausible miss 2:[[:space:]]*[^[:space:]]/ { miss2 = 1; current = 2; next }
        in_target && /Plausible miss 3:[[:space:]]*[^[:space:]]/ { miss3 = 1; current = 3; next }
        in_target && /Plausible miss [4-9][0-9]*:/ { current = 0; next }
        in_target && current >= 1 && current <= 3 && /^[[:space:]]*- (Check|Skipped|Skip reason):[[:space:]]*[^[:space:]]/ {
          has_check[current] = 1
        }
        END {
          score_block()
          if (found) print "yes"
        }
      ' "$file"
    }

    if [ -z "$self_audit_pairs" ]; then
      ok "no Review/Done tasks to check"
    else
      # Build exemption set from .self-audit-exempt (one task ID per line;
      # `#` comments allowed). Mirrors .adversarial-exempt. Exists for
      # cross-lane consolidations: tasks whose EVIDENCE recorded self-audits
      # under a different (pre-merge) reconcile grammar are grandfathered
      # rather than retroactively re-judged (2026-06-11, TASK-292 postmortem).
      self_audit_exempt_ids=""
      if [ -f "$DIR/.self-audit-exempt" ]; then
        self_audit_exempt_ids=$(awk '
          { sub(/#.*/, ""); gsub(/^[[:space:]]+|[[:space:]]+$/, "") }
          NF { print }
        ' "$DIR/.self-audit-exempt")
      fi

      while IFS='|' read -r tid task_status ttype claimed_at; do
        [ -z "$tid" ] && continue
        if printf '%s\n' "$self_audit_exempt_ids" | grep -qx "$tid"; then
          ok "$tid ($task_status) — self-audit grandfathered via .self-audit-exempt"
          continue
        fi
        if [ -z "$ttype" ]; then
          claimed_date=${claimed_at%% *}
          if [ -n "$claimed_date" ] && [ "$claimed_date" \< "$SELF_AUDIT_CUTOFF_DATE" ]; then
            ok "$tid ($task_status) — missing Type grandfathered before self-audit cutoff $SELF_AUDIT_CUTOFF_DATE"
          elif [ -z "$claimed_date" ]; then
            drift "$tid ($task_status) — missing Type and missing Claimed at; add Type: feature|bug|perf|ui|migration|docs|refactor|infra or record a durable grandfathering decision"
          else
            drift "$tid ($task_status) — missing Type; new Review/Done tasks claimed on/after $SELF_AUDIT_CUTOFF_DATE must declare Type: feature|bug|perf|ui|migration|docs|refactor|infra"
          fi
          continue
        fi
        case "$ttype" in
          docs)
            ok "$tid ($task_status, Type: docs) — docs-only task does not require pre-review self-audit"
            continue
            ;;
          feature|bug|perf|ui|migration|refactor|infra)
            ;;
          *)
            drift "$tid $task_status with unknown Type: '$ttype' — expected feature|bug|perf|ui|migration|docs|refactor|infra (see TASKS.md template)"
            continue
            ;;
        esac

        self_audit_ok=$(task_has_self_audit "$tid" "$EVIDENCE_FILE")
        if [ "$self_audit_ok" = "yes" ]; then
          ok "$tid ($task_status, Type: $ttype) — pre-review self-audit recorded in task block"
        else
          drift "$tid ($task_status, Type: $ttype) — EVIDENCE.md task block missing pre-review self-audit (need 'Pre-review self-audit', 'Plausible miss 1/2/3', and a Check/Skipped line inside each plausible-miss stanza in the '## ... $tid' block)"
        fi
      done <<< "$self_audit_pairs"
    fi
  fi
fi

# 8. Applied insight trail — every applied INS item must have a complete
# APPLIED.md ledger row, and judgment-routed items must have an Approved
# human approval trail. This mirrors the adversarial-review trail: the
# framework can propose/encode improvements, but applied learning must stay
# reconstructable.
section "Applied insight trail"
if [ "$FEATURE_TIER" != "large" ]; then
  printf '  INFO: skipped — tier=%s; applied insight trail is large-tier only.\n' "$FEATURE_TIER"
elif [ "$SLUG" != "continuous-self-improvement-loop" ]; then
  printf '  INFO: skipped — global insight trail is owned by feature=continuous-self-improvement-loop.\n'
else
  insight_items_dir="${INSIGHTS_ITEMS_DIR_ARG:-$ROOT/docs/insights/items}"
  applied_ledger_file="${INSIGHTS_APPLIED_LEDGER_ARG:-$ROOT/docs/insights/APPLIED.md}"
  approvals_file="${INSIGHTS_APPROVALS_FILE_ARG:-$DIR/APPROVALS.md}"

  insight_top_field() {
    local file="$1"
    local key="$2"
    awk -v key="$key" '
      NR==1 && $0!="---" { exit }
      NR>1 && $0=="---" { exit }
      index($0, key": ")==1 {
        sub(key": ", ""); gsub(/^[ \t]+|[ \t]+$/, ""); print; exit
      }' "$file"
  }

  insight_metadata_field() {
    local file="$1"
    local key="$2"
    awk -v key="$key" '
      NR==1 && $0!="---" { exit }
      NR>1 && $0=="---" { exit }
      /^metadata:[ \t]*$/ { in_meta=1; next }
      in_meta && /^[^ \t]/ { in_meta=0 }
      in_meta && index($0, "  " key ": ")==1 {
        sub("  " key ": ", ""); gsub(/^[ \t]+|[ \t]+$/, ""); print; exit
      }' "$file"
  }

  applied_ledger_row() {
    local ledger="$1"
    local insight_id="$2"
    [ -f "$ledger" ] || return 1
    awk -F'|' -v want="$insight_id" '
      function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
      $0 ~ /^\|/ {
        date=trim($2); id=trim($3); routing=trim($4); target=trim($5)
        eval_delta=trim($6); autonomy=trim($7); reviewer=trim($8)
        commit=trim($9); branch=trim($10)
        if (id == want) {
          printf "%s|%s|%s|%s|%s|%s|%s|%s|%s\n", date, id, routing, target, eval_delta, autonomy, reviewer, commit, branch
          found=1
        }
      }
      END { if (!found) exit 1 }
    ' "$ledger" | head -1
  }

  approval_approved_for_insight() {
    local approvals="$1"
    local insight_id="$2"
    [ -f "$approvals" ] || return 1
    awk -v want="$insight_id" '
      /^### APV-/ {
        if (seen && approved && mentioned) { found=1 }
        seen=1; approved=0; mentioned=0
        if ($0 ~ ("(^|[^[:alnum:]])" want "([^[:alnum:]-]|$)")) { mentioned=1 }
        next
      }
      seen && /^- Status: Approved[[:space:]]*$/ { approved=1 }
      END {
        if (seen && approved && mentioned) { found=1 }
        exit found ? 0 : 1
      }
    ' "$approvals"
  }

  applied_count=0
  if [ -d "$insight_items_dir" ]; then
    for insight_file in "$insight_items_dir"/INS-*.md; do
      [ -e "$insight_file" ] || continue
      status="$(insight_metadata_field "$insight_file" status)"
      status="$(printf '%s' "$status" | tr '[:upper:]' '[:lower:]' | sed 's/^["`]*//; s/["`]*$//')"
      [ "$status" = "applied" ] || continue

      applied_count=$((applied_count + 1))
      insight_id="$(insight_top_field "$insight_file" id)"
      routing="$(insight_metadata_field "$insight_file" routing)"
      routing="$(printf '%s' "$routing" | tr '[:upper:]' '[:lower:]' | sed 's/^["`]*//; s/["`]*$//')"
      insight_label="${insight_id:-$(basename "$insight_file")}"

      if [ -z "$insight_id" ]; then
        drift "applied insight $(basename "$insight_file") missing id"
        continue
      fi

      ledger_row="$(applied_ledger_row "$applied_ledger_file" "$insight_id" 2>/dev/null || true)"
      if [ -z "$ledger_row" ]; then
        drift "applied insight $insight_id missing APPLIED.md ledger row"
        continue
      fi

      IFS='|' read -r ledger_date ledger_id ledger_routing ledger_target ledger_eval_delta ledger_autonomy ledger_reviewer ledger_commit ledger_branch <<< "$ledger_row"
      [ "$ledger_routing" = "$routing" ] || drift "applied insight $insight_id ledger routing mismatch: item=$routing ledger=$ledger_routing"
      [ -n "$ledger_target" ] || drift "applied insight $insight_id ledger row missing target"
      [ -n "$ledger_eval_delta" ] || drift "applied insight $insight_id ledger row missing eval delta"
      [ -n "$ledger_commit" ] || drift "applied insight $insight_id ledger row missing commit"
      [ -n "$ledger_branch" ] || drift "applied insight $insight_id ledger row missing branch"
      case "$ledger_reviewer" in
        */*) ;;
        *) drift "applied insight $insight_id ledger reviewer must include tool/model" ;;
      esac

      case "$routing" in
        add-or-update-principle|role-prompt-edit)
          if approval_approved_for_insight "$approvals_file" "$insight_id"; then
            ok "$insight_id ($routing) — ledger row plus Approved approval trail"
          else
            drift "applied insight $insight_id judgment route missing Approved APPROVALS entry"
          fi
          ;;
        *)
          ok "$insight_label ($routing) — ledger row present"
          ;;
      esac
    done
  fi

  if [ "$applied_count" -eq 0 ]; then
    ok "no applied insight items"
  fi
fi

# 9. Worktree hygiene — dirty tree with no Claimed owner or with paths
# outside the Claimed task's file ownership is drift. The hygiene check
# is a pure reporter; we mirror its verdict into our drift counter so a
# single reconcile run surfaces all coordination problems.
section "Worktree hygiene"
if [ -x "$ROOT/scripts/worktree-hygiene" ]; then
  hygiene_output=$("$ROOT/scripts/worktree-hygiene" "$SLUG" 2>&1)
  hygiene_exit=$?
  case "$hygiene_exit" in
    0)
      ok "CLEAN or DIRTY_OWNED (within current Claimed task ownership)"
      ;;
    1)
      drift "worktree DIRTY_NO_TASK — dirty paths exist with no Claimed task; reviewers/adversary would see unowned changes. Run scripts/worktree-hygiene $SLUG for details."
      ;;
    2)
      drift "worktree DIRTY_MIXED — dirty paths include files outside the Claimed task's Intended file ownership; reviewer/qa/adversary scope is polluted. Run scripts/worktree-hygiene $SLUG for details."
      ;;
    *)
      drift "worktree-hygiene exited $hygiene_exit (unexpected). Output:"
      printf '%s\n' "$hygiene_output" | sed 's/^/    /'
      ;;
  esac
else
  printf '  INFO: scripts/worktree-hygiene not found or not executable; skipping.\n'
fi

# --- Diff-touches-paths within owning task(s) -------------------------------
# Added 2026-05-27 in response to the review-fix postmortem (P2: code
# landed while owning tasks remained Backlog/unclaimed, letting the
# "Adversarial review trail for Done tasks" check pass vacuously).
#
# For every code-bearing path touched in the diff vs
# ${BASE_REF:-${SDLC_BASE_BRANCH:-staging}},
# find the owning task(s) in TASKS.md ("Intended file ownership"
# blocks). Fail with `drift` if the owning task is Backlog or Open
# (not yet claimed); Claimed / Review / Done are accepted. Paths
# with no owning task in TASKS.md emit an INFO line rather than a
# drift (some repo paths legitimately fall outside the per-task
# ownership map — e.g., framework-evolution edits).
section "Diff-touches-paths within owning task(s)"
if ! command -v git >/dev/null 2>&1; then
  printf '  INFO: git not on PATH; skipping diff-vs-task-state check.\n'
else
  BASE="${BASE_REF:-${SDLC_BASE_BRANCH:-staging}}"
  if ! git rev-parse --verify --quiet "$BASE" >/dev/null 2>&1; then
    printf '  INFO: base ref %s not present; skipping diff-vs-task-state check.\n' "$BASE"
  else
    # Collect touched paths from the merge-base; restrict to code-bearing
    # roots (apps/seo, laravel-insurance, scripts) to avoid noisy hits on
    # control-plane doc edits which are owned by reconcile itself.
    touched=$(git diff --name-only "$BASE"...HEAD -- 'apps/seo/*' 'laravel-insurance/*' 'scripts/*' 2>/dev/null || true)
    if [ -z "$touched" ]; then
      ok "no code-bearing diff vs $BASE"
    else
      tasks_file="$DIR/TASKS.md"
      drift_paths=()
      info_paths=()
      while IFS= read -r path; do
        [ -z "$path" ] && continue
        # Skip the per-task verify scripts + the seo-rebuild-verify
        # script itself (these are framework infra owned by the script
        # itself, not by a feature task).
        case "$path" in
          scripts/seo-rebuild-verify|\
          scripts/seo-rebuild-phase-2-compare-and-quote-verify|\
          scripts/sanitize-check|\
          scripts/feature-*|\
          scripts/lib-*|\
          scripts/worktree-hygiene|\
          scripts/adversary-review|\
          scripts/claude-adversary-review|\
          scripts/agent-capsule-*|\
          scripts/codex-capsule-run|\
          scripts/claude-capsule-run|\
          scripts/security-review|\
          scripts/sdlc-doctor|\
          scripts/test-framework-v3)
            continue
            ;;
          # package.json / package-lock.json move with code; not task-owned.
          apps/seo/package.json|apps/seo/package-lock.json)
            continue
            ;;
        esac
        # Find the owning task: any block whose "Intended file ownership"
        # bullets include this path (literal substring match — sufficient
        # for the first-iteration check; tighten with anchors as needed).
        owning_tasks=$(awk -v p="$path" '
          /^### TASK-[0-9]+/ { task=$0; instatus=0 }
          /^- Status: / && task != "" { status=$0 }
          /^- Intended file ownership:/ { inown=1; next }
          inown && /^- / { inown=0 }
          inown && index($0, p) > 0 {
            printf "%s|%s\n", task, status
            inown=0
          }
        ' "$tasks_file" 2>/dev/null)
        if [ -z "$owning_tasks" ]; then
          info_paths+=("$path")
          continue
        fi
        # If ANY owning task is at least Claimed, the path is OK.
        ok_for_path=0
        while IFS= read -r row; do
          status_line=$(printf '%s' "$row" | sed -n 's/.*|//p')
          case "$status_line" in
            *"Status: Claimed"*|*"Status: Review"*|*"Status: Done"*|*"Status: Blocked"*)
              ok_for_path=1
              break
              ;;
          esac
        done <<< "$owning_tasks"
        if [ "$ok_for_path" -eq 0 ]; then
          # Pull the first task id for the drift message.
          first_task=$(printf '%s' "$owning_tasks" | head -n1 | sed -n 's/^### \([^:]*\).*/\1/p')
          drift_paths+=("$path → $first_task (Backlog/Open — should be Claimed or later before code lands)")
        fi
      done <<< "$touched"
      if [ "${#drift_paths[@]}" -gt 0 ]; then
        drift "${#drift_paths[@]} code-bearing path(s) touch task(s) still in Backlog/Open:"
        for p in "${drift_paths[@]}"; do
          printf '    %s\n' "$p"
        done
      else
        ok "all code-bearing diff paths owned by a Claimed/Review/Done task (or unowned)"
      fi
      if [ "${#info_paths[@]}" -gt 0 ]; then
        printf '  INFO: %d path(s) touch no TASKS.md "Intended file ownership" entry (legitimate for framework / control-plane edits):\n' "${#info_paths[@]}"
        for p in "${info_paths[@]}"; do
          printf '    %s\n' "$p"
        done
      fi
    fi
  fi
fi

section "Result"
if [ "$DRIFT" -eq 0 ]; then
  printf 'feature-reconcile passed: no drift detected\n'
  exit 0
fi

printf 'feature-reconcile detected %d drift point(s) — invoke planner (Phase: plan) to reconcile\n' "$DRIFT"
printf '\n'
printf 'If adversarial-trail drift was reported for historical Done tasks that\n'
printf 'predate the framework cutoff (%s), list their task IDs in:\n' "$ADVERSARIAL_CUTOFF_DATE"
printf '  %s\n' "$EXEMPT_FILE"
printf 'Otherwise invoke reviewer with Mode: adversarial (or /feature-review with adversarial pass)\n'
printf 'to record an adversarial trail.\n'
exit 1
