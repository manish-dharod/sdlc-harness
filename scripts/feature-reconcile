#!/usr/bin/env bash
# Validate that a feature's control plane is internally consistent.
#
# Checks that the YAML status block in STATE.md matches what TASKS.md /
# FINDINGS.md / TRACEABILITY.md actually say. If they disagree, prints the
# divergence and exits non-zero so the caller knows to invoke
# planner (Phase: plan) to reconcile (the plan phase owns STATE.md
# transitions).
#
# Also detects stale Claimed tasks (>24h) and dangling Depends-on references
# (a Depends-on pointing at a task ID that doesn't exist).
#
# Tier routing is centralized in scripts/feature-control. Current Review/Done
# code-bearing tasks on every tier need the newest exact-task self-audit, QA
# ledger, application-verification disposition/evidence, and a tracked scoped
# clear opposite-tool receipt. Legacy task status is derived from the immutable
# committed adoption boundary in sdlc.config.yml, never a mutable timestamp.
#
# Exits 0 if consistent; 1 if drift detected; 3 on usage error.

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 3

# Load sdlc.config.yml (no-op if absent). Exposes
# SDLC_CROSS_MODEL_ADVERSARIAL_REQUIRED and friends.
if [ -f "$ROOT/scripts/load-config" ]; then
  # shellcheck source=load-config
  . "$ROOT/scripts/load-config"
fi

SLUG=""
PRINT_TASK_METADATA=""
REQUIRE_CURRENT_FULL=0
TERMINAL_MODE=0

usage() {
  cat <<'EOF'
Usage: scripts/feature-reconcile <feature-slug> [options]

Validates internal consistency of the feature control plane. Exits 0 if
consistent, 1 if drift detected, 3 on usage error.

Options:
  --require-current-full         require a clean successful full verify at exact HEAD
  --terminal                     also require the live worktree to remain clean
  --print-task-metadata TASK-ID  print normalized tier/task metadata and exit
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 3
      ;;
    --require-current-full)
      REQUIRE_CURRENT_FULL=1
      shift
      ;;
    --terminal)
      TERMINAL_MODE=1
      REQUIRE_CURRENT_FULL=1
      shift
      ;;
    --print-task-metadata)
      if [ -z "${2:-}" ]; then
        printf 'feature-reconcile: --print-task-metadata requires a task ID\n' >&2
        exit 3
      fi
      PRINT_TASK_METADATA="$2"
      shift 2
      ;;
    --*)
      printf 'feature-reconcile: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 3
      ;;
    *)
      if [ -z "$SLUG" ]; then
        SLUG="$1"
        shift
      else
        printf 'feature-reconcile: unexpected argument: %s\n' "$1" >&2
        usage >&2
        exit 3
      fi
      ;;
  esac
done

if [ -z "$SLUG" ]; then
  usage
  exit 3
fi

DIR="docs/features/$SLUG"
if [ ! -d "$DIR" ]; then
  printf 'Feature not found: %s\n' "$DIR" >&2
  exit 3
fi

if [ -n "$PRINT_TASK_METADATA" ]; then
  if ! printf '%s' "$PRINT_TASK_METADATA" | grep -Eq '^[A-Z][A-Z0-9]*-[0-9]+[a-z]?$'; then
    printf 'feature-reconcile: invalid task ID: %s\n' "$PRINT_TASK_METADATA" >&2
    exit 3
  fi
  if [ ! -x "$ROOT/scripts/feature-control" ]; then
    printf 'feature-reconcile: scripts/feature-control missing or not executable\n' >&2
    exit 1
  fi
  metadata_paths=$($ROOT/scripts/feature-control paths "$SLUG" 2>&1)
  metadata_paths_rc=$?
  metadata_json=$($ROOT/scripts/feature-control task "$SLUG" "$PRINT_TASK_METADATA" 2>&1)
  metadata_json_rc=$?
  if [ "$metadata_paths_rc" -ne 0 ] || [ "$metadata_json_rc" -ne 0 ]; then
    printf '%s\n' "$metadata_paths" "$metadata_json" >&2
    exit 1
  fi
  python3 - "$metadata_paths" "$metadata_json" <<'PY'
import json, sys
paths = dict(line.split("=", 1) for line in sys.argv[1].splitlines() if "=" in line)
task = json.loads(sys.argv[2])
allowed = {"docs", "feature", "bug", "perf", "ui", "migration", "refactor", "infra", "workflow"}
if not task.get("status"):
    raise SystemExit("feature-reconcile: task has missing/invalid Status")
if task.get("type") not in allowed:
    raise SystemExit("feature-reconcile: task has missing/invalid Type")
for key in ("tier", "task_ledger", "evidence_ledger"):
    print(f"{key}={paths[key]}")
for key in ("id", "status", "type", "claimed_at", "application_verification"):
    label = "task_id" if key == "id" else key
    print(f"{label}={task.get(key, '')}")
PY
  metadata_rc=$?
  [ "$metadata_rc" -eq 0 ] && exit 0
  exit 1
fi

DRIFT=0
section() { printf '\n== %s ==\n' "$1"; }
ok()      { printf '  OK: %s\n' "$1"; }
drift()   { printf '  DRIFT: %s\n' "$1"; DRIFT=$((DRIFT + 1)); }

if [ ! -x "$ROOT/scripts/feature-control" ]; then
  printf 'feature-reconcile: scripts/feature-control missing or not executable\n' >&2
  exit 1
fi
CONTROL_PATHS=$($ROOT/scripts/feature-control paths "$SLUG" 2>&1)
CONTROL_PATHS_RC=$?
if [ "$CONTROL_PATHS_RC" -ne 0 ]; then
  printf '%s\n' "$CONTROL_PATHS" >&2
  exit 1
fi
FEATURE_TIER=$(printf '%s\n' "$CONTROL_PATHS" | sed -n 's/^tier=//p')
TASK_LEDGER=$(printf '%s\n' "$CONTROL_PATHS" | sed -n 's/^task_ledger=//p')
EVIDENCE_LEDGER=$(printf '%s\n' "$CONTROL_PATHS" | sed -n 's/^evidence_ledger=//p')

# 0. Feedback-gated shippable increment sequencing. Historical features are
# marker-free and retain the prior path; activated features fail closed before
# any other reconciliation result can be trusted.
section "Shippable increment sequencing"
if [ -f "$DIR/.incremental-delivery" ]; then
  if [ ! -x "$ROOT/scripts/feature-increment" ]; then
    drift "incremental delivery is active but scripts/feature-increment is missing or not executable"
  else
    increment_check_out=$("$ROOT/scripts/feature-increment" check "$SLUG" 2>&1)
    increment_check_rc=$?
    if [ "$increment_check_rc" -eq 0 ]; then
      ok "increment state valid: $increment_check_out"
    else
      drift "shippable increment state invalid"
      printf '%s\n' "$increment_check_out" | sed 's/^/    /'
    fi
  fi
else
  printf '  INFO: skipped — feature has no .incremental-delivery marker.\n'
fi

# A normal reconcile remains useful throughout implementation. Release
# readiness opts into the terminal exact-HEAD check with
# --require-current-full (and --terminal for a live cleanliness seal).
section "Current full verification"
if [ "$REQUIRE_CURRENT_FULL" -ne 1 ]; then
  printf '  INFO: skipped — pass --require-current-full at the readiness boundary.\n'
else
  VERIFY_STATUS="$DIR/.last-verify.json"
  if [ ! -f "$VERIFY_STATUS" ] || [ -L "$VERIFY_STATUS" ]; then
    drift "missing or unsafe .last-verify.json; run scripts/feature-verify $SLUG full after committing the candidate"
  else
    verify_check=$(python3 - "$VERIFY_STATUS" "$(git rev-parse HEAD 2>/dev/null || printf unknown)" <<'PY'
import json, os, stat, sys
path, expected_head = sys.argv[1:3]
try:
    meta = os.lstat(path)
    if not stat.S_ISREG(meta.st_mode) or meta.st_size > 65536:
        raise ValueError("status artifact is not a bounded regular file")
    def unique(items):
        result = {}
        for key, value in items:
            if key in result:
                raise ValueError(f"duplicate JSON key: {key}")
            result[key] = value
        return result
    with open(path, encoding="utf-8") as handle:
        data = json.load(handle, object_pairs_hook=unique)
    required = {"mode", "exit_code", "head_sha", "dirty", "timestamp", "failures"}
    missing = sorted(required - set(data))
    if missing:
        raise ValueError("missing field(s): " + ", ".join(missing))
    if data["mode"] != "full":
        raise ValueError(f"mode is {data['mode']!r}, expected 'full'")
    if data["exit_code"] != 0 or isinstance(data["exit_code"], bool):
        raise ValueError(f"exit_code is {data['exit_code']!r}, expected 0")
    if data["head_sha"] != expected_head:
        raise ValueError(f"head_sha is {data['head_sha']!r}, expected exact HEAD {expected_head}")
    if data["dirty"] is not False:
        raise ValueError("dirty is not false")
    if data["failures"] != []:
        raise ValueError("failures is not an empty list")
except (OSError, UnicodeError, ValueError, json.JSONDecodeError) as exc:
    print(str(exc))
    raise SystemExit(1)
print("current clean full verification is bound to exact HEAD")
PY
    )
    verify_check_rc=$?
    if [ "$verify_check_rc" -eq 0 ]; then
      ok "$verify_check"
    else
      drift ".last-verify.json is not release-current: $verify_check"
    fi
  fi
  if [ "$TERMINAL_MODE" -eq 1 ]; then
    terminal_dirty=$(git status --porcelain=v1 --untracked-files=normal -- . 2>/dev/null)
    if [ -n "$terminal_dirty" ]; then
      drift "terminal readiness requires a clean live worktree (tracked and untracked dirtiness found)"
      printf '%s\n' "$terminal_dirty" | sed 's/^/    /'
    else
      ok "terminal live worktree is clean"
    fi
  fi
fi

# 1. Parse machine-readable block from STATE.md (the YAML inside ```yaml ... ```).
section "STATE.md machine-readable block"
if [ "$FEATURE_TIER" != "large" ]; then
  printf '  INFO: skipped — tier=%s; STATE.md machine-readable block is large-tier only.\n' "$FEATURE_TIER"
else
state_yaml=$(awk '/^```yaml$/{flag=1; next} /^```$/{flag=0} flag' "$DIR/STATE.md" 2>/dev/null)

if [ -z "$state_yaml" ]; then
  drift "STATE.md is missing the machine-readable yaml block"
else
  ok "yaml block found"
fi

state_field() {
  printf '%s\n' "$state_yaml" | awk -v k="$1" '
    $1 == k":" { sub(/^[^:]+:[[:space:]]*/, ""); sub(/[[:space:]]*#.*$/, ""); print; exit }
  '
}

claimed_state=$(state_field claimed_tasks)
open_state=$(state_field open_tasks)
blocked_state=$(state_field blocked_tasks)
p0_state=$(state_field open_p0)
p1_state=$(state_field open_p1)
ac_total_state=$(state_field ac_total)
ac_pass_state=$(state_field ac_passing)
nfr_total_state=$(state_field nfr_total)
nfr_pass_state=$(state_field nfr_passing)
fi

# 2. Real counts from TASKS.md.
# grep -c always prints a single integer (0 on no match); using `|| echo 0`
# would double-print and break comparison.
section "TASKS.md vs STATE.md task counts"
if [ "$FEATURE_TIER" != "large" ]; then
  printf '  INFO: skipped — tier=%s; STATE.md task-count reconciliation is large-tier only.\n' "$FEATURE_TIER"
else
# Use awk with code-fence awareness so the schema-documentation block in
# TASKS.md is not double-counted alongside real task entries. Also excludes
# tasks whose ID contains EXAMPLE (template placeholders).
count_status() {
  if [ ! -f "$DIR/TASKS.md" ]; then printf '0'; return; fi
  awk -v target="$1" '
    /^```/ { in_code = !in_code; next }
    in_code { next }
    /^### / {
      hdr=$0; sub(/^### /, "", hdr); n=split(hdr, a, ":"); id=a[1]
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", id)
      example = (id ~ /EXAMPLE/)
    }
    /^- Status: / {
      s=$0; sub(/^- Status: /, "", s); gsub(/`/, "", s); gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
      if (!example && s == target) c++
    }
    END { print c+0 }
  ' "$DIR/TASKS.md"
}
real_open="$(count_status Open)"
real_claimed="$(count_status Claimed)"
real_blocked="$(count_status Blocked)"

[ "${open_state:-?}" = "$real_open" ]       && ok "open_tasks: $real_open"    || drift "open_tasks: STATE=$open_state TASKS=$real_open"
[ "${claimed_state:-?}" = "$real_claimed" ] && ok "claimed_tasks: $real_claimed" || drift "claimed_tasks: STATE=$claimed_state TASKS=$real_claimed"
[ "${blocked_state:-?}" = "$real_blocked" ] && ok "blocked_tasks: $real_blocked" || drift "blocked_tasks: STATE=$blocked_state TASKS=$real_blocked"
fi

# 3. Real P0/P1 counts from FINDINGS.md.
section "FINDINGS.md vs STATE.md severity counts"
if [ "$FEATURE_TIER" != "large" ]; then
  printf '  INFO: skipped — tier=%s; FINDINGS.md severity reconciliation is large-tier only.\n' "$FEATURE_TIER"
else
count_unresolved_findings() {
  awk -v sev_pat="$1" '
    /^```/ { in_code = !in_code; next }
    in_code { next }
    /^### / { sev=""; status=""; example=($0 ~ /EXAMPLE/) }
    /^- Severity: / { sev=$0 }
    /^- Status: / {
      status=$0
      if (!example && sev ~ sev_pat && status !~ /Fixed|False positive/) print
    }
  ' "$DIR/FINDINGS.md" 2>/dev/null | wc -l | tr -d ' '
}
unresolved_p0="$(count_unresolved_findings P0)"
unresolved_p1="$(count_unresolved_findings P1)"

[ "${p0_state:-?}" = "$unresolved_p0" ] && ok "open_p0: $unresolved_p0" || drift "open_p0: STATE=$p0_state FINDINGS=$unresolved_p0"
[ "${p1_state:-?}" = "$unresolved_p1" ] && ok "open_p1: $unresolved_p1" || drift "open_p1: STATE=$p1_state FINDINGS=$unresolved_p1"
fi

# 4. Real AC/NFR coverage from TRACEABILITY.md.
section "TRACEABILITY.md vs STATE.md coverage"
if [ "$FEATURE_TIER" != "large" ]; then
  printf '  INFO: skipped — tier=%s; TRACEABILITY.md coverage reconciliation is large-tier only.\n' "$FEATURE_TIER"
else
trace_field() {
  grep -E "^$1: " "$DIR/TRACEABILITY.md" 2>/dev/null | head -1 | awk '{print $NF}'
}
real_ac_total=$(trace_field "AC total")
real_ac_pass=$(trace_field "AC with passing tests")
real_nfr_total=$(trace_field "NFR total")
real_nfr_pass=$(trace_field "NFR measured and passing")

[ "${ac_total_state:-?}" = "${real_ac_total:-?}" ] && ok "ac_total: $real_ac_total" || drift "ac_total: STATE=$ac_total_state TRACEABILITY=$real_ac_total"
[ "${ac_pass_state:-?}" = "${real_ac_pass:-?}" ]   && ok "ac_passing: $real_ac_pass" || drift "ac_passing: STATE=$ac_pass_state TRACEABILITY=$real_ac_pass"
[ "${nfr_total_state:-?}" = "${real_nfr_total:-?}" ] && ok "nfr_total: $real_nfr_total" || drift "nfr_total: STATE=$nfr_total_state TRACEABILITY=$real_nfr_total"
[ "${nfr_pass_state:-?}" = "${real_nfr_pass:-?}" ]   && ok "nfr_passing: $real_nfr_pass" || drift "nfr_passing: STATE=$nfr_pass_state TRACEABILITY=$real_nfr_pass"
fi

# 4b. TRACEABILITY rows newly marked Passing must be backed by a green,
# current-enough scripts/feature-verify status artifact. This catches the
# "markdown says Passing, gate was red/stale" false-confidence class.
section "TRACEABILITY Passing verification status"

mode_rank() {
  case "$1" in
    fast) printf '1' ;;
    unit) printf '2' ;;
    full) printf '3' ;;
    *) printf '0' ;;
  esac
}

json_string_field() {
  local file="$1"
  local key="$2"
  sed -nE 's/^[[:space:]]*"'"$key"'"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p' "$file" 2>/dev/null | head -1
}

json_number_field() {
  local file="$1"
  local key="$2"
  sed -nE 's/^[[:space:]]*"'"$key"'"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' "$file" 2>/dev/null | head -1
}

task_required_mode() {
  local tid="$1"
  awk -v tid="$tid" '
    /^```/ { in_code = !in_code; next }
    in_code { next }
    /^### / {
      hdr=$0; sub(/^### /, "", hdr); split(hdr, a, ":"); id=a[1]
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", id)
      in_target = (id == tid)
      next
    }
    in_target && /^[[:space:]]*-[[:space:]]*mode:[[:space:]]*/ {
      line=$0
      sub(/^[[:space:]]*-[[:space:]]*mode:[[:space:]]*/, "", line)
      sub(/[[:space:]]*#.*$/, "", line)
      gsub(/`/, "", line)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
      if (line ~ /^(fast|unit|full)$/) { print line; exit }
    }
  ' "$DIR/TASKS.md" 2>/dev/null | head -1
}

collect_changed_passing_rows() {
  local trace_file="$DIR/TRACEABILITY.md"
  [ -f "$trace_file" ] || return 0

  if git ls-files --error-unmatch "$trace_file" >/dev/null 2>&1; then
    base="${BASE_REF:-${SDLC_BASE_BRANCH:-master}}"
    if git rev-parse --verify --quiet "$base" >/dev/null 2>&1; then
      git diff --unified=0 "$base"...HEAD -- "$trace_file" 2>/dev/null || true
    elif git rev-parse --verify --quiet "origin/$base" >/dev/null 2>&1; then
      git diff --unified=0 "origin/$base"...HEAD -- "$trace_file" 2>/dev/null || true
    fi
    git diff --unified=0 -- "$trace_file" 2>/dev/null || true
    git diff --cached --unified=0 -- "$trace_file" 2>/dev/null || true
  else
    sed 's/^/+/' "$trace_file"
  fi | awk '/^\+[^+]/ && /\|/ && /\|[[:space:]]*Passing[[:space:]]*\|/ { sub(/^\+/, ""); print }'
}

changed_passing_rows=$(collect_changed_passing_rows)
changed_passing_tasks=$(printf '%s\n' "$changed_passing_rows" | grep -Eo 'TASK-[A-Za-z0-9_-]*[0-9][A-Za-z0-9_-]*' | sort -u || true)

if [ -z "$changed_passing_rows" ]; then
  ok "no changed TRACEABILITY rows marked Passing"
else
  status_file="$DIR/.last-verify.json"
  if [ ! -f "$status_file" ]; then
    drift "TRACEABILITY row changed to Passing but $status_file is missing; run scripts/feature-verify $SLUG <mode>"
  else
    verify_exit=$(json_number_field "$status_file" exit_code)
    verify_mode=$(json_string_field "$status_file" mode)
    verify_sha=$(json_string_field "$status_file" head_sha)

    if [ "$verify_exit" != "0" ]; then
      drift "TRACEABILITY row changed to Passing but .last-verify.json is red (exit_code=${verify_exit:-missing})"
    fi

    if [ -z "$verify_sha" ] || ! git cat-file -e "$verify_sha^{commit}" 2>/dev/null; then
      drift "TRACEABILITY row changed to Passing but .last-verify.json head_sha is missing or not a commit (${verify_sha:-missing})"
    elif ! git merge-base --is-ancestor "$verify_sha" HEAD 2>/dev/null; then
      drift "TRACEABILITY row changed to Passing but .last-verify.json head_sha $verify_sha is not an ancestor of HEAD"
    fi

    required_mode="fast"
    required_rank=1
    if [ -n "$changed_passing_tasks" ]; then
      while IFS= read -r tid; do
        [ -z "$tid" ] && continue
        task_mode=$(task_required_mode "$tid")
        [ -z "$task_mode" ] && task_mode="fast"
        task_rank=$(mode_rank "$task_mode")
        if [ "$task_rank" -gt "$required_rank" ] 2>/dev/null; then
          required_mode="$task_mode"
          required_rank="$task_rank"
        fi
      done <<< "$changed_passing_tasks"
    fi

    verify_rank=$(mode_rank "$verify_mode")
    if [ "$verify_rank" -lt "$required_rank" ] 2>/dev/null; then
      drift "TRACEABILITY row changed to Passing but .last-verify.json mode=${verify_mode:-missing} is below required mode=$required_mode for changed task row(s)"
    fi

    if [ "$verify_exit" = "0" ] && [ "$verify_rank" -ge "$required_rank" ] 2>/dev/null && \
       [ -n "$verify_sha" ] && git cat-file -e "$verify_sha^{commit}" 2>/dev/null && \
       git merge-base --is-ancestor "$verify_sha" HEAD 2>/dev/null; then
      ok "changed Passing row(s) backed by green .last-verify.json (mode=$verify_mode, required=$required_mode)"
    fi
  fi
fi

# 5. Dangling Depends-on references. Skip code-fenced schema blocks and
# example tasks (any task ID containing EXAMPLE).
section "Depends-on integrity"
ids_present=$(awk '
  /^```/ { in_code = !in_code; next }
  in_code { next }
  /^### / {
    hdr=$0; sub(/^### /, "", hdr); n=split(hdr, a, ":"); id=a[1]
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", id)
    if (id !~ /EXAMPLE/) print id
  }
' "$DIR/TASKS.md" 2>/dev/null)

ids_in_deps=$(awk '
  /^```/ { in_code = !in_code; next }
  in_code { next }
  /^### / { example = ($0 ~ /EXAMPLE/) }
  /^- Depends-on:/ {
    if (example) next
    sub(/^- Depends-on:[[:space:]]*/, "")
    line = $0
    # Tolerate prose in Depends-on: extract machine IDs only (e.g. ICLR-020,
    # APR-001, CKO-051). Prose like "(none — root task)" yields zero IDs.
    while (match(line, /[A-Z][A-Z0-9]*-[0-9]+/)) {
      print substr(line, RSTART, RLENGTH)
      line = substr(line, RSTART + RLENGTH)
    }
  }
' "$DIR/TASKS.md" 2>/dev/null)

if [ -n "$ids_in_deps" ]; then
  missing=$(comm -23 <(printf '%s\n' "$ids_in_deps" | sort -u) <(printf '%s\n' "$ids_present" | sort -u))
  if [ -n "$missing" ]; then
    while IFS= read -r m; do
      [ -z "$m" ] && continue
      drift "Depends-on references nonexistent task: $m"
    done <<< "$missing"
  else
    ok "all Depends-on references resolve"
  fi
else
  ok "no Depends-on references to check"
fi

# 6. Stale Claimed tasks (> 24h since Claimed at). Code-fence-aware.
section "Stale Claimed tasks"
now=$(date +%s)
awk '
  /^```/ { in_code = !in_code; next }
  in_code { next }
  /^### / {
    hdr=$0; sub(/^### /, "", hdr); n=split(hdr, a, ":"); id=a[1]
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", id); status=""; claimed_at=""
    example = (id ~ /EXAMPLE/)
  }
  /^- Status: / { status=$0; sub(/^- Status: /, "", status); gsub(/`/, "", status); gsub(/^[[:space:]]+|[[:space:]]+$/, "", status) }
  /^- Claimed at: / {
    claimed_at=$0
    sub(/^- Claimed at: /, "", claimed_at)
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", claimed_at)
    if (!example && status == "Claimed" && claimed_at != "") print id "|" claimed_at
  }
' "$DIR/TASKS.md" 2>/dev/null | while IFS='|' read -r id claimed_at; do
  [ -z "$id" ] && continue
  ts=$(date -d "$claimed_at" +%s 2>/dev/null || date -j -f "%Y-%m-%d %H:%M %Z" "$claimed_at" +%s 2>/dev/null || echo "")
  if [ -z "$ts" ]; then
    printf '  WARN: cannot parse Claimed at for %s: %s\n' "$id" "$claimed_at"
    continue
  fi
  age=$(( now - ts ))
  if [ "$age" -gt 86400 ]; then
    drift "$id has been Claimed for $(( age / 3600 ))h (>24h) — reconcile or release"
  else
    ok "$id Claimed for $(( age / 3600 ))h (within 24h)"
  fi
done

# Cross-model task review is enforced by schema-v2 receipt validation in the
# all-tier section below. Local transcript/model-header checks are intentionally
# not duplicated here because they are not clone-durable evidence.
# 7b. Per-task-type artifact requirements (added in framework-v3 Phase 4).
#
# When a Done task declares `Type: <type>` and that type has a documented
# artifact requirement, EVIDENCE.md must include the type-specific
# artifact rows tied to the task ID. Tasks without `Type:` (or with a
# type that has no artifact requirement, e.g. feature/refactor/docs/infra)
# are not affected. This is opt-in for new tasks; pre-existing tasks
# remain valid.
#
# This section is gated to large tier (consistent with the adversarial-trail
# check above). Medium and small tiers get an advisory INFO line.
section "Per-task-type artifact requirements"

if [ "$FEATURE_TIER" != "large" ]; then
  printf '  INFO: skipped — tier=%s; per-task-type artifact gate is enforced for large tier only (advisory for medium/small).\n' "$FEATURE_TIER"
else
  EVIDENCE_FILE="$DIR/EVIDENCE.md"
  if [ ! -f "$EVIDENCE_FILE" ]; then
    drift "Per-task-type artifact check: EVIDENCE.md missing"
  else
    # Walk Done tasks; extract task ID and Type. Same code-fence-aware
    # parser pattern as the rest of this script.
    #
    # Done status detection: match `Done`, `Done (YYYY-MM-DD)`, `Done`-with-
    # trailing-whitespace, etc. — same regex shape the adjacent
    # adversarial-trail parser uses (^Done([[:space:]]|$)). Per ADV-FND-001
    # from the 2026-05-26 Phase-4 Codex adversary review: the strict
    # `status == "Done"` check let dated Done statuses bypass the gate.
    type_pairs=$(awk '
      /^```/ { in_code = !in_code; next }
      in_code { next }
      /^### / {
        if (id != "" && status ~ /^Done([[:space:]]|$)/ && type_field != "" && !example) {
          print id "|" type_field
        }
        hdr=$0; sub(/^### /, "", hdr); n=split(hdr, a, ":"); id=a[1]
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", id)
        example = (id ~ /EXAMPLE/)
        status=""; type_field=""
      }
      /^- Status: / {
        status=$0; sub(/^- Status: /, "", status)
        gsub(/`/, "", status); gsub(/^[[:space:]]+|[[:space:]]+$/, "", status)
      }
      /^- Type: / {
        type_field=$0; sub(/^- Type: /, "", type_field)
        sub(/[[:space:]]*#.*$/, "", type_field)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", type_field)
      }
      END {
        if (id != "" && status ~ /^Done([[:space:]]|$)/ && type_field != "" && !example) {
          print id "|" type_field
        }
      }
    ' "$DIR/TASKS.md" 2>/dev/null)

    # Helper: extract EVIDENCE.md block for a specific task ID. A "block"
    # is the lines from the `## ... <Task ID>` heading (or any `##` whose
    # following lines include `- Task: <id>`) up to the next `## ` heading.
    # Per ADV-FND-002 from the Phase-4 Codex adversary review: artifact
    # markers must be scoped to the task's evidence block, not grepped
    # globally across the file (otherwise one task's markers can satisfy
    # another task's gate).
    extract_task_block() {
      local tid="$1"
      local file="$2"
      awk -v tid="$tid" '
        /^## / {
          # Hitting a new section heading. Close previous block.
          if (in_target) { exit }
          in_section = 1
          section_matched_by_heading = ($0 ~ "[[:space:]]" tid "([^A-Za-z0-9_-]|$)") || ($0 ~ "[[:space:]]" tid "[[:space:]]") || ($0 ~ tid "$")
          in_target = section_matched_by_heading
          next
        }
        in_section && /^- Task:[[:space:]]+/ {
          if ($0 ~ "Task:[[:space:]]+" tid "([^A-Za-z0-9_-]|$)") {
            in_target = 1
          }
        }
        in_target { print }
      ' "$file"
    }

    if [ -z "$type_pairs" ]; then
      ok "no Done tasks with declared Type — nothing to check (Type field is opt-in)"
    else
      while IFS='|' read -r tid ttype; do
        [ -z "$tid" ] && continue
        block=$(extract_task_block "$tid" "$EVIDENCE_FILE")
        case "$ttype" in
          bug)
            # Markers must appear INSIDE this task's evidence block.
            if [ -n "$block" ] && \
               printf '%s' "$block" | grep -qE 'Repro pre-fix:' && \
               printf '%s' "$block" | grep -qE 'Repro post-fix:'; then
              ok "$tid (Type: bug) — failing-then-passing repro recorded in task block"
            else
              drift "$tid (Type: bug) Done — EVIDENCE.md task block missing failing-then-passing repro (need 'Repro pre-fix:' + 'Repro post-fix:' inside the '## ... $tid' block)"
            fi
            ;;
          perf)
            if [ -n "$block" ] && \
               printf '%s' "$block" | grep -qE '^- Baseline:' && \
               printf '%s' "$block" | grep -qE '^- Post-fix:' && \
               printf '%s' "$block" | grep -qE '^- Delta:'; then
              ok "$tid (Type: perf) — baseline/post/delta recorded in task block"
            else
              drift "$tid (Type: perf) Done — EVIDENCE.md task block missing baseline/post/delta (need 'Baseline:' + 'Post-fix:' + 'Delta:' inside the '## ... $tid' block)"
            fi
            ;;
          ui)
            if [ -n "$block" ] && \
               printf '%s' "$block" | grep -qE '^- Before:' && \
               printf '%s' "$block" | grep -qE '^- After:'; then
              ok "$tid (Type: ui) — before/after screenshots recorded in task block"
            else
              drift "$tid (Type: ui) Done — EVIDENCE.md task block missing before/after screenshots (need 'Before:' + 'After:' inside the '## ... $tid' block)"
            fi
            ;;
          migration)
            if [ -n "$block" ] && \
               printf '%s' "$block" | grep -qE 'Backfill evidence:' && \
               printf '%s' "$block" | grep -qE 'Rollback evidence:'; then
              ok "$tid (Type: migration) — backfill + rollback evidence recorded in task block"
            else
              drift "$tid (Type: migration) Done — EVIDENCE.md task block missing backfill+rollback evidence (need 'Backfill evidence:' + 'Rollback evidence:' inside the '## ... $tid' block)"
            fi
            ;;
          feature|refactor|docs|infra|workflow)
            ok "$tid (Type: $ttype) — no extra artifact required for this type"
            ;;
          *)
            drift "$tid Done with unknown Type: '$ttype' — expected feature|bug|perf|ui|migration|docs|refactor|infra|workflow (see TASKS.md template)"
            ;;
        esac
      done <<< "$type_pairs"
    fi
  fi
fi

# Historical date/exemption-based self-audit enforcement was removed. The
# authoritative all-tier adoption-based section below is the sole self-audit
# gate for current Review/Done tasks; tasks already Done at the committed
# adoption boundary remain legacy.

# 7d/7e/7f. Authoritative all-tier Review/Done evidence boundary.
#
# Legacy is derived from task state at an immutable committed adoption point;
# a mutable Claimed-at timestamp cannot manufacture an exemption. Current
# code-bearing work must cite the newest applicable task evidence, a tracked
# allocator-nonce schema-v2 clear receipt, a complete self-audit/QA ledger,
# and an explicit application-verification disposition.
CALLER_RECEIPT_ADOPTION="${SDLC_REVIEW_RECEIPT_ADOPTION_COMMIT:-}"
COMMITTED_RECEIPT_ADOPTION=$($ROOT/scripts/feature-control committed-config SDLC_REVIEW_RECEIPT_ADOPTION_COMMIT 2>&1)
COMMITTED_RECEIPT_ADOPTION_RC=$?
if [ "$COMMITTED_RECEIPT_ADOPTION_RC" -ne 0 ] || [ -z "$COMMITTED_RECEIPT_ADOPTION" ]; then
  drift "committed SDLC_REVIEW_RECEIPT_ADOPTION_COMMIT is missing or invalid: ${COMMITTED_RECEIPT_ADOPTION:-<missing>}"
  REVIEW_ROWS=""
elif [ -n "$CALLER_RECEIPT_ADOPTION" ] && [ "$CALLER_RECEIPT_ADOPTION" != "$COMMITTED_RECEIPT_ADOPTION" ]; then
  drift "ambient SDLC_REVIEW_RECEIPT_ADOPTION_COMMIT override is forbidden; committed config is authoritative"
  REVIEW_ROWS=""
else
  REVIEW_ROWS=$($ROOT/scripts/feature-control review-rows "$SLUG" "$COMMITTED_RECEIPT_ADOPTION" 2>&1)
  REVIEW_ROWS_RC=$?
  if [ "$REVIEW_ROWS_RC" -ne 0 ]; then
    drift "tier-aware task/history parser failed: $REVIEW_ROWS"
    REVIEW_ROWS=""
  fi
fi

is_canonical_code_type() {
  case "$1" in
    feature|bug|perf|ui|migration|refactor|infra|workflow) return 0 ;;
    *) return 1 ;;
  esac
}

COMMITTED_CODEX_REVIEWER_MODEL=$($ROOT/scripts/feature-control committed-config \
  SDLC_CODEX_ADVERSARY_REQUIRED_MODEL 2>/dev/null || true)
COMMITTED_CLAUDE_REVIEWER_MODEL=$($ROOT/scripts/feature-control committed-config \
  SDLC_CLAUDE_ADVERSARY_REQUIRED_MODEL 2>/dev/null || true)
COMMITTED_CODEX_REVIEWER_MODEL="${COMMITTED_CODEX_REVIEWER_MODEL:-gpt-5.5}"
COMMITTED_CLAUDE_REVIEWER_MODEL="${COMMITTED_CLAUDE_REVIEWER_MODEL:-claude-opus-4-8}"

section "Review-stage tracked opposite-tool receipt (all tiers)"
if [ -z "$REVIEW_ROWS" ]; then
  ok "no Review/Done tasks to check"
else
  while IFS='|' read -r tid task_status ttype claimed_at app_verification task_lifecycle lifecycle_reason docs_classification; do
    [ -n "$tid" ] || continue
    if [ "$task_lifecycle" != "current" ] && [ "$task_lifecycle" != "legacy" ]; then
      drift "$tid ($task_status) — invalid receipt-gate lifecycle: ${task_lifecycle:-missing}"
      continue
    fi
    if [ "$task_lifecycle" = "legacy" ]; then
      ok "$tid ($task_status) — receipt gate legacy by committed history ($lifecycle_reason)"
      continue
    fi
    if [ "$ttype" = "docs" ]; then
      case "$docs_classification" in
        verified:*)
          ok "$tid ($task_status, Type: docs) — verified docs-only claim-to-candidate scope does not require an opposite-tool receipt"
          ;;
        *)
          drift "$tid ($task_status, Type: docs) — docs-only classifier failed closed: ${docs_classification#invalid:}"
          ;;
      esac
      continue
    fi
    if ! is_canonical_code_type "$ttype"; then
      drift "$tid ($task_status) — missing/invalid Type '$ttype'; expected feature|bug|perf|ui|migration|refactor|infra|workflow|docs"
      continue
    fi
    tracked_receipt_path=$($ROOT/scripts/feature-control latest-tracked-receipt-path "$SLUG" "$tid" 2>/dev/null)
    if [ "$?" -ne 0 ] || [ -z "$tracked_receipt_path" ]; then
      drift "$tid ($task_status) — HEAD tracks no allocator-named adversary receipt for this task"
      continue
    fi
    evidence_receipt_path=$($ROOT/scripts/feature-control latest-receipt-path "$SLUG" "$tid" 2>/dev/null)
    if [ "$?" -ne 0 ] || [ -z "$evidence_receipt_path" ]; then
      drift "$tid ($task_status) — latest task evidence does not cite newest HEAD-tracked adversary receipt: $tracked_receipt_path"
      continue
    fi
    if [ "$evidence_receipt_path" != "$tracked_receipt_path" ]; then
      drift "$tid ($task_status) — latest task evidence does not cite newest HEAD-tracked adversary receipt: tracked=$tracked_receipt_path evidence=$evidence_receipt_path"
      continue
    fi
    receipt_path="$tracked_receipt_path"
    case "$receipt_path" in
      docs/features/"$SLUG"/review-receipts/*.json) ;;
      *) drift "$tid ($task_status) — latest receipt path is missing or outside this feature: ${receipt_path:-<missing>}"; continue ;;
    esac
    if ! git cat-file -e "HEAD:$receipt_path" 2>/dev/null || ! git diff --quiet HEAD -- "$receipt_path" 2>/dev/null; then
      drift "$tid ($task_status) — receipt is not clone-durable and byte-identical in current HEAD: $receipt_path"
      continue
    fi
    if ! "$ROOT/scripts/review-attempt" validate-receipt "$receipt_path" --require-scoped >/dev/null 2>&1; then
      drift "$tid ($task_status) — latest receipt fails scoped content/ancestry/hash validation: $receipt_path"
      continue
    fi
    receipt_fields=$($ROOT/scripts/review-attempt receipt-human-fields "$receipt_path" 2>/dev/null)
    receipt_feature=$(printf '%s\n' "$receipt_fields" | sed -n 's/^feature=//p')
    receipt_task=$(printf '%s\n' "$receipt_fields" | sed -n 's/^task_id=//p')
    receipt_kind=$(printf '%s\n' "$receipt_fields" | sed -n 's/^review_kind=//p')
    receipt_status=$(printf '%s\n' "$receipt_fields" | sed -n 's/^status=//p')
    receipt_reviewer=$(printf '%s\n' "$receipt_fields" | sed -n 's/^reviewer_tool=//p')
    receipt_reviewer_model=$(printf '%s\n' "$receipt_fields" | sed -n 's/^reviewer_model=//p')
    if [ "$receipt_feature" != "$SLUG" ] || [ "$receipt_task" != "$tid" ] || [ "$receipt_kind" != "adversary" ]; then
      drift "$tid ($task_status) — latest receipt content identity does not match feature/task/adversary gate"
      continue
    fi
    if [ "$receipt_status" != "clear" ]; then
      drift "$tid ($task_status) — latest receipt status is '$receipt_status', expected clear"
      continue
    fi
    case "$receipt_reviewer" in
      codex-cli) required_reviewer_model="$COMMITTED_CODEX_REVIEWER_MODEL" ;;
      claude-code) required_reviewer_model="$COMMITTED_CLAUDE_REVIEWER_MODEL" ;;
      *)
        drift "$tid ($task_status) — receipt reviewer tool '$receipt_reviewer' is not a sanctioned opposite-tool wrapper"
        continue
        ;;
    esac
    if [ "$receipt_reviewer_model" != "$required_reviewer_model" ]; then
      drift "$tid ($task_status) — receipt reviewer model '$receipt_reviewer_model' does not match committed pin '$required_reviewer_model'"
      continue
    fi
    receipt_candidate=$(python3 - "$receipt_path" <<'PY' 2>/dev/null
import json, sys
with open(sys.argv[1], encoding="utf-8") as handle:
    print(json.load(handle).get("reviewed_candidate_sha", ""))
PY
    )
    if [ -z "$receipt_candidate" ]; then
      drift "$tid ($task_status) — latest receipt is missing reviewed_candidate_sha"
      continue
    fi
    post_review_changes=$($ROOT/scripts/feature-control post-review-owned-changes "$SLUG" "$tid" "$receipt_candidate" 2>&1)
    post_review_rc=$?
    if [ "$post_review_rc" -eq 1 ]; then
      drift "$tid ($task_status) — task-owned product change exists after the reviewed candidate; obtain a fresh receipt: $(printf '%s' "$post_review_changes" | tr '\n' ' ')"
      continue
    elif [ "$post_review_rc" -ne 0 ]; then
      drift "$tid ($task_status) — could not verify post-receipt task scope: $post_review_changes"
      continue
    fi
    if ! python3 - "$receipt_path" "$tid" "$receipt_kind" "$receipt_reviewer" <<'PY' >/dev/null 2>&1
import datetime, os, re, sys
path, task_id, kind, reviewer = sys.argv[1:5]
match = re.fullmatch(
    rf"(?P<stamp>\d{{4}}-\d{{2}}-\d{{2}}T\d{{6}}Z)-{re.escape(task_id)}-"
    rf"{re.escape(kind)}-{re.escape(reviewer)}-attempt-[1-9][0-9]*-[0-9a-f]{{12}}\.json",
    os.path.basename(path),
)
if not match:
    raise SystemExit(1)
datetime.datetime.strptime(match.group("stamp"), "%Y-%m-%dT%H%M%SZ")
PY
    then
      drift "$tid ($task_status) — receipt filename is not allocator nonce-bound to its validated content: $receipt_path"
      continue
    fi
    ok "$tid ($task_status) — latest evidence cites a tracked scoped clear opposite-tool receipt"
  done <<< "$REVIEW_ROWS"
fi

section "Pre-review self-audit evidence (all tiers)"
if [ -z "$REVIEW_ROWS" ]; then
  ok "no Review/Done tasks to check"
else
  while IFS='|' read -r tid task_status ttype claimed_at app_verification task_lifecycle lifecycle_reason docs_classification; do
    [ -n "$tid" ] || continue
    if [ "$task_lifecycle" != "current" ] && [ "$task_lifecycle" != "legacy" ]; then
      drift "$tid ($task_status) — invalid evidence-gate lifecycle: ${task_lifecycle:-missing}"
      continue
    fi
    if [ "$task_lifecycle" = "legacy" ]; then
      ok "$tid ($task_status) — self-audit gate legacy by committed history"
      continue
    fi
    if [ "$ttype" = "docs" ]; then
      case "$docs_classification" in
        verified:*) ok "$tid ($task_status, Type: docs) — verified docs-only scope does not require pre-review self-audit" ;;
        *) drift "$tid ($task_status, Type: docs) — docs-only classifier failed closed: ${docs_classification#invalid:}" ;;
      esac
      continue
    fi
    if ! is_canonical_code_type "$ttype"; then
      drift "$tid ($task_status) — missing/invalid Type '$ttype'"
      continue
    fi
    audit_block=$($ROOT/scripts/feature-control review-evidence "$SLUG" "$tid" self-audit 2>/dev/null)
    if [ "$?" -ne 0 ] || [ -z "$audit_block" ]; then
      drift "$tid ($task_status, Type: $ttype) — latest evidence is missing a pre-review self-audit"
      continue
    fi
    if ! printf '%s\n' "$audit_block" | python3 -c '
import re, sys
text = sys.stdin.read()
for number in (1, 2, 3):
    match = re.search(rf"(?mi)^\s*-?\s*Plausible miss {number}:\s*\S.*$", text)
    if not match:
        raise SystemExit(1)
    end = re.search(rf"(?mi)^\s*-?\s*Plausible miss {number + 1}:\s*", text[match.end():]) if number < 3 else None
    stanza = text[match.end():match.end() + end.start()] if end else text[match.end():]
    if not re.search(r"(?mi)^\s*-\s*(?:Check|Skipped|Skip reason):\s*\S", stanza):
        raise SystemExit(1)
'; then
      drift "$tid ($task_status, Type: $ttype) — pre-review self-audit needs nonblank Plausible miss 1/2/3 and Check/Skipped/Skip reason rows"
      continue
    fi
    ok "$tid ($task_status, Type: $ttype) — pre-review self-audit recorded"
  done <<< "$REVIEW_ROWS"
fi

section "QA coverage ledger for Review/Done tasks (all tiers)"
if [ -z "$REVIEW_ROWS" ]; then
  ok "no Review/Done tasks to check"
else
  while IFS='|' read -r tid task_status ttype claimed_at app_verification task_lifecycle lifecycle_reason docs_classification; do
    [ -n "$tid" ] || continue
    if [ "$task_lifecycle" != "current" ] && [ "$task_lifecycle" != "legacy" ]; then
      drift "$tid ($task_status) — invalid evidence-gate lifecycle: ${task_lifecycle:-missing}"
      continue
    fi
    if [ "$task_lifecycle" = "legacy" ]; then
      ok "$tid ($task_status) — QA coverage gate legacy by committed history"
      continue
    fi
    if [ "$ttype" = "docs" ]; then
      case "$docs_classification" in
        verified:*) ok "$tid ($task_status, Type: docs) — verified docs-only scope does not require QA coverage ledger" ;;
        *) drift "$tid ($task_status, Type: docs) — docs-only classifier failed closed: ${docs_classification#invalid:}" ;;
      esac
      continue
    fi
    if ! is_canonical_code_type "$ttype"; then
      drift "$tid ($task_status) — missing/invalid Type '$ttype'"
      continue
    fi
    qa_block=$($ROOT/scripts/feature-control review-evidence "$SLUG" "$tid" qa 2>/dev/null)
    if [ "$?" -ne 0 ] || [ -z "$qa_block" ]; then
      drift "$tid ($task_status) — latest evidence is missing a QA coverage ledger"
      continue
    fi
    if ! printf '%s\n' "$qa_block" | python3 -c '
import re, sys
text = sys.stdin.read()
required = ("Control inventory", "Production baseline", "Candidate proof", "Data-path proof", "Untested rows", "Result")
values = {}
for label in required:
    matches = re.findall(rf"(?mi)^\s*-\s*{re.escape(label)}:\s*(.*?)\s*$", text)
    if len(matches) != 1:
        raise SystemExit(1)
    values[label] = matches[0]
if not re.fullmatch(r"(?i)(?:0|none)\.?", values["Untested rows"]):
    raise SystemExit(1)
if not re.fullmatch(r"(?i)PASS\.?", values["Result"]):
    raise SystemExit(1)
'; then
      drift "$tid ($task_status) — QA coverage ledger needs one exact field set, zero untested rows, and Result: PASS (duplicates/contradictions are forbidden)"
      continue
    fi
    ok "$tid ($task_status) — QA coverage ledger recorded with zero untested rows"
  done <<< "$REVIEW_ROWS"
fi

section "Application verification disposition (all tiers)"
if [ -z "$REVIEW_ROWS" ]; then
  ok "no Review/Done tasks to check"
else
  while IFS='|' read -r tid task_status ttype claimed_at app_verification task_lifecycle lifecycle_reason docs_classification; do
    [ -n "$tid" ] || continue
    if [ "$task_lifecycle" != "current" ] && [ "$task_lifecycle" != "legacy" ]; then
      drift "$tid ($task_status) — invalid app-verification lifecycle: ${task_lifecycle:-missing}"
      continue
    fi
    if [ "$task_lifecycle" = "legacy" ]; then
      ok "$tid ($task_status) — application verification not required for legacy task"
      continue
    fi
    if [ "$ttype" = "docs" ]; then
      case "$docs_classification" in
        verified:*) ok "$tid ($task_status, Type: docs) — verified docs-only scope does not require application verification" ;;
        *) drift "$tid ($task_status, Type: docs) — docs-only classifier failed closed: ${docs_classification#invalid:}" ;;
      esac
      continue
    fi
    case "$app_verification" in
      required)
        app_block=$($ROOT/scripts/feature-control review-evidence "$SLUG" "$tid" app 2>/dev/null)
        if [ "$?" -ne 0 ] || [ -z "$app_block" ]; then
          drift "$tid ($task_status) — Application verification: required but latest evidence has no application verification block"
          continue
        fi
        if ! printf '%s\n' "$app_block" | python3 -c '
import re, sys
text = sys.stdin.read()
required = ("Real server start", "Index curl", "Port check", "Environment/config cross-check", "Result")
values = {}
for label in required:
    matches = re.findall(rf"(?mi)^\s*-\s*{re.escape(label)}:\s*(.*?)\s*$", text)
    if len(matches) != 1 or (label != "Result" and not matches[0]):
        raise SystemExit(1)
    values[label] = matches[0]
if not re.fullmatch(r"(?i)PASS\.?", values["Result"]):
    raise SystemExit(1)
'; then
          drift "$tid ($task_status) — application verification block needs one exact server/curl/port/env field set and Result: PASS (duplicates/contradictions are forbidden)"
          continue
        fi
        ok "$tid ($task_status) — application verification evidence records server/curl/port/env checks"
        ;;
      not-applicable\ —\ *|not-applicable\ -\ *)
        ok "$tid ($task_status) — application verification explicitly not applicable: ${app_verification#* — }"
        ;;
      *)
        drift "$tid ($task_status) — set 'Application verification: required' or 'not-applicable — <specific reason>'"
        ;;
    esac
  done <<< "$REVIEW_ROWS"
fi

# Historical pre-receipt Review-stage implementations were removed here.
# The all-tier sections above are now the single enforcement path: they use
# committed-history adoption, newest exact-task evidence, and scoped tracked
# receipts instead of candidate-authored dates or gitignored transcripts.
# 9. Worktree hygiene — dirty tree with no Claimed owner or with paths
# outside the Claimed task's file ownership is drift. The hygiene check
# is a pure reporter; we mirror its verdict into our drift counter so a
# single reconcile run surfaces all coordination problems.
section "Worktree hygiene"
if [ -x "$ROOT/scripts/worktree-hygiene" ]; then
  hygiene_output=$("$ROOT/scripts/worktree-hygiene" "$SLUG" 2>&1)
  hygiene_exit=$?
  case "$hygiene_exit" in
    0)
      ok "CLEAN or DIRTY_OWNED (within current Claimed task ownership)"
      ;;
    1)
      drift "worktree DIRTY_NO_TASK — dirty paths exist with no Claimed task; reviewers/adversary would see unowned changes. Run scripts/worktree-hygiene $SLUG for details."
      ;;
    2)
      drift "worktree DIRTY_MIXED — dirty paths include files outside the Claimed task's Intended file ownership; reviewer/qa/adversary scope is polluted. Run scripts/worktree-hygiene $SLUG for details."
      ;;
    *)
      drift "worktree-hygiene exited $hygiene_exit (unexpected). Output:"
      printf '%s\n' "$hygiene_output" | sed 's/^/    /'
      ;;
  esac
else
  printf '  INFO: scripts/worktree-hygiene not found or not executable; skipping.\n'
fi

# --- Diff-touches-paths within owning task(s) -------------------------------
# Added 2026-05-27 in response to the review-fix postmortem (P2: code
# landed while owning tasks remained Backlog/unclaimed, letting the
# "Adversarial review trail for Done tasks" check pass vacuously).
#
# For every code-bearing path touched in the diff vs the configured base,
# find the owning task(s) in TASKS.md ("Intended file ownership"
# blocks). Fail with `drift` if the owning task is Backlog or Open
# (not yet claimed); Claimed / Review / Done are accepted. Paths
# with no owning task in TASKS.md emit an INFO line rather than a
# drift (some repo paths legitimately fall outside the per-task
# ownership map — e.g., framework-evolution edits).
section "Diff-touches-paths within owning task(s)"
if ! command -v git >/dev/null 2>&1; then
  printf '  INFO: git not on PATH; skipping diff-vs-task-state check.\n'
else
  BASE="${BASE_REF:-${SDLC_BASE_BRANCH:-master}}"
  if ! git rev-parse --verify --quiet "$BASE" >/dev/null 2>&1 &&
     git rev-parse --verify --quiet "origin/$BASE" >/dev/null 2>&1; then
    BASE="origin/$BASE"
  fi
  if ! git rev-parse --verify --quiet "$BASE" >/dev/null 2>&1; then
    printf '  INFO: base ref %s not present; skipping diff-vs-task-state check.\n' "$BASE"
  else
    # Code-bearing roots are adopter-owned configuration. The portable default
    # covers the harness engine only; projects can add app/service paths or use
    # ALL to scan every changed path.
    CODE_ROOTS_STR="${SDLC_CODE_BEARING_ROOTS:-scripts/*}"
    IFS=' ' read -r -a CODE_ROOTS <<< "$CODE_ROOTS_STR"
    if [ "$CODE_ROOTS_STR" = "ALL" ]; then
      touched=$(git diff --name-only "$BASE"...HEAD 2>/dev/null || true)
    else
      touched=$(git diff --name-only "$BASE"...HEAD -- "${CODE_ROOTS[@]}" 2>/dev/null || true)
    fi
    if [ -z "$touched" ]; then
      ok "no code-bearing diff vs $BASE"
    else
      tasks_file="$DIR/TASKS.md"
      drift_paths=()
      info_paths=()
      FRAMEWORK_IGNORES=(
        "scripts/feature-*"
        "scripts/lib-*"
        "scripts/worktree-hygiene"
        "scripts/adversary-review"
        "scripts/claude-adversary-review"
        "scripts/agent-capsule-*"
        "scripts/codex-capsule-run"
        "scripts/claude-capsule-run"
        "scripts/security-review"
        "scripts/sdlc-doctor"
        "scripts/test-framework-v3"
        "scripts/test-feature-*"
        "scripts/sanitize-check"
        "scripts/load-config"
        "scripts/log-decision"
        "scripts/preflight-credentials"
        "scripts/verify-app-change"
      )
      if [ -n "${SDLC_RECONCILE_PATH_IGNORE:-}" ]; then
        while IFS= read -r pattern; do
          [ -n "$pattern" ] && FRAMEWORK_IGNORES+=("$pattern")
        done <<< "$SDLC_RECONCILE_PATH_IGNORE"
      fi
      while IFS= read -r path; do
        [ -z "$path" ] && continue
        ignored=0
        for pattern in "${FRAMEWORK_IGNORES[@]}"; do
          # shellcheck disable=SC2053
          case "$path" in $pattern) ignored=1; break ;; esac
        done
        [ "$ignored" -eq 1 ] && continue
        # Find the owning task: any block whose "Intended file ownership"
        # bullets include this path (literal substring match — sufficient
        # for the first-iteration check; tighten with anchors as needed).
        owning_tasks=$(awk -v p="$path" '
          /^### TASK-[0-9]+/ { task=$0; instatus=0 }
          /^- Status: / && task != "" { status=$0 }
          /^- Intended file ownership:/ { inown=1; next }
          inown && /^- / { inown=0 }
          inown && index($0, p) > 0 {
            printf "%s|%s\n", task, status
            inown=0
          }
        ' "$tasks_file" 2>/dev/null)
        if [ -z "$owning_tasks" ]; then
          info_paths+=("$path")
          continue
        fi
        # If ANY owning task is at least Claimed, the path is OK.
        ok_for_path=0
        while IFS= read -r row; do
          status_line=$(printf '%s' "$row" | sed -n 's/.*|//p')
          case "$status_line" in
            *"Status: Claimed"*|*"Status: Review"*|*"Status: Done"*|*"Status: Blocked"*)
              ok_for_path=1
              break
              ;;
          esac
        done <<< "$owning_tasks"
        if [ "$ok_for_path" -eq 0 ]; then
          # Pull the first task id for the drift message.
          first_task=$(printf '%s' "$owning_tasks" | head -n1 | sed -n 's/^### \([^:]*\).*/\1/p')
          drift_paths+=("$path → $first_task (Backlog/Open — should be Claimed or later before code lands)")
        fi
      done <<< "$touched"
      if [ "${#drift_paths[@]}" -gt 0 ]; then
        drift "${#drift_paths[@]} code-bearing path(s) touch task(s) still in Backlog/Open:"
        for p in "${drift_paths[@]}"; do
          printf '    %s\n' "$p"
        done
      else
        ok "all code-bearing diff paths owned by a Claimed/Review/Done task (or unowned)"
      fi
      if [ "${#info_paths[@]}" -gt 0 ]; then
        printf '  INFO: %d path(s) touch no TASKS.md "Intended file ownership" entry (legitimate for framework / control-plane edits):\n' "${#info_paths[@]}"
        for p in "${info_paths[@]}"; do
          printf '    %s\n' "$p"
        done
      fi
    fi
  fi
fi

section "Result"
if [ "$DRIFT" -eq 0 ]; then
  printf 'feature-reconcile passed: no drift detected\n'
  exit 0
fi

printf 'feature-reconcile detected %d drift point(s) — invoke planner (Phase: plan) to reconcile\n' "$DRIFT"
printf '\n'
printf 'Current code-bearing Review/Done tasks cannot bypass the committed-history\n'
printf 'receipt/evidence gates. Retry the opposite-tool reviewer or keep the task\n'
printf 'blocked until a tracked scoped clear receipt is available.\n'
exit 1
