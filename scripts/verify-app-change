#!/usr/bin/env python3
"""Run the owner-required real-server smoke without printing env values.

Profiles invoke this helper with an actual server command after ``--``.  It
checks the port is initially free, confirms declared environment keys are
present in both the env file and runtime config, starts the server in its own
process group, curls the index URL, confirms the listener, and proves cleanup.
"""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import re
import signal
import socket
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request


ROOT = Path(__file__).resolve().parent.parent
MAX_CONFIG_BYTES = 2 * 1024 * 1024
MAX_BODY_BYTES = 1024 * 1024
KEY_RE = re.compile(r"[A-Z][A-Z0-9_]*")


class SmokeError(RuntimeError):
    pass


class SameOriginRedirectHandler(urllib.request.HTTPRedirectHandler):
    def __init__(self, origin: tuple[str, str, int]) -> None:
        super().__init__()
        self.origin = origin

    def redirect_request(self, req, fp, code, msg, headers, newurl):  # type: ignore[no-untyped-def]
        target = urllib.parse.urlsplit(urllib.parse.urljoin(req.full_url, newurl))
        try:
            target_port = target.port or 80
        except ValueError as exc:
            raise SmokeError("index redirect contains an invalid port") from exc
        if (target.scheme, target.hostname or "", target_port) != self.origin:
            raise SmokeError("index redirect leaves the declared local origin")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def regular_repo_file(value: str, label: str) -> Path:
    raw = ROOT / value
    try:
        raw_meta = raw.lstat()
    except FileNotFoundError as exc:
        raise SmokeError(f"{label} is missing: {value}") from exc
    if not stat.S_ISREG(raw_meta.st_mode):
        raise SmokeError(f"{label} is a symlink/non-regular file: {value}")
    candidate = raw.resolve()
    try:
        candidate.relative_to(ROOT)
    except ValueError as exc:
        raise SmokeError(f"{label} escapes repository root") from exc
    meta = candidate.lstat()
    if not stat.S_ISREG(meta.st_mode) or meta.st_size > MAX_CONFIG_BYTES:
        raise SmokeError(f"{label} is not a bounded regular file: {value}")
    return candidate


def port_open(port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
        probe.settimeout(0.25)
        return probe.connect_ex(("127.0.0.1", port)) == 0


def lsof_listener(port: int) -> bool | None:
    if not shutil_which("lsof"):
        return None
    result = subprocess.run(
        ["lsof", "-nP", "-tiTCP:" + str(port), "-sTCP:LISTEN"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
        timeout=5,
    )
    return result.returncode == 0 and bool(result.stdout.strip())


def shutil_which(command: str) -> str | None:
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        path = os.path.join(directory, command)
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return None


def check_env_config(env_file: Path | None, config_file: Path | None, keys: list[str]) -> None:
    if not keys:
        if env_file or config_file:
            raise SmokeError("--env-file/--config-file require at least one --env-key")
        print("PASS: Environment/config cross-check — not declared")
        return
    if env_file is None or config_file is None:
        raise SmokeError("every --env-key requires both --env-file and --config-file")
    env_text = env_file.read_text(encoding="utf-8")
    config_text = config_file.read_text(encoding="utf-8")
    declared = {
        match.group(1)
        for line in env_text.splitlines()
        if (match := re.match(r"^([A-Z][A-Z0-9_]*)=", line))
    }
    for key in keys:
        if key not in declared:
            raise SmokeError(f"environment/config key is absent from env file: {key}")
        if not re.search(rf"(?<![A-Z0-9_]){re.escape(key)}(?![A-Z0-9_])", config_text):
            raise SmokeError(f"environment/config key is not referenced by config: {key}")
    print(f"PASS: Environment/config cross-check — {len(keys)} key name(s) matched (values not printed)")


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--url", required=True)
    parser.add_argument("--port", required=True, type=int)
    parser.add_argument("--env-file")
    parser.add_argument("--config-file")
    parser.add_argument("--env-key", action="append", default=[])
    parser.add_argument("--expect", required=True)
    parser.add_argument("--timeout", type=float, default=30.0)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args(argv[1:])
    if args.command and args.command[0] == "--":
        args.command = args.command[1:]
    if not args.command:
        parser.error("a real server command is required after --")
    if not 1 <= args.port <= 65535 or not 1 <= args.timeout <= 300:
        parser.error("--port/--timeout is out of range")
    if any(not KEY_RE.fullmatch(key) for key in args.env_key) or len(set(args.env_key)) != len(args.env_key):
        parser.error("--env-key values must be unique uppercase environment names")
    if (
        not args.expect.strip()
        or len(args.expect.encode("utf-8")) > 4096
        or any(ord(char) < 32 or ord(char) == 127 for char in args.expect)
    ):
        parser.error("--expect must be a nonblank public marker of at most 4096 UTF-8 bytes without control characters")
    parsed_url = urllib.parse.urlsplit(args.url)
    if (
        parsed_url.scheme != "http"
        or parsed_url.hostname not in {"127.0.0.1", "localhost"}
        or parsed_url.username is not None
        or parsed_url.password is not None
    ):
        parser.error("--url must be a local http://127.0.0.1 or localhost URL")
    try:
        url_port = parsed_url.port or 80
    except ValueError:
        parser.error("--url contains an invalid port")
    if url_port != args.port:
        parser.error("--url port must exactly match --port")
    opener = urllib.request.build_opener(
        urllib.request.ProxyHandler({}),
        SameOriginRedirectHandler((parsed_url.scheme, parsed_url.hostname or "", url_port))
    )

    env_file = regular_repo_file(args.env_file, "env file") if args.env_file else None
    config_file = regular_repo_file(args.config_file, "config file") if args.config_file else None
    check_env_config(env_file, config_file, args.env_key)

    if port_open(args.port) or lsof_listener(args.port) is True:
        raise SmokeError(f"port {args.port} is already in use before server start")
    print(f"PASS: Port check — {args.port} is free before start")

    process = subprocess.Popen(
        args.command,
        cwd=ROOT,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    try:
        deadline = time.monotonic() + args.timeout
        body = b""
        status = 0
        while time.monotonic() < deadline:
            if process.poll() is not None:
                raise SmokeError(f"real server exited before readiness (exit {process.returncode})")
            try:
                with opener.open(args.url, timeout=1.0) as response:
                    status = response.status
                    body = response.read(MAX_BODY_BYTES + 1)
                if 200 <= status < 300:
                    break
            except (urllib.error.URLError, TimeoutError):
                pass
            time.sleep(0.2)
        else:
            raise SmokeError(f"index curl did not reach a 2xx response within {args.timeout:g}s")
        if len(body) > MAX_BODY_BYTES:
            raise SmokeError("index response exceeds 1 MiB smoke limit")
        if args.expect.encode("utf-8") not in body:
            raise SmokeError("index curl response is missing the expected public marker")
        print("PASS: Real server start — readiness reached")
        print(f"PASS: Index curl — HTTP {status} with expected marker")
        if not port_open(args.port):
            raise SmokeError(f"port {args.port} is not accepting connections after readiness")
        lsof_state = lsof_listener(args.port)
        if lsof_state is False:
            raise SmokeError(f"lsof found no listener on expected port {args.port}")
        method = "lsof + socket" if lsof_state is True else "socket (lsof unavailable)"
        print(f"PASS: Port check — expected listener confirmed via {method}")
    finally:
        if process.poll() is None:
            os.killpg(process.pid, signal.SIGTERM)
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait(timeout=5)
        cleanup_deadline = time.monotonic() + 5
        while time.monotonic() < cleanup_deadline and port_open(args.port):
            time.sleep(0.1)
        if port_open(args.port):
            raise SmokeError(f"port {args.port} remains in use after server cleanup")
    print("PASS: Port check — listener cleaned up")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except (OSError, UnicodeError, SmokeError, subprocess.SubprocessError) as exc:
        print(f"verify-app-change: {exc}", file=sys.stderr)
        raise SystemExit(1)
