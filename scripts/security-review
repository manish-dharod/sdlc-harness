#!/usr/bin/env bash
# scripts/security-review — sanctioned wrapper to invoke Codex CLI as a
# different-model security reviewer for the the SDLC harness SDLC.
#
# Mirrors scripts/adversary-review's safety model:
#   - Pre-tool guard hook blocks raw `codex` / `codex exec` from Claude.
#   - This script runs as a child process; its internal `codex exec` call
#     is not re-checked by the hook.
#   - Sanitization tripwire scans the ENTIRE assembled prompt before
#     sending; refuses to call Codex if a secret-shaped string is found.
#
# Why a SEPARATE wrapper instead of one generic codex wrapper:
#   - Security review benefits from a different context package than
#     adversarial review: THREAT_MODEL.md + MIGRATION_PLAN.md +
#     APPROVALS.md + RELEASE_GATES.md, plus the STRIDE-categorized
#     output schema and the framework's security severity rubric.
#   - Cross-model value is highest where assumption-sharing is the
#     failure mode; security defects (webhook bypass, PII leak, swapped
#     ID mapping) are exactly that class.
#
# Usage:
#   scripts/security-review <feature-slug> [task-id] [mode] [base-assertion] <implementer-model>
#
# Args:
#   feature-slug   required; must match docs/features/<slug>/
#   task-id        optional; narrows context to that task
#   mode           optional; review (default) | review-strict |
#                  review-resume | review-narrow
#                    review:        standard security pass
#                    review-strict: extra emphasis on launch-gate +
#                                   external-traffic + flag defaults
#   base-assertion optional derived-base assertion; legacy tasks may override
#   implementer-model required fifth positional; Claude model that authored candidate
#
# Exit codes:
#   0 — codex ran; security review captured to a gitignored local artifact
#   2 — codex CLI unavailable; sdlc-security should fall back to direct review
#   3 — usage error / feature dir missing
#   4 — sanitization tripwire fired
# 124 — reviewer timeout; 130/143 — wrapper interrupted/terminated

set -u
set -o pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 3
export GIT_NO_REPLACE_OBJECTS=1
for git_redirect in GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_SHALLOW_FILE GIT_NAMESPACE; do
  unset "$git_redirect"
done

for gate_var in SDLC_CONFIG_FILE SDLC_BASE_BRANCH SDLC_CODEX_SECURITY_REQUIRED_MODEL SDLC_CODEX_ADVERSARY_REQUIRED_MODEL; do
  if printenv "$gate_var" >/dev/null 2>&1; then
    printf 'scripts/security-review: ambient %s is not accepted for review gate control; use committed sdlc.config.yml and positional base assertion arg 4.\n' "$gate_var" >&2
    exit 3
  fi
done

SLUG="${1:-}"
TASK_ID="${2:-}"
MODE="${3:-review}"
BASE_OVERRIDE="${4:-}"
IMPLEMENTER_MODEL_ARG="${5:-}"

usage() {
  cat <<'EOF'
Usage: scripts/security-review <feature-slug> [task-id] [mode] [base-assertion] <implementer-model>

  feature-slug   required; must match docs/features/<slug>/
  task-id        optional; narrows context to that task
                 (e.g. TASK-051, PLATFORM-010, QA-030)
  mode           optional; review (default) | review-strict | review-resume | review-narrow
                   review:        standard security review pass
                   review-strict: extra emphasis on launch-gate + external traffic
                                  + flag-default + production-readiness
                   review-resume: retry after timeout/invalid output with
                                  reduced context and prior-attempt metadata
                   review-narrow: final focused retry with prior metadata
  base-assertion optional base assertion. Post-cutoff task reviews derive an
                 immutable claim commit; feature reviews derive the configured
                 integration merge base. The assertion must resolve exactly to
                 that derived commit. Legacy tasks retain merge-base override
                 compatibility.
  implementer-model
                 required fifth positional. Name the Claude model that authored
                 the committed candidate; pass "" as base to use the default.

Exit codes:
  0 — codex ran; security artifact written
  2 — codex CLI unavailable; agent should fall back to direct security review
  3 — usage error
  4 — sanitization tripwire fired
  124 — reviewer timeout; 130/143 — wrapper interrupted/terminated

Environment:
  SECURITY_REVIEW_TIMEOUT_SECONDS=<seconds>
      bounds reviewer runtime. Defaults to 300. Set to 0 to disable.
  Implementer tool is derived as claude-code. Ambient implementer identity
      variables are rejected.
  Canonical task diffs have one immutable 280000-byte ceiling in every mode;
      retries change routing/focus, never the reviewed diff. Oversized diffs
      fail closed rather than issue a partial receipt; prompts cap at 400000.
EOF
}

if [ -z "$SLUG" ] || [ "$SLUG" = "-h" ] || [ "$SLUG" = "--help" ]; then
  usage
  exit 3
fi

if [[ ! "$SLUG" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]]; then
  printf 'scripts/security-review: invalid feature slug: %s\n' "$SLUG" >&2
  exit 3
fi

if [ "$#" -gt 5 ]; then
  usage >&2
  exit 3
fi

case "$MODE" in
  review|review-strict|review-resume|review-narrow) ;;
  *)
    printf 'Unknown mode: %s (expected: review | review-strict | review-resume | review-narrow)\n' "$MODE" >&2
    usage >&2
    exit 3
    ;;
esac

DIR="docs/features/$SLUG"
if [ ! -d "$DIR" ]; then
  printf 'Feature not found: %s\n' "$DIR" >&2
  exit 3
fi

TIER_FILE="$DIR/.tier"
TIER="large"

# Resolution order (per `principle-encode-lessons-in-structure`):
#   1. $CODEX_BIN  (explicit override)
#   2. Highest-version codex under ~/.nvm/versions/node/*/bin
#   3. `codex` from PATH (legacy)
CODEX_CMD=""
if [ -n "${CODEX_BIN:-}" ]; then
  if [ -x "$CODEX_BIN" ]; then
    CODEX_CMD="$CODEX_BIN"
  else
    printf 'scripts/security-review: CODEX_BIN=%s is not executable.\n' "$CODEX_BIN" >&2
    exit 2
  fi
fi
if [ -z "$CODEX_CMD" ] && [ -d "$HOME/.nvm/versions/node" ]; then
  best_ver=""
  best_path=""
  for nv in "$HOME"/.nvm/versions/node/*/bin/codex; do
    [ -x "$nv" ] || continue
    pkg="${nv%/bin/codex}/lib/node_modules/@openai/codex/package.json"
    [ -f "$pkg" ] || continue
    ver=$(awk -F'"' '/"version":/ {print $4; exit}' "$pkg" 2>/dev/null)
    [ -n "$ver" ] || continue
    if [ -z "$best_ver" ] || [ "$(printf '%s\n%s\n' "$best_ver" "$ver" | sort -V | tail -1)" = "$ver" ]; then
      best_ver="$ver"
      best_path="$nv"
    fi
  done
  if [ -n "$best_path" ]; then
    CODEX_CMD="$best_path"
  fi
fi
if [ -z "$CODEX_CMD" ]; then
  if command -v codex >/dev/null 2>&1; then
    CODEX_CMD="codex"
  fi
fi
if [ -z "$CODEX_CMD" ]; then
  cat <<'EOF' >&2
scripts/security-review: codex CLI not on PATH and CODEX_BIN not set.

This wrapper is the sanctioned path for Codex-backed security review.
Without Codex, the sdlc-security agent should fall back to direct
Claude-internal security review and note the limitation in EVIDENCE.md.

Install Codex CLI via:
  npm install -g @openai/codex

Or run sdlc-security directly via the Task tool without --codex.
EOF
  exit 2
fi

TS=$(date -u +%Y-%m-%dT%H%M%SZ)
STARTED_EPOCH=$(date +%s)
OUT_FILE=""
SIDECAR_FILE=""
RECEIPT_FILE=""

if [ -n "${BASE_REF:-}" ]; then
  printf 'scripts/security-review: BASE_REF is no longer accepted. Pass the derived base assertion as the fourth positional argument.\n' >&2
  exit 3
fi
if [ -n "$BASE_OVERRIDE" ] && [[ ! "$BASE_OVERRIDE" =~ ^[A-Za-z0-9][A-Za-z0-9._/@{}^~:+-]*$ ]]; then
  printf 'scripts/security-review: invalid positional base assertion: %s\n' "$BASE_OVERRIDE" >&2
  exit 3
fi
HEAD_SHA=$(git rev-parse --verify 'HEAD^{commit}' 2>/dev/null) || {
  printf 'scripts/security-review: HEAD does not resolve to a commit.\n' >&2
  exit 3
}
SCOPE_TASK="${TASK_ID:-feature}"
SDLC_BASE_BRANCH=$(python3 "$ROOT/scripts/lib-review-scope.py" config-value "$HEAD_SHA" SDLC_BASE_BRANCH) || exit 3
[ -n "$SDLC_BASE_BRANCH" ] || SDLC_BASE_BRANCH="master"
if [[ ! "$SDLC_BASE_BRANCH" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]]; then
  printf 'scripts/security-review: committed SDLC_BASE_BRANCH is invalid: %s\n' "$SDLC_BASE_BRANCH" >&2
  exit 3
fi
if git rev-parse --verify --quiet "origin/${SDLC_BASE_BRANCH}^{commit}" >/dev/null 2>&1; then
  INTEGRATION_SOURCE_REF="origin/$SDLC_BASE_BRANCH"
elif git rev-parse --verify --quiet "${SDLC_BASE_BRANCH}^{commit}" >/dev/null 2>&1; then
  INTEGRATION_SOURCE_REF="$SDLC_BASE_BRANCH"
else
  printf 'scripts/security-review: configured base does not resolve: origin/%s or %s\n' "$SDLC_BASE_BRANCH" "$SDLC_BASE_BRANCH" >&2
  exit 3
fi
INTEGRATION_TIP_SHA=$(git rev-parse --verify "${INTEGRATION_SOURCE_REF}^{commit}" 2>/dev/null) || {
  printf 'scripts/security-review: configured integration ref does not resolve to a commit: %s\n' "$INTEGRATION_SOURCE_REF" >&2
  exit 3
}
INTEGRATION_BASE_SHA=$(git merge-base "$HEAD_SHA" "$INTEGRATION_TIP_SHA" 2>/dev/null) || {
  printf 'scripts/security-review: no merge base between HEAD and %s; refusing an unbound review.\n' "$INTEGRATION_SOURCE_REF" >&2
  exit 3
}
DERIVED_REVIEW_BASE=$(python3 "$ROOT/scripts/lib-review-scope.py" review-base \
  "$SLUG" "$SCOPE_TASK" "$INTEGRATION_BASE_SHA" "$HEAD_SHA") || exit 3
if [ "$DERIVED_REVIEW_BASE" = "legacy" ]; then
  BASE_SOURCE_REF="${BASE_OVERRIDE:-$INTEGRATION_SOURCE_REF}"
  BASE_TIP_SHA=$(git rev-parse --verify "${BASE_SOURCE_REF}^{commit}" 2>/dev/null) || {
    printf 'scripts/security-review: legacy positional base does not resolve to a commit: %s\n' "$BASE_SOURCE_REF" >&2
    exit 3
  }
  BASE_SHA=$(git merge-base "$HEAD_SHA" "$BASE_TIP_SHA" 2>/dev/null) || {
    printf 'scripts/security-review: no merge base between HEAD and legacy base %s.\n' "$BASE_SOURCE_REF" >&2
    exit 3
  }
else
  BASE_SHA="$DERIVED_REVIEW_BASE"
  BASE_SOURCE_REF="$BASE_SHA"
  if [ -n "$BASE_OVERRIDE" ]; then
    ASSERTED_BASE_SHA=$(git rev-parse --verify "${BASE_OVERRIDE}^{commit}" 2>/dev/null) || {
      printf 'scripts/security-review: positional base assertion does not resolve to a commit: %s\n' "$BASE_OVERRIDE" >&2
      exit 3
    }
    if [ "$ASSERTED_BASE_SHA" != "$BASE_SHA" ]; then
      printf 'scripts/security-review: positional base assertion %s resolves to %s, expected derived review base %s.\n' "$BASE_OVERRIDE" "$ASSERTED_BASE_SHA" "$BASE_SHA" >&2
      exit 3
    fi
  fi
fi
candidate_blob() {
  GIT_NO_REPLACE_OBJECTS=1 git cat-file -p "$HEAD_SHA:$1" 2>/dev/null
}
candidate_blob_exists() {
  GIT_NO_REPLACE_OBJECTS=1 git cat-file -e "$HEAD_SHA:$1" 2>/dev/null
}
candidate_tier=$(candidate_blob "$DIR/.tier" 2>/dev/null | tr -d '[:space:]' || true)
case "$candidate_tier" in small|medium|large) TIER="$candidate_tier" ;; esac
if [ -n "${SECURITY_REVIEW_IMPLEMENTER_TOOL:-}" ]; then
  printf 'scripts/security-review: SECURITY_REVIEW_IMPLEMENTER_TOOL is not accepted; this cross-model entrypoint derives claude-code.\n' >&2
  exit 3
fi
IMPLEMENTER_TOOL="claude-code"
if [ -n "${SECURITY_REVIEW_IMPLEMENTER_MODEL:-}" ]; then
  printf 'scripts/security-review: SECURITY_REVIEW_IMPLEMENTER_MODEL is not accepted; pass implementer model as the fifth positional argument.\n' >&2
  exit 3
fi
IMPLEMENTER_MODEL="$IMPLEMENTER_MODEL_ARG"
if [ -z "$IMPLEMENTER_MODEL" ] || [ "$IMPLEMENTER_MODEL" = "unknown" ] || [ "$IMPLEMENTER_MODEL" = "n/a" ]; then
  printf 'scripts/security-review: implementer model is required as the fifth positional argument.\n' >&2
  exit 3
fi
if [[ ! "$IMPLEMENTER_MODEL" =~ ^[A-Za-z0-9][A-Za-z0-9._:+/-]*$ ]]; then
  printf 'scripts/security-review: invalid positional implementer model: %s\n' "$IMPLEMENTER_MODEL" >&2
  exit 3
fi
model_matches_tool() {
  local tool="$1"
  local model="$2"
  case "$tool:$model" in
    claude-code:claude|claude-code:claude-*|claude-code:claude.*|claude-code:claude_*) return 0 ;;
    codex-cli:gpt|codex-cli:gpt-*|codex-cli:gpt.*|codex-cli:gpt_*|codex-cli:codex|codex-cli:codex-*|codex-cli:codex.*|codex-cli:codex_*|codex-cli:o[1-9]|codex-cli:o[1-9]-*|codex-cli:o[1-9].*|codex-cli:o[1-9]_*) return 0 ;;
    codex-app:gpt|codex-app:gpt-*|codex-app:gpt.*|codex-app:gpt_*|codex-app:codex|codex-app:codex-*|codex-app:codex.*|codex-app:codex_*|codex-app:o[1-9]|codex-app:o[1-9]-*|codex-app:o[1-9].*|codex-app:o[1-9]_*) return 0 ;;
    *) return 1 ;;
  esac
}
if ! model_matches_tool "$IMPLEMENTER_TOOL" "$IMPLEMENTER_MODEL"; then
  printf 'scripts/security-review: implementer model %s does not match derived implementer tool %s.\n' "$IMPLEMENTER_MODEL" "$IMPLEMENTER_TOOL" >&2
  exit 3
fi

# Sensitive-data sanitizer — sourced from scripts/lib-sanitize.sh,
# shared with scripts/adversary-review and scripts/feature-arena. Covers
# secret / card / CVV / expiry / SSN patterns per SEC-FND-001 from the
# framework-v3 PR security review. We scan the FULL assembled prompt
# below (after all context is concatenated), not just the diff —
# security context naturally pulls in THREAT_MODEL.md and adjacent
# files where stray sensitive values are easy to accidentally include.
# shellcheck source=lib-sanitize.sh
. "$ROOT/scripts/lib-sanitize.sh"

# -------------------------------------------------------------------------
# Build sanitized context
# -------------------------------------------------------------------------

REVIEW_TMP_DIR=""
cleanup_review_temp() {
  local dir="${REVIEW_TMP_DIR:-}"
  local path
  [ -n "$dir" ] || return 0
  if [ -d "$dir" ] && [ ! -L "$dir" ]; then
    for path in scope.json diff.patch prompt.md reviewer-output.md receipt-human.txt whitespace.md; do
      path="$dir/$path"
      if [ -L "$path" ] || [ -f "$path" ]; then
        rm -f -- "$path"
      fi
    done
    rmdir "$dir" 2>/dev/null || true
  fi
}
abort_review_signal() {
  local exit_code="$2"
  trap - INT TERM
  exit "$exit_code"
}
assert_review_temp_file() {
  python3 - "$REVIEW_TMP_DIR" "$1" "$2" <<'PY'
import os, stat, sys
directory, path, expected = sys.argv[1:4]
directory_meta = os.lstat(directory)
if not stat.S_ISDIR(directory_meta.st_mode) or directory_meta.st_uid != os.getuid() or stat.S_IMODE(directory_meta.st_mode) != 0o700:
    raise SystemExit("unsafe review temp directory")
if os.path.dirname(path) != directory:
    raise SystemExit("review temp path escaped private directory")
meta = os.lstat(path)
identity = f"{meta.st_dev}:{meta.st_ino}"
if not stat.S_ISREG(meta.st_mode) or meta.st_uid != os.getuid() or meta.st_nlink != 1 or identity != expected:
    raise SystemExit("review temp file identity changed")
PY
}

REVIEW_TMP_DIR=$(mktemp -d -t security-review.XXXXXX) || {
  printf 'scripts/security-review: could not allocate private review temp directory.\n' >&2
  exit 3
}
trap 'cleanup_review_temp' EXIT
trap 'abort_review_signal INT 130' INT
trap 'abort_review_signal TERM 143' TERM
chmod 700 "$REVIEW_TMP_DIR" || exit 3
SCOPE_FILE="$REVIEW_TMP_DIR/scope.json"
DIFF_FILE="$REVIEW_TMP_DIR/diff.patch"
PROMPT_FILE="$REVIEW_TMP_DIR/prompt.md"
REVIEW_OUTPUT_FILE="$REVIEW_TMP_DIR/reviewer-output.md"
RECEIPT_HUMAN_FILE="$REVIEW_TMP_DIR/receipt-human.txt"
WHITESPACE_FILE="$REVIEW_TMP_DIR/whitespace.md"
TEMP_IDENTITIES=$(python3 - "$REVIEW_TMP_DIR" "$SCOPE_FILE" "$DIFF_FILE" "$PROMPT_FILE" \
  "$REVIEW_OUTPUT_FILE" "$RECEIPT_HUMAN_FILE" "$WHITESPACE_FILE" <<'PY'
import os, stat, sys
directory, *paths = sys.argv[1:]
meta = os.lstat(directory)
if not stat.S_ISDIR(meta.st_mode) or meta.st_uid != os.getuid() or stat.S_IMODE(meta.st_mode) != 0o700:
    raise SystemExit("unsafe review temp directory")
identities = []
for path in paths:
    if os.path.dirname(path) != directory:
        raise SystemExit("review temp path escaped private directory")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(path, flags, 0o600)
    file_meta = os.fstat(fd)
    os.close(fd)
    identities.append(f"{file_meta.st_dev}:{file_meta.st_ino}")
print(" ".join(identities))
PY
) || exit 3
read -r SCOPE_FILE_ID DIFF_FILE_ID PROMPT_FILE_ID REVIEW_OUTPUT_FILE_ID \
  RECEIPT_HUMAN_FILE_ID WHITESPACE_FILE_ID <<< "$TEMP_IDENTITIES"

DIFF_LIMIT=280000
assert_review_temp_file "$SCOPE_FILE" "$SCOPE_FILE_ID" || exit 3
if ! "$ROOT/scripts/review-attempt" scope-json "$SLUG" "$SCOPE_TASK" "$BASE_SHA" "$HEAD_SHA" > "$SCOPE_FILE"; then
  rm -f "$SCOPE_FILE" "$DIFF_FILE"
  exit 3
fi
DIRTY_TASK_SCOPE=""
dirty_status=0
DIRTY_TASK_SCOPE=$("$ROOT/scripts/review-attempt" dirty-scope "$SLUG" "$SCOPE_TASK" "$BASE_SHA" "$HEAD_SHA" 2>&1) || dirty_status=$?
if [ "$dirty_status" -eq 1 ] && [ -n "$DIRTY_TASK_SCOPE" ]; then
  printf 'scripts/security-review: task-scoped staged, unstaged, or untracked changes are outside committed candidate %s:\n%s\n' "$HEAD_SHA" "$DIRTY_TASK_SCOPE" >&2
  printf 'Commit the complete task candidate before cross-model review. Unrelated dirty paths are ignored.\n' >&2
  rm -f "$SCOPE_FILE" "$DIFF_FILE"
  exit 3
elif [ "$dirty_status" -ne 0 ]; then
  printf 'scripts/security-review: could not inspect committed task scope and working-tree state.\n%s\n' "$DIRTY_TASK_SCOPE" >&2
  rm -f "$SCOPE_FILE" "$DIFF_FILE"
  exit 3
fi
assert_review_temp_file "$DIFF_FILE" "$DIFF_FILE_ID" || exit 3
if ! "$ROOT/scripts/review-attempt" canonical-diff "$BASE_SHA" "$HEAD_SHA" "$SLUG" "$SCOPE_TASK" "$DIFF_LIMIT" > "$DIFF_FILE"; then
  rm -f "$SCOPE_FILE" "$DIFF_FILE"
  exit 3
fi
assert_review_temp_file "$SCOPE_FILE" "$SCOPE_FILE_ID" || exit 3
assert_review_temp_file "$DIFF_FILE" "$DIFF_FILE_ID" || exit 3
DIFF_NAMES=$(python3 - "$SCOPE_FILE" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as handle:
    for path in json.load(handle)["changed_paths"]:
        print(path)
PY
)
DIFF_NAMES_WORKTREE="(task-owned worktree clean; committed candidate required)"
DIFF_BYTES=$(LC_ALL=C wc -c < "$DIFF_FILE" | tr -d '[:space:]')
if [ "$DIFF_BYTES" -gt "$DIFF_LIMIT" ]; then
  printf 'scripts/security-review: canonical helper exceeded positional %s-byte limit; refusing to load review context.\n' "$DIFF_LIMIT" >&2
  exit 3
fi
DIFF_FULL=$(cat "$DIFF_FILE")
DIFF_WORKTREE=""
DIFF_HASH=$(shasum -a 256 "$DIFF_FILE" | awk '{print $1}')
DIFF_PATH_COUNT=$(python3 - "$SCOPE_FILE" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as handle:
    print(len(json.load(handle)["changed_paths"]))
PY
)
DIFF_STAT="${DIFF_PATH_COUNT} committed task-scoped path(s); ${DIFF_BYTES} canonical diff bytes"

# Machine-generated Git/content hashes are not user context and may randomly
# contain a card-PAN-shaped decimal run. Render only these trusted values in
# bounded groups for the external-review prompt; keep the raw values above for
# canonical hashes, sidecars, and receipts. User-controlled context remains
# byte-for-byte subject to the sanitizer.
format_trusted_hash_for_prompt() {
  local value="${1:-}"
  case "$value" in
    ''|*[!0-9a-f]*) return 1 ;;
  esac
  case "${#value}" in
    40|64) ;;
    *) return 1 ;;
  esac
  LC_ALL=C awk -v value="$value" 'BEGIN {
    for (i = 1; i <= length(value); i += 8) {
      if (i > 1) printf "-"
      printf "%s", substr(value, i, 8)
    }
    printf "\n"
  }'
}

format_trusted_git_index_lines() {
  LC_ALL=C awk '
    function is_hash(value) {
      return (length(value) == 40 || length(value) == 64) && value ~ /^[0-9a-f]+$/
    }
    function grouped(value, result, i) {
      result = ""
      for (i = 1; i <= length(value); i += 8) {
        if (result != "") result = result "-"
        result = result substr(value, i, 8)
      }
      return result
    }
    index($0, "index ") == 1 {
      count = split($2, ids, /\.\./)
      if (count == 2 && is_hash(ids[1]) && is_hash(ids[2])) {
        suffix = $0
        sub(/^index [^ ]+/, "", suffix)
        print "index " grouped(ids[1]) ".." grouped(ids[2]) suffix
        next
      }
    }
    { print }
  ' "$1"
}

PROMPT_BASE_SHA=$(format_trusted_hash_for_prompt "$BASE_SHA") || exit 3
PROMPT_HEAD_SHA=$(format_trusted_hash_for_prompt "$HEAD_SHA") || exit 3
PROMPT_DIFF_HASH=$(format_trusted_hash_for_prompt "$DIFF_HASH") || exit 3
DIFF_FOR_PROMPT=$(format_trusted_git_index_lines "$DIFF_FILE") || exit 3

ATTEMPT_NUMBER=$("$ROOT/scripts/review-attempt" next-attempt "$SLUG" security "$TASK_ID") || exit 3
PRIOR_RETRYABLE_ATTEMPTS=$("$ROOT/scripts/review-attempt" latest-retryable "$SLUG" "$TASK_ID" security 2>/dev/null || true)

# Task block extraction (same logic as adversary-review).
TASK_BLOCK=""
TASK_SOURCE_FILE=""
case "$TIER" in
  small) TASK_SOURCE_FILE="$DIR/FEATURE.md" ;;
  *)     TASK_SOURCE_FILE="$DIR/TASKS.md" ;;
esac

if [ -n "$TASK_ID" ]; then
  TASK_BLOCK=$(python3 "$ROOT/scripts/lib-review-scope.py" task-block "$SLUG" "$TASK_ID" "$BASE_SHA" "$HEAD_SHA") || exit 3
fi

# DESIGN anchor — security review especially needs the Feature Flag section.
DESIGN_ANCHOR=""
DESIGN_SECTION=""
if [ -n "$TASK_BLOCK" ]; then
  DESIGN_ANCHOR=$(printf '%s\n' "$TASK_BLOCK" | grep -E '^- Design anchor:' | head -1 | sed -E 's/^- Design anchor:[[:space:]]*//')
fi

if [ -n "$DESIGN_ANCHOR" ] && candidate_blob_exists "$DIR/DESIGN.md"; then
  anchor=${DESIGN_ANCHOR#DESIGN.md#}
  DESIGN_SECTION=$(candidate_blob "$DIR/DESIGN.md" | awk -v anchor="$anchor" '
    function to_slug(s,   out) {
      out = tolower(s)
      gsub(/[^a-z0-9]+/, "-", out)
      gsub(/^-+|-+$/, "", out)
      return out
    }
    BEGIN { in_block = 0 }
    /^#+ / {
      if (in_block && match($0, /^#+ /)) exit
      hdr = $0; sub(/^#+ /, "", hdr)
      if (to_slug(hdr) == anchor) { in_block = 1; print; next }
    }
    in_block { print }
  ' | head -200)
fi

# THREAT_MODEL.md content — the strategic baseline for sdlc-security.
# We send the whole file (it's typically short and entirely relevant).
THREAT_MODEL_CONTENT=""
if candidate_blob_exists "$DIR/THREAT_MODEL.md"; then
  THREAT_MODEL_CONTENT=$(candidate_blob "$DIR/THREAT_MODEL.md" | head -400)
fi

# MIGRATION_PLAN.md content — only when the diff touches migrations or DDL.
MIGRATION_PLAN_CONTENT=""
touches_migration=0
if printf '%s\n%s\n' "$DIFF_NAMES" "$DIFF_NAMES_WORKTREE" | grep -qE '(database/migrations/|\.sql$|migrate|schema\.)'; then
  touches_migration=1
fi
if [ "$touches_migration" -eq 1 ] && candidate_blob_exists "$DIR/MIGRATION_PLAN.md"; then
  MIGRATION_PLAN_CONTENT=$(candidate_blob "$DIR/MIGRATION_PLAN.md" | head -400)
fi

# APPROVALS.md slice — what's already gated, so we don't re-file the same gate.
APPROVALS_CONTENT=""
if candidate_blob_exists "$DIR/APPROVALS.md"; then
  APPROVALS_CONTENT=$(candidate_blob "$DIR/APPROVALS.md" | tail -120)
fi

# RELEASE_GATES.md slice — what a finding could move.
RELEASE_GATES_CONTENT=""
if candidate_blob_exists "$DIR/RELEASE_GATES.md"; then
  RELEASE_GATES_CONTENT=$(candidate_blob "$DIR/RELEASE_GATES.md" | head -120)
fi

# Recent EVIDENCE entries (tail) for context on what's been run.
RECENT_EVIDENCE=""
if candidate_blob_exists "$DIR/EVIDENCE.md"; then
  RECENT_EVIDENCE=$(candidate_blob "$DIR/EVIDENCE.md" | tail -150)
elif [ "$TIER" = "small" ] && candidate_blob_exists "$DIR/FEATURE.md"; then
  RECENT_EVIDENCE=$(candidate_blob "$DIR/FEATURE.md" | awk '/^## Evidence$/,0' | head -100)
fi

# Existing security FINDINGS to avoid double-filing.
RELEVANT_FINDINGS=""
FINDINGS_FILE=""
if candidate_blob_exists "$DIR/FINDINGS.md"; then
  FINDINGS_FILE="$DIR/FINDINGS.md"
elif [ "$TIER" = "medium" ] && candidate_blob_exists "$DIR/EVIDENCE.md"; then
  FINDINGS_FILE="$DIR/EVIDENCE.md"
elif [ "$TIER" = "small" ] && candidate_blob_exists "$DIR/FEATURE.md"; then
  FINDINGS_FILE="$DIR/FEATURE.md"
fi

if [ -n "$FINDINGS_FILE" ]; then
  # Prefer security-flavored findings; tail-fallback if none.
  RELEVANT_FINDINGS=$(candidate_blob "$FINDINGS_FILE" | grep -B1 -A14 -E "Source: sdlc-security|THREAT_MODEL ref" 2>/dev/null | head -120)
  if [ -z "$RELEVANT_FINDINGS" ]; then
    RELEVANT_FINDINGS=$(candidate_blob "$FINDINGS_FILE" | tail -80)
  fi
fi

# -------------------------------------------------------------------------
# Build the Codex prompt in a temp file
# -------------------------------------------------------------------------

assert_review_temp_file "$PROMPT_FILE" "$PROMPT_FILE_ID" || exit 3

STRICT_NOTE=""
if [ "$MODE" = "review-strict" ]; then
  STRICT_NOTE='
EXTRA STRICT EMPHASIS for this run:
- Launch gate: every flag default in the diff must be OFF in production.
  Verify every new flag, every new env var, every new config toggle.
- External traffic: any real production-side-effect path must remain disabled
  pending explicit launch approval + safe-environment evidence in EVIDENCE.md.
- Production-readiness: do not bless any "works in local/mock" claim as
  production-ready. Local pass != production pass.
- Rollback: every schema/data change must have a rollback DDL or a
  documented forward-only rationale.
'
fi

RESUME_NOTE=""
case "$MODE" in
  review-resume|review-narrow)
    RESUME_NOTE="
RESUME / RETRY MODE:
- This is attempt ${ATTEMPT_NUMBER} after a previous cross-model security
  review timed out, was unavailable, or produced invalid/incomplete output.
- Prior retryable attempt metadata:
${PRIOR_RETRYABLE_ATTEMPTS:-  (none found; proceed as a bounded retry)}
- Keep the verdict machine-readable. The wrapper will reject this artifact
  unless the final Verdict block contains one of the exact expected verdict
  enum lines.
- Focus first on the changed files, threat-model deltas, approvals, and the
  smallest concrete hypotheses that could change the security verdict.
"
    ;;
esac

cat > "$PROMPT_FILE" <<EOF
You are a SECURITY REVIEWER for the the SDLC harness feature SDLC, invoked
via the sanctioned cross-model wrapper (scripts/security-review). You are
NOT the original implementer and NOT the style/correctness reviewer
(sdlc-reviewer). Your role is the security-and-launch-gate perspective:
PCI / secrets / PII / auth / webhook / migration / launch-gate risk.

The framework's security rubric (apply this — do NOT use a generic one):

  P0 — raw secrets / PCI / PII exposure, production-side-effect gate
       failing, signature bypass, auth bypass, credentials in repo or
       logs, swapped ID mapping in migration.
  P1 — missing replay/idempotency, weak validation, log/cache leakage,
       missing rate-limit, dependency known-vuln, threat-model gap.
  P2/P3 — hardening opportunities without active exploit risk.

Categories you MUST consider (in order):

  1. pci-card-handling     — raw PAN/CVV/expiry, hosted-iframe scope,
                             secrets vault proxy boundaries, token storage
                             at rest, log redaction.
  2. secrets               — hardcoded credentials, .env leaks, tokens,
                             auth headers, passphrases, webhook signing
                             secrets in code/logs/screenshots/evidence.
  3. pii                   — customer data in logs, screenshots, doc
                             artifacts, error messages, browser storage,
                             DB dumps.
  4. auth-session          — bypasses, scope expansion, missing CSRF/
                             idempotency, session pinning, privilege
                             checks.
  5. webhook-validation    — signature checks, replay protection,
                             idempotency keys, timing safety.
  6. logging-cache         — sensitive fields in error logs, browser
                             local/session storage, response caches,
                             unsafe window globals.
  7. dependency-config     — new packages, version downgrades,
                             permission widening, scope of new MCP/API
                             access.
  8. migration-safety      — ID-mapping correctness (no swapped values),
                             NOT NULL backfill safety, FK cascade
                             surprises, lock duration, rollback DDL.
                             Only relevant if diff touches migrations.
  9. launch-gate           — production side-effect flags, launch flag
                             defaults (must default OFF), rollback path,
                             scope of approved environment/integration.
10. threat-model-coverage — for each diff hunk, identify which
                             THREAT_MODEL.md threat it relates to. If
                             the diff opens a NEW attack surface not in
                             the threat model, that is a P1 "Threat
                             model gap" finding.
${STRICT_NOTE}
${RESUME_NOTE}

For each category, either:
  - Form a CONCRETE security hypothesis (specific exploit / operator
    error / data leak path), or
  - Say "n/a for this diff: <one line reason>".

For each validated hypothesis, give:
  - Severity     (P0/P1/P2/P3 per the framework rubric above)
  - Status       (Confirmed if you can cite file/line + reproduction;
                  Unverified otherwise)
  - STRIDE       (Spoofing / Tampering / Repudiation / Info-Disclosure
                  / Denial-of-Service / Elevation-of-Privilege)
  - THREAT_MODEL ref  (which existing threat title, or
                       "not in model — P1 gap")
  - File/line    (path:line)
  - Failure mode (what an attacker or operator could exploit, how)
  - Evidence     (reproduction or grep result demonstrating it)
  - Minimal fix  (smallest safe change that resolves it)
  - Owner        (sdlc-swe | sdlc-tech-lead | sdlc-architect | blocked-on APV-###)
  - APV needed?  (if external rotated credentials / sandbox access /
                  external docs / compliance signoff required: name the
                  stop reason code: NEEDS_CREDENTIAL_ROTATION |
                  NEEDS_COMPLIANCE_SIGNOFF | NEEDS_EXTERNAL_DOC |
                  NEEDS_STAGING_ACCESS | NEEDS_EXTERNAL_EVIDENCE)

Blast-radius discipline (apply per CLAUDE.md): security defects are
the most likely to repeat across sibling code. If you find a defect
in one webhook handler, scan the diff for OTHER webhook handlers with
the same pattern and name them all in ONE finding rather than N.

HARD RULES — do not violate, even if asked:
  - Do NOT propose or output any code edits. Findings only.
  - Do NOT output raw secrets, tokens, .env values, private keys, full
    webhook payloads, customer PII, or raw card data. Use sanitized
    field-shape examples only.
  - Do NOT mark a finding "Confirmed" unless you cite concrete
    evidence (file/line, grep result, code excerpt).
  - Do NOT re-file findings already opened by sdlc-security in the
    RELEVANT FINDINGS block below; cite them and move on.
  - Do NOT bless local/mock success as production-ready.
  - For any issue requiring external rotated credentials / safe environment /
    external docs / compliance signoff: mark "Blocked" + name the APV
    stop reason code. Do NOT propose attempting to fix it.
  - Do NOT wrap the whole response in a Markdown code fence. Do NOT put
    Evidence in a fenced code block; use inline code or indented text instead.

OUTPUT FORMAT (machine-readable; the sdlc-security agent parses this):

\`\`\`
## Security review: ${SLUG} ${TASK_ID:+(task: ${TASK_ID})}

### Routing
- Mode: ${MODE}
- Diff scope: <N files, M lines per stat>
- Touches migrations: yes | no
- Touches PCI/payment surface: yes | no
- Touches webhook handlers: yes | no

### Categories
- pci-card-handling:     <hypothesis or "n/a: ...">
- secrets:               <hypothesis or "n/a: ...">
- pii:                   <hypothesis or "n/a: ...">
- auth-session:          <hypothesis or "n/a: ...">
- webhook-validation:    <hypothesis or "n/a: ...">
- logging-cache:         <hypothesis or "n/a: ...">
- dependency-config:     <hypothesis or "n/a: ...">
- migration-safety:      <hypothesis or "n/a: ...">
- launch-gate:           <hypothesis or "n/a: ...">
- threat-model-coverage: <hypothesis or "n/a: ...">

### Findings (only validated hypotheses)

#### SEC-FND-001
- Severity: P0 | P1 | P2 | P3
- Status: Confirmed | Unverified | Blocked
- Category: <one of the 10>
- STRIDE: <S/T/R/I/D/E>
- THREAT_MODEL ref: <threat title or "not in model — P1 gap">
- File/line: <path:line>
- Failure mode: <one or two sentences>
- Evidence: <command / grep / code excerpt>
- Minimal fix: <one sentence>
- Owner: <sdlc-swe | sdlc-tech-lead | sdlc-architect | blocked-on APV-###>
- APV needed: <stop reason code or "none">

(repeat for each finding; if none, write "(no findings)")

### Launch-gate impact
- RELEASE_GATES items that would move on these findings: <GATE-### list or "none">

### Verdict
- SECURITY CLEAR | SECURITY FINDINGS OPENED
- Reason: <one line>
\`\`\`

================ CONTEXT ================

FEATURE: ${SLUG}
TIER: ${TIER}
TASK ID: ${TASK_ID:-<not specified — review the entire diff>}
MODE: ${MODE}
ATTEMPT: ${ATTEMPT_NUMBER}
BASE SHA: ${PROMPT_BASE_SHA}
HEAD SHA: ${PROMPT_HEAD_SHA}
DIFF HASH: ${PROMPT_DIFF_HASH}

----- git diff --stat -----
${DIFF_STAT}

----- changed files (branch vs configured base) -----
${DIFF_NAMES}

----- changed files (worktree, unstaged) -----
${DIFF_NAMES_WORKTREE}

----- task block -----
${TASK_BLOCK:-(no task ID provided or task not found)}

----- DESIGN anchor -----
${DESIGN_SECTION:-(no DESIGN section resolved)}

----- THREAT_MODEL.md (strategic baseline) -----
${THREAT_MODEL_CONTENT:-(no THREAT_MODEL.md or tier without one)}

----- MIGRATION_PLAN.md (only if diff touches migrations) -----
${MIGRATION_PLAN_CONTENT:-(diff does not touch migrations OR no MIGRATION_PLAN.md)}

----- APPROVALS.md (what's already gated) -----
${APPROVALS_CONTENT:-(no APPROVALS.md or empty)}

----- RELEASE_GATES.md (what your findings could move) -----
${RELEASE_GATES_CONTENT:-(no RELEASE_GATES.md or empty)}

----- recent EVIDENCE entries -----
${RECENT_EVIDENCE:-(no EVIDENCE file)}

----- RELEVANT FINDINGS (don't re-file these) -----
${RELEVANT_FINDINGS:-(no FINDINGS file or no relevant security entries)}

----- git diff (branch vs configured base) -----
${DIFF_FOR_PROMPT:-(no branch diff)}

----- git diff (worktree, unstaged) -----
${DIFF_WORKTREE:-(no worktree diff)}

================ END CONTEXT ================

Produce the output exactly in the OUTPUT FORMAT above. Do not include any
preamble. Do not propose code edits. Do not output secrets.
EOF

assert_review_temp_file "$PROMPT_FILE" "$PROMPT_FILE_ID" || exit 3
PROMPT_BYTES=$(LC_ALL=C wc -c < "$PROMPT_FILE" | tr -d '[:space:]')
if [ "$PROMPT_BYTES" -gt 400000 ]; then
  printf 'scripts/security-review: assembled prompt exceeds hard 400000-byte limit (%s bytes).\n' "$PROMPT_BYTES" >&2
  exit 3
fi
PROMPT_HASH=$(shasum -a 256 "$PROMPT_FILE" | awk '{print $1}')

# -------------------------------------------------------------------------
# Sanitization tripwire — scan the FULL assembled prompt
# -------------------------------------------------------------------------

if ! sg_sanitize_scan_file "$PROMPT_FILE"; then
  cat <<EOF >&2
scripts/security-review: REFUSING to send context to Codex.

The assembled prompt (diff + task block + DESIGN anchor + THREAT_MODEL
+ MIGRATION_PLAN + APPROVALS + RELEASE_GATES + recent EVIDENCE +
relevant FINDINGS) appears to contain a sensitive-data pattern. The
matched category + redacted line is shown above by
sg_sanitize_scan_file (categories: secret-* | card-* | pii-*).

This is a safety tripwire — extra-important for security review, where
the context naturally pulls THREAT_MODEL.md and adjacent files where
stray sensitive values are easy to accidentally include. Either:
  1. The match is a false positive — refine
     scripts/lib-sanitize.sh sg_sanitize_patterns() and re-run.
  2. The match is real — scrub the value from the offending file
     (typically THREAT_MODEL.md / EVIDENCE.md / FINDINGS.md).

The sdlc-security agent should treat this as "codex unavailable" and
fall back to direct Claude-internal security review, with a note in
EVIDENCE that the codex path was skipped due to a sanitization
tripwire.

Prompt file (deleted on exit): $PROMPT_FILE
EOF
  exit 4
fi

# -------------------------------------------------------------------------
# Invoke Codex CLI
# -------------------------------------------------------------------------

CODEX_ARGS=(exec --sandbox read-only --skip-git-repo-check --color never)
# Override the reasoning-effort key from ~/.codex/config.toml in case the user
# set a value that the current Codex CLI version rejects. See
# scripts/adversary-review for the long rationale. Override via env:
#   SECURITY_REVIEW_REASONING=medium scripts/security-review ...
#
# Validate the env-supplied value so unsupported values do not reintroduce the
# failure this override exists to prevent (per ADV-FND-002 from the
# framework-v3 proposal adversary pass). Keep Codex security review on the same
# GPT-5.5/xhigh default as the other public harness review paths.
SECURITY_REVIEW_REASONING_VALUE="${SECURITY_REVIEW_REASONING:-xhigh}"
case "$SECURITY_REVIEW_REASONING_VALUE" in
  minimal|low|medium|high|xhigh) ;;
  *)
    printf 'scripts/security-review: invalid SECURITY_REVIEW_REASONING="%s" (expected: minimal | low | medium | high | xhigh).\n' "$SECURITY_REVIEW_REASONING_VALUE" >&2
    exit 3
    ;;
esac
CODEX_ARGS+=(--config "model_reasoning_effort=\"$SECURITY_REVIEW_REASONING_VALUE\"")
REQUIRED_SECURITY_REVIEW_MODEL=$(python3 "$ROOT/scripts/lib-review-scope.py" config-value "$HEAD_SHA" SDLC_CODEX_SECURITY_REQUIRED_MODEL) || exit 3
if [ -z "$REQUIRED_SECURITY_REVIEW_MODEL" ]; then
  REQUIRED_SECURITY_REVIEW_MODEL=$(python3 "$ROOT/scripts/lib-review-scope.py" config-value "$HEAD_SHA" SDLC_CODEX_ADVERSARY_REQUIRED_MODEL) || exit 3
fi
[ -n "$REQUIRED_SECURITY_REVIEW_MODEL" ] || REQUIRED_SECURITY_REVIEW_MODEL="gpt-5.5"
if [ -z "${SECURITY_REVIEW_MODEL:-}" ]; then
  SECURITY_REVIEW_MODEL="$REQUIRED_SECURITY_REVIEW_MODEL"
elif [ "$SECURITY_REVIEW_MODEL" != "$REQUIRED_SECURITY_REVIEW_MODEL" ]; then
  printf 'scripts/security-review: SECURITY_REVIEW_MODEL="%s" does not match required Codex security reviewer model "%s".\n' "$SECURITY_REVIEW_MODEL" "$REQUIRED_SECURITY_REVIEW_MODEL" >&2
  exit 3
fi
CODEX_ARGS+=(--model "$SECURITY_REVIEW_MODEL")
CODEX_ARGS+=("-")
REVIEWER_MODEL="$SECURITY_REVIEW_MODEL"
if [ "$IMPLEMENTER_MODEL" = "$REVIEWER_MODEL" ]; then
  printf 'scripts/security-review: implementer model must differ from the pinned reviewer model %s.\n' "$REVIEWER_MODEL" >&2
  exit 3
fi
if ! model_matches_tool "codex-cli" "$REVIEWER_MODEL"; then
  printf 'scripts/security-review: pinned reviewer model %s does not match reviewer tool codex-cli.\n' "$REVIEWER_MODEL" >&2
  exit 3
fi

SECURITY_REVIEW_TIMEOUT_SECONDS="${SECURITY_REVIEW_TIMEOUT_SECONDS:-300}"
case "$SECURITY_REVIEW_TIMEOUT_SECONDS" in
  ''|*[!0-9]*)
    printf 'scripts/security-review: invalid SECURITY_REVIEW_TIMEOUT_SECONDS="%s" (expected non-negative integer seconds).\n' "$SECURITY_REVIEW_TIMEOUT_SECONDS" >&2
    exit 3
    ;;
esac
REVIEW_OUTPUT_MAX_BYTES=262144

run_with_review_timeout() {
  exec python3 "$ROOT/scripts/lib-review-scope.py" run-bounded-review \
    "$SECURITY_REVIEW_TIMEOUT_SECONDS" "$REVIEW_OUTPUT_MAX_BYTES" "$@"
}

REVIEW_RUNNER_PID=""
forward_review_signal() {
  local signal_name="$1"
  local exit_code="$2"
  trap - INT TERM
  if [ -n "$REVIEW_RUNNER_PID" ]; then
    kill -s "$signal_name" "$REVIEW_RUNNER_PID" 2>/dev/null || true
    wait "$REVIEW_RUNNER_PID" 2>/dev/null || true
  fi
  exit "$exit_code"
}
trap 'forward_review_signal INT 130' INT
trap 'forward_review_signal TERM 143' TERM

recommended_security_command() {
  local status="$1"
  local retryable="$2"
  local next_mode="review-resume"
  if [ "$MODE" = "review-resume" ]; then
    next_mode="review-narrow"
  fi
  if [ "$retryable" != "true" ]; then
    printf 'Fall back to direct security review or open/update APV if external evidence is required; do not treat %s as a clear Codex-backed review.\n' "$status"
    return
  fi
  if [ -n "$TASK_ID" ]; then
    printf 'scripts/security-review %s %s %s %s %s\n' "$SLUG" "$TASK_ID" "$next_mode" "$BASE_SHA" "$IMPLEMENTER_MODEL"
  else
    printf 'scripts/security-review %s "" %s %s %s\n' "$SLUG" "$next_mode" "$BASE_SHA" "$IMPLEMENTER_MODEL"
  fi
}

write_attempt_sidecar() {
  local status="$1"
  local exit_code="$2"
  local retryable="$3"
  local failure_reason="${4:-}"
  local retry_limit="${SECURITY_REVIEW_RETRY_LIMIT:-3}"
  local finished_epoch
  local elapsed
  local finished_at
  local next_command

  if [ "$retryable" = "true" ] && [ "$ATTEMPT_NUMBER" -ge "$retry_limit" ] 2>/dev/null; then
    retryable="false"
  fi

  finished_epoch=$(date +%s)
  elapsed=$(( finished_epoch - STARTED_EPOCH ))
  finished_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  next_command=$(recommended_security_command "$status" "$retryable")

  "$ROOT/scripts/review-attempt" write "$SIDECAR_FILE" \
    feature="$SLUG" \
    task_id="${TASK_ID:-}" \
    review_kind="security" \
    mode="$MODE" \
    implementer_tool="$IMPLEMENTER_TOOL" \
    implementer_model="$IMPLEMENTER_MODEL" \
    reviewer_tool="codex-cli" \
    reviewer_model="$REVIEWER_MODEL" \
    base_ref="$BASE_SOURCE_REF" \
    base_sha="$BASE_SHA" \
    head_sha="$HEAD_SHA" \
    diff_hash="${DIFF_HASH:-}" \
    prompt_hash="${PROMPT_HASH:-}" \
    artifact_path="$OUT_FILE" \
    status="$status" \
    failure_reason="$failure_reason" \
    exit_code="$exit_code" \
    started_at="$(date -u -r "$STARTED_EPOCH" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ)" \
    finished_at="$finished_at" \
    elapsed_seconds="$elapsed" \
    attempt_number="$ATTEMPT_NUMBER" \
    retryable="$retryable" \
    recommended_next_command="$next_command"
}

write_review_receipt() {
  local reviewed_at
  local transcript_hash
  local receipt_status
  local receipt_human_fields

  receipt_status="$1"
  reviewed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  transcript_hash=$(shasum -a 256 "$OUT_FILE" | awk '{print $1}')
  assert_review_temp_file "$SCOPE_FILE" "$SCOPE_FILE_ID" || return 2
  if ! "$ROOT/scripts/review-attempt" write-receipt "$RECEIPT_FILE" \
      schema_version=2 \
      feature="$SLUG" \
      task_id="${TASK_ID:-feature}" \
      review_kind="security" \
      status="$receipt_status" \
      implementer_tool="$IMPLEMENTER_TOOL" \
      implementer_model="$IMPLEMENTER_MODEL" \
      reviewer_tool="codex-cli" \
      reviewer_model="$REVIEWER_MODEL" \
      base_sha="$BASE_SHA" \
      reviewed_candidate_sha="$HEAD_SHA" \
      canonical_diff_hash="$DIFF_HASH" \
      prompt_hash="$PROMPT_HASH" \
      transcript_hash="$transcript_hash" \
      reviewed_at="$reviewed_at" \
      scope_json_file="$SCOPE_FILE"; then
    printf 'scripts/security-review: failed to write tracked review receipt.\n' >&2
    return 2
  fi
  receipt_human_fields="$RECEIPT_HUMAN_FILE"
  assert_review_temp_file "$receipt_human_fields" "$RECEIPT_HUMAN_FILE_ID" || return 2
  : > "$receipt_human_fields"
  if ! "$ROOT/scripts/review-attempt" validate-receipt "$RECEIPT_FILE" --require-scoped; then
    rm -f "$RECEIPT_FILE"
    rm -f "$receipt_human_fields"
    printf 'scripts/security-review: generated scoped receipt failed validation and was removed.\n' >&2
    return 2
  fi
  if ! "$ROOT/scripts/review-attempt" receipt-human-fields "$RECEIPT_FILE" > "$receipt_human_fields" \
      || ! assert_review_temp_file "$receipt_human_fields" "$RECEIPT_HUMAN_FILE_ID" \
      || ! sg_sanitize_scan_file "$receipt_human_fields"; then
    rm -f "$RECEIPT_FILE"
    rm -f "$receipt_human_fields"
    printf 'scripts/security-review: generated receipt human fields failed sanitization and were removed.\n' >&2
    return 4
  fi
  rm -f "$receipt_human_fields"
}

OUTPUT_ALLOCATION=$("$ROOT/scripts/review-attempt" allocate "$SLUG" security "$TASK_ID" codex-cli "$ATTEMPT_NUMBER") || exit 3
IFS='|' read -r OUT_FILE SIDECAR_FILE RECEIPT_FILE <<< "$OUTPUT_ALLOCATION"
if [ -z "$OUT_FILE" ] || [ -z "$SIDECAR_FILE" ] || [ -z "$RECEIPT_FILE" ]; then
  printf 'scripts/security-review: output allocation returned incomplete paths.\n' >&2
  exit 3
fi

{
  printf '<!-- Codex CLI security review artifact -->\n'
  printf '<!-- Feature: %s -->\n' "$SLUG"
  printf '<!-- Task: %s -->\n' "${TASK_ID:-<unspecified>}"
  printf '<!-- Mode: %s -->\n' "$MODE"
  printf '<!-- Generated: %s -->\n' "$TS"
  printf '<!-- Model: %s -->\n\n' "$REVIEWER_MODEL"
} > "$OUT_FILE"

review_status=0
assert_review_temp_file "$PROMPT_FILE" "$PROMPT_FILE_ID" || exit 3
assert_review_temp_file "$REVIEW_OUTPUT_FILE" "$REVIEW_OUTPUT_FILE_ID" || exit 3
: > "$REVIEW_OUTPUT_FILE"
run_with_review_timeout "$CODEX_CMD" "${CODEX_ARGS[@]}" < "$PROMPT_FILE" > "$REVIEW_OUTPUT_FILE" 2>&1 &
REVIEW_RUNNER_PID=$!
while runner_state=$(ps -p "$REVIEW_RUNNER_PID" -o stat= 2>/dev/null); do
  case "$runner_state" in
    *Z*) break ;;
  esac
  sleep 0.1
done
wait "$REVIEW_RUNNER_PID" || review_status=$?
REVIEW_RUNNER_PID=""
assert_review_temp_file "$REVIEW_OUTPUT_FILE" "$REVIEW_OUTPUT_FILE_ID" || exit 3
REVIEW_OUTPUT_BYTES=$(LC_ALL=C wc -c < "$REVIEW_OUTPUT_FILE" | tr -d '[:space:]')
REVIEW_OUTPUT_LIMIT_REACHED=false
if [ "$REVIEW_OUTPUT_BYTES" -ge "$REVIEW_OUTPUT_MAX_BYTES" ]; then
  REVIEW_OUTPUT_LIMIT_REACHED=true
  review_status=125
fi
tee -a "$OUT_FILE" < "$REVIEW_OUTPUT_FILE"
if [ "$review_status" -ne 0 ]; then
  attempt_status="unavailable"
  failure_reason="reviewer-exit"
  if [ "$review_status" -eq 124 ]; then
    attempt_status="timeout"
    failure_reason="timeout"
    printf '\nscripts/security-review: codex-cli timed out after %ss. Artifact written to %s\n' "$SECURITY_REVIEW_TIMEOUT_SECONDS" "$OUT_FILE" | tee -a "$OUT_FILE" >&2
  elif [ "$review_status" -eq 125 ] && [ "$REVIEW_OUTPUT_LIMIT_REACHED" = true ]; then
    attempt_status="invalid-output"
    failure_reason="reviewer-output-limit"
    printf '\nscripts/security-review: reviewer output reached the hard %s-byte limit.\n' "$REVIEW_OUTPUT_MAX_BYTES" | tee -a "$OUT_FILE" >&2
  fi
  write_attempt_sidecar "$attempt_status" "$review_status" "true" "$failure_reason"
  printf '\nscripts/security-review: codex exec exited non-zero (%s). Artifact written to %s\n' "$review_status" "$OUT_FILE" >&2
  printf 'Attempt sidecar: %s\n' "$SIDECAR_FILE" >&2
  printf 'Recommended next command: %s\n' "$(recommended_security_command "$attempt_status" "true")" >&2
  printf 'The agent should treat this as "codex unavailable" and fall back to direct security review.\n' >&2
  case "$review_status" in
    124|130|143) exit "$review_status" ;;
    *) exit 2 ;;
  esac
fi

CURRENT_HEAD=$(git rev-parse --verify 'HEAD^{commit}' 2>/dev/null || true)
drift_status=0
DRIFT_SCOPE=$("$ROOT/scripts/review-attempt" dirty-scope "$SLUG" "$SCOPE_TASK" "$BASE_SHA" "$HEAD_SHA" 2>&1) || drift_status=$?
if [ "$CURRENT_HEAD" != "$HEAD_SHA" ] || [ "$drift_status" -ne 0 ]; then
  write_attempt_sidecar "incomplete" "2" "true" "candidate-drift"
  printf 'scripts/security-review: candidate HEAD/task scope changed during review; no receipt issued.\n' >&2
  printf 'Attempt sidecar: %s\n' "$SIDECAR_FILE" >&2
  [ -n "$DRIFT_SCOPE" ] && printf '%s\n' "$DRIFT_SCOPE" >&2
  exit 2
fi

# Strip trailing whitespace from the captured artifact. Codex's stdout often
# carries trailing spaces (blank lines inside fenced blocks, quoted file/diff
# lines); committing them to the SDLC review trail trips `git diff --check`.
# Cosmetic only — line content + finding semantics are unchanged. Portable
# in-place strip that preserves the file's inode/perms (no GNU-vs-BSD `sed -i`).
if [ -f "$OUT_FILE" ]; then
  _ws_clean="$WHITESPACE_FILE"
  if assert_review_temp_file "$_ws_clean" "$WHITESPACE_FILE_ID"; then
    : > "$_ws_clean"
    sed 's/[[:blank:]]*$//' "$OUT_FILE" > "$_ws_clean" \
      && cat "$_ws_clean" > "$OUT_FILE"
  fi
fi

artifact_status=$("$ROOT/scripts/review-attempt" status security "$OUT_FILE" 2>/dev/null || printf 'invalid-output')
case "$artifact_status" in
  clear|findings)
    receipt_status=0
    write_review_receipt "$artifact_status" || receipt_status=$?
    if [ "$receipt_status" -ne 0 ]; then
      write_attempt_sidecar "incomplete" "$receipt_status" "true" "receipt-error"
      printf 'Attempt sidecar: %s (incomplete; receipt-error)\n' "$SIDECAR_FILE" >&2
      exit "$receipt_status"
    fi
    write_attempt_sidecar "$artifact_status" "0" "false"
    ;;
  incomplete|invalid-output|*)
    write_attempt_sidecar "$artifact_status" "2" "true"
    printf '\nscripts/security-review: reviewer output did not contain a valid machine-readable security verdict. Artifact written to %s\n' "$OUT_FILE" >&2
    printf 'Attempt sidecar: %s\n' "$SIDECAR_FILE" >&2
    printf 'Recommended next command: %s\n' "$(recommended_security_command "$artifact_status" "true")" >&2
    printf 'Do not treat this as a clear Codex-backed security review.\n' >&2
    exit 2
    ;;
esac

# -------------------------------------------------------------------------
# Summary block
# -------------------------------------------------------------------------

cat <<EOF

== security-review summary ==
Feature:       $SLUG
Task:          ${TASK_ID:-<unspecified>}
Mode:          $MODE
Tier:          $TIER
Touches migration: $([ "$touches_migration" -eq 1 ] && echo yes || echo no)
Artifact:      $OUT_FILE
Attempt JSON:  $SIDECAR_FILE
Review receipt: $RECEIPT_FILE
Attempt:       $ATTEMPT_NUMBER
Status:        $artifact_status
Codex model:   $SECURITY_REVIEW_MODEL

Next step: the sdlc-security agent reads the artifact, validates each
proposed finding against actual code (do NOT trust Confirmed claims
without re-checking file/line), and either:
  - opens FINDINGS.md entries with Source: sdlc-security (and opens
    APPROVALS.md entries for any APV stop-reason-coded finding), or
  - records "Security review clear" in EVIDENCE.md if no validated
    finding survives.
EOF
