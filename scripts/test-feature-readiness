#!/usr/bin/env bash
# Isolated-repository regression tests for all-tier control parsing, evidence
# gates, and exact-HEAD verification receipts.

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/feature-readiness.XXXXXX")"
SMOKE_SLUG="_test-fixture-app-smoke-$$"
SMOKE_DIR="$ROOT/docs/features/$SMOKE_SLUG"
PASS=0
FAIL=0

cleanup() {
  rm -rf "$TMP_ROOT"
  case "$SMOKE_DIR" in "$ROOT/docs/features/_test-fixture-app-smoke-"*) rm -rf "$SMOKE_DIR" ;; esac
}
trap cleanup EXIT INT TERM

check() {
  local name="$1"
  shift
  if "$@"; then
    printf 'PASS: %s\n' "$name"
    PASS=$((PASS + 1))
  else
    printf 'FAIL: %s\n' "$name"
    FAIL=$((FAIL + 1))
  fi
}

REPO="$TMP_ROOT/repo"
mkdir -p "$REPO/scripts" "$REPO/app" \
  "$REPO/docs/features/small-app/review-receipts" \
  "$REPO/docs/features/medium-review/review-receipts" \
  "$REPO/docs/features/large-review/review-receipts" \
  "$REPO/docs/features/large-legacy" \
  "$REPO/docs/features/large-relabel"
cp "$ROOT/scripts/feature-control" "$ROOT/scripts/feature-reconcile" \
  "$ROOT/scripts/feature-ready" "$ROOT/scripts/feature-verify" \
  "$ROOT/scripts/evidence-scaffold" \
  "$ROOT/scripts/load-config" "$ROOT/scripts/lib-review-scope.py" "$REPO/scripts/"
cp "$ROOT/scripts/review-attempt" "$REPO/scripts/review-attempt-real"

cat > "$REPO/scripts/review-attempt" <<'EOF'
#!/usr/bin/env bash
set -u
if [ "${1:-}" = validate-receipt ]; then
  [ "$#" -eq 3 ] && [ "${3:-}" = --require-scoped ] || exit 3
fi
exec "$(dirname "$0")/review-attempt-real" "$@"
EOF
chmod +x "$REPO/scripts/"*

git -C "$REPO" init -q
git -C "$REPO" config user.email fixture@example.com
git -C "$REPO" config user.name Fixture
git -C "$REPO" config core.filemode false

cat > "$REPO/.gitignore" <<'EOF'
docs/features/*/.last-verify.json
EOF
printf 'small\n' > "$REPO/docs/features/small-app/.tier"
cat > "$REPO/docs/features/small-app/FEATURE.md" <<'EOF'
# Small application fixture

### TASK-001: Verify application

- Status: Claimed
- Type: ui
- Claimed at: 2026-07-10 12:00 PDT
- Application verification: required
- Depends-on:
- Intended file ownership:
  - app/
  - docs/features/small-app/FEATURE.md
  - docs/features/small-app/SPEC.md
  - docs/features/small-app/DESIGN.md

### TASK-031: Cross-task evidence target

- Status: Claimed
- Type: workflow
- Claimed at: 2026-07-10 13:31 PDT
- Application verification: not-applicable — exact-task parser fixture
- Intended file ownership:
  - scripts/example
EOF
printf 'before review\n' > "$REPO/app/index.html"
printf '# Reviewed fixture specification\n' > "$REPO/docs/features/small-app/SPEC.md"
printf '# Reviewed fixture design\n\nStatus: Approved\n' > "$REPO/docs/features/small-app/DESIGN.md"

printf '# Medium fixture\n' > "$REPO/docs/features/medium-review/README.md"
printf '# Medium fixture specification\n' > "$REPO/docs/features/medium-review/SPEC.md"
printf '# Medium fixture design\n\nStatus: Approved\n' > "$REPO/docs/features/medium-review/DESIGN.md"

for tier in medium large; do
  feature="$tier-review"
  printf '%s\n' "$tier" > "$REPO/docs/features/$feature/.tier"
  cat > "$REPO/docs/features/$feature/TASKS.md" <<EOF
# $tier current-Review fixture

### TASK-001: Verify all-tier review gates

- Status: Claimed
- Type: workflow
- Claimed at: 2026-07-10 12:00 PDT
- Application verification: not-applicable — fixture exercises harness control-plane behavior only
- Depends-on:
- Intended file ownership:
  - app/
EOF
  : > "$REPO/docs/features/$feature/EVIDENCE.md"
  printf 'before review\n' > "$REPO/app/$tier-review.txt"
done

cat > "$REPO/docs/features/large-review/STATE.md" <<'EOF'
```yaml
verdict: implementation
open_tasks: 0
claimed_tasks: 0
blocked_tasks: 0
open_p0: 0
open_p1: 0
ac_total: 0
ac_passing: 0
nfr_total: 0
nfr_passing: 0
```
EOF
: > "$REPO/docs/features/large-review/FINDINGS.md"
cat > "$REPO/docs/features/large-review/TRACEABILITY.md" <<'EOF'
AC total: 0
AC with passing tests: 0
NFR total: 0
NFR measured and passing: 0
EOF

printf 'large\n' > "$REPO/docs/features/large-legacy/.tier"
cat > "$REPO/docs/features/large-legacy/TASKS.md" <<'EOF'
# Large legacy fixture

### TASK-009: Done before all-tier adoption

- Status: Done
- Type: workflow

### TASK-010: Docs review before all-tier adoption

- Status: Review
- Type: docs
EOF
: > "$REPO/docs/features/large-legacy/EVIDENCE.md"
: > "$REPO/docs/features/large-legacy/FINDINGS.md"
cat > "$REPO/docs/features/large-legacy/STATE.md" <<'EOF'
```yaml
verdict: implementation
open_tasks: 0
claimed_tasks: 0
blocked_tasks: 0
open_p0: 0
open_p1: 0
ac_total: 0
ac_passing: 0
nfr_total: 0
nfr_passing: 0
```
EOF
cat > "$REPO/docs/features/large-legacy/TRACEABILITY.md" <<'EOF'
AC total: 0
AC with passing tests: 0
NFR total: 0
NFR measured and passing: 0
EOF

printf 'large\n' > "$REPO/docs/features/large-relabel/.tier"
cat > "$REPO/docs/features/large-relabel/TASKS.md" <<'EOF'
# Historical type relabel fixture

### TASK-011: Code review at adoption

- Status: Review
- Type: workflow
EOF
: > "$REPO/docs/features/large-relabel/EVIDENCE.md"

git -C "$REPO" add .
git -C "$REPO" commit -qm 'fixture adoption boundary'
ADOPTION="$(git -C "$REPO" rev-parse HEAD)"

replace_status() {
  python3 - "$1" "$2" "$3" <<'PY'
from pathlib import Path
import sys
p = Path(sys.argv[1]); old, new = sys.argv[2:4]
text = p.read_text(); assert text.count(old) == 1; p.write_text(text.replace(old, new, 1))
PY
}

printf 'reviewed candidate\n' > "$REPO/app/index.html"
printf 'reviewed medium candidate\n' > "$REPO/app/medium-review.txt"
printf 'reviewed large candidate\n' > "$REPO/app/large-review.txt"
git -C "$REPO" add app/index.html app/medium-review.txt app/large-review.txt
git -C "$REPO" commit -qm 'fixture product candidate'
REVIEWED_CANDIDATE="$(git -C "$REPO" rev-parse HEAD)"

cat > "$REPO/sdlc.config.yml" <<EOF
SDLC_BASE_BRANCH: main
SDLC_REVIEW_STAGE_CROSS_MODEL_ADVERSARIAL_REQUIRED: true
SDLC_QA_COVERAGE_LEDGER_REQUIRED: true
SDLC_REVIEW_RECEIPT_ADOPTION_COMMIT: $ADOPTION
EOF

write_fixture_receipt() {
  local feature="$1" path="$2" status="$3" reviewed_at="$4"
  local scope="$TMP_ROOT/$feature.scope.json" diff_hash
  (cd "$REPO" && scripts/review-attempt-real scope-json "$feature" TASK-001 \
    "$ADOPTION" "$REVIEWED_CANDIDATE") > "$scope" || return 1
  diff_hash=$(cd "$REPO" && scripts/review-attempt-real canonical-diff-hash \
    "$ADOPTION" "$REVIEWED_CANDIDATE" "$feature" TASK-001) || return 1
  (cd "$REPO" && scripts/review-attempt-real write-receipt "$path" \
    schema_version=2 feature="$feature" task_id=TASK-001 review_kind=adversary \
    status="$status" implementer_tool=codex-app implementer_model=gpt-5.5 \
    reviewer_tool=claude-code reviewer_model=claude-opus-4-8 \
    base_sha="$ADOPTION" reviewed_candidate_sha="$REVIEWED_CANDIDATE" \
    canonical_diff_hash="$diff_hash" \
    prompt_hash=1111111111111111111111111111111111111111111111111111111111111111 \
    transcript_hash=2222222222222222222222222222222222222222222222222222222222222222 \
    reviewed_at="$reviewed_at" scope_json_file="$scope")
}

CLEAR_RECEIPT_REL=docs/features/small-app/review-receipts/2026-07-10T010000Z-TASK-001-adversary-claude-code-attempt-1-abcdef123456.json
write_fixture_receipt small-app "$CLEAR_RECEIPT_REL" clear 2026-07-10T01:00:00Z
for tier in medium large; do
  feature="$tier-review"
  receipt="docs/features/$feature/review-receipts/2026-07-10T010000Z-TASK-001-adversary-claude-code-attempt-1-abcdef123456.json"
  write_fixture_receipt "$feature" "$receipt" clear 2026-07-10T01:00:00Z
done
cat > "$REPO/docs/features/small-app/FEATURE.md" <<EOF
# Small application fixture

### TASK-001: Verify application

- Status: Review
- Type: ui
- Claimed at: 2026-07-10 12:00 PDT
- Application verification: required
- Depends-on:
- Intended file ownership:
  - app/
  - docs/features/small-app/FEATURE.md
  - docs/features/small-app/SPEC.md
  - docs/features/small-app/DESIGN.md

## 2026-07-10 - Complete evidence: TASK-001

- Task: TASK-001
- Review receipt: $CLEAR_RECEIPT_REL
- Pre-review self-audit
- Plausible miss 1: Server might not start.
  - Check: Started the fixture server.
- Plausible miss 2: Index might not render.
  - Check: Curled the fixture index.
- Plausible miss 3: Environment might drift.
  - Check: Compared environment and config keys.
- QA coverage ledger
- Control inventory: server, index, port, and environment rows.
- Production baseline: prior fixture behavior recorded.
- Candidate proof: current fixture behavior recorded.
- Data-path proof: request and response recorded.
- Untested rows: 0
- Result: PASS
- Application verification
- Real server start: fixture server reached ready state.
- Index curl: HTTP 200 with expected marker.
- Port check: expected listener only; clean after shutdown.
- Environment/config cross-check: referenced keys match.
- Result: PASS
EOF

for tier in medium large; do
  feature="$tier-review"
  receipt="docs/features/$feature/review-receipts/2026-07-10T010000Z-TASK-001-adversary-claude-code-attempt-1-abcdef123456.json"
  cat > "$REPO/docs/features/$feature/TASKS.md" <<EOF
# $tier current-Review fixture

### TASK-001: Verify all-tier review gates

- Status: Review
- Type: workflow
- Claimed at: 2026-07-10 12:00 PDT
- Application verification: not-applicable — fixture exercises harness control-plane behavior only
- Depends-on:
- Intended file ownership:
  - app/
EOF
  cat > "$REPO/docs/features/$feature/EVIDENCE.md" <<EOF
# $tier current-Review evidence

## 2026-07-10 - Complete evidence: TASK-001

- Task: TASK-001
- Review receipt: $receipt
- Pre-review self-audit
- Plausible miss 1: Tier routing could select the wrong task ledger.
  - Check: Reconcile reads the $tier TASKS.md and EVIDENCE.md pair.
- Plausible miss 2: QA prose could omit a required field.
  - Check: The fixture records every exact QA field once.
- Plausible miss 3: A same-tool review could be accepted.
  - Check: The tracked receipt records Codex implementation and Claude review.
- QA coverage ledger
- Control inventory: task parser, evidence parser, and receipt validator rows.
- Production baseline: pre-adoption behavior recorded.
- Candidate proof: current $tier candidate behavior recorded.
- Data-path proof: claim, candidate, receipt, and reconcile path recorded.
- Untested rows: 0
- Result: PASS
EOF
done

git -C "$REPO" add .
git -C "$REPO" commit -qm 'fixture review receipt and control-plane evidence'
EVIDENCE_BASELINE="$(git -C "$REPO" rev-parse HEAD)"

replace_status "$REPO/docs/features/large-relabel/TASKS.md" '- Type: workflow' '- Type: docs'
historical_code_type_cannot_be_relabelled_legacy() {
  output=$(cd "$REPO" && scripts/feature-control lifecycle large-relabel TASK-011 "$ADOPTION" 2>&1) || return 1
  [ "$output" = 'current|task was Review at the committed adoption boundary' ]
}
check "current Type:docs cannot grandfather a code task that was Review at adoption" historical_code_type_cannot_be_relabelled_legacy
git -C "$REPO" show "HEAD:docs/features/large-relabel/TASKS.md" > \
  "$REPO/docs/features/large-relabel/TASKS.md"

VALID_RECEIPT="$REPO/$CLEAR_RECEIPT_REL"
validator_requires_scoped_flag() {
  (cd "$REPO" && ! scripts/review-attempt validate-receipt "$VALID_RECEIPT" >/dev/null 2>&1)
}
check "fixture validator requires --require-scoped" validator_requires_scoped_flag

python3 - "$VALID_RECEIPT" "$TMP_ROOT" <<'PY'
import copy, json, pathlib, sys
data = json.load(open(sys.argv[1], encoding="utf-8")); root = pathlib.Path(sys.argv[2])
variants = {
    "malformed-schema": {"schema_version": 1},
    "missing-key": {"scope_hash": None},
    "same-tool": {"reviewer_tool": "codex-cli", "reviewer_model": "gpt-5.5"},
    "bad-provenance": {"reviewer_model": "gpt-5.5"},
}
for name, changes in variants.items():
    item = copy.deepcopy(data)
    for key, value in changes.items():
        item.pop(key) if value is None else item.__setitem__(key, value)
    (root / f"{name}.json").write_text(json.dumps(item))
PY
invalid_receipt() {
  (cd "$REPO" && ! scripts/review-attempt validate-receipt "$1" --require-scoped >/dev/null 2>&1)
}
check "fixture validator rejects malformed scoped schema" invalid_receipt "$TMP_ROOT/malformed-schema.json"
check "fixture validator rejects missing scoped receipt fields" invalid_receipt "$TMP_ROOT/missing-key.json"
check "fixture validator rejects same-tool receipts" invalid_receipt "$TMP_ROOT/same-tool.json"
check "fixture validator rejects tool/model provenance mismatch" invalid_receipt "$TMP_ROOT/bad-provenance.json"

current_reconcile_pass() {
  local feature="$1" app_marker="$2" output
  output=$(cd "$REPO" && scripts/feature-reconcile "$feature" 2>&1) || return 1
  printf '%s' "$output" | grep -qF 'latest evidence cites a tracked scoped clear opposite-tool receipt' && \
    printf '%s' "$output" | grep -qF 'pre-review self-audit recorded' && \
    printf '%s' "$output" | grep -qF 'QA coverage ledger recorded with zero untested rows' && \
    printf '%s' "$output" | grep -qF "$app_marker"
}
small_reconcile_pass() { current_reconcile_pass small-app 'application verification evidence records server/curl/port/env checks'; }
check "small-tier current Review task passes tracked receipt, self-audit, QA, and app evidence" small_reconcile_pass
check "medium-tier current Review task passes all four gates" current_reconcile_pass medium-review 'application verification explicitly not applicable'
check "large-tier current Review task passes all four gates" current_reconcile_pass large-review 'application verification explicitly not applicable'

render_scaffold_case() {
  local feature="$1" tier="$2" mode="$3" receipt="$4" raw
  raw=$(cd "$REPO" && scripts/evidence-scaffold "$feature" TASK-001) || return 1
  printf '%s\n' "$raw" | python3 -c '
import sys

receipt, tier, mode = sys.argv[1:4]
proof = {
    "- Control inventory:": "- Control inventory: task, parser, and receipt rows.",
    "- Production baseline:": "- Production baseline: committed fixture behavior.",
    "- Candidate proof:": "- Candidate proof: scaffold fixture output.",
    "- Data-path proof:": "- Data-path proof: scaffold to evidence parser to reconcile.",
}
rendered = []
for line in sys.stdin.read().splitlines():
    if line == "- Review receipt:":
        line = f"- Review receipt: {receipt}"
    elif line.startswith("- Plausible miss ") and line.endswith(":"):
        if mode != "audit-blank":
            line += " fixture evidence could be parsed outside its physical line."
    elif line == "  - Check:":
        if mode == "audit-blank":
            rendered.append("  - Check: first populated check must not become the description.")
            line = "  - Check: second populated check must not hide a blank description."
        elif mode != "check-blank":
            line = "  - Check: exercised the exact production evidence parser."
    elif line in proof and mode != "qa-blank":
        line = proof[line]
    elif line == "- Untested rows:":
        line = "- Untested rows: 0"
    elif line == "- Result:":
        line = "- Result: PASS"
    rendered.append(line)

if tier == "small":
    rendered.append("- Application verification")
    app = (
        ("Real server start", "fixture server reached ready state"),
        ("Index curl", "HTTP 200 with expected marker"),
        ("Port check", "expected listener only; clean after shutdown"),
        ("Environment/config cross-check", "referenced keys match"),
    )
    for label, value in app:
        rendered.append(f"- {label}:" if mode == "app-blank" else f"- {label}: {value}.")
    rendered.append("- Result: PASS")
sys.stdout.write("\n".join(rendered) + "\n")
' "$receipt" "$tier" "$mode"
}

scaffold_reconcile_case() {
  local tier="$1" mode="$2" feature ledger rel receipt rendered output rc passed=1
  case "$tier" in
    small)
      feature=small-app
      rel=docs/features/small-app/FEATURE.md
      receipt="$CLEAR_RECEIPT_REL"
      ;;
    medium|large)
      feature="$tier-review"
      rel="docs/features/$feature/EVIDENCE.md"
      receipt="docs/features/$feature/review-receipts/2026-07-10T010000Z-TASK-001-adversary-claude-code-attempt-1-abcdef123456.json"
      ;;
    *) return 1 ;;
  esac
  ledger="$REPO/$rel"
  rendered=$(render_scaffold_case "$feature" "$tier" "$mode" "$receipt") || return 1
  printf '\n%s\n' "$rendered" >> "$ledger"
  git -C "$REPO" add "$rel"
  git -C "$REPO" commit -qm "fixture $tier scaffold $mode"

  output=$(cd "$REPO" && scripts/feature-reconcile "$feature" 2>&1)
  rc=$?
  printf '%s' "$output" | grep -qF \
    'latest evidence cites a tracked scoped clear opposite-tool receipt' || passed=0
  if [ "$mode" != "app-blank" ]; then
    if [ "$tier" = "small" ]; then
      printf '%s' "$output" | grep -qF \
        'application verification evidence records server/curl/port/env checks' || passed=0
    else
      printf '%s' "$output" | grep -qF \
        'application verification explicitly not applicable' || passed=0
    fi
  fi
  case "$mode" in
    complete)
      [ "$rc" -eq 0 ] || passed=0
      printf '%s' "$output" | grep -qF 'pre-review self-audit recorded' || passed=0
      printf '%s' "$output" | grep -qF 'QA coverage ledger recorded with zero untested rows' || passed=0
      ;;
    qa-blank)
      [ "$rc" -eq 1 ] || passed=0
      printf '%s' "$output" | grep -qF 'pre-review self-audit recorded' || passed=0
      printf '%s' "$output" | grep -qF 'QA coverage ledger needs one exact field set' || passed=0
      ;;
    audit-blank)
      [ "$rc" -eq 1 ] || passed=0
      printf '%s' "$output" | grep -qF 'pre-review self-audit needs nonblank' || passed=0
      printf '%s' "$output" | grep -qF 'QA coverage ledger recorded with zero untested rows' || passed=0
      ;;
    check-blank)
      [ "$rc" -eq 1 ] || passed=0
      printf '%s' "$output" | grep -qF 'pre-review self-audit needs nonblank' || passed=0
      printf '%s' "$output" | grep -qF 'QA coverage ledger recorded with zero untested rows' || passed=0
      ;;
    app-blank)
      [ "$tier" = small ] && [ "$rc" -eq 1 ] || passed=0
      printf '%s' "$output" | grep -qF 'pre-review self-audit recorded' || passed=0
      printf '%s' "$output" | grep -qF 'QA coverage ledger recorded with zero untested rows' || passed=0
      printf '%s' "$output" | grep -qF 'application verification block needs one exact' || passed=0
      ;;
    *) passed=0 ;;
  esac

  git -C "$REPO" show "$EVIDENCE_BASELINE:$rel" > "$ledger"
  git -C "$REPO" add "$rel"
  git -C "$REPO" commit -qm "restore $tier scaffold fixture"
  [ "$passed" -eq 1 ]
}

for tier in small medium large; do
  check "$tier completed scaffold round-trips through reconcile" \
    scaffold_reconcile_case "$tier" complete
  check "$tier valid receipt cannot make blank QA proof pass" \
    scaffold_reconcile_case "$tier" qa-blank
  check "$tier populated checks cannot hide blank self-audit descriptions" \
    scaffold_reconcile_case "$tier" audit-blank
  check "$tier blank self-audit checks remain non-evidence" \
    scaffold_reconcile_case "$tier" check-blank
done
check "small-tier Result PASS cannot hide blank application proof" \
  scaffold_reconcile_case small app-blank

large_legacy_reconcile_pass() {
  output=$(cd "$REPO" && scripts/feature-reconcile large-legacy 2>&1) || return 1
  printf '%s' "$output" | grep -qF 'receipt gate legacy by committed history' && \
    printf '%s' "$output" | grep -qF 'self-audit gate legacy by committed history' && \
    printf '%s' "$output" | grep -qF 'QA coverage gate legacy by committed history' && \
    printf '%s' "$output" | grep -qF 'application verification not required for legacy task' && \
    printf '%s' "$output" | grep -qF 'TASK-010 (Review) — receipt gate legacy by committed history (task was already Review at the committed adoption boundary)'
}
check "Done and docs-Review tasks at adoption remain legacy without modern receipt/evidence" large_legacy_reconcile_pass

create_docs_fixture() {
  local slug="$1" task="$2" owner="$3" changed="$4" payload="$5"
  local dir ledger
  dir="$REPO/docs/features/$slug"
  ledger="$dir/FEATURE.md"
  mkdir -p "$dir" "$(dirname "$REPO/$changed")"
  printf 'small\n' > "$dir/.tier"
  cat > "$ledger" <<EOF
# Docs classifier fixture
### $task: Verify documentation-only classification
- Status: Open
- Type: docs
- Claimed at:
- Application verification: not-applicable — classifier fixture
- Intended file ownership:
  - docs/features/$slug/FEATURE.md
  - $owner
EOF
  git -C "$REPO" add "docs/features/$slug"
  git -C "$REPO" commit -qm "initialize $slug"
  replace_status "$ledger" '- Status: Open' '- Status: Claimed'
  git -C "$REPO" add "docs/features/$slug/FEATURE.md"
  git -C "$REPO" commit -qm "claim $slug"
  printf '%s\n' "$payload" > "$REPO/$changed"
  git -C "$REPO" add "$changed"
  git -C "$REPO" commit -qm "implement $slug"
  replace_status "$ledger" '- Status: Claimed' '- Status: Review'
  git -C "$REPO" add "docs/features/$slug/FEATURE.md"
  git -C "$REPO" commit -qm "route $slug to review"
}

create_docs_fixture docs-valid TASK-101 docs/valid-fixture.md \
  docs/valid-fixture.md 'verified documentation candidate'
valid_docs_scope_skips_heavy_gates() {
  output=$(cd "$REPO" && scripts/feature-reconcile docs-valid 2>&1) || return 1
  printf '%s' "$output" | grep -qF 'verified docs-only claim-to-candidate scope' && \
    printf '%s' "$output" | grep -qF 'verified docs-only scope does not require QA coverage ledger'
}
check "Type: docs skips heavy gates only after a verified owned docs-only diff" valid_docs_scope_skips_heavy_gates

printf '#!/usr/bin/env bash\n' > "$REPO/scripts/docs-smuggled.sh"
git -C "$REPO" add scripts/docs-smuggled.sh
git -C "$REPO" commit -qm 'smuggle code between docs claim cycles'
replace_status "$REPO/docs/features/docs-valid/FEATURE.md" '- Status: Review' '- Status: Open'
git -C "$REPO" add docs/features/docs-valid/FEATURE.md
git -C "$REPO" commit -qm 'reopen docs fixture'
replace_status "$REPO/docs/features/docs-valid/FEATURE.md" '- Status: Open' '- Status: Claimed'
git -C "$REPO" add docs/features/docs-valid/FEATURE.md
git -C "$REPO" commit -qm 'reclaim docs fixture'
printf 'second documentation candidate\n' > "$REPO/docs/valid-fixture.md"
git -C "$REPO" add docs/valid-fixture.md
git -C "$REPO" commit -qm 'second docs candidate'
replace_status "$REPO/docs/features/docs-valid/FEATURE.md" '- Status: Claimed' '- Status: Review'
git -C "$REPO" add docs/features/docs-valid/FEATURE.md
git -C "$REPO" commit -qm 'route second docs candidate to review'
multi_cycle_code_fails_closed() {
  output=$(cd "$REPO" && scripts/feature-reconcile docs-valid 2>&1)
  [ "$?" -eq 1 ] && printf '%s' "$output" | grep -qF 'scripts/docs-smuggled.sh'
}
check "Type: docs validates the full multi-cycle claim span" multi_cycle_code_fails_closed

create_docs_fixture docs-script TASK-102 scripts/docs-bad.sh \
  scripts/docs-bad.sh '#!/usr/bin/env bash'
script_as_docs_fails_closed() {
  output=$(cd "$REPO" && scripts/feature-reconcile docs-script 2>&1)
  rc=$?
  [ "$rc" -eq 1 ] && \
    printf '%s' "$output" | grep -qF 'docs-only classifier failed closed' && \
    printf '%s' "$output" | grep -qF 'owns non-documentation path(s): scripts/docs-bad.sh'
}
check "Type: docs cannot exempt a task that owns or changes a script" script_as_docs_fails_closed

