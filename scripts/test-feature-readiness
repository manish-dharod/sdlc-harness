    _test-review-template-evidence TASK-030 app) || return 1
  printf '%s' "$qa" | grep -qF 'Control inventory:' && \
    ! printf '%s' "$qa" | grep -qF 'Real server start:' && \
    printf '%s' "$app" | grep -qF 'Real server start: canonical template row' && \
    ! printf '%s' "$app" | grep -qF 'Control inventory:'
}
