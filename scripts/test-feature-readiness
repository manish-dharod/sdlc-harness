for tier in small medium large; do
  case "$tier" in
    small)
      feature="small-app"
      task_ledger="$REPO/docs/features/$feature/FEATURE.md"
      evidence_ledger="$task_ledger"
      ;;
    *)
      feature="$tier-review"
      task_ledger="$REPO/docs/features/$feature/TASKS.md"
      evidence_ledger="$REPO/docs/features/$feature/EVIDENCE.md"
      ;;
  esac
  python3 - "$task_ledger" "$evidence_ledger" <<'PY'
from pathlib import Path
import re
import sys

task_path = Path(sys.argv[1])
evidence_path = Path(sys.argv[2])
task_text = task_path.read_text()
task_text, count = re.subn(
    r"^- Application verification:.*\n", "", task_text, count=1, flags=re.MULTILINE
)
if count != 1:
    raise SystemExit("fixture did not contain one application disposition")
task_path.write_text(task_text)

evidence_text = evidence_path.read_text()
evidence_text, receipt_count = re.subn(
    r"^- Review receipt:.*\n", "", evidence_text, count=1, flags=re.MULTILINE
)
evidence_text, audit_count = re.subn(
    r"^- Pre-review self-audit\s*$", "- Builder notes", evidence_text,
    count=1, flags=re.MULTILINE,
)
evidence_text, qa_count = re.subn(
    r"^- QA coverage ledger\s*$", "- QA notes", evidence_text,
    count=1, flags=re.MULTILINE,
)
if (receipt_count, audit_count, qa_count) != (1, 1, 1):
    raise SystemExit("fixture did not contain the expected receipt/self-audit/QA markers")
evidence_path.write_text(evidence_text)
PY
  current_review_missing_gates_fail() {
    output=$(cd "$REPO" && scripts/feature-reconcile "$feature" 2>&1)
    rc=$?
    [ "$rc" -eq 1 ] && \
      printf '%s' "$output" | grep -qF 'latest task evidence does not cite newest HEAD-tracked adversary receipt' && \
      printf '%s' "$output" | grep -qF 'latest evidence is missing a pre-review self-audit' && \
      printf '%s' "$output" | grep -qF 'latest evidence is missing a QA coverage ledger' && \
      printf '%s' "$output" | grep -qF "set 'Application verification: required' or 'not-applicable — <specific reason>'"
  }
  check "$tier-tier current Review task fails all four missing receipt/evidence/disposition gates" current_review_missing_gates_fail
  if [ "$task_ledger" = "$evidence_ledger" ]; then
    git -C "$REPO" show "HEAD:docs/features/$feature/FEATURE.md" > "$task_ledger"
  else
    git -C "$REPO" show "HEAD:docs/features/$feature/TASKS.md" > "$task_ledger"
    git -C "$REPO" show "HEAD:docs/features/$feature/EVIDENCE.md" > "$evidence_ledger"
  fi
done

for tier in medium large; do
  feature="$tier-review"
  evidence="$REPO/docs/features/$feature/EVIDENCE.md"
  replace_status "$evidence" '- Untested rows: 0' '- Untested rows: 1'
  current_review_qa_fail() {
    (cd "$REPO" && scripts/feature-reconcile "$feature" 2>&1) | \
      grep -qF 'QA coverage ledger needs one exact field set'
  }
  check "$tier-tier current Review task rejects a non-zero QA ledger" current_review_qa_fail
  git -C "$REPO" show "HEAD:docs/features/$feature/EVIDENCE.md" > "$evidence"
done

