newest_tracked_receipt_must_be_cited() {
  tracked=$(cd "$REPO" && scripts/feature-control latest-tracked-receipt-path small-app TASK-001) || return 1
  evidence=$(cd "$REPO" && scripts/feature-control latest-receipt-path small-app TASK-001) || return 1
  output=$(cd "$REPO" && scripts/feature-reconcile small-app 2>&1)
  rc=$?
  [ "$tracked" = "$FINDINGS_RECEIPT_REL" ] && [ "$evidence" = "$CLEAR_RECEIPT_REL" ] && \
    [ "$rc" -eq 1 ] && \
    printf '%s' "$output" | grep -qF 'latest task evidence does not cite newest HEAD-tracked adversary receipt'
}
check "newer tracked receipt cannot be hidden by omitting its evidence citation" newest_tracked_receipt_must_be_cited

cat >> "$REPO/docs/features/small-app/FEATURE.md" <<EOF

## 2026-07-10 - Receipt ordering conflict: TASK-001

- Task: TASK-001
- Review receipt: $FINDINGS_RECEIPT_REL
- Review receipt: $CLEAR_RECEIPT_REL
EOF
git -C "$REPO" add docs/features/small-app
git -C "$REPO" commit -qm 'cite newer findings receipt before older clear citation'
latest_is_chronological() {
  [ "$(cd "$REPO" && scripts/feature-control latest-receipt-path small-app TASK-001)" = "$FINDINGS_RECEIPT_REL" ]
}
check "latest receipt selection uses allocator chronology, not first/last text match" latest_is_chronological

reconcile_validates_selected_receipt() {
  (cd "$REPO" && scripts/feature-reconcile small-app 2>&1) | \
    grep -qF "latest receipt status is 'findings', expected clear"
}
check "reconcile validates the exact receipt selected for chronology" reconcile_validates_selected_receipt

review_evidence_cannot_borrow_prior_attempt() {
  output=$(cd "$REPO" && scripts/feature-reconcile small-app 2>&1)
  ! (cd "$REPO" && scripts/feature-control review-evidence small-app TASK-001 qa >/dev/null 2>&1) && \
    ! (cd "$REPO" && scripts/feature-control review-evidence small-app TASK-001 self-audit >/dev/null 2>&1) && \
    ! (cd "$REPO" && scripts/feature-control review-evidence small-app TASK-001 app >/dev/null 2>&1) && \
    printf '%s' "$output" | grep -qF 'latest evidence is missing a pre-review self-audit' && \
    printf '%s' "$output" | grep -qF 'latest evidence is missing a QA coverage ledger' && \
    printf '%s' "$output" | grep -qF 'latest evidence has no application verification block'
}
check "newest receipt section cannot borrow prior-attempt QA, self-audit, or app proof" review_evidence_cannot_borrow_prior_attempt

mkdir -p "$SMOKE_DIR/public"
cat > "$SMOKE_DIR/.env.fixture" <<'EOF'
APP_SMOKE_ORIGIN=http://127.0.0.1
EOF
cat > "$SMOKE_DIR/config.fixture.py" <<'EOF'
origin = os.environ.get("APP_SMOKE_ORIGIN")
EOF
printf '<html><body>smoke-ok</body></html>\n' > "$SMOKE_DIR/public/index.html"
SMOKE_PORT=$(python3 - <<'PY'
import socket
with socket.socket() as sock:
    sock.bind(("127.0.0.1", 0))
    print(sock.getsockname()[1])
PY
)
app_smoke_out=$(
  "$ROOT/scripts/verify-app-change" \
    --url "http://127.0.0.1:$SMOKE_PORT/" \
    --port "$SMOKE_PORT" \
    --env-file "docs/features/$SMOKE_SLUG/.env.fixture" \
    --config-file "docs/features/$SMOKE_SLUG/config.fixture.py" \
    --env-key APP_SMOKE_ORIGIN \
    --expect smoke-ok \
    --timeout 10 \
    -- python3 -m http.server "$SMOKE_PORT" --bind 127.0.0.1 --directory "$SMOKE_DIR/public" \
    2>&1
)
app_smoke_rc=$?
app_smoke_complete() {
  [ "$app_smoke_rc" -eq 0 ] && \
    printf '%s' "$app_smoke_out" | grep -qF 'PASS: Real server start' && \
    printf '%s' "$app_smoke_out" | grep -qF 'PASS: Index curl' && \
    printf '%s' "$app_smoke_out" | grep -qF 'PASS: Port check' && \
    printf '%s' "$app_smoke_out" | grep -qF 'PASS: Environment/config cross-check'
}
check "repo app-smoke helper starts/curls/checks port and env-config names" app_smoke_complete

missing_marker_out=$(
  "$ROOT/scripts/verify-app-change" \
    --url "http://127.0.0.1:$SMOKE_PORT/" \
    --port "$SMOKE_PORT" \
    -- python3 -m http.server "$SMOKE_PORT" --bind 127.0.0.1 \
    2>&1
)
missing_marker_rc=$?
app_smoke_requires_marker() {
  [ "$missing_marker_rc" -ne 0 ] && printf '%s' "$missing_marker_out" | grep -q -- '--expect'
}
check "repo app-smoke helper requires an identity marker" app_smoke_requires_marker

blank_marker_out=$(
  "$ROOT/scripts/verify-app-change" \
    --url "http://127.0.0.1:$SMOKE_PORT/" \
    --port "$SMOKE_PORT" \
    --expect '   ' \
    -- python3 -m http.server "$SMOKE_PORT" --bind 127.0.0.1 \
    2>&1
)
blank_marker_rc=$?
app_smoke_rejects_blank_marker() {
  [ "$blank_marker_rc" -ne 0 ] && \
    printf '%s' "$blank_marker_out" | grep -qF 'nonblank public marker'
}
check "repo app-smoke helper rejects a blank identity marker" app_smoke_rejects_blank_marker

cat > "$SMOKE_DIR/redirect_server.py" <<'PY'
from http.server import BaseHTTPRequestHandler, HTTPServer
import sys

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(302)
        self.send_header("Location", "https://example.com/")
        self.end_headers()

    def log_message(self, *args):
        pass

HTTPServer(("127.0.0.1", int(sys.argv[1])), Handler).serve_forever()
PY
REDIRECT_PORT=$(python3 - <<'PY'
import socket
with socket.socket() as sock:
    sock.bind(("127.0.0.1", 0))
    print(sock.getsockname()[1])
PY
)
redirect_out=$(
  "$ROOT/scripts/verify-app-change" \
    --url "http://127.0.0.1:$REDIRECT_PORT/" \
    --port "$REDIRECT_PORT" \
    --expect smoke-ok \
    --timeout 10 \
    -- python3 "$SMOKE_DIR/redirect_server.py" "$REDIRECT_PORT" \
    2>&1
)
redirect_rc=$?
cross_origin_redirect_fails() {
  [ "$redirect_rc" -ne 0 ] && \
    printf '%s' "$redirect_out" | grep -qF 'index redirect leaves the declared local origin'
}
check "repo app-smoke helper refuses cross-origin redirects" cross_origin_redirect_fails

replace_status "$REPO/docs/features/small-app/FEATURE.md" '- Status: Review' '- Status: Done'
git -C "$REPO" add docs/features/small-app/FEATURE.md
git -C "$REPO" commit -qm 'mark fixture task Done before hostile adoption advance'
HOSTILE_ADOPTION="$(git -C "$REPO" rev-parse HEAD)"
replace_status "$REPO/sdlc.config.yml" "$ADOPTION" "$HOSTILE_ADOPTION"
git -C "$REPO" add sdlc.config.yml
git -C "$REPO" commit -qm 'attempt to advance immutable adoption boundary'
adoption_pin_is_immutable() {
  config_output=$(cd "$REPO" && scripts/feature-control committed-config \
    SDLC_REVIEW_RECEIPT_ADOPTION_COMMIT 2>&1)
  config_rc=$?
  reconcile_output=$(cd "$REPO" && scripts/feature-reconcile small-app 2>&1)
  reconcile_rc=$?
  [ "$config_rc" -ne 0 ] && [ "$reconcile_rc" -eq 1 ] && \
    printf '%s' "$config_output" | grep -qF 'changed after first introduction' && \
    printf '%s' "$reconcile_output" | grep -qF 'changed after first introduction'
}
check "receipt adoption pin cannot advance after a task becomes Done" adoption_pin_is_immutable

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
