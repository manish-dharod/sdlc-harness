metadata_all_tiers() {
  small=$(cd "$REPO" && scripts/feature-reconcile small-app --print-task-metadata TASK-001) || return 1
  medium=$(cd "$REPO" && scripts/feature-reconcile medium-meta --print-task-metadata TASK-010) || return 1
  large=$(cd "$REPO" && scripts/feature-reconcile large-meta --print-task-metadata TASK-010) || return 1
  printf '%s' "$small" | grep -qF 'tier=small' && \
    printf '%s' "$small" | grep -qF 'task_ledger=docs/features/small-app/FEATURE.md' && \
    printf '%s' "$medium" | grep -qF 'tier=medium' && \
    printf '%s' "$large" | grep -qF 'tier=large' && \
    printf '%s' "$large" | grep -qF 'status=Done'
}
check "shared task metadata parser routes and normalizes all three tiers" metadata_all_tiers
