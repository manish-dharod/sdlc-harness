hostile_adoption_history_isolated() {
  lifecycle_out=$(
    cd "$REPO" && \
      GIT_DIR="$TMP_ROOT/hostile.git" \
      GIT_WORK_TREE="$TMP_ROOT/hostile-worktree" \
      GIT_INDEX_FILE="$TMP_ROOT/hostile-index" \
      GIT_CONFIG_COUNT=1 \
      GIT_CONFIG_KEY_0=core.repositoryformatversion \
      GIT_CONFIG_VALUE_0=99 \
      scripts/feature-control lifecycle small-app TASK-001 "$ADOPTION" 2>&1
  ) || return 1
  rows_out=$(
    cd "$REPO" && \
      GIT_DIR="$TMP_ROOT/hostile.git" \
      GIT_WORK_TREE="$TMP_ROOT/hostile-worktree" \
      GIT_INDEX_FILE="$TMP_ROOT/hostile-index" \
      GIT_CONFIG_COUNT=1 \
      GIT_CONFIG_KEY_0=core.repositoryformatversion \
      GIT_CONFIG_VALUE_0=99 \
      scripts/feature-control review-rows small-app "$ADOPTION" 2>&1
  ) || return 1
  [ "$lifecycle_out" = 'current|task was Claimed at the committed adoption boundary' ] && \
    printf '%s' "$rows_out" | grep -qF '|current|task was Claimed at the committed adoption boundary'
}
check "adoption lifecycle/history reads ignore hostile Git env and replacement refs" hostile_adoption_history_isolated
git -C "$REPO" replace -d "$ADOPTION" >/dev/null

