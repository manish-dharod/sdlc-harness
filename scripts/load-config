#!/usr/bin/env bash
# scripts/load-config - load optional sdlc.config.yml defaults.
#
# Source this from framework scripts:
#   . "$ROOT/scripts/load-config"
#
# This intentionally supports only the simple top-level keys used by the
# harness: `KEY: value` and `KEY: |` block literals. Environment variables set
# by the caller win over file values.

# Resolve this script's repo root so safety-critical paths (the error-budget
# downgrade floor) stay immune to the caller's CWD.
LOAD_CONFIG_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"
[ -n "$LOAD_CONFIG_ROOT" ] || LOAD_CONFIG_ROOT="."

CONFIG_FILE="${SDLC_CONFIG_FILE:-sdlc.config.yml}"

current_key=""
current_block=""
in_block=0

export_default() {
  key="$1"
  value="$2"
  existing="$(printenv "$key" 2>/dev/null || true)"
  # if-form, not `[ ... ] && export`: callers source this file under
  # `set -e`, and the && short-circuit returns 1 when the env var is
  # already set, killing the sourcing script.
  if [ -z "$existing" ]; then
    export "$key=$value"
  fi
}

if [ -f "$CONFIG_FILE" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    if [ "$in_block" -eq 0 ]; then
      case "$line" in
        ''|\#*) continue ;;
      esac
    fi

    if [ "$in_block" -eq 1 ]; then
      case "$line" in
        ' '*|$'\t'*)
          stripped="${line#  }"
          if [ -n "$current_block" ]; then
            current_block="${current_block}"$'\n'"${stripped}"
          else
            current_block="${stripped}"
          fi
          continue
          ;;
        *)
          [ -n "$current_key" ] && export_default "$current_key" "$current_block"
          current_key=""
          current_block=""
          in_block=0
          ;;
      esac
    fi

    case "$line" in
      *:\ \|)
        current_key="${line%%:*}"
        current_block=""
        in_block=1
        ;;
      *:*)
        key="${line%%:*}"
        val="${line#*: }"
        val="${val#\"}"; val="${val%\"}"
        val="${val#\'}"; val="${val%\'}"
        export_default "$key" "$val"
        ;;
    esac
  done < "$CONFIG_FILE"

  if [ "$in_block" -eq 1 ] && [ -n "$current_key" ]; then
    export_default "$current_key" "$current_block"
  fi
fi

sdlc_approval_is_approved() {
  approval_file="$1"
  approval_id="$2"

  [ -f "$approval_file" ] || return 1
  awk -v id="$approval_id" '
    /^### / {
      if ($0 ~ "^### " id ":") {
        in_block = 1
      } else if (in_block) {
        in_block = 0
      }
    }
    in_block && /^- Status: / {
      status = $0
      sub(/^- Status: /, "", status)
      gsub(/`/, "", status)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", status)
      if (status == "Approved") found = 1
    }
    END { exit(found ? 0 : 1) }
  ' "$approval_file"
}

normalize_self_improve_autonomy() {
  raw="${SDLC_SELF_IMPROVE_AUTONOMY:-capture}"
  case "$raw" in
    off|capture|distill|auto-structural)
      ;;
    *)
      printf 'load-config: invalid SDLC_SELF_IMPROVE_AUTONOMY=%s; using off\n' "$raw" >&2
      raw="off"
      ;;
  esac

  if [ "$raw" = "auto-structural" ]; then
    approval_file="${SDLC_SELF_IMPROVE_APPROVALS_FILE:-docs/features/continuous-self-improvement-loop/APPROVALS.md}"
    approval_id="${SDLC_SELF_IMPROVE_AUTO_APPROVAL_ID:-APV-001}"
    if ! sdlc_approval_is_approved "$approval_file" "$approval_id"; then
      printf 'load-config: SDLC_SELF_IMPROVE_AUTONOMY=auto-structural requested but %s is not Approved; using distill\n' "$approval_id" >&2
      raw="distill"
    fi
  fi

  if [ "$raw" = "auto-structural" ]; then
    # Check the repo-root-anchored canonical floor AND any
    # SDLC_ERROR_BUDGET_STATE_DIR override. The canonical floor is anchored to
    # this script's repo root (not the caller's CWD), so a breach recorded there
    # cannot be evaded by redirecting CWD or pointing the env override at an
    # empty dir for the read (FND-493/FND-550 class): the env override can only
    # ADD a state dir to check, never remove the canonical floor.
    for downgrade_file in \
      "$LOAD_CONFIG_ROOT/.sdlc/error-budget/state.env" \
      "${SDLC_ERROR_BUDGET_STATE_DIR:+${SDLC_ERROR_BUDGET_STATE_DIR}/state.env}"; do
      [ -n "$downgrade_file" ] || continue
      if [ -f "$downgrade_file" ] &&
         awk -F= '$1 == "SDLC_SELF_IMPROVE_AUTONOMY" && $2 == "distill" { found = 1 } END { exit(found ? 0 : 1) }' "$downgrade_file"; then
        printf 'load-config: error-budget downgrade is active; using distill\n' >&2
        raw="distill"
        break
      fi
    done
  fi

  export SDLC_SELF_IMPROVE_AUTONOMY="$raw"
}

normalize_self_improve_autonomy
