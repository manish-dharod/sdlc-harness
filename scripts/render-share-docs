#!/usr/bin/env python3
"""Render shareable standalone HTML versions of the public SDLC docs."""

from __future__ import annotations

import html
import re
from dataclasses import dataclass
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
OUT_DIR = ROOT / "docs" / "share"
GITHUB_DOCS_BASE = "https://github.com/manish-dharod/sdlc-harness/blob/main/docs/"


@dataclass(frozen=True)
class Page:
    source: Path
    output: Path
    title: str
    kicker: str
    description: str


PAGES = [
    Page(
        source=ROOT / "docs" / "AGENT_SDLC_OVERVIEW.md",
        output=OUT_DIR / "agent-sdlc-overview.html",
        title="Agentic SDLC Overview",
        kicker="SDLC Harness",
        description=(
            "A plain-English guide to the harness: why it exists, how memory "
            "works, how agents run in parallel, and where humans approve risk."
        ),
    ),
    Page(
        source=ROOT / "docs" / "AGENT_SDLC_WORKFLOW.md",
        output=OUT_DIR / "agent-sdlc-workflow.html",
        title="Agent SDLC Workflow",
        kicker="SDLC Harness",
        description=(
            "The operating guide for using the SDLC harness: feature folders, "
            "agents, commands, scripts, lifecycle, review, and release gates."
        ),
    ),
]


