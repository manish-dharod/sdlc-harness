def slugify(text: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return slug or "section"


def inline_md(text: str) -> str:
    placeholders: list[str] = []

    def keep(value: str) -> str:
        placeholders.append(value)
        return f"\x00{len(placeholders) - 1}\x00"

    def link_repl(match: re.Match[str]) -> str:
        label = inline_md(match.group(1))
        href = html.escape(rewrite_href(match.group(2)), quote=True)
        return keep(f'<a href="{href}">{label}</a>')

    text = re.sub(r"\[([^\]]+)\]\(([^)]+)\)", link_repl, text)

    def code_repl(match: re.Match[str]) -> str:
        return keep(f"<code>{html.escape(match.group(1))}</code>")

    text = re.sub(r"`([^`]+)`", code_repl, text)
    text = html.escape(text)
    text = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", text)
    text = re.sub(r"\*([^*]+)\*", r"<em>\1</em>", text)

    for idx, value in enumerate(placeholders):
        text = text.replace(f"\x00{idx}\x00", value)
    return text


def rewrite_href(href: str) -> str:
    filename = href.split("#", 1)[0].split("/")[-1]
    suffix = "#" + href.split("#", 1)[1] if "#" in href else ""
    if filename == "AGENT_SDLC_OVERVIEW.md":
        return "agent-sdlc-overview.html" + suffix
    if filename == "AGENT_SDLC_WORKFLOW.md":
        return "agent-sdlc-workflow.html" + suffix
    if filename.endswith(".md") and not re.match(r"^[a-z][a-z0-9+.-]*:", href):
        return GITHUB_DOCS_BASE + filename + suffix
    return href


def parse_table(lines: list[str], start: int) -> tuple[str | None, int]:
    if start + 1 >= len(lines):
        return None, start
    header = lines[start].strip()
    sep = lines[start + 1].strip()
    if not (header.startswith("|") and header.endswith("|")):
        return None, start
    if not re.fullmatch(r"\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)+\|?", sep):
        return None, start

    def cells(row: str) -> list[str]:
        row = row.strip().strip("|")
        return [cell.strip() for cell in row.split("|")]

    headers = cells(header)
    rows: list[list[str]] = []
    i = start + 2
    while i < len(lines):
        row = lines[i].strip()
        if not (row.startswith("|") and row.endswith("|")):
            break
        rows.append(cells(row))
        i += 1

    thead = "".join(f"<th>{inline_md(cell)}</th>" for cell in headers)
    tbody = []
    for row in rows:
        tbody.append("<tr>" + "".join(f"<td>{inline_md(cell)}</td>" for cell in row) + "</tr>")
    table = (
        '<div class="table-wrap"><table><thead><tr>'
        + thead
        + "</tr></thead><tbody>"
        + "".join(tbody)
        + "</tbody></table></div>"
    )
    return table, i


def render_markdown(markdown: str) -> tuple[str, list[tuple[int, str, str]]]:
    lines = markdown.splitlines()
    out: list[str] = []
    toc: list[tuple[int, str, str]] = []
    heading_counts: dict[str, int] = {}
    seen_section = False
    i = 0

    while i < len(lines):
        line = lines[i]

        if not line.strip():
            i += 1
            continue

        if line.startswith("```"):
            language = line.strip().strip("`").strip()
            code_lines: list[str] = []
            i += 1
            while i < len(lines) and not lines[i].startswith("```"):
                code_lines.append(lines[i])
                i += 1
            i += 1
            class_attr = f' class="language-{html.escape(language)}"' if language else ""
            out.append(f"<pre><code{class_attr}>{html.escape(chr(10).join(code_lines))}</code></pre>")
            continue

        table, next_i = parse_table(lines, i)
        if table:
            out.append(table)
            i = next_i
            continue

        heading = re.match(r"^(#{1,4})\s+(.+)$", line)
        if heading:
            level = len(heading.group(1))
            text = heading.group(2).strip()
            if level == 1:
                i += 1
                continue
            seen_section = True
            base = slugify(re.sub(r"`([^`]+)`", r"\1", text))
            count = heading_counts.get(base, 0)
            heading_counts[base] = count + 1
            anchor = base if count == 0 else f"{base}-{count + 1}"
            if level == 2:
                toc.append((level, text, anchor))
            out.append(f'<h{level} id="{anchor}">{inline_md(text)}</h{level}>')
            i += 1
            continue

        if line.startswith(">"):
            quote_lines: list[str] = []
            while i < len(lines) and lines[i].startswith(">"):
                quote_lines.append(lines[i].lstrip(">").strip())
                i += 1
            if not seen_section:
                continue
            out.append("<blockquote>" + render_paragraphs(quote_lines) + "</blockquote>")
            continue

        list_match = re.match(r"^(\s*)([-*]|\d+\.)\s+(.+)$", line)
        if list_match:
            ordered = bool(re.match(r"\d+\.", list_match.group(2)))
            tag = "ol" if ordered else "ul"
            items: list[str] = []
            while i < len(lines):
                item_match = re.match(r"^\s*([-*]|\d+\.)\s+(.+)$", lines[i])
                if not item_match:
                    break
                item_text = item_match.group(2).strip()
                i += 1
                continuation: list[str] = []
                while i < len(lines) and lines[i].startswith("  ") and not re.match(r"^\s*([-*]|\d+\.)\s+", lines[i]):
                    continuation.append(lines[i].strip())
                    i += 1
                if continuation:
                    item_text += " " + " ".join(continuation)
                items.append(f"<li>{inline_md(item_text)}</li>")
            out.append(f"<{tag}>" + "".join(items) + f"</{tag}>")
            continue

        para_lines = [line.strip()]
        i += 1
        while i < len(lines):
            nxt = lines[i]
            if not nxt.strip():
                break
            if nxt.startswith("```") or nxt.startswith("#") or nxt.startswith(">") or re.match(r"^\s*([-*]|\d+\.)\s+", nxt):
                break
            if parse_table(lines, i)[0]:
                break
            para_lines.append(nxt.strip())
            i += 1
        out.append(render_paragraphs(para_lines))

    return "\n".join(out), toc


def render_paragraphs(lines: list[str]) -> str:
    text = " ".join(line for line in lines if line.strip())
    return f"<p>{inline_md(text)}</p>" if text else ""


def nav_html(current: str) -> str:
    links = [
        ("agent-sdlc-overview.html", "Overview"),
        ("agent-sdlc-workflow.html", "Workflow"),
    ]
    rendered = []
    for href, label in links:
        current_attr = ' aria-current="page"' if href == current else ""
        rendered.append(f'<a href="{href}"{current_attr}>{label}</a>')
    return "".join(rendered)


def render_page(page: Page) -> str:
    body, toc = render_markdown(page.source.read_text())
    toc_items = "\n".join(
        f'<li class="toc-level-{level}"><a href="#{anchor}">{html.escape(text)}</a></li>'
        for level, text, anchor in toc
    )
    source_name = page.source.name
    return f"""<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{html.escape(page.title)}</title>
  <meta name="description" content="{html.escape(page.description, quote=True)}">
  <style>{STYLE}</style>
</head>
<body>
  <header class="site-bar">
    <div class="site-bar__inner">
      <div class="brand">SDLC Harness</div>
      <nav class="nav" aria-label="Document navigation">
        {nav_html(page.output.name)}
      </nav>
    </div>
  </header>

  <main class="page">
    <section class="hero">
      <p class="kicker">{html.escape(page.kicker)}</p>
      <h1>{html.escape(page.title)}</h1>
      <p class="dek">{html.escape(page.description)}</p>
      <div class="meta">
        <span class="pill">Standalone HTML</span>
        <span class="pill">Source: {html.escape(source_name)}</span>
        <span class="pill">Updated 2026-05-27</span>
      </div>
    </section>

    <div class="layout">
      <article>
        {body}
      </article>
      <aside class="toc" aria-label="Table of contents">
        <h2>In This Article</h2>
        <ol>
          {toc_items}
        </ol>
      </aside>
    </div>

    <footer class="footer">
      Open this file directly in a browser. No build step or network access is required.
    </footer>
  </main>
</body>
</html>
"""


def main() -> None:
    OUT_DIR.mkdir(parents=True, exist_ok=True)
    for page in PAGES:
        page.output.write_text(render_page(page))
        print(page.output)


if __name__ == "__main__":
    main()
