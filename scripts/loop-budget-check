#!/usr/bin/env python3
"""Evaluate feature-loop iteration budgets and oscillation deterministically."""

from __future__ import annotations

import argparse
import datetime as dt
import re
import sys
from dataclasses import dataclass
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SLUG_RE = re.compile(r"[a-z0-9][a-z0-9-]{0,79}")
HEADING_RE = re.compile(r"^###\s+(RUN-[A-Za-z0-9-]+)\s+[—-]\s+(\d{4}-\d{2}-\d{2})\b")
FIELD_RE = re.compile(r"^- ([A-Za-z][A-Za-z0-9 -]*):\s*(.*)$")
FINDING_RE = re.compile(r"\b(?:FND|ADV-FND|SEC-FND)-[A-Za-z0-9-]+\b")
DEFAULTS = {"iterations": 25, "no_progress": 3, "blocked_external": 3}


@dataclass
class Run:
    run_id: str
    date: dt.date
    fields: dict[str, str]

    @property
    def task(self) -> str:
        return self.fields.get("task claimed", "").strip("` ")

    @property
    def file_count(self) -> int | None:
        match = re.match(r"\s*(\d+)\b", self.fields.get("files changed", ""))
        return int(match.group(1)) if match else None

    @property
    def diff_hash(self) -> str:
        value = self.fields.get("diff hash", "").strip("` ")
        return value if re.fullmatch(r"[A-Fa-f0-9]{7,64}", value) else ""

    @property
    def stop_reason(self) -> str:
        return self.fields.get("stop reason", "").strip("` ").lower()

    def findings(self, field: str) -> set[str]:
        return set(FINDING_RE.findall(self.fields.get(field, "")))


def parse_runs(path: Path) -> list[Run]:
    runs: list[Run] = []
    current: Run | None = None
    fenced = False
    for line in path.read_text(encoding="utf-8").splitlines():
        if re.match(r"^\s*```", line):
            fenced = not fenced
            continue
        if fenced:
            continue
        heading = HEADING_RE.match(line)
        if heading:
            current = Run(heading.group(1), dt.date.fromisoformat(heading.group(2)), {})
            runs.append(current)
            continue
        if current:
            field = FIELD_RE.match(line)
            if field:
                current.fields[field.group(1).strip().lower()] = field.group(2).strip()
    return runs


def parse_budgets(paths: list[Path]) -> dict[str, int]:
    budgets = dict(DEFAULTS)
    patterns = {
        "iterations": re.compile(r"Max iterations per .*campaign:\s*(\d+)", re.I),
        "no_progress": re.compile(r"Max consecutive no-progress iterations:\s*(\d+)", re.I),
        "blocked_external": re.compile(r"Max consecutive .*blocked-external.*:\s*(\d+)", re.I),
    }
    for path in paths:
        if not path.is_file():
            continue
        text = path.read_text(encoding="utf-8")
        for key, pattern in patterns.items():
            match = pattern.search(text)
            if match:
                budgets[key] = int(match.group(1))
    return budgets


def trailing_count(runs: list[Run], predicate) -> int:  # type: ignore[no-untyped-def]
    count = 0
    for run in reversed(runs):
        if not predicate(run):
            break
        count += 1
    return count


def verdict(runs: list[Run], budgets: dict[str, int], as_of: dt.date) -> tuple[int, str]:
    today_count = sum(run.date == as_of for run in runs)
    if today_count >= budgets["iterations"]:
        return 10, f"ITERATION_BUDGET_EXHAUSTED count={today_count} limit={budgets['iterations']}"

    blocked = trailing_count(runs, lambda run: run.stop_reason == "blocked-external")
    if blocked >= budgets["blocked_external"]:
        return 12, f"BLOCKED_EXTERNAL_BUDGET_EXHAUSTED consecutive={blocked} limit={budgets['blocked_external']}"

    no_progress = trailing_count(
        runs,
        lambda run: run.file_count == 0 or run.stop_reason in {"no-progress", "oscillation"},
    )
    if no_progress >= budgets["no_progress"]:
        return 11, f"NO_PROGRESS_3X consecutive={no_progress} limit={budgets['no_progress']}"

    if len(runs) >= 2:
        previous, latest = runs[-2], runs[-1]
        if latest.task and latest.task == previous.task and latest.file_count == previous.file_count == 0:
            return 20, f"OSCILLATION_DETECTED same-task-zero-files task={latest.task}"
        if latest.diff_hash and latest.diff_hash == previous.diff_hash:
            return 21, f"OSCILLATION_DETECTED repeated-diff-hash hash={latest.diff_hash}"

    if len(runs) >= 3:
        last_three = runs[-3:]
        cycled = set.intersection(
            *(run.findings("findings opened") & run.findings("findings closed") for run in last_three)
        )
        if cycled:
            return 22, f"OSCILLATION_DETECTED repeated-finding-cycle finding={sorted(cycled)[0]}"

    return 0, (
        f"OK iterations={today_count}/{budgets['iterations']} "
        f"no-progress={no_progress}/{budgets['no_progress']} "
        f"blocked-external={blocked}/{budgets['blocked_external']}"
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("slug")
    parser.add_argument("--as-of", help="campaign/day date (YYYY-MM-DD); default: today UTC")
    parser.add_argument("--feature-dir", type=Path, help="test/operator override")
    args = parser.parse_args()
    if not SLUG_RE.fullmatch(args.slug):
        parser.error("slug must contain lowercase letters, digits, and hyphens")
    try:
        as_of = dt.date.fromisoformat(args.as_of) if args.as_of else dt.datetime.now(dt.timezone.utc).date()
    except ValueError:
        parser.error("--as-of must be YYYY-MM-DD")
    feature_dir = args.feature_dir or ROOT / "docs" / "features" / args.slug
    runs_path = feature_dir / "RUNS.md"
    if not runs_path.is_file():
        print(f"loop-budget-check: RUNS.md not found: {runs_path}", file=sys.stderr)
        return 3
    try:
        runs = parse_runs(runs_path)
        budgets = parse_budgets([runs_path, feature_dir / "STATE.md"])
    except (OSError, UnicodeError, ValueError) as error:
        print(f"loop-budget-check: could not parse control plane: {error}", file=sys.stderr)
        return 3
    code, message = verdict(runs, budgets, as_of)
    print(f"loop-budget-check: {message}")
    return code


if __name__ == "__main__":
    raise SystemExit(main())
