#!/usr/bin/env bash
# Scaffold a new feature control plane from a tier-appropriate template.
#
# Usage:
#   scripts/feature-init <feature-slug>
#   scripts/feature-init <feature-slug> --spec path/to/spec.md
#   scripts/feature-init <feature-slug> --tier {small|medium|large}
#   scripts/feature-init <feature-slug> --tier medium --spec path/to/spec.md
#
# Tiers:
#   small  — 1 file  (FEATURE.md). 1–3 day scope, no schema/PCI/auth surface.
#   medium — 5 files (README, SPEC, DESIGN, TASKS, EVIDENCE). 1–2 week scope.
#   large  — 19 files (full v2 control plane). Default. PCI / payment / multi-
#            team / launch-gated work.
#
# Tier defaults to `large` for back-compat with existing callers and CI.
#
# This script does not invoke any agent. It only does deterministic file
# scaffolding. Agent invocation is the job of the /feature-init slash command.

set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 1

SLUG="${1:-}"
SPEC_PATH=""
TIER="large"

usage() {
  cat <<'EOF'
Usage: scripts/feature-init <feature-slug> [--tier small|medium|large] [--spec path/to/spec.md]

Tiers:
  small   1 file   (FEATURE.md)               — tiny scoped features
  medium  5 files  (README/SPEC/DESIGN/TASKS/EVIDENCE) — week-scale features
  large   19 files (full v2 control plane)    — PCI/payment/launch-gated work (default)

Examples:
  scripts/feature-init add-coupon-field --tier small
  scripts/feature-init carrier-paypal --tier medium --spec docs/specs/paypal.md
  scripts/feature-init example-feature-v3 --tier large
EOF
}

if [ -z "$SLUG" ] || [ "$SLUG" = "-h" ] || [ "$SLUG" = "--help" ]; then
  usage
  exit 2
fi

shift
while [ $# -gt 0 ]; do
  case "$1" in
    --spec)
      SPEC_PATH="${2:-}"
      shift 2
      ;;
    --tier)
      TIER="${2:-}"
      shift 2
      ;;
    *)
      printf 'Unknown arg: %s\n' "$1" >&2
      usage
      exit 2
      ;;
  esac
done

case "$TIER" in
  small|medium|large) ;;
  *)
    printf 'Invalid --tier: %s (expected small|medium|large)\n' "$TIER" >&2
    exit 2
    ;;
esac

# Resolve template source by tier. Large maps to the legacy `_template` path
# so existing callers (no --tier flag) behave exactly as before.
case "$TIER" in
  small)  SRC_DIR="docs/features/_template-small" ;;
  medium) SRC_DIR="docs/features/_template-medium" ;;
  large)  SRC_DIR="docs/features/_template" ;;
esac

TARGET_DIR="docs/features/$SLUG"

if [ -d "$TARGET_DIR" ]; then
  printf 'Refusing to overwrite existing feature: %s\n' "$TARGET_DIR" >&2
  printf 'If you intend to re-scaffold, archive the existing folder first.\n' >&2
  exit 1
fi

if [ ! -d "$SRC_DIR" ]; then
  printf 'Missing template directory: %s\n' "$SRC_DIR" >&2
  printf 'Expected for --tier %s. Re-run scripts/feature-init --help for tier list.\n' "$TIER" >&2
  exit 1
fi

cp -R "$SRC_DIR" "$TARGET_DIR"

# Drop a `.tier` marker so downstream tooling can identify which control plane
# this feature uses without re-inspecting file structure.
printf '%s\n' "$TIER" > "$TARGET_DIR/.tier"

# Drop spec contents into the spec file if provided. The spec file path differs
# by tier (FEATURE.md for small, SPEC.md for medium/large).
if [ -n "$SPEC_PATH" ]; then
  if [ ! -f "$SPEC_PATH" ]; then
    printf 'Spec file not found: %s\n' "$SPEC_PATH" >&2
    exit 1
  fi

  case "$TIER" in
    small)  SPEC_TARGET="$TARGET_DIR/FEATURE.md" ;;
    medium) SPEC_TARGET="$TARGET_DIR/SPEC.md" ;;
    large)  SPEC_TARGET="$TARGET_DIR/SPEC.md" ;;
  esac

  # Replace the placeholder "<spec text>" line with the contents of the spec file.
  # Uses awk for portability.
  tmp="$(mktemp)"
  awk -v specfile="$SPEC_PATH" '
    /^> <spec text>$/ {
      while ((getline line < specfile) > 0) {
        print "> " line
      }
      close(specfile)
      next
    }
    { print }
  ' "$SPEC_TARGET" > "$tmp" && mv "$tmp" "$SPEC_TARGET"

  printf 'Spec contents inserted into %s from %s.\n' "$SPEC_TARGET" "$SPEC_PATH"
fi

printf 'Scaffolded %s (tier=%s) from %s.\n\n' "$TARGET_DIR" "$TIER" "$SRC_DIR"
printf 'Files created:\n'
ls -1 "$TARGET_DIR" | sed 's/^/  /'

cat <<EOF

Next steps (tier=$TIER):
EOF

case "$TIER" in
  small)
    cat <<EOF
  1. Edit $TARGET_DIR/FEATURE.md — set Goal, ACs, first task.
  2. If --spec was not used: paste the spec under "Owner-provided spec" (if you added that section).
  3. Implement the task; record evidence inline.
  4. When all ACs verified + tasks Done + no P0/P1 findings: feature is done.
EOF
    ;;
  medium)
    cat <<EOF
  1. Edit $TARGET_DIR/README.md — set Goal and verification profile.
  2. Edit $TARGET_DIR/SPEC.md — paste spec (if --spec not used), extract AC IDs.
  3. Author $TARGET_DIR/DESIGN.md and set Status: Approved before opening tasks.
  4. Add tasks to $TARGET_DIR/TASKS.md, cite AC IDs.
  5. Record verification + findings in $TARGET_DIR/EVIDENCE.md as you go.
EOF
    ;;
  large)
    cat <<EOF
  1. Edit $TARGET_DIR/README.md — set Goal, Scope, Main areas.
  2. Edit $TARGET_DIR/STATE.md — set Feature metadata + verification profile.
  3. If --spec was not used: paste the spec into $TARGET_DIR/SPEC.md
     under "Owner-provided spec".
  4. In Claude Code: /feature-context $SLUG
  5. Invoke planner (Phase: intake) via the Task tool to extract AC/NFR IDs and open
     ambiguity questions.
EOF
    ;;
esac

printf '\nTier marker written to %s/.tier\n' "$TARGET_DIR"
